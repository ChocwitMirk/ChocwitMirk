actProp('snap',6,32.6,Math.PI,1.7,.8,null,g=>{B(1.5,1.5,1.0,0x8f55e6,0,.75,0,g);B(1.8,.16,1.3,0xf5c544,0,1.58,0,g);B(1.1,.5,.06,0xfff6df,0,1.05,.52,g);
  B(1.3,.1,.3,0x9a6a3e,0,.82,.62,g);const cam2=B(.6,.38,.3,0x2b2118,0,1.9,0,g);cam2.rotation.y=.3;C(.13,.18,0x9aa3ad,.08,1.9,.17,g,[Math.PI/2,0,0]);E(.07,.05,.05,0xffd23f,-.16,2.12,0,g);
  for(const s of[-1,1])B(.09,1.6,.09,0x6b4a2e,s*.8,.8,-.55,g);});
// flowers and clover were scattered before the props went down: tuck away any that landed inside something solid (barrels, signs, coop...)
(function cullGrass(){const M4=new THREE.Matrix4(),P=new THREE.Vector3(),Z=new THREE.Matrix4().makeScale(0,0,0);
  const inside=(x,z)=>{for(const c of farmCircles)if((x-c.x)**2+(z-c.z)**2<(c.r+.15)**2)return true;for(const q of farmBoxes)if(Math.abs(x-q.x)<q.hw+.15&&Math.abs(z-q.z)<q.hd+.15)return true;return false;};
  for(const im of[GRASS.clover,GRASS.flowers]){if(!im)continue;let n=0;for(let k=0;k<im.count;k++){im.getMatrixAt(k,M4);P.setFromMatrixPosition(M4);if(inside(P.x,P.z)){im.setMatrixAt(k,Z);n++;}}if(n)im.instanceMatrix.needsUpdate=true;}})();

// ---- the game ----
const SNAP={speed:.43,props:[],keyM:false,keyP:false,film:12,shots:[],dist:0,v:0,look:0,pitch:-.04,zoom:0,zoomT:0,done:false,drag:null,flash:0,mooCD:0,t:0,keyZ:false,keyF:false};
const SNAP_SPOTS=[[-27,-28.5],[-9,-30.5],[2,-26],[29.5,-3],[18.5,9.5],[30,10],[28,26],[10,29.5],[-7,30.5],[-29.5,6],[-30,-9],[-14,23]];
function snapPlaceFriends(){const spots=SNAP_SPOTS.slice().sort(()=>Math.random()-.5);
  FRIENDS.forEach((f,i)=>{const[x,z]=spots[i%spots.length];f.state='snap';f.obj.visible=true;f.obj.position.set(x,0,z);resolve(f.obj.position,.4);f.obj.rotation.order='YXZ';f.obj.rotation.set(0,rnd(0,TAU),0);
    const bb=new THREE.Box3().setFromObject(f.obj);f.sn={hx:f.obj.position.x,hz:f.obj.position.z,tx:f.obj.position.x,tz:f.obj.position.z,wt:rnd(.5,3),pose:0,h:Math.max(.5,bb.max.y-bb.min.y),sc:f.obj.scale.clone(),gag:null,gagCD:rnd(4,12)};});}
function startSnap(){setLevel('farm');mode='snap';state='play';resetFriendsTo('roam');snapPlaceFriends();
  snapClearProps();snapMakePeeks();Object.assign(SNAP,{speed:.43,film:12,shots:[],dist:0,v:0,look:0,pitch:-.04,zoom:0,zoomT:0,done:false,drag:null,flash:0,mooCD:0,t:0});
  trainPlace(TRAIN.stationU);moonie.root.visible=false;moonie.vel.set(0,0,0);
  hud(['snapUI','pauseBtn']);for(const id of['title','end','pause','intro'])$(id).hidden=true;$('snapEnd').hidden=true;$('snapAlbum').hidden=true;snapHud();snapLeverShow();canvas.focus();
  [392,523,659].forEach((f,i)=>voice({type:'square',f0:f,f1:f*.98,dur:.5,vol:.07,filt:1800,delay:i*.02}));
  toast(isTouch()?'<b>All aboard!</b>Drag to look around. Tap an animal to make it do something silly, tap anywhere else for a photo. Slide the lever to go faster or slower!':'<b>All aboard!</b>Drag or use the arrow keys to look, Space takes a photo, click an animal to make it do something silly, Z zooms, Q moos, - and = (or the lever) change the speed!',4800);}
function snapHud(){$('snapFilm').textContent=SNAP.film;$('snapUI').classList.toggle('zoomed',SNAP.zoomT>.5);$('snapZoom').setAttribute('aria-pressed',SNAP.zoomT>.5);if(!$('snapMooImg').src&&typeof COW_TOKEN!=='undefined')$('snapMooImg').src=COW_TOKEN;}
function updateSnap(dt,pad){const S=SNAP;S.t+=dt;
  const target=S.done?0:(S.film<=0?11:S.speed*10);S.v=lerp(S.v,target,1-Math.pow(.25,dt));S.dist+=S.v*dt;
  trainPlace(TRAIN.stationU+S.dist);trainTick(dt,S.v>.3,S.v);
  _tk.u=0;trkAt(TRAIN.stationU+S.dist+TRAIN.offs[1],_tk);moonie.pos.set(_tk.x,0,_tk.z);
  {const w=Math.round(clamp(S.dist/TRK.L)*200)/2;if(w!==S._tw){S._tw=w;$('snapTrack').style.width=w+'%';}}
  if(!S.done&&S.dist>=TRK.L-6.5){S.done=true;[659,523,392].forEach((f,i)=>voice({type:'square',f0:f,f1:f*.98,dur:.4,vol:.07,filt:1800,delay:i*.18}));setTimeout(()=>{if(mode==='snap'&&state==='play')snapFinish();},1600);}
  // look around: keys, sticks; drag/touch is handled by the pointer code
  const kx=(keys.ArrowLeft||keys.KeyA?1:0)-(keys.ArrowRight||keys.KeyD?1:0)-pad.x-pad.rx,ky=(keys.ArrowUp||keys.KeyW?1:0)-(keys.ArrowDown||keys.KeyS?1:0)-pad.y-pad.ry;
  const zk=1-S.zoom*.7;S.look=clamp(S.look+kx*dt*1.6*zk,-2.6,2.6);S.pitch=clamp(S.pitch+ky*dt*1.1*zk,-.6,.45);
  if(keys.KeyZ&&!S.keyZ){S.zoomT=S.zoomT>.5?0:1;snapHud();voice({type:'triangle',f0:600,f1:900,dur:.08,vol:.06});}S.keyZ=!!keys.KeyZ;
  if(act.search){S.zoomT=S.zoomT>.5?0:1;snapHud();voice({type:'triangle',f0:600,f1:900,dur:.08,vol:.06});}
  S.zoom=lerp(S.zoom,S.zoomT,1-Math.pow(.002,dt));
  if(act.jump||(keys.KeyF&&!S.keyF))snapShoot();S.keyF=!!keys.KeyF;
  const bt=pad.btn||{};if((keys.Minus&&!S.keyM)||bt.lb)snapSetSpeed(S.speed-.2);if((keys.Equal&&!S.keyP)||bt.rb)snapSetSpeed(S.speed+.2);S.keyM=!!keys.Minus;S.keyP=!!keys.Equal;
  S.mooCD-=dt;if(act.moo)snapMoo();snapPropsTick(dt);
  {const f0=S.flash;S.flash=Math.max(0,S.flash-dt*3);if(f0>0||S._fl!==0){S._fl=S.flash;$('snapFlash').style.opacity=S.flash;}}
  // the animals mill about their spot; when Moonie moos nearby they turn, hop and pose
  const cp=cam.position,t=S.t;snapPeekTick(dt,cp);
  for(const f of FRIENDS){const n=f.sn;if(!n||f.state!=='snap')continue;const o=f.obj;n.pose=Math.max(0,n.pose-dt);
    if(n.peek)continue;if(n.gag){snapGagTick(f,n,dt,cp);continue;}
    n.gagCD-=dt;if(n.gagCD<=0){n.gagCD=rnd(9,18);if(o.position.distanceTo(cp)<30&&Math.random()<.55){snapGag(f,true);continue;}}
    if(n.pose>0){const want=Math.atan2(cp.x-o.position.x,cp.z-o.position.z);o.rotation.y=lerpAngle(o.rotation.y,want,1-Math.pow(.001,dt));o.position.y=Math.abs(Math.sin(t*9+n.hx))*.32*Math.min(1,n.pose);}
    else{o.position.y=Math.max(0,o.position.y-dt*2);n.wt-=dt;if(n.wt<=0){n.wt=rnd(2.5,5.5);const a=rnd(0,TAU),r=rnd(0,1.8);n.tx=n.hx+Math.cos(a)*r;n.tz=n.hz+Math.sin(a)*r;if(Math.random()<.12)n.pose=1.4;}
      const dx=n.tx-o.position.x,dz=n.tz-o.position.z,d=Math.hypot(dx,dz);if(d>.08){const sp=Math.min(d,.7*dt);o.position.x+=dx/d*sp;o.position.z+=dz/d*sp;o.rotation.y=lerpAngle(o.rotation.y,Math.atan2(dx,dz),1-Math.pow(.01,dt));}}}}
// ---- silly tricks: tap an animal (or wait) and it does its thing; photos taken mid-trick get a funny caption ----
const SNAP_GAGS={
  pig:{dur:2.1,ev:1.0,side:true,cap:['Pee-yew! # pooped!','# did a stinky!','Caught # pooping!','Oops, # made a mess!']},
  chicken:{dur:1.8,ev:.9,cap:['# laid an egg!','Egg-cellent shot!','Surprise egg from #!']},
  sheep:{dur:1.8,ev:.6,cap:['Fluffy explosion!','# got extra fluffy!','Bless you, #!']},
  duck:{dur:1.6,ev:.2,cap:['Dizzy duck!','# is spinning!','Round and round!']},
  dog:{dur:2.2,ev:.3,cap:['# is chasing that tail!','Tail chaser!','So close, #!']},
  horse:{dur:2.0,ev:.5,cap:['Yee-haw!','# stood up tall!','Whoa there, #!']},
  goat:{dur:1.3,ev:.1,cap:['Goat flip!','# got big air!','A perfect ten!']},
  cat:{dur:2.4,ev:.3,cap:['Big stretch!','# is sooo sleepy!','Stretchy cat!']},
  llama:{dur:1.6,ev:.75,cap:['Llama spit! Ewww!','Ptooey!','# spit at the camera!']},
  donkey:{dur:1.6,ev:.4,cap:['Donkey kick!','# kicked up high!','Hee-haw kick!']}};
function snapGag(f,auto){const n=f.sn;if(!n||n.gag||n.peek||!SNAP_GAGS[f.kind])return;n.gag={t:0,did:false,dur:SNAP_GAGS[f.kind].dur,ev:SNAP_GAGS[f.kind].ev};n.pose=0;n.gagCD=rnd(10,18);
  if(!auto)voice({type:'triangle',f0:700,f1:1000,dur:.07,vol:.06});}
function snapGagTick(f,n,dt,cp){const o=f.obj,g=n.gag,G=SNAP_GAGS[f.kind];g.t+=dt;const p=clamp(g.t/g.dur),S1=Math.sin(Math.PI*p);
  const toCam=Math.atan2(cp.x-o.position.x,cp.z-o.position.z);
  if(f.kind!=='duck'&&f.kind!=='dog')o.rotation.y=lerpAngle(o.rotation.y,toCam+(G.side?Math.PI/2:0),1-Math.pow(.02,dt));
  o.scale.copy(n.sc);o.rotation.x=0;o.position.y=0;
  switch(f.kind){
    case'pig':o.scale.y*=1-.16*S1;o.scale.x*=1+.06*S1;break;
    case'chicken':o.position.y=Math.abs(Math.sin(g.t*14))*.14*S1;break;
    case'sheep':o.scale.multiplyScalar(1+.45*Math.sin(Math.PI*clamp(g.t/.9)));break;
    case'duck':o.rotation.y+=dt*16*(1-p*.6);break;
    case'dog':o.rotation.y+=dt*12*(1-p*.3);o.position.y=Math.abs(Math.sin(g.t*10))*.05;break;
    case'horse':o.rotation.x=-.65*S1;o.position.y=.3*n.h*S1;break;
    case'goat':o.rotation.x=-TAU*(p*p*(3-2*p));o.position.y=6.4*p*(1-p)*Math.max(.8,n.h);break;
    case'cat':o.scale.z*=1+.42*S1;o.scale.y*=1-.25*S1;break;
    case'llama':o.rotation.x=g.t<g.ev?-.28*Math.sin(Math.PI/2*clamp(g.t/g.ev)):-.28*(1-clamp((g.t-g.ev)/.3))+.12*Math.sin(Math.PI*clamp((g.t-g.ev)/.3));break;
    case'donkey':o.rotation.x=.42*S1;break;}
  if(!g.did&&g.t>=g.ev){g.did=true;const fx=Math.sin(o.rotation.y),fz=Math.cos(o.rotation.y);
    if(f.kind==='pig'){voice({type:'sawtooth',f0:95,f1:55,dur:.55,vol:.16,filt:500,vib:30});voice({type:'sine',f0:320,f1:110,dur:.14,vol:.12,delay:.45});
      snapAddProp(poopTpl.clone(),o.position.x-fx*.6,o.position.z-fz*.6,.75,'poop',f);
      for(let i=0;i<3;i++){const m=new THREE.Mesh(sphG,new THREE.MeshBasicMaterial({color:0x9acd32,transparent:true,opacity:.6,depthWrite:false}));m.userData.noOutline=true;m.scale.setScalar(.14);
        snapAddProp(m,o.position.x-fx*.6+rnd(-.2,.2),o.position.z-fz*.6+rnd(-.2,.2),1,'stink',f,.4+i*.25);}}
    else if(f.kind==='chicken'){const eg=new THREE.Group();E(.11,.15,.11,0xfff3dc,0,.15,0,eg);addOutlines(eg,0,.004);snapAddProp(eg,o.position.x-fx*.32,o.position.z-fz*.32,1,'egg',f);voice({type:'sine',f0:500,f1:900,dur:.1,vol:.1});friendSound(f,1,0);}
    else if(f.kind==='sheep'){noiseBurst(.18,.14,2200);friendSound(f,.9,0,.2);}
    else if(f.kind==='llama'){voice({type:'sawtooth',f0:180,f1:90,dur:.18,vol:.1,filt:900});const sp=new THREE.Mesh(sphG,M(0xeefaff));sp.userData.noOutline=true;sp.scale.setScalar(.09);
      const from=new THREE.Vector3(o.position.x+fx*.45,n.h*.9,o.position.z+fz*.45);sp.position.copy(from);farmRoot.add(sp);SNAP.props.push({g:sp,kind:'spit',t:0,from,to:cp.clone(),life:2});}
    else friendSound(f,1,0);}
  if(g.t>=g.dur){o.scale.copy(n.sc);o.rotation.x=0;o.position.y=0;n.gag=null;n.wt=rnd(1,3);n.tx=o.position.x;n.tz=o.position.z;}}
function snapAddProp(g,x,z,sc,kind,f,delay=0){g.position.set(x,0,z);g.scale.multiplyScalar(.01);g.visible=delay<=0;farmRoot.add(g);SNAP.props.push({g,kind,f,sc:g.scale.x/.01*sc,t:-delay,life:kind==='stink'?2.2:40});}
function snapPropsTick(dt){const L=SNAP.props;for(let i=L.length-1;i>=0;i--){const q=L[i];q.t+=dt;
    if(q.kind==='spit'){const k=clamp(q.t/.6);q.g.position.lerpVectors(q.from,q.to,k);q.g.position.y+=Math.sin(k*Math.PI)*.8;
      if(k>=1&&!q.hit){q.hit=true;q.g.visible=false;q.life=0;if(mode==='snap'){$('snapSpit').style.transition='none';$('snapSpit').style.opacity=1;noiseBurst(.1,.12,1500);setTimeout(()=>{$('snapSpit').style.transition='';$('snapSpit').style.opacity=0;},1100);}}}
    else if(q.t>=0){q.g.visible=true;
      if(q.kind==='stink'){q.g.scale.setScalar(.14+q.t*.12);q.g.position.y=.3+q.t*.7;q.g.material.opacity=.6*(1-clamp(q.t/q.life));}
      else{const s=q.sc*Math.min(1,.2+q.t*4);q.g.scale.setScalar(s>q.sc?q.sc:s);if(q.t>q.life-1)q.g.scale.setScalar(q.sc*Math.max(.01,q.life-q.t));}}
    if(q.t>=q.life){farmRoot.remove(q.g);if(q.g.material&&q.kind!=='egg'&&q.kind!=='poop')q.g.material.dispose();L.splice(i,1);}}}
function snapClearProps(){for(const q of SNAP.props)farmRoot.remove(q.g);SNAP.props.length=0;}
function snapPoopInView(){for(const q of SNAP.props){if(q.kind!=='poop'||q.t<0)continue;const d=q.g.position.distanceTo(cam.position);if(d>24)continue;
    const v=q.g.position.clone().setY(.15).project(cam);if(v.z<1&&Math.abs(v.x)<.95&&Math.abs(v.y)<.95)return q;}return null;}
function snapPickFriend(x,y){let best=null,bd=1e9;const th=Math.tan(cam.fov*Math.PI/360);
  for(const f of FRIENDS){const n=f.sn;if(!n||!f.obj.visible)continue;const c=new THREE.Vector3(f.obj.position.x,f.obj.position.y+n.h*.5,f.obj.position.z),d=c.distanceTo(cam.position);if(d>40)continue;
    const v=c.clone().project(cam);if(v.z>1)continue;const sx=(v.x+1)/2*innerWidth,sy=(1-v.y)/2*innerHeight,r=Math.max(48,n.h/(2*d*th)*innerHeight*.65),dd=Math.hypot(sx-x,sy-y);
    if(dd<r&&dd<bd){bd=dd;best=f;}}return best;}
function snapSetSpeed(v){const o=SNAP.speed;SNAP.speed=clamp(v);if(Math.abs(o-SNAP.speed)>.001){snapLeverShow();voice({type:'square',f0:300+SNAP.speed*500,f1:300+SNAP.speed*500,dur:.04,vol:.04});}}
function snapLeverShow(){const v=SNAP.speed;$('snapStick').style.transform=`rotate(${-55+110*v}deg)`;$('snapSpd').textContent=v<.05?'Stop':v<.3?'Slow':v<.65?'Go':'Fast!';$('snapLever').setAttribute('aria-valuenow',Math.round(v*100));}
(function snapLeverInput(){const L=$('snapLever');let id=null;
  const set=e=>{const r=L.getBoundingClientRect(),px=r.left+r.width/2,py=r.bottom-22,a=Math.atan2(e.clientX-px,py-e.clientY)*180/Math.PI;snapSetSpeed((clamp(a,-55,55)+55)/110);};
  L.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();audio();id=e.pointerId;try{L.setPointerCapture(id);}catch(_){}set(e);});
  L.addEventListener('pointermove',e=>{if(e.pointerId===id){e.stopPropagation();set(e);}});
  const up=e=>{if(e.pointerId===id)id=null;};L.addEventListener('pointerup',up);L.addEventListener('pointercancel',up);
  L.addEventListener('keydown',e=>{if(e.key==='ArrowUp'||e.key==='ArrowRight'){snapSetSpeed(SNAP.speed+.1);e.preventDefault();}if(e.key==='ArrowDown'||e.key==='ArrowLeft'){snapSetSpeed(SNAP.speed-.1);e.preventDefault();}});})();
// ---- peekaboo: as the train rolls past the cornfield, a random animal pokes its head out of the corn on each side facing the track ----
function snapMakePeeks(){const fe=[1,0],fn=[0,-1];
  SNAP.peeks=[{x:corn.x1-.35,z:rnd(corn.z0+4,corn.z1-4),f:fe,ry:Math.PI/2},{x:rnd(corn.x0+4,corn.x1-4),z:corn.z0+.35,f:fn,ry:Math.PI}].map(p=>Object.assign(p,{state:0,t:0,who:null}));}
function snapPeekTick(dt,cp){for(const p of SNAP.peeks||[]){
    if(p.state===0){if(p.force||Math.hypot(cp.x-p.x,cp.z-p.z)<19){const pool=FRIENDS.filter(f=>f.sn&&!f.sn.gag&&!f.sn.peek);if(!pool.length){p.state=3;continue;}
        const f=pool[Math.floor(Math.random()*pool.length)];p.who=f;p.state=1;p.t=0;f.sn.peek=p;f.sn.pose=0;f.obj.position.y=0;f.obj.rotation.x=0;f.obj.scale.copy(f.sn.sc);}continue;}
    if(p.state!==1)continue;const f=p.who,n=f.sn,o=f.obj;p.t+=dt;
    if(!n){p.state=3;continue;}
    // slide out of the stalks (only the head clears the first row), look at the train, then duck back in
    const out=p.t<.7?clamp(p.t/.7):p.t<4.2?1:1-clamp((p.t-4.2)/.6);p.out=out;const back=1.7*(1-out*out*(3-2*out))+.15*Math.max(0,(1-out));
    o.position.set(p.x-p.f[0]*back,0,p.z-p.f[1]*back);
    const look=Math.atan2(cp.x-o.position.x,cp.z-o.position.z);o.rotation.y=lerpAngle(p.ry,look,.35*out)+Math.sin(p.t*5)*.12*out;
    o.position.y=Math.abs(Math.sin(p.t*7))*.04*out;
    if(!p.said&&p.t>.5){p.said=true;friendSound(f,.9,0);noiseBurst(.12,.06,1600);}
    if(p.t>=4.8){p.state=2;n.peek=null;o.position.set(n.hx,0,n.hz);n.tx=n.hx;n.tz=n.hz;o.rotation.y=rnd(0,TAU);}}}
function lerpAngle(a,b,k){let d=((b-a+Math.PI)%TAU+TAU)%TAU-Math.PI;return a+d*k;}
function snapCam(){const S=SNAP;trkAt(TRAIN.stationU+S.dist+TRAIN.offs[1],_tk);
  const bob=Math.sin(S.t*11)*.025*Math.min(1,S.v/3);cam.position.set(_tk.x,_tk.y+1.75+bob,_tk.z);
  const base=Math.atan2(_tk.sx,_tk.sz),dir=base+S.look;cam.rotation.order='YXZ';cam.rotation.set(S.pitch,Math.atan2(-Math.sin(dir),-Math.cos(dir)),0);
  const f0=innerWidth<innerHeight?60:48,fov=lerp(f0,f0*.34,S.zoom);if(Math.abs(cam.fov-fov)>.01){cam.fov=fov;cam.updateProjectionMatrix();}}
function snapMoo(){if(SNAP.mooCD>0)return;SNAP.mooCD=1.2;SFX.moo();let n=0;
  FRIENDS.forEach(f=>{if(!f.sn||f.state!=='snap')return;const d=f.obj.position.distanceTo(cam.position);if(d<26){f.sn.pose=2.8;if(n++<3)setTimeout(()=>friendSound(f,clamp(1.3-d/26,.3,1),0),300+d*40);}});}
// scoring, Pokemon Snap style: how big, how centred, facing the camera, posing, plus friends together
const _sv=new THREE.Vector3(),_sr=new THREE.Raycaster();
function snapSeen(f,top){const n=f.sn,o=f.obj,p=new THREE.Vector3(o.position.x,o.position.y+n.h*(top?.85:.5),o.position.z),d=p.distanceTo(cam.position);
  _sr.set(cam.position,p.clone().sub(cam.position).normalize());_sr.far=Math.max(.1,d-.6);_sr.near=.2;
  const hits=_sr.intersectObject(farmRoot,true);for(const h of hits){let q=h.object,mine=false;while(q){if(q===o){mine=true;break;}q=q.parent;}if(mine||h.object.userData.isOutline)continue;if(h.object.isInstancedMesh&&(h.object.geometry===cloverG||h.object.geometry===flowerG))continue;if(n.peek&&(h.object===corn.mesh||h.object===corn.tips||h.object===corn.leaves))continue;return false;}return true;}
function snapScore(){const res=[];const th=Math.tan(cam.fov*Math.PI/360);
  for(const f of FRIENDS){const n=f.sn;if(!n||!f.obj.visible)continue;const o=f.obj;_sv.set(o.position.x,o.position.y+n.h*.5,o.position.z);const d=_sv.distanceTo(cam.position);
    const v=_sv.clone().project(cam);if(v.z>1||Math.abs(v.x)>1.05||Math.abs(v.y)>1.05)continue;
    const frac=n.h/(2*d*th);if(frac<.035)continue;
    const vis=(snapSeen(f,false)?.6:0)+(snapSeen(f,true)?.4:0);if(vis<=0)continue;
    const size=Math.round(clamp(frac/.45)*400),center=Math.round((1-clamp(Math.hypot(v.x,v.y)))*200);
    const fx=Math.sin(o.rotation.y),fz=Math.cos(o.rotation.y),cx=cam.position.x-o.position.x,cz=cam.position.z-o.position.z,cl=Math.hypot(cx,cz)||1,dot=(fx*cx+fz*cz)/cl;
    const face=dot>0?Math.round(dot*200):0,pose=n.pose>0?300:0;res.push({f,frac,vis,size,center,face,pose,pts:Math.round((size+center+face+pose)*vis)});}
  const pk=a=>a[Math.floor(Math.random()*a.length)];
  const poop=snapPoopInView();
  if(!res.length){if(poop)return{score:120,f:null,msg:pk(['A lovely photo of… poop!','Art! (It is poop.)','Pee-yew! Just the poop!'])};
    return{score:0,f:null,msg:SNAP.pitch>.25?pk(['What a nice sky!','Lovely clouds!','Up, up, up!']):pk(['Oops, nobody in this one!','A lovely picture of… grass!','Where did everybody go?'])};}
  res.sort((a,b)=>b.pts-a.pts);const m=res[0],more=res.slice(1).filter(r=>r.frac>.06).length,nm=m.f.name,n=m.f.sn;
  let score=m.pts+more*100,funny=0;
  const dot=Math.cos(m.f.obj.rotation.y)*(cam.position.z-m.f.obj.position.z)+Math.sin(m.f.obj.rotation.y)*(cam.position.x-m.f.obj.position.x);
  let msg=m.vis<1?pk(['A little hidden…','Peekaboo!','Who\'s hiding?']):m.size<80?pk(['Far away!','Tiny '+nm+'!','Zoom in next time!']):
    m.pose?pk(['Great pose!','Strike a pose!','Supermodel '+nm+'!','Say cheese!']):m.face>120?pk(['Nice smile!','Looking good, '+nm+'!','So cute!']):dot<-.3?pk(['Nice tail!','Wrong end!','Hey '+nm+', turn around!']):pk(['Got it!','Snap!','Hi '+nm+'!']);
  if(m.f.obj.position.y>.35)msg=pk(['Air time!','Up, up and away!','Boing!']);
  if(more)msg=more>1?pk(['The whole gang!','Group photo!','Party on the farm!']):pk(['Two friends!','Best buddies!','Double trouble!']);
  if(n&&n.peek&&n.peek.out>.6){funny=250;msg=pk(['Peekaboo! '+nm+' in the corn!','Who\'s in the corn? '+nm+'!','Sneaky '+nm+'!','Corn-y '+nm+'!']);}
  else if(n&&n.gag&&n.gag.t>n.gag.ev*.6){funny=300;msg=pk(SNAP_GAGS[m.f.kind].cap).replace('#',nm);}
  else if(poop&&poop.f===m.f||poop&&!more&&m.size<160){funny=200;msg=pk(['Pee-yew! '+poop.f.name+' pooped!','Uh oh… poop alert!','Caught '+poop.f.name+' red-handed!','That\'s gonna stink!']);}
  score+=funny;return{score,f:m.f,size:m.size,center:m.center,face:m.face,pose:m.pose,more,funny,msg};}
function snapStars(s){return s>=900?3:s>=500?2:s>=150?1:0;}
function snapShoot(){const S=SNAP;if(S.done)return;
  if(S.film<=0){voice({type:'square',f0:160,f1:120,dur:.12,vol:.06});toast('Out of film! Enjoy the ride.',1400);return;}
  S.film--;snapCam();R.render(scene,cam);
  const w=360,h=Math.round(w*clamp(innerHeight/innerWidth,.5,1.3)),c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');
  const sw=R.domElement.width,sh=R.domElement.height,ar=w/h;let cw=sw,ch=sw/ar;if(ch>sh){ch=sh;cw=sh*ar;}x.drawImage(R.domElement,(sw-cw)/2,(sh-ch)/2,cw,ch,0,0,w,h);
  const r=snapScore();r.img=c.toDataURL('image/jpeg',.82);S.shots.push(r);
  S.flash=1;noiseBurst(.06,.12,3000);voice({type:'square',f0:1400,f1:900,dur:.05,vol:.07,delay:.05});snapHud();
  const p=$('snapPop');p.innerHTML=`<img alt="" src="${r.img}"><b>${r.f?r.f.name:'Oops!'}</b><span>${'★'.repeat(snapStars(r.score))||'☆'} ${r.msg}</span>`;p.classList.remove('show');void p.offsetWidth;p.classList.add('show');
  if(S.film===0)setTimeout(()=>{if(mode==='snap'&&!S.done)toast('<b>That was the last photo!</b>Hold on, heading back to the station.',2400);},500);}
function snapLoadAlbum(){try{return JSON.parse(localStorage.getItem('moonie-snap-album')||'{}')||{};}catch(e){return{};}}
function snapFinish(){const S=SNAP;state='end';hud([]);
  const bestBy={};S.shots.forEach((s,i)=>{if(s.f&&s.score>0&&(!bestBy[s.f.name]||s.score>S.shots[bestBy[s.f.name]].score))bestBy[s.f.name]=i;});
  const total=Object.values(bestBy).reduce((a,i)=>a+S.shots[i].score,0),names=Object.keys(bestBy);
  const album=snapLoadAlbum();let newBest=0;
  for(const nm of names){const s=S.shots[bestBy[nm]];if(!album[nm]||s.score>album[nm].score){album[nm]={img:s.img,score:s.score};newBest++;s.newBest=true;}}
  try{localStorage.setItem('moonie-snap-album',JSON.stringify(album));}catch(e){}
  if(names.length>=FRIENDS.length)award('shutterbug');const b=best('moonie-snap-best',total,false);SFX.win();
  const stars=total>=FRIENDS.length*600?3:total>=2500?2:total>0?1:0;
  $('snapEndTitle').textContent=names.length>=FRIENDS.length?'Every friend on film!':total>=2500?'Super snaps!':'Photo time!';
  $('snapEndStars').innerHTML=[0,1,2].map(i=>`<i class="${i<stars?'on':''}">★</i>`).join('');
  $('snapEndInfo').innerHTML=`Report score <b>${total}</b> · ${names.length} of ${FRIENDS.length} friends`+(b?` · Best <b>${b}</b>`:'')+(newBest?` · ${newBest} new in the album!`:'');
  $('snapGrid').innerHTML=S.shots.length?S.shots.map((s,i)=>`<figure class="${Object.values(bestBy).includes(i)?'best':''}"><img alt="" src="${s.img}"><figcaption><b>${s.f?s.f.name:'Nobody'}</b><span>${'★'.repeat(snapStars(s.score))||'☆'} ${s.score}</span><i>${s.msg||''}</i>${s.newBest?'<em>New best!</em>':''}</figcaption></figure>`).join(''):'<p>No photos this time. Tap the screen or press Space to snap!</p>';
  $('snapEnd').hidden=false;setTimeout(()=>{const bt=$('snapAgain');device==='pad'?padFocus(bt):bt.focus();},60);}
function snapShowAlbum(){const A=snapLoadAlbum();$('snapAlbumGrid').innerHTML=FRIENDS.map(f=>{const a=A[f.name];return`<figure class="${a?'':'empty'}">${a?`<img alt="" src="${a.img}">`:`<div class="q">?</div>`}<figcaption><b>${f.name}</b><span>${a?`${'★'.repeat(snapStars(a.score))} ${a.score}`:'No photo yet'}</span></figcaption></figure>`;}).join('');
  $('snapAlbum').hidden=false;setTimeout(()=>{const bt=$('snapAlbumClose');device==='pad'?padFocus(bt):bt.focus();},60);}
(function snapButtons(){const stop=e=>e.stopPropagation();
  for(const id of['snapZoom','snapMooB','snapShut']){$(id).addEventListener('pointerdown',stop);$(id).addEventListener('pointerup',stop);}
  $('snapShut').onclick=()=>{audio();if(mode==='snap'&&state==='play')snapShoot();};
  $('snapMooB').onclick=()=>{audio();if(mode==='snap'&&state==='play')snapMoo();};
  $('snapZoom').onclick=()=>{audio();if(mode!=='snap'||state!=='play')return;SNAP.zoomT=SNAP.zoomT>.5?0:1;snapHud();voice({type:'triangle',f0:600,f1:900,dur:.08,vol:.06});};
  $('snapAgain').onclick=()=>{audio();$('snapEnd').hidden=true;startActivity('snap');};
  $('snapAlbumBtn').onclick=()=>{audio();snapShowAlbum();};
  $('snapAlbumClose').onclick=()=>{audio();$('snapAlbum').hidden=true;if(state==='end'){const bt=$('snapAgain');device==='pad'?padFocus(bt):bt.focus();}};
  $('snapFarm').onclick=()=>{audio();$('snapEnd').hidden=true;backToFarm();};
  canvas.addEventListener('wheel',e=>{if(mode==='snap'&&state==='play'){e.preventDefault();SNAP.zoomT=clamp(SNAP.zoomT-Math.sign(e.deltaY)*.25);snapHud();}},{passive:false});})();
function snapCleanup(){$('snapEnd').hidden=true;$('snapAlbum').hidden=true;SNAP.drag=null;snapClearProps();$('snapSpit').style.opacity=0;FRIENDS.forEach(f=>{if(f.sn){const o=f.obj;o.rotation.x=0;o.rotation.z=0;o.rotation.order='XYZ';o.scale.copy(f.sn.sc);o.position.y=0;}f.sn=null;});trainPlace(TRAIN.stationU);resize();}

function plankTex(text){const c=document.createElement('canvas');c.width=1024;c.height=222;const x=c.getContext('2d');
  const draw=()=>{const g=x.createLinearGradient(0,0,0,222);g.addColorStop(0,'#b07a46');g.addColorStop(.5,'#9a6538');g.addColorStop(1,'#83522c');x.fillStyle=g;x.fillRect(0,0,1024,222);
    x.globalAlpha=.25;x.strokeStyle='#5e3a1d';x.lineWidth=3;for(let i=0;i<9;i++){const y=14+i*24+Math.sin(i*2.3)*6;x.beginPath();x.moveTo(0,y);for(let k=0;k<=1024;k+=64)x.lineTo(k,y+Math.sin(k*.01+i)*5);x.stroke();}
    x.beginPath();x.ellipse(760,70,26,11,0,0,TAU);x.stroke();x.beginPath();x.ellipse(760,70,12,5,0,0,TAU);x.stroke();x.beginPath();x.ellipse(220,160,20,8,0,0,TAU);x.stroke();x.globalAlpha=1;
    x.strokeStyle='#4a2c14';x.lineWidth=10;x.strokeRect(5,5,1014,212);
    x.font='130px "Lilita One",sans-serif';x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';x.lineWidth=16;x.strokeStyle='#3a2210';x.strokeText(text,512,118);x.fillStyle='#ffe28a';x.fillText(text,512,118);};
  draw();const t=new THREE.CanvasTexture(c);t.anisotropy=4;if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{draw();t.needsUpdate=true;});return t;}
function letterTex(l,col){const c=document.createElement('canvas');c.width=c.height=128;const x=c.getContext('2d');x.fillStyle='#fffaf0';x.fillRect(0,0,128,128);x.strokeStyle='#2b2118';x.lineWidth=8;x.strokeRect(4,4,120,120);
  x.fillStyle='#'+col.toString(16).padStart(6,'0');x.font='96px "Lilita One",sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText(l,64,70);const t=new THREE.CanvasTexture(c);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{x.fillStyle='#fffaf0';x.fillRect(8,8,112,112);x.fillStyle='#'+col.toString(16).padStart(6,'0');x.fillText(l,64,70);t.needsUpdate=true;});return t;}
function checkerTex(){const c=document.createElement('canvas');c.width=c.height=128;const x=c.getContext('2d');for(let r=0;r<6;r++)for(let q=0;q<6;q++){x.fillStyle=(r+q)%2?'#4f9e44':'#f7e3a8';x.fillRect(q*128/6,r*128/6,128/6+1,128/6+1);}return new THREE.CanvasTexture(c);}
function easelTex(){const c=document.createElement('canvas');c.width=256;c.height=200;const x=c.getContext('2d');x.fillStyle='#ffffff';x.fillRect(0,0,256,200);x.lineCap='round';x.lineWidth=22;
  [['#e0393a',60],['#ffd23f',90],['#3fa34d',120],['#3d6fd6',150]].forEach(([col,k])=>{x.strokeStyle=col;x.beginPath();x.moveTo(30,k);x.quadraticCurveTo(128,k-90,226,k);x.stroke();});
  x.fillStyle='#ff7fc0';x.beginPath();x.arc(200,40,18,0,TAU);x.fill();return new THREE.CanvasTexture(c);}
// ---------- the trophy shelf on the back wall of the barn ----------
const TROPHIES=[
  {id:'copycow',name:'Copy Cow',how:'Copy 8 sounds in a row in Moo Says',did:'You copied 8 animal sounds in a row!',col:0x3fa34d},
  {id:'balloons',name:'Balloon Buster',how:'Pop 10 balloons',did:'You popped 10 balloons!',col:0xff6f91},
  {id:'shutterbug',name:'Shutterbug',how:'Photograph all 10 friends in one train ride',did:'You photographed every friend in one train ride!',col:0xa66bff},
  {id:'ducks',name:'Duck Pond',how:'Put all 3 rubber duckies in the pond',did:'You put all 3 rubber duckies in the pond!',col:0xf5c544},
  {id:'stuffed',name:'Bellies Full',how:'Feed every animal until it turns into a ball',did:'You fed every animal until it turned into a ball!',col:0xff7fc0},
  {id:'fatcat',name:'Round Kitty',how:'Feed Izzy 3 fish so she rolls away',did:'You fed Izzy so many fish she rolled away!',col:0xff9f43},
  {id:'launch',name:'Sky High',how:'Launch an animal with the seesaw',did:'You launched an animal into the sky with the seesaw!',col:0x3db8ff},
  {id:'swish',name:'Hoop Star',how:'Make 3 baskets in a row',did:'You made 3 baskets in a row!',col:0xd6453d},
  {id:'mow',name:'Corn Cutter',how:'Mow 100 corn stalks with the tractor',did:'You mowed 100 corn stalks with the tractor!',col:0xf2cf4a},
