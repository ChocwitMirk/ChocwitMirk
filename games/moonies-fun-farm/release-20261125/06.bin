/* ---------- farm animals, detailed versions (the classic ones are kept as f.classic; see the "Animals" button in the pause menu) ----------
   Every builder keeps the same contract the rest of the game relies on:
   - returns a Group facing +Z, standing on y=0
   - userData.head: a child group holding everything on the head (Mix-o-Matic swaps it)
   - userData.eyes: eye groups (blinking scales their y)
   Extra, optional: userData.legs [{p,o}], userData.tail, userData.ears, userData.wings, animated by animalParts(). */
const AN=(()=>{
  const coneG={};const cone=(r,h,c,x,y,z,p,rot,seg=12)=>{const k=r+'_'+h+'_'+seg;const m=new THREE.Mesh(coneG[k]||(coneG[k]=new THREE.ConeGeometry(r,h,seg)),M(c));m.position.set(x,y,z);if(rot)m.rotation.set(rot[0]||0,rot[1]||0,rot[2]||0);p.add(m);return m;};
  const pivot=(p,x,y,z,rot)=>{const g=new THREE.Group();g.position.set(x,y,z);if(rot)g.rotation.set(rot[0]||0,rot[1]||0,rot[2]||0);g.userData.base=g.rotation.clone();p.add(g);return g;};
  const flat=m=>{m.userData.noOutline=true;return m;};
  // big glossy cartoon eyes: ink rim, white, coloured iris, pupil, two catch-lights, optional lashes
  function eyes(h,sep,y,z,s,list,o={}){for(const sx of[-1,1]){const g=new THREE.Group();g.position.set(sx*sep,y,z);g.rotation.y=sx*.2;h.add(g);
      E(s*.9,s*1.08,s*.42,0x1d1510,0,0,-s*.08,g);E(s*.82,s,s*.5,0xffffff,0,0,0,g);
      E(s*.6,s*.74,s*.32,o.iris||0x3a2a20,sx*s*.05,-s*.08,s*.25,g);
      if(o.slit)E(s*.13,s*.55,s*.26,0x120d0a,sx*s*.05,-s*.08,s*.33,g);else E(s*.36,s*.48,s*.26,0x120d0a,sx*s*.05,-s*.08,s*.33,g);
      E(s*.2,s*.2,s*.1,0xffffff,sx*s*.12+s*.08,s*.17,s*.47,g);E(s*.09,s*.09,s*.06,0xffffff,-sx*s*.12,-s*.3,s*.43,g);
      if(o.lash)[.95,1.25,1.55].forEach((a,i)=>{const l=E(s*.06,s*.2,s*.05,0x1d1510,sx*Math.cos(a-.45)*s*.86,Math.sin(a-.45)*s*1.02+s*.06,s*.05,g);l.rotation.z=-sx*(.9-i*.35);});
      list.push(g);}}
  const brows=(h,sep,y,z,w,c,tilt=.18)=>{for(const sx of[-1,1])flat(E(w,w*.28,w*.25,c,sx*sep,y,z,h,[0,sx*.2,sx*-tilt]));};
  const blush=(h,sep,y,z,r,c=0xff9fb2)=>{for(const sx of[-1,1])flat(E(r,r*.6,r*.25,c,sx*sep,y,z,h,[0,sx*.55,0]));};
  const smile=(h,y,z,w,c,tilt=-.25)=>{const m=new THREE.Mesh(new THREE.TorusGeometry(w,Math.max(.008,w*.2),6,16,Math.PI),M(c));m.position.set(0,y,z);m.rotation.set(tilt,0,Math.PI);h.add(m);return flat(m);};
  // four-legged leg: pivot at the hip so it can swing; thigh, shin, optional sock, then a hoof or a paw
  function leg(g,legs,x,z,hip,r,c,foot,o={}){const p=pivot(g,x,hip,z);
    E(r*1.25,hip*.3,r*1.3,c,0,-hip*.2,0,p);C(r,hip*.62,c,0,-hip*.58,0,p,null,r*.9);
    if(o.knee)E(r*1.08,r*1.05,r*1.1,c,0,-hip*.55,r*.12,p);
    if(o.sock)C(r*.98,hip*.26,o.sock,0,-hip*.8,0,p,null,r*.98);
    if(o.paw){E(r*1.25,r*.72,r*1.5,foot,0,-hip+r*.7,r*.3,p);for(const k of[-1,0,1])E(r*.4,r*.34,r*.42,foot,k*r*.5,-hip+r*.42,r*1.35,p);}
    else{C(r*1.08,r*.9,foot,0,-hip+r*.45,0,p,null,r*1.22);flat(B(r*.12,r*.5,r*.3,0x120d0a,0,-hip+r*.4,r*1.1,p));}
    legs.push({p,o:o.ph||0});return p;}
  // bird leg: thin shank, fluffy thigh, toes (or a webbed foot)
  function birdLeg(g,legs,x,hip,c,feather,ph,webbed){const p=pivot(g,x,hip,0);E(.07,.07,.07,feather,0,0,0,p);C(.024,hip,c,0,-hip/2,0,p);
