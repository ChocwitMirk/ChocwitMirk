// legs swing while an animal walks, tails wag, ears twitch, wings flap — driven by how fast the animal actually moved this frame
function animalParts(o,dt,t){const u=o.userData;if(!u.legs&&!u.tail)return;dt=Math.min(dt,.05);
  const p=o.position,pv=u.pv||(u.pv=p.clone());const d=Math.hypot(p.x-pv.x,p.z-pv.z);pv.copy(p);
  const v=dt>0?Math.min(9,d/dt):0;u.spd=lerp(u.spd||0,v,1-Math.pow(.002,dt));const mv=clamp(u.spd/1.1);
  u.ph=(u.ph||Math.random()*6)+dt*(1.5+u.spd*4.5);
  if(u.legs)for(const L of u.legs){L.p.rotation.x=L.p.userData.base.x+Math.sin(u.ph+L.o)*.6*mv;}
  if(u.tail){u.tph=(u.tph||Math.random()*6)+dt*(2.4+mv*4)*(u.wag||1);const b=u.tail.userData.base;u.tail.rotation.y=b.y+Math.sin(u.tph)*(.22+mv*.15)*Math.min(1.4,u.wag||1);u.tail.rotation.x=b.x+Math.sin(u.tph*.5)*.06;}
  if(u.ears){u.et=(u.et??Math.random()*4)-dt;if(u.et<-.35)u.et=1.5+Math.random()*4;const tw=u.et<0?Math.sin(-u.et/.35*Math.PI)*.35:0;
    u.ears.forEach((e,i)=>{const b=e.userData.base;e.rotation.z=b.z+(i?-1:1)*(tw*(i===(u.ewhich??(u.ewhich=Math.random()<.5?0:1))?1:.25)+Math.sin(t*1.3+i)*.04);});}
  if(u.wings){const fl=mv>.6||p.y>.15?Math.abs(Math.sin(t*16))*.8:Math.sin(t*2)*.04;u.wings.forEach(w=>{w.rotation.z=w.userData.base.z+w.userData.side*fl;});}}

// pick the animal style: the new detailed animals, or the classic ones (switch in the pause menu)
// the original animals are the default again (Nov 17); the detailed set is behind the pause-menu switch
const CLASSIC_ANIMALS=true;
FRIENDS.forEach(f=>{f.build=(!CLASSIC_ANIMALS&&AN[f.name])||f.classic;});
FRIENDS.forEach(f=>{f.obj=f.build();f.obj.traverse(o=>{if(o.isMesh)o.castShadow=true;});addOutlines(f.obj,.085,.0048);blob(f.size===3?.6:f.size===2?.45:.28,f.obj);f.obj.visible=false;scene.add(f.obj);});
const tray=$('tray');
(function portraits(){
  const pr=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true});pr.setSize(120,108);pr.setPixelRatio(1);
  const ps=new THREE.Scene();ps.add(new THREE.HemisphereLight(0xffffff,0x888866,.9));const dl=new THREE.DirectionalLight(0xffffff,.6);dl.position.set(2,3,4);ps.add(dl);
  const pc=new THREE.PerspectiveCamera(30,120/108,.1,50);
  FRIENDS.forEach(f=>{const o=f.build();o.rotation.y=.6;ps.add(o);const bb=new THREE.Box3().setFromObject(o);const c=bb.getCenter(new THREE.Vector3()),s=bb.getSize(new THREE.Vector3());
    const d=Math.max(s.x,s.y,s.z)*2.3;pc.position.set(c.x+d*.15,c.y+d*.2,c.z+d);pc.lookAt(c);pr.render(ps,pc);
    const el=document.createElement('div');el.className='pal hidden';const cv=document.createElement('canvas');cv.width=120;cv.height=108;cv.getContext('2d').drawImage(pr.domElement,0,0);
    el.appendChild(cv);const sp=document.createElement('span');sp.textContent=f.name;el.appendChild(sp);tray.appendChild(el);f.el=el;ps.remove(o);});
  pr.dispose();
})();

