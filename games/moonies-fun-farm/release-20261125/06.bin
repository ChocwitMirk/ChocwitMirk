    const h=new THREE.Group();h.position.set(0,.88,.32);g.add(h);E(.36,.33,.33,PK,0,0,0,h);
    for(const s of[-1,1])E(.13,.1,.1,PK,s*.17,-.15,.17,h);
    C(.15,.12,PD,0,-.06,.32,h,[Math.PI/2,0,0],.16);C(.135,.012,0xf7a9bd,0,-.06,.382,h,[Math.PI/2,0,0]);
    for(const s of[-1,1])flat(E(.03,.046,.02,0x9c3f5d,s*.055,-.06,.39,h));
    const ears=[];for(const s of[-1,1]){const e=pivot(h,s*.22,.22,-.02,[-.55,0,s*-.55]);const o=cone(.12,.24,0xf2a0b6,0,.11,0,e);o.scale.z=.42;const i=cone(.075,.16,0xff8fab,0,.09,.025,e);i.scale.z=.3;flat(i);ears.push(e);}
