    for(const g of G.list){const c=g.attributes.position.count;P.set(g.attributes.position.array,off*3);if(g.attributes.normal)N.set(g.attributes.normal.array,off*3);if(U)U.set(g.attributes.uv.array,off*2);off+=c;}
