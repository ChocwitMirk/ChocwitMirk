/* ================= MOO SNAP: a little train rides round the outside of the fence; take photos of the animals ================= */
// ---- the track: a rounded square loop through the hills just outside the fence ----
const TRK={H:39.5,Rc:8,P:[],Y:[],T:[],S:[],L:0,n:0,ds:.5};
function hillY(x,z){const out=Math.max(Math.abs(x),Math.abs(z));if(out<=FENCE+2)return 0;const k=out-FENCE-2;return Math.pow(k,1.25)*.18*(1+noise(x*.3,z*.3)*.6);}
(function buildTrackPath(){const H=TRK.H,Rc=TRK.Rc,S=H-Rc,q=Math.PI/2*Rc;
  // pieces in order, starting mid-south heading +x (the farm is on the left of the train)
  const segs=[{l:S,f:s=>[s,H]},{l:q,f:s=>{const a=Math.PI/2-s/Rc;return[S+Math.cos(a)*Rc,S+Math.sin(a)*Rc];}},{l:2*S,f:s=>[H,S-s]},
    {l:q,f:s=>{const a=-s/Rc;return[S+Math.cos(a)*Rc,-S+Math.sin(a)*Rc];}},{l:2*S,f:s=>[S-s,-H]},{l:q,f:s=>{const a=-Math.PI/2-s/Rc;return[-S+Math.cos(a)*Rc,-S+Math.sin(a)*Rc];}},
    {l:2*S,f:s=>[-H,-S+s]},{l:q,f:s=>{const a=Math.PI-s/Rc;return[-S+Math.cos(a)*Rc,S+Math.sin(a)*Rc];}},{l:S,f:s=>[-S+s,H]}];
  const L=segs.reduce((a,g)=>a+g.l,0),n=Math.round(L/TRK.ds);TRK.L=L;TRK.n=n;TRK.ds=L/n;
  const at=s=>{for(const g of segs){if(s<=g.l)return g.f(s);s-=g.l;}return segs[0].f(0);};
  for(let i=0;i<n;i++)TRK.P.push(at(i*TRK.ds));
  // ride height: the ground, smoothed so the train doesn't bounce, and never dipping into a hill
  const raw=TRK.P.map(([x,z])=>hillY(x,z)),W=14;
  for(let i=0;i<n;i++){let a=0;for(let k=-W;k<=W;k++)a+=raw[(i+k+n)%n];TRK.Y.push(Math.max(a/(2*W+1),raw[i])+.12);}
  for(let i=0;i<n;i++){const[a,b]=TRK.P[i],[c,d]=TRK.P[(i+1)%n],l=Math.hypot(c-a,d-b)||1;TRK.T.push([(c-a)/l,(d-b)/l]);}
  // side vector pointing into the farm (left of travel)
  for(let i=0;i<n;i++){const[tx,tz]=TRK.T[i];TRK.S.push([tz,-tx]);}})();
function trkAt(u,o){const n=TRK.n;u=((u%TRK.L)+TRK.L)%TRK.L;const f=u/TRK.ds,i=Math.floor(f)%n,j=(i+1)%n,k=f-Math.floor(f);
  o.x=lerp(TRK.P[i][0],TRK.P[j][0],k);o.z=lerp(TRK.P[i][1],TRK.P[j][1],k);o.y=lerp(TRK.Y[i],TRK.Y[j],k);
  const tx=lerp(TRK.T[i][0],TRK.T[j][0],k),tz=lerp(TRK.T[i][1],TRK.T[j][1],k);o.yaw=Math.atan2(tx,tz);
  o.pitch=Math.atan2(TRK.Y[j]-TRK.Y[i],TRK.ds);o.sx=tz;o.sz=-tx;return o;}
(function buildTrack(){const n=TRK.n,root=new THREE.Group();farmRoot.add(root);TRK.root=root;
  // gravel bed with sloped sides that tuck into the hill
  const pos=[],idx=[];for(let i=0;i<n;i++){const[x,z]=TRK.P[i],[sx,sz]=TRK.S[i],y=TRK.Y[i];
    for(const[o,dy]of[[-1.75,-1],[-1.2,0],[1.2,0],[1.75,-1]])pos.push(x+sx*o,y+dy*.9-.02,z+sz*o);}
  for(let i=0;i<n;i++){const a=i*4,b=((i+1)%n)*4;for(let k=0;k<3;k++)idx.push(a+k,b+k,a+k+1,a+k+1,b+k,b+k+1);}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setIndex(idx);g.computeVertexNormals();
  const bed=new THREE.Mesh(g,toonMat({color:0xb3a48e,side:THREE.DoubleSide}));bed.receiveShadow=true;bed.userData.noOutline=true;bed.userData.noPaint=true;root.add(bed);
  // wooden sleepers
  const every=2,cnt=Math.floor(n/every),ties=new THREE.InstancedMesh(boxG(2.1,.13,.36),M(0x7a5233),cnt);
  for(let c=0;c<cnt;c++){const i=c*every,[x,z]=TRK.P[i],[tx,tz]=TRK.T[i];_o.position.set(x,TRK.Y[i]+.06,z);_o.rotation.set(0,Math.atan2(tx,tz),0);_o.scale.set(1,1,1);_o.updateMatrix();ties.setMatrixAt(c,_o.matrix);}
  ties.receiveShadow=true;ties.castShadow=true;root.add(ties);
  // two steel rails
  for(const off of[-.56,.56]){const pts=TRK.P.map(([x,z],i)=>new THREE.Vector3(x+TRK.S[i][0]*off,TRK.Y[i]+.2,z+TRK.S[i][1]*off));
    const rail=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts,true),n,.065,6,true),M(0x9aa3ad));rail.castShadow=true;rail.userData.noOutline=true;rail.userData.noPaint=true;root.add(rail);}
  root.traverse(o=>{o.raycast=()=>{};});})();
// ---- the train: a little steam engine and two open cars ----
const _tk={};
const TRAIN={cars:[],wheels:[],offs:[0,-3.35,-6.25],stationU:9.4,u:9.4,smoke:[],puffT:0,spin:0};
(function buildTrain(){const RED=0xd6453d,BLUE=0x3d7fd6,GOLD=0xf5c544,BLK=0x2b2118,ORG=0xf08a2a;
  const wheel=(g,x,z,r)=>{const w=new THREE.Group();w.position.set(x,r,z);g.add(w);C(r,.14,BLK,0,0,0,w,[0,0,Math.PI/2]);C(r*.45,.16,RED,0,0,0,w,[0,0,Math.PI/2]);B(.05,r*1.7,.08,GOLD,Math.sign(x)*.085,0,0,w);TRAIN.wheels.push(w);};
  // engine (faces +z)
  const L=new THREE.Group();farmRoot.add(L);TRAIN.cars.push(L);
  B(1.45,.28,3.0,BLK,0,.55,0,L);C(.56,1.95,RED,0,1.2,.42,L,[Math.PI/2,0,0]);C(.6,.1,BLK,0,1.2,1.42,L,[Math.PI/2,0,0]);
  for(const z of[-.1,.5,1.05])C(.6,.07,GOLD,0,1.2,z,L,[Math.PI/2,0,0]);
  C(.17,.55,BLK,0,1.95,1.05,L,null,.13);C(.27,.16,BLK,0,2.26,1.05,L,null,.18);E(.2,.16,.2,GOLD,0,1.82,.35,L);
  B(1.45,1.15,1.05,BLUE,0,1.3,-.95,L);B(1.65,.14,1.3,GOLD,0,1.95,-.95,L);for(const s of[-1,1])B(.04,.45,.5,0x1d1510,s*.73,1.5,-.95,L);
  const lamp=E(.17,.17,.12,0xfff3b0,0,1.32,1.5,L);lamp.material=toonMat({color:0xfff3b0,emissive:0xffd23f,emissiveIntensity:.6});
  const cc=B(1.3,.4,.4,RED,0,.42,1.6,L);cc.rotation.x=.5;
  for(const s of[-1,1]){wheel(L,s*.74,.95,.36);wheel(L,s*.74,.1,.36);wheel(L,s*.74,-.9,.28);}
  // two open cars with benches: Moonie rides in the first one
  for(let c=0;c<2;c++){const g=new THREE.Group();farmRoot.add(g);TRAIN.cars.push(g);const col=c?ORG:GOLD;
    B(1.45,.24,2.5,BLK,0,.52,0,g);B(1.4,.1,2.35,0x9a6a3e,0,.68,0,g);
    for(const s of[-1,1]){B(.1,.5,2.35,col,s*.7,.95,0,g);B(1.4,.5,.1,col,0,.95,s*1.15,g);}
    B(1.2,.12,.45,0x6b4a2e,0,.98,.35,g);B(1.2,.45,.1,0x6b4a2e,0,1.18,.12,g);
    for(const s of[-1,1])for(const z of[-.8,.8])wheel(g,s*.74,z,.3);
    B(.2,.16,.5,BLK,0,.55,1.45,g);}
  TRAIN.cars.forEach(g=>{g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.userData.noPaint=true;}});addOutlines(g,0,.004);});
  for(let i=0;i<14;i++){const p=new THREE.Mesh(sphG,toonMat({color:0xffffff,transparent:true,opacity:.85}));p.visible=false;p.userData.noOutline=true;p.raycast=()=>{};farmRoot.add(p);TRAIN.smoke.push({m:p,t:9});}
  trainPlace(TRAIN.stationU);})();
function trainPlace(u){TRAIN.u=u;TRAIN.cars.forEach((g,i)=>{trkAt(u+TRAIN.offs[i],_tk);g.position.set(_tk.x,_tk.y+.02,_tk.z);g.rotation.set(-_tk.pitch,_tk.yaw,0,'YXZ');});}
function trainPuff(big){const s=TRAIN.smoke.find(q=>q.t>=1.6)||TRAIN.smoke[0];const L=TRAIN.cars[0];L.updateMatrixWorld();const p=new THREE.Vector3(0,2.45,1.05).applyMatrix4(L.matrixWorld);
  s.m.position.copy(p);s.t=0;s.big=big?1.5:1;s.vx=rnd(-.2,.2);s.vz=rnd(-.2,.2);s.m.visible=true;}

/* ---------- party balloons (Levi's air_balloons.glb, the 7 coloured ones, stood upright + slimmed): 1-3 float around the farm and pop at a touch ---------- */
const BALLOON_DATA=[{"name":"redpurple","col":11549340,"ext":1.0732009410858154,"size":[0.984,1.073,0.984],"p":"","n":"","i":""},{"name":"white","col":16182488,"ext":1.2766880989074707,"size":[0.886,1.277,0.886],"p":"","n":"","i":""},{"name":"Orange","col":16747050,"ext":1.2766880989074707,"size":[0.929,1.277,0.929],"p":"","n":"","i":""},{"name":"blue","col":4029408,"ext":1.018051028251648,"size":[1.014,1.018,0.443],"p":"","n":"","i":""},{"name":"green","col":5948490,"ext":1.3040220141410828,"size":[0.377,1.304,0.377],"p":"","n":"","i":""},{"name":"material","col":14694714,"ext":0.9412939548492432,"size":[1.042,0.941,0.783],"p":"","n":"","i":""},{"name":"yellow","col":16765503,"ext":1.102665901184082,"size":[1.236,1.103,0.433],"p":"","n":"","i":""}];
const BAL={list:[],geos:null,wait:3,target:2,g:new THREE.Group(),popped:0};
farmRoot.add(BAL.g);
try{BAL.popped=+localStorage.getItem('moonie-balloons')||0;}catch(e){}
function balGeos(){if(BAL.geos)return BAL.geos;const b64=s=>{const r=atob(s),u=new Uint8Array(r.length);for(let i=0;i<r.length;i++)u[i]=r.charCodeAt(i);return u.buffer;};
  BAL.geos=BALLOON_DATA.map(o=>{const p=new Int16Array(b64(o.p)),n=new Int8Array(b64(o.n)),ix=new Uint16Array(b64(o.i)),P=new Float32Array(p.length),N=new Float32Array(n.length),k=o.ext/32767;
    for(let i=0;i<p.length;i++){P[i]=p[i]*k;N[i]=n[i]/127;}const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('normal',new THREE.BufferAttribute(N,3));g.setIndex(new THREE.BufferAttribute(ix,1));g.computeBoundingSphere();
    return{g,col:o.col,h:o.size[1],name:o.name};});return BAL.geos;}
// balloons only hang around the playground and the train station corner
const BAL_ZONES=[{x0:-32,x1:-16,z0:17,z1:32.5},{x0:-1,x1:15,z0:26,z1:33}];
function balSpot(){for(let k=0;k<40;k++){const Z=BAL_ZONES[Math.floor(Math.random()*BAL_ZONES.length)],x=rnd(Z.x0+1,Z.x1-1),z=rnd(Z.z0+1,Z.z1-1);
    if(moonie&&Math.hypot(x-moonie.pos.x,z-moonie.pos.z)<3)continue;return[x,z,Z];}const Z=BAL_ZONES[0];return[(Z.x0+Z.x1)/2,(Z.z0+Z.z1)/2,Z];}
function balSpawn(){const G=balGeos(),d=G[Math.floor(Math.random()*G.length)],[x,z,Z]=balSpot();
  const root=new THREE.Group(),body=new THREE.Group();root.add(body);const sc=1.05/d.h;
  const m=new THREE.Mesh(d.g,toonMat({color:d.col}));m.scale.setScalar(sc);m.castShadow=true;body.add(m);
  const shine=new THREE.Mesh(sphG,new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:.7}));shine.userData.noOutline=true;shine.scale.set(.07,.13,.04);shine.position.set(-.16,.72,.3);shine.rotation.z=.4;body.add(shine);
  addOutlines(body,0,.004);
  const sp=[];for(let i=0;i<9;i++)sp.push(new THREE.Vector3());const sg=new THREE.BufferGeometry().setFromPoints(sp);const str=new THREE.Line(sg,new THREE.LineBasicMaterial({color:0x5a4a3a}));str.frustumCulled=false;root.add(str);
  const y=rnd(1.95,2.45);root.position.set(x,y+8,z);root.traverse(o=>{o.userData.noPaint=true;o.userData.balloon=true;});BAL.g.add(root);
  const a=rnd(0,TAU);BAL.list.push({root,body,str,col:d.col,x,z,y,Z,vy:0,in:0,t:rnd(0,9),life:rnd(70,110),vx:Math.cos(a)*rnd(.25,.6),vz:Math.sin(a)*rnd(.25,.6),r:.62,up:0});}
function balCenter(b,v){return v.set(b.root.position.x,b.root.position.y+.55,b.root.position.z);}
function balPop(b,why){const i=BAL.list.indexOf(b);if(i<0)return;BAL.list.splice(i,1);if(BAL.held===b)BAL.held=null;const c=balCenter(b,new THREE.Vector3());
  BAL.g.remove(b.root);b.root.traverse(o=>{if(o.material&&!o.userData.isOutline&&!o.material.userData.w)o.material.dispose();});b.str.geometry.dispose();
  noiseBurst(.09,.3,2600);voice({type:'square',f0:160,f1:40,dur:.08,vol:.16,filt:1200});
  burst(c.x,c.y,c.z,b.col,9);burst(c.x,c.y,c.z,[0xffd23f,0xff6f91,0x3db8ff,0x7be05a][Math.floor(Math.random()*4)],6);
  BAL.popped++;try{localStorage.setItem('moonie-balloons',BAL.popped);}catch(e){}
  if(mode==='hub'||mode==='hide')toast(['Pop!','POP!','Kaboom!','Pop pop!','Bang!'][Math.floor(Math.random()*5)],700);
  if(BAL.popped>=10)award('balloons');BAL.wait=rnd(5,14);}
function balloonTick(dt){const L=BAL.list;
  BAL.wait-=dt;if(BAL.wait<=0&&L.length<BAL.target){balSpawn();BAL.target=1+Math.floor(Math.random()*3);BAL.wait=rnd(8,18);}
  const m=moonie,c=_balV;
  for(let i=L.length-1;i>=0;i--){const b=L[i];b.t+=dt;b.life-=dt;const r=b.root;
    b.in=Math.min(1,b.in+dt*.5);const fall=(1-b.in)*(1-b.in)*8; // drifts down into place when it appears
    const held=BAL.held===b,P=b.str.geometry.attributes.position;
    if(held){ // Moonie has the string: the balloon bobs along above and a little behind her hand
      const h=balHand(_balH);if(b.hx==null){b.hx=b.x;b.hz=b.z;}
      const tx=h.x-Math.sin(m.yaw)*.35,tz=h.z-Math.cos(m.yaw)*.35,k=1-Math.pow(.02,dt);b.x+=(tx-b.x)*k;b.z+=(tz-b.z)*k;b.vx=b.vz=0;
      const ty=h.y+1.05+Math.sin(b.t*1.6)*.1;r.position.set(b.x,r.position.y+(ty-r.position.y)*k,b.z);
      for(let q=0;q<9;q++){const f=q/8;P.setXYZ(q,(h.x-r.position.x)*f,(h.y-r.position.y)*f-Math.sin(f*Math.PI)*.12,(h.z-r.position.z)*f);}P.needsUpdate=true;
      b.body.rotation.z=Math.sin(b.t*.9)*.12-(m.vel.x*Math.cos(m.yaw)-m.vel.z*Math.sin(m.yaw))*.03;b.body.rotation.y+=dt*.25;b.life=Math.max(b.life,30);
      if(mode!=='hub'&&mode!=='hide')balRelease();continue;}
    if(b.life<0||b.free)b.up+=dt*(b.free?.9:.6); // old (or let-go) balloons float away into the sky
    b.x+=b.vx*dt;b.z+=b.vz*dt;const Z=b.Z;if(!b.free&&Z){if(b.x<Z.x0)b.vx=Math.abs(b.vx);if(b.x>Z.x1)b.vx=-Math.abs(b.vx);if(b.z<Z.z0)b.vz=Math.abs(b.vz);if(b.z>Z.z1)b.vz=-Math.abs(b.vz);}
    b.vx+=Math.sin(b.t*.23)*dt*.05;b.vz+=Math.cos(b.t*.19)*dt*.05;
    const yy=b.y+Math.sin(b.t*1.3)*.18+fall+b.up*b.up*1.5;r.position.set(b.x,yy,b.z);
    b.body.rotation.z=Math.sin(b.t*.9)*.12;b.body.rotation.x=Math.sin(b.t*.7+1)*.08;b.body.rotation.y+=dt*.25;
    // the string hangs from the knot and trails behind the drift
    for(let k=0;k<9;k++){const f=k/8;P.setXYZ(k,-b.vx*f*f*.9+Math.sin(b.t*2.1+f*4)*.08*f,-f*1.25,-b.vz*f*f*.9+Math.cos(b.t*1.8+f*4)*.08*f);}P.needsUpdate=true;
    if(yy>40){BAL.g.remove(r);L.splice(i,1);continue;}
    // walk into the dangling string to grab it
    if((mode==='hub'||mode==='hide')&&state==='play'&&m&&!BAL.held&&!b.free&&b.in>.9&&m.onGround){const ex=b.x-m.pos.x,ez=b.z-m.pos.z;if(ex*ex+ez*ez<.75*.75){balGrab(b);continue;}}
    // Moonie bumps it (walking into a low one, or jumping / bouncing up to a high one)
    if((mode==='hub'||mode==='hide')&&state==='play'&&m&&b.in>.8){balCenter(b,c);const dx=c.x-m.pos.x,dz=c.z-m.pos.z,hy=c.y-(m.pos.y+1.0);
      if(dx*dx+dz*dz<1.0&&m.pos.y+1.75>c.y-.45&&m.pos.y<c.y+.5){balPop(b,'moonie');continue;}}
    // the friends can bump low ones too
    if(mode==='hub'&&b.in>.8&&(b.t%1)<dt*1.2){balCenter(b,c);for(const f of FRIENDS){if(!f.obj.visible)continue;const q=f.obj.position;if(Math.hypot(q.x-c.x,q.z-c.z)<.9&&c.y-q.y<1.9){balPop(b,'friend');break;}}}}}
const _balV=new THREE.Vector3(),_balS=new THREE.Vector3(),_balH=new THREE.Vector3();
function balHand(v){const m=moonie;if(m.model&&BAL.handBone===undefined)BAL.handBone=m.model.getObjectByName('RightHand')||null;
  if(BAL.handBone&&m.root.visible){BAL.handBone.getWorldPosition(v);farmRoot.worldToLocal(v);return v;}
  return v.set(m.pos.x+Math.cos(m.yaw)*.35,m.pos.y+1.0,m.pos.z-Math.sin(m.yaw)*.35);}
function balGrab(b){BAL.held=b;b.hx=null;voice({type:'triangle',f0:500,f1:760,dur:.1,vol:.09});if(!BAL.toldLetGo){BAL.toldLetGo=true;toast(device==='touch'?'Got a balloon! Tap Use to let go':device==='pad'?'Got a balloon! Press X to let go':'Got a balloon! Press E to let go',2400);}else toast('Got it!',700);}
function balRelease(){const b=BAL.held;if(!b)return;BAL.held=null;b.free=true;b.up=.3;b.y=b.root.position.y;b.x=b.root.position.x;b.z=b.root.position.z;const a=rnd(0,TAU);b.vx=Math.cos(a)*.3;b.vz=Math.sin(a)*.3;voice({type:'sine',f0:700,f1:1200,dur:.25,vol:.08});}
// tap / click a balloon: generous on purpose, they pop easily
function balPick(x,y){let best=null,bd=1e9;const th=Math.tan(cam.fov*Math.PI/360);
  for(const b of BAL.list){balCenter(b,_balS);const d=_balS.distanceTo(cam.position);if(d>60)continue;const v=_balS.clone().project(cam);if(v.z>1)continue;
    const sx=(v.x+1)/2*innerWidth,sy=(1-v.y)/2*innerHeight,rr=Math.max(38,b.r/(d*th)*innerHeight*.75),dd=Math.hypot(sx-x,sy-y);if(dd<rr&&dd<bd){bd=dd;best=b;}}
  return best;}
function trainTick(dt,moving,spd){TRAIN.puffT-=dt;if(TRAIN.puffT<=0){TRAIN.puffT=moving?Math.max(.18,.9-spd*.12):1.6;trainPuff(moving);}
  for(const s of TRAIN.smoke){if(s.t>=1.6){s.m.visible=false;continue;}s.t+=dt;const k=s.t/1.6;s.m.position.y+=dt*(1.1+k);s.m.position.x+=s.vx*dt;s.m.position.z+=s.vz*dt;
    s.m.scale.setScalar((.18+k*.55)*s.big);s.m.material.opacity=.85*(1-k);}
  if(moving){TRAIN.spin-=spd*dt/.33;for(const w of TRAIN.wheels)w.rotation.x=TRAIN.spin;}}
// the outer ring of big trees must not grow on the tracks
const TRACK_CLEAR=(x,z)=>Math.abs(Math.max(Math.abs(x),Math.abs(z))-TRK.H)<4.5;
// ---- the ticket booth just inside the south fence, where the ride starts ----
