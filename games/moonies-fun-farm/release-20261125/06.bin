    flat(E(.16,.11,.05,0x8a5a32,-.26,.4,-.36,g,[0,-.8,0]));flat(E(.05,.04,.02,0x8a5a32,-.36,.28,-.3,g,[0,-1,0]));
    const tail=pivot(g,0,.62,-.5);{const pts=[];for(let i=0;i<=24;i++){const a=i*.42,r=.07-i*.0018;pts.push(new THREE.Vector3(Math.cos(a)*r,Math.sin(a)*r+i*.004,-i*.006));}
