</script>
<script type="application/octet-stream" id="asset-wallpaper.jpg"></script>
<script type="application/octet-stream" id="asset-alphabet-v5.mp3"></script>
<script>
(()=>{

'use strict';
const $=id=>document.getElementById(id);
// Embedded assets: no local file fetch or web server needed.
function embeddedText(name){const el=$('asset-'+name);if(!el)throw new Error('Missing embedded asset: '+name);return el.textContent;}
const embeddedImages=Object.create(null);
function embeddedImage(name){return embeddedImages[name]||(embeddedImages[name]='data:image/'+(name.endsWith('.png')?'png':'jpeg')+';base64,'+embeddedText(name));}
async function embeddedFile(name){return new Response(embeddedText(name),{status:200});}

const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
const lerp=(a,b,t)=>a+(b-a)*t;
const rnd=(a,b)=>a+Math.random()*(b-a);
const TAU=Math.PI*2;
const GAME_TIME=300;
const _o=new THREE.Object3D(),tmp=new THREE.Vector3(),tmp2=new THREE.Vector3();
let level='farm',state='title';

/* ---------- renderer / scene ---------- */
const canvas=$('c');
const R=new THREE.WebGLRenderer({canvas,antialias:true});
R.setPixelRatio(Math.min(devicePixelRatio||1,window.__moonieAndroid?1.5:2));
R.shadowMap.enabled=true;R.shadowMap.type=matchMedia('(pointer:coarse)').matches?THREE.PCFShadowMap:THREE.PCFSoftShadowMap;R.shadowMap.autoUpdate=false; // the loop decides when shadows are redrawn
const scene=new THREE.Scene();
const cam=new THREE.PerspectiveCamera(45,1,0.08,500);
function resize(){const w=innerWidth,h=innerHeight;R.setSize(w,h,false);cam.aspect=w/h;const f=level==='farm'?45:55;cam.fov=w<h?f+15:f;cam.updateProjectionMatrix();}
addEventListener('resize',resize);resize();
const farmRoot=new THREE.Group(),brRoot=new THREE.Group();scene.add(farmRoot);scene.add(brRoot);brRoot.visible=false;
let WORLD=farmRoot;

const skyU={top:{value:new THREE.Color(0x5cb8f0)},bot:{value:new THREE.Color(0xd8f1ff)}};
const sky=new THREE.Mesh(new THREE.SphereGeometry(300,24,12),new THREE.ShaderMaterial({uniforms:skyU,side:THREE.BackSide,depthWrite:false,fog:false,
  vertexShader:'varying float h;void main(){h=normalize(position).y;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
  fragmentShader:'uniform vec3 top;uniform vec3 bot;varying float h;void main(){gl_FragColor=vec4(mix(bot,top,smoothstep(-.05,.5,h)),1.);}'}));
sky.userData.noOutline=true;scene.add(sky);
scene.fog=new THREE.Fog(0xd8f1ff,55,170);scene.background=new THREE.Color(0x9fd8f5);
const hemi=new THREE.HemisphereLight(0xe8f6ff,0x6d9a3c,.6);scene.add(hemi);
/* ---------- day & night: ~30 min of day, ~5 min of night, with a sunset and a sunrise in between ---------- */
let PERF_OFF=false;try{PERF_OFF=localStorage.getItem('moonie-nomerge')==='1';}catch(e){}
const DN={on:true,t:150,DAY:1800,NIGHT:300,ff:0,saveT:0,d:1,w:0};
try{const v=localStorage.getItem('moonie-daynight');if(v==='0')DN.on=false;const tt=parseFloat(localStorage.getItem('moonie-dn-t'));if(isFinite(tt))DN.t=tt;}catch(e){}
const DN_STARS=(()=>{const g=new THREE.Group();const mk=(n,size,col)=>{const pos=new Float32Array(n*3);for(let i=0;i<n;i++){const u=Math.random(),th=rnd(0,TAU),y=.08+u*.92,r=Math.sqrt(1-y*y);
    pos.set([Math.cos(th)*r*280,y*280,Math.sin(th)*r*280],i*3);}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
  const p=new THREE.Points(geo,new THREE.PointsMaterial({color:col,size:size*(R.getPixelRatio()),sizeAttenuation:false,transparent:true,opacity:0,fog:false,depthWrite:false}));p.raycast=()=>{};p.userData.noOutline=p.userData.noPaint=true;g.add(p);return p;};
  g.userData.sets=[mk(420,2,0xffffff),mk(160,3,0xfff4c8),mk(60,4.2,0xffffff)];
  const moon=new THREE.Mesh(new THREE.SphereGeometry(9,24,16),new THREE.MeshBasicMaterial({color:0xfdf6d8,fog:false,transparent:true,opacity:0}));moon.raycast=()=>{};moon.userData.noOutline=moon.userData.noPaint=true;g.add(moon);
  for(const[x,y,r]of[[-2.5,2,1.8],[3,-2.5,1.3],[1.5,3.5,.9]]){const c=new THREE.Mesh(new THREE.CircleGeometry(r,16),new THREE.MeshBasicMaterial({color:0xe6dcb4,fog:false,transparent:true,opacity:0}));c.position.set(x,y,8.6);moon.add(c);}
  g.userData.moon=moon;
  const sunD=new THREE.Mesh(new THREE.SphereGeometry(11,24,16),new THREE.MeshBasicMaterial({color:0xffe27a,fog:false,transparent:true,opacity:0}));sunD.raycast=()=>{};sunD.userData.noOutline=sunD.userData.noPaint=true;g.add(sunD);g.userData.sunD=sunD;
  sky.add(g);return g;})();
const FIREFLIES=(()=>{const n=60,pos=new Float32Array(n*3),base=[];for(let i=0;i<n;i++){const b={x:rnd(-30,30),y:rnd(.4,2.2),z:rnd(-30,30),p:rnd(0,TAU),s:rnd(.4,1)};base.push(b);pos.set([b.x,b.y,b.z],i*3);}
  const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
  const p=new THREE.Points(geo,new THREE.PointsMaterial({color:0xfff27a,size:.22,transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending}));p.raycast=()=>{};p.userData.noOutline=p.userData.noPaint=true;p.userData.base=base;p.frustumCulled=false;farmRoot.add(p);return p;})();
function dnPhase(){const T=DN.t%(DN.DAY+DN.NIGHT);if(T<DN.DAY){const u=T/DN.DAY,a=lerp(-.12,Math.PI+.12,u),s=Math.sin(a);return{night:false,a,s,u};}
  const u=(T-DN.DAY)/DN.NIGHT;return{night:true,a:lerp(-.12,Math.PI+.12,u),s:-1,u};}
function dnLabel(){const P=dnPhase();if(P.night)return 'night';if(P.s<.25)return P.u<.5?'sunrise':'sunset';return P.u<.5?'morning':P.u<.75?'afternoon':'evening';}
function dnTick(dt){if(!DN.on)return;let step=dt;if(DN.ff>0){const k=Math.min(DN.ff,dt*90);step+=k;DN.ff-=k;}DN.t=(DN.t+step)%(DN.DAY+DN.NIGHT);
  DN.saveT-=dt;if(DN.saveT<=0){DN.saveT=10;try{localStorage.setItem('moonie-dn-t',DN.t.toFixed(0));}catch(e){}}}
const DN_C={dayTop:new THREE.Color().setHSL(.56,.75,.65),dayBot:new THREE.Color().setHSL(.55,.8,.92),setTop:new THREE.Color(0x5a5aa8),setBot:new THREE.Color(0xff9a6a)};
const _cA=new THREE.Color(),_cB=new THREE.Color(),_cN1=new THREE.Color(0x203066),_cN2=new THREE.Color(0x4a5d9a);
function dnApply(m,t){const P=dnPhase();
  // how much daylight, and how orange the light is near the horizon
  const d=P.night?0:clamp((P.s+.05)/.32),w=P.night?0:clamp(1-(P.s-.02)/.4)*clamp((P.s+.08)/.12);DN.d=d;DN.w=w;const n=1-d;
  // sun (or moon) light direction: keep it a bit above the horizon so shadows stay sane
  const la=clamp(P.a,.32,Math.PI-.32);sun.position.set(m.pos.x-Math.cos(la)*30,Math.sin(la)*40+6,m.pos.z+18);sun.target.position.set(m.pos.x,0,m.pos.z);
  _cA.setHSL(lerp(.12,.06,w),lerp(.6,.95,w),lerp(.9,.68,w));_cB.set(0xb9c8ff);sun.color.copy(_cA).lerp(_cB,n);sun.intensity=lerp(lerp(1.05,.8,w),.62,n);
  hemi.color.set(0xe8f6ff).lerp(_cB.set(0x9fb0ff),n);hemi.groundColor.set(0x6d9a3c).lerp(_cB.set(0x3a4a5a),n);hemi.intensity=lerp(lerp(.6,.42,w),.6,n);
  skyU.top.value.copy(DN_C.dayTop).lerp(DN_C.setTop,w).lerp(_cN1,n);skyU.bot.value.copy(DN_C.dayBot).lerp(DN_C.setBot,w).lerp(_cN2,n);
  scene.fog.color.copy(skyU.bot.value);scene.background.copy(skyU.bot.value);
  // stars, moon, sun disc
  const so=clamp((n-.25)/.6);DN_STARS.userData.sets.forEach((p,i)=>{p.material.opacity=so*(.75+.25*Math.sin(t*(1.3+i*.9)+i*2));});
  const mo=DN_STARS.userData.moon;mo.material.opacity=clamp((n-.3)/.5);mo.children.forEach(c=>c.material.opacity=mo.material.opacity*.8);mo.visible=mo.material.opacity>.01;
  const ma=P.night?P.a:(P.u<.5?-.3:Math.PI+.3);mo.position.set(-Math.cos(ma)*200,Math.max(30,Math.sin(ma)*190+30),-120);mo.lookAt(0,0,0);
  const sd=DN_STARS.userData.sunD;sd.visible=!P.night;sd.material.opacity=P.night?0:clamp((P.s+.15)/.2);sd.material.color.setHSL(lerp(.15,.07,w),1,lerp(.7,.6,w));sd.position.set(-Math.cos(P.a)*220,Math.sin(P.a)*200+4,-150);
  // fireflies come out at night
  const ff=FIREFLIES;ff.material.opacity=clamp((n-.4)/.5)*(.75+.25*Math.sin(t*3));ff.visible=ff.material.opacity>.01;
  if(ff.visible){const ps=ff.geometry.attributes.position;ff.userData.base.forEach((b,i)=>ps.setXYZ(i,b.x+Math.sin(t*b.s+b.p)*1.2,b.y+Math.sin(t*b.s*1.7+b.p)*.4,b.z+Math.cos(t*b.s*.8+b.p)*1.2));ps.needsUpdate=true;}}
function dnOff(){DN_STARS.userData.sets.forEach(p=>p.material.opacity=0);DN_STARS.userData.moon.visible=false;DN_STARS.userData.sunD.visible=false;FIREFLIES.visible=false;
  hemi.color.set(0xe8f6ff);hemi.groundColor.set(0x6d9a3c);DN.d=1;DN.w=0;}
function dnButtons(){const b=$('dnBtn'),s=$('dnSkip');if(!b)return;b.innerHTML=icon(DN.on?'sun':'moon')+'Day &amp; night: '+(DN.on?'on':'off');
  const night=dnPhase().night;s.hidden=!DN.on;s.innerHTML=icon(night?'sun':'moon')+(night?'Skip to morning':'Skip to night');}
function dnSkip(){const L=DN.DAY+DN.NIGHT,T=DN.t%L;if(T<DN.DAY)DN.ff=(DN.DAY+20)-T;else DN.ff=(L-T)+170;dnButtons();setTimeout(dnButtons,3500);}
const sun=new THREE.DirectionalLight(0xfff0cf,.95);sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);Object.assign(sun.shadow.camera,{left:-26,right:26,top:26,bottom:-26,near:1,far:120});sun.shadow.bias=-0.0006;sun.shadow.normalBias=0.03;
scene.add(sun);scene.add(sun.target);
// ---- graphics quality: Auto watches the frame rate and trades resolution/shadow detail for smoothness ----
// levels: 0 = sharpest, 3 = fastest. Phones and tablets start one step down. Choice is saved (Auto / Fast / Pretty).
const PACE={next:0,cap:60,frame:0,input:0};
addEventListener('pointerdown',()=>{PACE.input=performance.now();},true);addEventListener('keydown',()=>{PACE.input=performance.now();},true);
const GFX={mode:'auto',max:Math.min(devicePixelRatio||1,window.__moonieAndroid?1.5:2),lvl:0,t:0,n:0,good:0,lastDown:-99,clock:0,
  L:[{pr:1,sh:2048},{pr:.8,sh:2048},{pr:.66,sh:1024},{pr:.5,sh:1024}]};
try{const v=localStorage.getItem('moonie-gfx');if(v==='fast'||v==='pretty'||v==='auto')GFX.mode=v;}catch(e){}
GFX.mobile=matchMedia('(pointer:coarse)').matches;
function gfxApply(l){l=clamp(l,0,GFX.L.length-1);GFX.lvl=l;const L=GFX.L[l],pr=Math.max(.75,GFX.max*L.pr);if(Math.abs(R.getPixelRatio()-pr)>.01){R.setPixelRatio(pr);resize();}
  if(sun.shadow.mapSize.x!==L.sh){sun.shadow.mapSize.set(L.sh,L.sh);if(sun.shadow.map){sun.shadow.map.dispose();sun.shadow.map=null;}}}
function gfxStart(){gfxApply(GFX.mode==='fast'?3:GFX.mode==='pretty'?0:GFX.mobile?(window.__moonieAndroid?2:1):0);GFX.t=GFX.n=GFX.good=0;}
function gfxTick(raw){if(GFX.mode!=='auto'||document.hidden||raw>.25)return;GFX.clock+=raw;GFX.t+=raw;GFX.n++;if(GFX.t<2)return;
  const fps=GFX.n/GFX.t;GFX.t=GFX.n=0;
  if(GFX.capAt!==PACE.cap){GFX.capAt=PACE.cap;GFX.good=0;return;} // the cap changed mid-measure: start again
  if(fps<PACE.cap*.78&&GFX.lvl<GFX.L.length-1){gfxApply(GFX.lvl+1);GFX.lastDown=GFX.clock;GFX.good=0;}
  else if(fps>PACE.cap*.95){GFX.good++;if(GFX.good>=4&&GFX.lvl>0&&GFX.clock-GFX.lastDown>30){gfxApply(GFX.lvl-1);GFX.good=0;}}else GFX.good=0;}
gfxStart();
const key=new THREE.DirectionalLight(0xfff2c8,.24);key.position.set(.5,1,.32);key.visible=false;scene.add(key);
const amb=new THREE.AmbientLight(0xfff0c0,.06);amb.visible=false;scene.add(amb);

/* ---------- helpers ---------- */
const matCache={},geoCache={};
// cel shading: three flat light bands
const GRAD=(()=>{const d=new Uint8Array([90,90,90,255, 175,175,175,255, 255,255,255,255]);const t=new THREE.DataTexture(d,3,1,THREE.RGBAFormat);t.minFilter=t.magFilter=THREE.NearestFilter;t.generateMipmaps=false;t.needsUpdate=true;return t;})();
const toonMat=o=>new THREE.MeshToonMaterial(Object.assign({gradientMap:GRAD},o));
const M=c=>matCache[c]||(matCache[c]=toonMat({color:c}));
// soft, bubbly boxes: every box gets rounded edges with smooth normals
function roundBox(w,h,d,seg=6){const r=Math.min(Math.min(w,h,d)*.32,.42);const g=new THREE.BoxGeometry(w,h,d,seg,seg,seg);const p=g.attributes.position,n=g.attributes.normal;
  const hx=w/2-r,hy=h/2-r,hz=d/2-r,v=new THREE.Vector3(),c=new THREE.Vector3();
  for(let i=0;i<p.count;i++){v.fromBufferAttribute(p,i);c.set(clamp(v.x,-hx,hx),clamp(v.y,-hy,hy),clamp(v.z,-hz,hz));v.sub(c);const l=v.length()||1;v.multiplyScalar(1/l);
    n.setXYZ(i,v.x,v.y,v.z);p.setXYZ(i,c.x+v.x*r,c.y+v.y*r,c.z+v.z*r);}
  g.userData.round=true;return g;}
const boxG=(w,h,d)=>{const k=w+'_'+h+'_'+d;return geoCache[k]||(geoCache[k]=roundBox(w,h,d));};
const sharpBoxG=(w,h,d)=>{const k='s'+w+'_'+h+'_'+d;return geoCache[k]||(geoCache[k]=new THREE.BoxGeometry(w,h,d));};
const ballG=new THREE.SphereGeometry(1,20,14);
// ink outlines: back faces pushed out along the normal, constant thickness on screen
const outlineMats={};
function outlineMat(skinned,w=.0032){const k=(skinned?'s':'n')+w;if(outlineMats[k])return outlineMats[k];
  const m=new THREE.MeshBasicMaterial({color:0x1d1510,side:THREE.BackSide,skinning:skinned});m.userData.w=w;
  m.customProgramCacheKey=()=>'outline'+k;m.onBeforeCompile=sh=>{sh.vertexShader=sh.vertexShader.replace('#include <project_vertex>',
    `vec4 mvPosition=modelViewMatrix*vec4(transformed,1.0);
    #ifdef USE_SKINNING
      mat4 oSk=skinWeight.x*boneMatX+skinWeight.y*boneMatY+skinWeight.z*boneMatZ+skinWeight.w*boneMatW;
      oSk=bindMatrixInverse*oSk*bindMatrix;
      vec3 oN=(oSk*vec4(normal,0.0)).xyz;
    #else
      vec3 oN=normal;
    #endif
    mvPosition.xyz+=normalize(normalMatrix*oN)*${w.toFixed(4)}*(-mvPosition.z);
    gl_Position=projectionMatrix*mvPosition;`);};
  return outlineMats[k]=m;}
const OUTLINE_TYPES=new Set(['SphereGeometry','CylinderGeometry','ConeGeometry','TorusGeometry']);
const _ws=new THREE.Vector3();
function addOutlines(root,minSize=.07,w=.0032){const list=[];root.updateMatrixWorld(true);
  root.traverse(o=>{if(!o.isMesh||o.isInstancedMesh||o.userData.isOutline||o.userData.noOutline)return;const g=o.geometry;if(!(g.userData.round||OUTLINE_TYPES.has(g.type)))return;
    if(o.material.transparent||o.material.side===THREE.BackSide)return;
    if(!g.boundingSphere)g.computeBoundingSphere();o.getWorldScale(_ws);if(g.boundingSphere.radius*Math.max(_ws.x,_ws.y,_ws.z)<minSize)return;list.push(o);});
  for(const o of list){let ol;
    if(o.isSkinnedMesh){ol=new THREE.SkinnedMesh(o.geometry,outlineMat(true,w));ol.bind(o.skeleton,o.bindMatrix);ol.position.copy(o.position);ol.quaternion.copy(o.quaternion);ol.scale.copy(o.scale);o.parent.add(ol);ol.frustumCulled=false;}
    else{ol=new THREE.Mesh(o.geometry,outlineMat(false,w));o.add(ol);}
    ol.userData.isOutline=true;ol.castShadow=false;ol.receiveShadow=false;}}
const cylG=(rt,rb,h,n=12)=>{const k='c'+rt+'_'+rb+'_'+h+'_'+n;return geoCache[k]||(geoCache[k]=new THREE.CylinderGeometry(rt,rb,h,n));};
function mesh(g,c,x=0,y=0,z=0,p=WORLD,shadow=true){const m=new THREE.Mesh(g,typeof c==='number'?M(c):c);m.position.set(x,y,z);m.castShadow=shadow;m.receiveShadow=true;p.add(m);return m;}
const B=(w,h,d,c,x,y,z,p,s)=>mesh(boxG(w,h,d),c,x,y,z,p||WORLD,s);
const prismG=(()=>{const g=new THREE.CylinderGeometry(1,1,1,3);g.rotateX(-Math.PI/2);g.translate(0,.5,0);g.scale(1/1.732,1/1.5,1);return g;})();
function group(x=0,z=0,ry=0,p=WORLD){const g=new THREE.Group();g.position.set(x,0,z);g.rotation.y=ry;p.add(g);return g;}
const blobMat=new THREE.MeshBasicMaterial({color:0x2b2118,transparent:true,opacity:.28,depthWrite:false});
const blobG=new THREE.CircleGeometry(.5,20);blobG.rotateX(-Math.PI/2);
function blob(r,p){const m=new THREE.Mesh(blobG,blobMat);m.scale.setScalar(r*2);m.position.y=.015;p.add(m);return m;}
const texLoader=new THREE.TextureLoader();
function tex(url,rep){const t=texLoader.load(url);t.wrapS=t.wrapT=THREE.RepeatWrapping;if(rep)t.repeat.set(rep[0],rep[1]);t.anisotropy=8;return t;}
function b64bytes(s){const bin=atob(s.trim());const a=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);return a;}

/* ================= FARM ================= */
const farmCircles=[],farmBoxes=[];
const colC=(x,z,r)=>farmCircles.push({x,z,r});
const colB=(x,z,hw,hd)=>farmBoxes.push({x,z,hw,hd});
const BOUND=34.4,FENCE=35;
const path=[[-12,-4],[-6,-1],[0,0],[6,3],[8,7],[0,0],[0,10],[-3,16],[0,10],[8,15],[0,0],[5,-6],[12,-10]];
function distToPath(x,z){let m=1e9;for(let i=0;i<path.length-1;i++){const[a,b]=path[i],[c,d]=path[i+1];const vx=c-a,vz=d-b,l=vx*vx+vz*vz;const t=clamp(((x-a)*vx+(z-b)*vz)/l);m=Math.min(m,Math.hypot(x-a-vx*t,z-b-vz*t));}return m;}
function noise(x,z){return Math.sin(x*.37+Math.sin(z*.21)*2)*.5+Math.sin(z*.43+x*.11)*.35+Math.sin((x+z)*.9)*.15;}
(function ground(){
  const g=new THREE.PlaneGeometry(220,220,110,110);g.rotateX(-Math.PI/2);
  const pos=g.attributes.position,col=new Float32Array(pos.count*3);const c=new THREE.Color(),dirt=new THREE.Color();
  for(let i=0;i<pos.count;i++){
    const x=pos.getX(i),z=pos.getZ(i);const out=Math.max(Math.abs(x),Math.abs(z));
    let y=0;if(out>FENCE+2){const k=(out-FENCE-2);y=Math.pow(k,1.25)*.18*(1+noise(x*.3,z*.3)*.6);}
    pos.setY(i,y);const n=noise(x,z);
    c.setHSL(.27+n*.03,.55+n*.08,.43+n*.06+(y>6?.04:0));
    const dp=distToPath(x,z);if(out<FENCE&&dp<1.6){const t=clamp((1.6-dp)/0.6);dirt.set(0xc79a62).offsetHSL(0,0,n*.04);c.lerp(dirt,t);}
    col.set([c.r,c.g,c.b],i*3);}
  g.setAttribute('color',new THREE.BufferAttribute(col,3));g.computeVertexNormals();
  const m=new THREE.Mesh(g,toonMat({vertexColors:true}));m.receiveShadow=true;m.userData.ground=true;farmRoot.add(m);
})();
(function mountains(){
  const cols=[0x86b8d6,0x95c2dc,0x78abcb];
  for(let i=0;i<26;i++){const a=i/26*TAU+rnd(-.1,.1),d=rnd(100,140),h=rnd(22,42),r=rnd(20,32);
    const m=mesh(ballG,cols[i%3],Math.cos(a)*d,-2,Math.sin(a)*d,farmRoot,false);m.scale.set(r,h,r);
    const cap=mesh(ballG,0xf4f7fb,0,.8,0,m,false);cap.scale.set(.42,.28,.42);}
  for(let i=0;i<40;i++){const a=rnd(0,TAU),d=rnd(48,80);if(Math.abs(Math.max(Math.abs(Math.cos(a)*d),Math.abs(Math.sin(a)*d))-39.5)<5)continue; // keep the train track clear
    const t=group(Math.cos(a)*d,Math.sin(a)*d);t.position.y=Math.pow(Math.max(0,Math.max(Math.abs(t.position.x),Math.abs(t.position.z))-FENCE-2),1.25)*.18;
    mesh(cylG(.4,.55,2.4,8),0x7a5233,0,1.2,0,t,false);const s=rnd(1.6,2.2);const b1=mesh(ballG,0x3f8a3a,0,3.6,0,t,false);b1.scale.setScalar(s);const b2=mesh(ballG,0x4f9e44,s*.5,3.4,s*.3,t,false);b2.scale.setScalar(s*.7);}
})();
(function fence(){
  const post=boxG(.28,1.3,.28),railX=boxG(2,.16,.12),railZ=boxG(.12,.16,2);
  const n=FENCE,mp=new THREE.InstancedMesh(post,M(0xe8d9b8),n*4+4),mr=new THREE.InstancedMesh(railX,M(0xdccaa3),n*4),mz=new THREE.InstancedMesh(railZ,M(0xdccaa3),n*4);
