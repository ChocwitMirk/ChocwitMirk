station('snap','Moo Snap','Ride the train, snap photos!','back',0,2.1,0xa66bff,'#8f55e6',.03);
actProp('says',-24.9,-26.3,Math.PI*.3,1.15,.5,null,g0=>{const g=new THREE.Group();g.scale.setScalar(.55);g0.add(g);
  C(.9,.22,WOOD,0,.11,0,g);C(.82,.05,0xf5c544,0,.24,0,g);C(.12,.75,WOOD_D,0,.6,0,g);
  const d=new THREE.Group();d.position.set(0,1.05,0);d.rotation.x=1.05;g.add(d);
  [[0x3fa34d,0],[0xd6453d,1],[0xffd23f,2],[0x3d6fd6,3]].forEach(([c,k])=>mesh(new THREE.CylinderGeometry(.72,.72,.12,10,1,false,k*Math.PI/2+.05,Math.PI/2-.1),c,0,0,0,d));
