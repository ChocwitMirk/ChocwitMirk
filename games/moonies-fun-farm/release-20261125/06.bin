};
function icon(n){if(n==='moo')return `<img class="ico" alt="" src="${typeof COW_TOKEN!=='undefined'?COW_TOKEN:''}">`;
  return `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[n]||''}</svg>`;}
const ACT_LABEL={play:'Play',look:'Look',use:'Use',fire:'Fire'};
let searchAct='';
function setSearchAct(a){if(a===searchAct)return;searchAct=a;const b=$('tbSearch');if(b)b.innerHTML=`${icon(a)}<span>${ACT_LABEL[a]}</span>`;}
function actionFor(ns){if(mode==='paint')return'fire';if(!ns)return mode==='hide'?'look':'use';if(ns.station)return'play';if(ns==='secret'||ns==='outhouse'||ns.play)return'use';return'look';}
/* ---------- audio ---------- */
let AC=null,master=null;
const MUSIC={bytes:null,buf:null,src:null,gain:null,on:true,busy:false,vol:.3};
try{MUSIC.on=localStorage.getItem('moonie-music')!=='off';}catch(e){}
setTimeout(()=>{try{voiceLoad();}catch(e){}},1500);
embeddedFile('music.txt').then(r=>{if(!r.ok)throw new Error('music '+r.status);return r.text();}).then(t=>{MUSIC.bytes=b64bytes(t);startMusic();}).catch(e=>console.warn(e));
let bonusTrack=null, trackChoice='original', tunesMuted=false;
try{if(localStorage.getItem('moonie-track')==='bonus')trackChoice='bonus';}catch(e){}
function musicTarget(){return MUSIC.on&&!tunesMuted&&trackChoice==='original'?MUSIC.vol:0;}
function syncBonusTrack(){
