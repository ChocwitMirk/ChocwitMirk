  const len=Math.hypot(3.4,SLIDE.top-.35),ang=Math.atan2(SLIDE.top-.35,3.4);
  const ramp=new THREE.Group();ramp.position.set(.75+1.7,(SLIDE.top+.35)/2,0);ramp.rotation.z=-ang;g.add(ramp);
  B(len,.12,.9,0xf5c544,0,0,0,ramp);for(const s of[-1,1])B(len,.28,.1,0xd6453d,0,.16,s*.46,ramp);
