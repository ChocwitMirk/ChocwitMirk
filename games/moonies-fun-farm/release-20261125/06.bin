const _cornFr=new THREE.Frustum(),_cornPM=new THREE.Matrix4();
function updateCorn(p,t,dt=0){
  // the tractor mows a path through the corn; mown stalks drop cobs and slowly grow back
  const T=typeof TRACTOR!=='undefined'&&TRACTOR.driving?TRACTOR:null,fx=T?T.x+Math.sin(T.yaw)*1.1:0,fz=T?T.z+Math.cos(T.yaw)*1.1:0;
  // only move the stalks when the field is on screen, and at most ~30 times a second
  let onScreen=true;if(p&&typeof cam!=='undefined'){cam.updateMatrixWorld();_cornPM.multiplyMatrices(cam.projectionMatrix,cam.matrixWorldInverse);_cornFr.setFromProjectionMatrix(_cornPM);onScreen=_cornFr.intersectsBox(corn.box);}
  corn.mesh.visible=corn.tips.visible=corn.leaves.visible=onScreen;
  corn.acc=(corn.acc||0)+dt;const draw=onScreen&&(corn.acc>=1/30||!p);
  if(dt>0)corn.stalks.forEach(s=>{if(T&&s.g>.3&&Math.hypot(s.x-fx,s.z-fz)<1.5)cornMow(s);if(s.regrow>0){s.regrow=Math.max(0,s.regrow-dt);}else if(s.g<1)s.g=Math.min(1,s.g+dt/4);});
  if(!draw)return;corn.acc=0;const ease=p?.28:1;
