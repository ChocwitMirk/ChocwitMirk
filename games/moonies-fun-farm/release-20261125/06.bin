    return pack(g,h,ey,legs,{tail,ears});},

  Clucky(){const g=new THREE.Group(),ey=[],legs=[],W=0xffffff,W2=0xf3f0ea,OR=0xf0a030;
    birdLeg(g,legs,-.08,.19,OR,W2,0);birdLeg(g,legs,.08,.19,OR,W2,Math.PI);
    E(.27,.25,.29,W,0,.37,0,g);E(.21,.2,.16,0xfffbf2,0,.39,.16,g);E(.17,.14,.15,W2,0,.33,-.22,g);
    const wings=[];for(const s of[-1,1]){const w=pivot(g,s*.24,.43,0);E(.06,.15,.21,W2,0,-.03,-.02,w,[0,0,s*.15]);E(.05,.12,.18,0xe9e4da,s*.012,-.07,-.09,w,[0,0,s*.15]);E(.045,.08,.12,0xdedad0,s*.018,-.11,-.16,w,[0,0,s*.15]);w.userData.side=s;wings.push(w);}
