  {const yb=(SLIDE.top+.35)/2-(3.5-2.45)*Math.tan(ang)-.08;for(const s2 of[-1,1])mesh(cylG(.07,.07,yb,8),0xd6453d,3.5,yb/2,s2*.35,g);}
  SLIDE.cols=[{x:SLIDE.x,z:SLIDE.z,r:.75},{x:SLIDE.x+3.5,z:SLIDE.z,r:.45}];SLIDE.cols.forEach(c=>farmCircles.push(c));})();
