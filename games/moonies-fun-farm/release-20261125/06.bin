    if(p){const dx=s.x-p.x,dz=s.z-p.z,d=Math.hypot(dx,dz);if(d<1.6){const k=(1.6-d)/1.6*.7;tx+=dx/(d||1)*k;tz+=dz/(d||1)*k;}}
    s.bx=lerp(s.bx,tx,ease);s.bz=lerp(s.bz,tz,ease);const g=Math.max(.001,s.g),H=s.h*Math.max(.08,g);
    _o.position.set(s.x,H/2,s.z);_o.rotation.set(s.bz,0,-s.bx);_o.scale.set(1,H,1);_o.updateMatrix();corn.mesh.setMatrixAt(i,_o.matrix);
    _o.position.set(s.x+s.bx*H,H,s.z+s.bz*H);_o.scale.setScalar(g<.6?.001:(g-.6)/.4);_o.updateMatrix();corn.tips.setMatrixAt(i,_o.matrix);
    _o.position.set(s.x+s.bx*H*.5,H*.55,s.z+s.bz*H*.5);_o.rotation.set(s.bz,i*1.7,-s.bx+.3);_o.scale.setScalar(g<.25?.001:g);_o.updateMatrix();corn.leaves.setMatrixAt(i,_o.matrix);});
  corn.mesh.instanceMatrix.needsUpdate=corn.tips.instanceMatrix.needsUpdate=corn.leaves.instanceMatrix.needsUpdate=true;
}
