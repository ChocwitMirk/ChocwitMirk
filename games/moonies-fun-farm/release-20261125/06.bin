    else{for(const k of[-1,0,1]){const t=E(.016,.014,.075,c,k*.035,-hip+.014,.05,p);t.rotation.y=k*.45;}E(.014,.012,.05,c,0,-hip+.014,-.04,p);}
    legs.push({p,o:ph});return p;}
  function chain(p,pts,c,r0,r1){pts.forEach(([x,y,z],i)=>{const r=lerp(r0,r1,i/Math.max(1,pts.length-1));E(r,r,r,Array.isArray(c)?c[i]:c,x,y,z,p);});}
