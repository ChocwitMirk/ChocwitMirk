  for(const s of[-1,1]){const r=mesh(cylG(.06,.06,2.6,8),0xd6453d,-.25,1.3,s*.42,g);}
  for(let i=0;i<6;i++){const rg=mesh(cylG(.04,.04,.84,8),0xf5c544,-.25,.35+i*.38,0,g);rg.rotation.x=Math.PI/2;}
