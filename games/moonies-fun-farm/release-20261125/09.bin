  if(SLIDE.drag&&SLIDE.drag.id===e.pointerId){SLIDE.drag=null;SLIDE.g.position.y=0;canvas.style.cursor='';voice({type:'sine',f0:180,f1:110,dur:.15,vol:.15});return;}
  if(TRAMP.drag&&TRAMP.drag.id===e.pointerId){TRAMP.drag=null;TRAMP.g.position.y=0;canvas.style.cursor='';voice({type:'sine',f0:180,f1:110,dur:.15,vol:.15});return;}
  if(stick.id===e.pointerId){stick.id=null;stick.x=stick.y=0;$('knob').style.transform='';if((stick.mv||0)>=10)stick.endT=performance.now();
    if((stick.mv||0)<10&&performance.now()-(stick.t0||0)<350&&state==='play'&&(mode==='hub'||mode==='hide'))clickAt(e.clientX,e.clientY,true); // a quick tap on the left side still taps things (stations, hiding spots) but never sends her walking
