');
    bonusTrack.loop=true;
    bonusTrack.volume=MUSIC.vol;
  }
  if(bonusTrack.paused)bonusTrack.play().catch(()=>{});
}
function syncMusic(){
  if(MUSIC.gain){
    const gain=MUSIC.gain.gain,now=AC.currentTime;
    gain.cancelScheduledValues(now);
    if(!musicTarget())gain.setValueAtTime(0,now);
    else gain.setTargetAtTime(musicTarget(),now,.15);
  }
  syncBonusTrack();
}
function showTrackChoice(){
  $('trackBtn').textContent='Track: '+(trackChoice==='bonus'?'Bonus Track':'Original');
}
function startMusic(){if(!AC||!MUSIC.bytes||MUSIC.src||MUSIC.busy)return;
  if(!MUSIC.buf){MUSIC.busy=true;const done=b=>{MUSIC.buf=b;MUSIC.busy=false;startMusic();};const p=AC.decodeAudioData(MUSIC.bytes.buffer.slice(0),done,()=>{MUSIC.busy=false;});if(p&&p.catch)p.catch(()=>{});return;}
  MUSIC.gain=AC.createGain();MUSIC.gain.gain.value=0;MUSIC.gain.connect(AC.destination);MUSIC.gain.gain.setTargetAtTime(musicTarget(),AC.currentTime,.6);
  const s=AC.createBufferSource();s.buffer=MUSIC.buf;s.loop=true;s.connect(MUSIC.gain);s.start();MUSIC.src=s;}
function setMusic(on){MUSIC.on=on;try{localStorage.setItem('moonie-music',on?'on':'off');}catch(e){}
  syncMusic();document.querySelectorAll('.musicBtn').forEach(b=>b.innerHTML=icon(on?'music':'mute')+'Music: '+(on?'on':'off'));}
function audio(){syncBonusTrack();setTimeout(startMusic,0);if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)();master=AC.createGain();master.gain.value=.5;master.connect(AC.destination);}catch(e){}}if(AC&&AC.state==='suspended')AC.resume();}
function voice({type='sawtooth',f0=200,f1=150,dur=.5,vol=.3,pan=0,filt=1200,q=1,vib=0,delay=0}){
  if(!AC)return;const t=AC.currentTime+delay;const o=AC.createOscillator(),g=AC.createGain(),bp=AC.createBiquadFilter(),p=AC.createStereoPanner?AC.createStereoPanner():null;
  o.type=type;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(Math.max(20,f1),t+dur);
  if(vib){const l=AC.createOscillator(),lg=AC.createGain();l.frequency.value=vib;lg.gain.value=f0*.04;l.connect(lg).connect(o.frequency);l.start(t);l.stop(t+dur);}
  bp.type='lowpass';bp.frequency.value=filt;bp.Q.value=q;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+.03);g.gain.setValueAtTime(vol,t+dur*.7);g.gain.linearRampToValueAtTime(0,t+dur);
  o.connect(bp).connect(g);if(p){p.pan.value=clamp(pan,-1,1);g.connect(p).connect(master);}else g.connect(master);o.start(t);o.stop(t+dur+.05);}
function noiseBurst(dur=.25,vol=.2,filt=2000,pan=0,delay=0){if(!AC)return;const t=AC.currentTime+delay;const n=AC.createBufferSource(),b=AC.createBuffer(1,Math.floor(AC.sampleRate*dur),AC.sampleRate),d=b.getChannelData(0);
  for(let i=0;i<d.length;i++)d[i]=(Math.random()*2-1)*(1-i/d.length);n.buffer=b;const f=AC.createBiquadFilter();f.type='bandpass';f.frequency.value=filt;f.Q.value=.8;const g=AC.createGain();g.gain.value=vol;
  const p=AC.createStereoPanner?AC.createStereoPanner():null;n.connect(f).connect(g);if(p){p.pan.value=clamp(pan,-1,1);g.connect(p).connect(master);}else g.connect(master);n.start(t);}
const SFX={
  moo(){if(!AC)return;const t=AC.currentTime+.01,dur=1.05;
    const pitch=[[0,255],[.2,330],[.55,310],[dur,235]];
    const lfo=AC.createOscillator(),lg=AC.createGain();lfo.frequency.value=5.5;lg.gain.setValueAtTime(0,t);lg.gain.linearRampToValueAtTime(7,t+.35);lfo.connect(lg);
    const pre=AC.createGain();
    for(const[type,mul,vol]of[['sawtooth',1,.7],['triangle',1.003,.5]]){const o=AC.createOscillator();o.type=type;pitch.forEach(([tt,f],i)=>i?o.frequency.linearRampToValueAtTime(f*mul,t+tt):o.frequency.setValueAtTime(f*mul,t));
      lg.connect(o.frequency);const og=AC.createGain();og.gain.value=vol;o.connect(og).connect(pre);o.start(t);o.stop(t+dur+.05);}
    lfo.start(t);lfo.stop(t+dur+.05);
    const nasal=AC.createBiquadFilter();nasal.type='lowpass';nasal.frequency.value=330;const ng=AC.createGain();
    ng.gain.setValueAtTime(1.4,t);ng.gain.linearRampToValueAtTime(1.4,t+.07);ng.gain.linearRampToValueAtTime(0,t+.18);pre.connect(nasal).connect(ng);
    const vowel=AC.createGain();vowel.gain.setValueAtTime(0,t);vowel.gain.linearRampToValueAtTime(0,t+.06);vowel.gain.linearRampToValueAtTime(1,t+.17);
    for(const[f,q,gn,f0]of[[440,5,1.6,300],[1080,7,.55,800],[2850,9,.14,2600]]){const bp=AC.createBiquadFilter();bp.type='bandpass';bp.Q.value=q;bp.frequency.setValueAtTime(f0,t);bp.frequency.linearRampToValueAtTime(f,t+.18);bp.frequency.linearRampToValueAtTime(f*.93,t+dur);
      const g=AC.createGain();g.gain.value=gn;pre.connect(bp).connect(g).connect(vowel);}
    const env=AC.createGain();env.gain.setValueAtTime(0,t);env.gain.linearRampToValueAtTime(.55,t+.05);env.gain.setValueAtTime(.55,t+dur-.3);env.gain.linearRampToValueAtTime(0,t+dur);
    ng.connect(env);vowel.connect(env);env.connect(master);noiseBurst(.25,.025,1100,0,.12);},
  oink(o){for(let i=0;i<2;i++)voice({type:'square',f0:260,f1:170,dur:.14,vol:.18*o.v,pan:o.p,filt:800,q:6,delay:i*.18+(o.d||0)});},
  cluck(o){for(let i=0;i<3;i++)voice({type:'square',f0:900,f1:600,dur:.07,vol:.12*o.v,pan:o.p,filt:2200,delay:i*.11+(o.d||0)});},
  baa(o){voice({f0:340,f1:300,dur:.7,vol:.18*o.v,pan:o.p,filt:1600,q:3,vib:9,delay:o.d||0});},
  quack(o){for(let i=0;i<2;i++)voice({type:'square',f0:480,f1:320,dur:.16,vol:.14*o.v,pan:o.p,filt:1000,q:8,delay:i*.22+(o.d||0)});},
  maa(o){voice({f0:420,f1:380,dur:.6,vol:.16*o.v,pan:o.p,filt:1800,q:3,vib:12,delay:o.d||0});},
  neigh(o){voice({f0:700,f1:260,dur:.9,vol:.16*o.v,pan:o.p,filt:2400,q:2,vib:14,delay:o.d||0});},
  hum(o){voice({type:'sine',f0:330,f1:360,dur:.35,vol:.16*o.v,pan:o.p,vib:5,delay:o.d||0});voice({type:'sine',f0:360,f1:300,dur:.45,vol:.16*o.v,pan:o.p,vib:5,delay:.32+(o.d||0)});},
  heehaw(o){const d=o.d||0;for(let i=0;i<2;i++){voice({type:'sawtooth',f0:820,f1:760,dur:.28,vol:.11*o.v,pan:o.p,filt:2200,q:3,delay:d+i*.6});voice({type:'sawtooth',f0:260,f1:200,dur:.3,vol:.13*o.v,pan:o.p,filt:1200,q:3,delay:d+.28+i*.6});}},
  woof(o){for(let i=0;i<2;i++){voice({type:'sawtooth',f0:330,f1:170,dur:.16,vol:.2*o.v,pan:o.p,filt:900,q:4,delay:i*.24+(o.d||0)});noiseBurst(.06,.06*o.v,700,o.p,i*.24+(o.d||0));}},
  meow(o){voice({type:'sawtooth',f0:620,f1:820,dur:.25,vol:.12*o.v,pan:o.p,filt:2400,q:5,delay:o.d||0});voice({type:'sawtooth',f0:820,f1:480,dur:.4,vol:.12*o.v,pan:o.p,filt:2200,q:5,vib:6,delay:.24+(o.d||0)});},
  rustle(o){noiseBurst(.35,.12*o.v,2600,o.p);},
  giggle(o){for(let i=0;i<4;i++)voice({type:'triangle',f0:700+i*40,f1:620,dur:.08,vol:.07*o.v,pan:o.p,filt:3000,delay:i*.1});},
  pop(){voice({type:'sine',f0:300,f1:900,dur:.15,vol:.25});noiseBurst(.15,.1,3000);},
  empty(){noiseBurst(.3,.15,900);voice({type:'triangle',f0:260,f1:180,dur:.25,vol:.12});},
  jump(){voice({type:'sine',f0:220,f1:440,dur:.18,vol:.12});},
  warp(){voice({type:'sine',f0:600,f1:80,dur:1.2,vol:.2,vib:6});voice({type:'triangle',f0:300,f1:60,dur:1.2,vol:.1,delay:.1});},
  win(){[523,659,784,1047].forEach((f,i)=>voice({type:'triangle',f0:f,f1:f,dur:.3,vol:.18,filt:4000,delay:i*.14}));},
  lose(){[392,349,311,262].forEach((f,i)=>voice({type:'triangle',f0:f,f1:f*.98,dur:.35,vol:.15,filt:3000,delay:i*.18}));},
};
function friendSound(f,v=1,p=0,d=0){SFX[f.sound]({v,p,d});}

/* ---------- Moonie (Mixamo rig + running clip, procedural layers) ---------- */
const moonie={root:new THREE.Group(),pos:new THREE.Vector3(0,0,4),vel:new THREE.Vector3(),yaw:Math.PI,vy:0,y:0,onGround:true,t:0,
  rig:{},loaded:false,action:null,actT:0,squash:0,trail:[],happy:0,mixer:null,run:null};
scene.add(moonie.root);blob(.42,moonie.root);
const glow=new THREE.PointLight(0xffe2a0,.55,7,2);glow.position.set(0,2.6,.6);glow.visible=false;moonie.root.add(glow);
const MAXIS={X:new THREE.Vector3(1,0,0),Y:new THREE.Vector3(0,1,0),Z:new THREE.Vector3(0,0,1)};
const _qa=new THREE.Quaternion(),_qd=new THREE.Quaternion(),_qp=new THREE.Quaternion(),_qr=new THREE.Quaternion();
// rotate a bone (on top of whatever the animation set) about Moonie's own X/Y/Z axes
function boneAdd(name,parts){const b=moonie.rig[name];if(!b)return;_qd.identity();let any=false;for(const[ax,ang]of parts){if(!ang)continue;any=true;_qa.setFromAxisAngle(MAXIS[ax],ang);_qd.multiply(_qa);}
  if(!any)return;b.parent.getWorldQuaternion(_qp);_qp.premultiply(_qr);
  b.quaternion.premultiply(_qp.clone().invert().multiply(_qd).multiply(_qp));b.updateMatrixWorld(true);}
// Moonie's own cel shader: crisp light bands + a soft rim, so her painted texture reads as cel shaded
const celU={lightDir:{value:new THREE.Vector3(.4,.8,.4)},tint:{value:new THREE.Color(1,1,1)},bright:{value:1}};
function moonieCelMat(map){return new THREE.ShaderMaterial({skinning:true,side:THREE.DoubleSide,extensions:{derivatives:true},
  uniforms:{map:{value:map},lightDir:celU.lightDir,tint:celU.tint,bright:celU.bright},
  vertexShader:`#include <common>
#include <skinning_pars_vertex>
varying vec2 vUv;varying vec3 vN;varying vec3 vV;
void main(){vUv=uv;
#include <beginnormal_vertex>
#include <skinbase_vertex>
#include <skinnormal_vertex>
#include <begin_vertex>
#include <skinning_vertex>
#include <project_vertex>
vN=normalize(normalMatrix*objectNormal);vV=-mvPosition.xyz;}`,
  fragmentShader:`uniform sampler2D map;uniform vec3 lightDir;uniform vec3 tint;uniform float bright;
varying vec2 vUv;varying vec3 vN;varying vec3 vV;
void main(){vec3 base=texture2D(map,vUv).rgb;vec3 n=normalize(vN);if(!gl_FrontFacing)n=-n;
float d=dot(n,normalize(lightDir));float w=max(fwidth(d)*1.5,0.02);
float band=mix(0.8,1.0,smoothstep(-0.08-w,-0.08+w,d));
float rim=smoothstep(0.62,0.7,1.0-max(dot(n,normalize(vV)),0.0))*step(-0.1,d)*0.1;
// the cel band only shows on her white fur: the brown spots (the circles on her tummy) and the pink nose/ears stay flat and clean
float lum=dot(base,vec3(0.299,0.587,0.114)),sat=max(base.r,max(base.g,base.b))-min(base.r,min(base.g,base.b));
float flatM=1.0-smoothstep(0.6,0.74,lum)*(1.0-smoothstep(0.18,0.3,sat));band=mix(band,1.0,flatM);rim*=1.0-flatM;
gl_FragColor=vec4(base*band*tint*min(bright,1.15)+rim,1.0);}`});}
function celSkinMat(map){return new THREE.ShaderMaterial({skinning:true,side:THREE.DoubleSide,extensions:{derivatives:true},
  uniforms:{map:{value:map},lightDir:celU.lightDir,tint:celU.tint,bright:celU.bright},
  vertexShader:`#include <common>
#include <skinning_pars_vertex>
varying vec2 vUv;varying vec3 vN;varying vec3 vV;
void main(){vUv=uv;
#include <beginnormal_vertex>
#include <skinbase_vertex>
#include <skinnormal_vertex>
#include <begin_vertex>
#include <skinning_vertex>
#include <project_vertex>
vN=normalize(normalMatrix*objectNormal);vV=-mvPosition.xyz;}`,
  fragmentShader:`uniform sampler2D map;uniform vec3 lightDir;uniform vec3 tint;uniform float bright;
varying vec2 vUv;varying vec3 vN;varying vec3 vV;
void main(){vec3 base=texture2D(map,vUv).rgb;vec3 n=normalize(vN);if(!gl_FrontFacing)n=-n;
float d=dot(n,normalize(lightDir));
float w=max(fwidth(d)*1.2,0.015);float band=mix(0.56,0.76,smoothstep(-0.22-w,-0.22+w,d));band=mix(band,1.0,smoothstep(0.28-w,0.28+w,d));
