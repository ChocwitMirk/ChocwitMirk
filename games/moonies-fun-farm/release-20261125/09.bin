let VFIX={};try{VFIX=JSON.parse(localStorage.getItem('moonie-voicefix')||'{}')||{};}catch(e){VFIX={};}
function vfSave(){try{localStorage.setItem('moonie-voicefix',JSON.stringify(VFIX));}catch(e){}}
function vfClip(i){const r=VLIST[i],f=VFIX[r[0]]||{};const j=Math.max(0,Math.min(VLIST.length-1,i+(f.shift||0))),src=VLIST[j];
  const st=Math.max(0,src[2]+(f.a||0)),en=Math.max(st+.1,src[2]+src[3]+(f.b||0));return[+st.toFixed(3),+(en-st).toFixed(3)];}
function vfApply(){VOICE.map.text=Object.assign({},VBASE.text);VOICE.map.key=Object.assign({},VBASE.key);
  VLIST.forEach((r,i)=>{const f=VFIX[r[0]];if(!f||(!f.shift&&!f.a&&!f.b))return;const c=vfClip(i);VOICE.map.text[vNorm(r[1])]=c;if(VOICE.map.key[r[0]])VOICE.map.key[r[0]]=c;});}
vfApply();
const SND_GROUPS=[['abc_q_letter','ABCs: which veggie starts with…'],['abc_q_veg','ABCs: what letter does…'],['abc_right','ABCs: right answers'],['abc_oops_veg','ABCs: wrong veggie'],['abc_oops_letter','ABCs: wrong letter'],['abc_letter','ABCs: letters'],['abc_word','ABCs: veggie names'],['abc_end','ABCs: end'],['cnt_q','Count: how many…'],['cnt_tap','Count: tap the…'],['cnt_num','Count: numbers'],['cnt_thats','Count: that\'s a…'],['cnt_word','Count: animal words'],['cnt_','Count: other'],['greet','Moonie: greetings & lines']];
function sndGroupOf(k){for(const[g]of SND_GROUPS)if(k.startsWith(g))return g;return'cnt_';}
function sndPlay(i){audio();voiceLoad();if(!AC||!VOICE.bytes){$('sndMsg').textContent='Still loading the recordings... try again in a second.';return;}voicePlay([vfClip(i)]);}
function sndRender(){const g=$('sndGroup').value,box=$('sndList');box.innerHTML='';
  if(g==='greet'){Object.keys(GREET.data).forEach(k=>{const d=document.createElement('div');d.className='sr';d.innerHTML=`<button data-a="play">\u25B6</button><b>${k.startsWith('welcome')?'Welcome to my farm ('+k.slice(-1)+')':'Moonie line '+k.slice(-1)}<small>${k.startsWith('welcome')?'plays when the game starts':'plays now and then on the farm'}</small></b>`;d.onclick=e=>{if(e.target.dataset&&e.target.dataset.a==='play')greetPlay(k);};box.appendChild(d);});return;}
  const rows=VLIST.map((r,i)=>({r,i})).filter(({r})=>sndGroupOf(r[0])===g);if(g==='abc_letter')rows.sort((a,b)=>a.r[1].localeCompare(b.r[1]));rows.forEach(({r,i})=>{const f=VFIX[r[0]]||{};const d=document.createElement('div');
    const fixed=f.shift||f.a||f.b;d.className='sr'+(f.mark==='bad'?' bad':f.mark==='ok'?' ok':'')+(fixed?' fix':'');
    const note=fixed?`<small>fix: ${f.shift?('using clip '+(f.shift>0?'+':'')+f.shift):''} ${f.a?('start '+(f.a>0?'+':'')+f.a.toFixed(1)+'s'):''} ${f.b?('end '+(f.b>0?'+':'')+f.b.toFixed(1)+'s'):''}</small>`:'';
    d.innerHTML=`<button data-a="play" aria-label="Play">\u25B6</button><b>${r[1]}${note}<small>${r[0]}</small></b><button data-a="ok">OK</button><button data-a="bad">Wrong</button><button data-a="sl" title="Use the clip before">\u25C0 clip</button><button data-a="sr" title="Use the clip after">clip \u25B6</button><button data-a="a-">start \u2212</button><button data-a="a+">start +</button><button data-a="b-">end \u2212</button><button data-a="b+">end +</button>`;
    d.onclick=e=>{const a=e.target.dataset&&e.target.dataset.a;if(!a)return;const F=VFIX[r[0]]=VFIX[r[0]]||{};
      if(a==='ok')F.mark=F.mark==='ok'?null:'ok';else if(a==='bad')F.mark=F.mark==='bad'?null:'bad';
      else if(a==='sl')F.shift=(F.shift||0)-1;else if(a==='sr')F.shift=(F.shift||0)+1;
      else if(a[0]==='a'||a[0]==='b')F[a[0]]=Math.round(((F[a[0]]||0)+(a[1]==='+'?.1:-.1))*10)/10;
      vfSave();vfApply();if(a!=='ok'&&a!=='bad')sndPlay(i);sndRender();};
    box.appendChild(d);});}
function sndOpen(){$('sndGroup').innerHTML=SND_GROUPS.map(([g,n])=>`<option value="${g}">${n}</option>`).join('');$('sndck').hidden=false;voiceLoad();sndRender();}
function sndReport(){const L=[];VLIST.forEach(r=>{const f=VFIX[r[0]];if(!f)return;const p=[];if(f.mark==='bad')p.push('WRONG');if(f.mark==='ok')p.push('ok');if(f.shift)p.push('clip '+(f.shift>0?'+':'')+f.shift);if(f.a)p.push('start '+f.a);if(f.b)p.push('end '+f.b);if(p.length)L.push(r[0]+' ("'+r[1]+'"): '+p.join(', '));});
  return L.length?'Moonie sound check report\n'+L.join('\n'):'Moonie sound check: no changes or flags.';}

// ---- Chowder's greetings: played now and then, like when the game first starts ----
const GREET={data:{"welcome1":"","welcome2":"","line1":"","line2":"","line3":"","line4":"","line5":""},buf:{},last:-999,src:null};
function greetPlay(k){try{audio();if(!AC)return;const now=performance.now()/1000;GREET.last=now;
  if(!k)k=Math.random()<.5?'welcome1':'welcome2';
  const go=b=>{try{if(GREET.src)GREET.src.stop();}catch(e){}voiceStop();const s=AC.createBufferSource(),g=AC.createGain();g.gain.value=.5;s.buffer=b;s.connect(g).connect(AC.destination);s.start(AC.currentTime+.05);GREET.src=s;};
  if(GREET.buf[k]){go(GREET.buf[k]);return;}
  const bin=atob(GREET.data[k]),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);
  AC.decodeAudioData(u.buffer,b=>{GREET.buf[k]=b;go(b);},()=>{});}catch(e){}}
const GREET_LINES=['line1','line2','line3','line4','line5'];
// one of Moonie's other lines, now and then (never two close together, never the same one twice in a row)
function greetLine(){let k;do{k=GREET_LINES[Math.floor(Math.random()*GREET_LINES.length)];}while(k===GREET.prev&&GREET_LINES.length>1);GREET.prev=k;greetPlay(k);}
function greetMaybe(p){if(performance.now()/1000-GREET.last<240||Math.random()>p)return;greetLine();}
function greetTick(dt){if(mode!=='hub'||level!=='farm'||state!=='play')return;GREET.next=(GREET.next??rnd(240,420))-dt;if(GREET.next<=0){GREET.next=rnd(300,540);greetMaybe(.5);}}
function say(t){try{audio();voiceLoad();const parts=voiceFor(t);if(parts&&AC&&VOICE.bytes){try{speechSynthesis.cancel();}catch(e){}voicePlay(parts);return;}}catch(e){}
  if(/^[a-z]$/i.test(vNorm(t)))return; // never use a computerized voice for standalone alphabet letters
  sayTTS(t);}
function sayTTS(t){try{if(!('speechSynthesis' in window))return;speechSynthesis.cancel();if(!SAY_VOICE)SAY_VOICE=pickVoice();const u=new SpeechSynthesisUtterance(t);
  if(SAY_VOICE){u.voice=SAY_VOICE;u.lang=SAY_VOICE.lang;}const natural=SAY_VOICE&&/natural|neural|premium|enhanced|siri|google/i.test(SAY_VOICE.name);
  u.rate=natural?.92:.86;u.pitch=natural?1.05:1.1;u.volume=1;speechSynthesis.speak(u);}catch(e){}}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function startLetters(){voiceLoad();mode='letters';state='play';hud(['abcUI']);ABC.round=0;ABC.stars=0;ABC.learned=[];ABC.used=[];
  $('abcDots').innerHTML=Array.from({length:ABC.rounds},()=>'<i></i>').join('');$('abcBasket').innerHTML='';$('abcCow').src=COW_TOKEN;abcNext();}
function abcNext(){if(ABC.round>=ABC.rounds){abcFinish();return;}
  ABC.busy=false;ABC.first=true;const dots=$('abcDots').children;[...dots].forEach((d,i)=>d.className=i<ABC.round?(ABC.learned[i]&&ABC.learned[i].ok?'ok':'meh'):i===ABC.round?'now':'');
  let pool=VEGGIES.filter(v=>!ABC.used.includes(v.n));if(pool.length<3)pool=VEGGIES.slice();
  const v=pool[Math.floor(Math.random()*pool.length)];ABC.used.push(v.n);ABC.cur=v;ABC.kind=Math.random()<.55?'veg':'letter';
  const main=$('abcMain'),ch=$('abcChoices');main.className='abcMain '+ABC.kind;
  if(ABC.kind==='veg'){ // show a letter, pick the veggie
    const others=shuffle(VEGGIES.filter(q=>q.l!==v.l)).slice(0,2);ABC.choices=shuffle([v,...others]);
    main.innerHTML=`<button class="bigLetter" id="abcSay" aria-label="Letter ${v.l}. Tap to hear it."><b>${v.l}</b><small>${v.l.toLowerCase()}</small></button>`;
    ch.innerHTML=ABC.choices.map((q,i)=>`<button class="abcCard" data-i="${i}" aria-label="${q.n}"><img alt="" src="${vegSrc(q)}"><span><em>${q.n[0]}</em>${q.n.slice(1)}</span><kbd>${i+1}</kbd></button>`).join('');
    $('abcAsk').innerHTML=`Which veggie starts with <b>${v.l}</b>?`;say(`Which veggie starts with ${v.l}?`);}
  else{ // show a veggie, pick its first letter
    const ls=shuffle(abcLetters().filter(l=>l!==v.l)).slice(0,2);ABC.choices=shuffle([v.l,...ls]);
    main.innerHTML=`<button class="bigVeg" id="abcSay" aria-label="${v.n}. Tap to hear it."><img alt="" src="${vegSrc(v)}"><span><em>?</em>${v.n.slice(1)}</span></button>`;
    ch.innerHTML=ABC.choices.map((l,i)=>`<button class="abcLetter" data-i="${i}" aria-label="Letter ${l}"><b>${l}</b><small>${l.toLowerCase()}</small><kbd>${i+1}</kbd></button>`).join('');
    $('abcAsk').innerHTML=`What letter does <b>${v.n}</b> start with?`;say(`What letter does ${v.n} start with?`);}
  $('abcSay').onclick=()=>{audio();say(ABC.kind==='veg'?ABC.cur.l:ABC.cur.n);};
  setTimeout(()=>{if(mode==='letters'&&device==='pad')padFocus(ch.children[0]);},80);}
function abcPick(i){if(ABC.busy||mode!=='letters')return;audio();const btn=$('abcChoices').children[i];if(!btn||btn.disabled)return;const pick=ABC.choices[i],v=ABC.cur;
  const ok=ABC.kind==='veg'?pick.l===v.l:pick===v.l;
  if(ok){ABC.busy=true;btn.classList.add('right');if(ABC.first)ABC.stars++;ABC.learned[ABC.round]={v,ok:ABC.first};
    [523,659,784].forEach((f,k)=>voice({type:'triangle',f0:f,f1:f,dur:.14,vol:.12,delay:k*.08}));say(`${v.l} is for ${v.n}!`);
    $('abcAsk').innerHTML=`<b>${v.l}</b> is for <b>${v.n}</b>!`;
    if(ABC.kind==='letter'){const sp=$('abcMain').querySelector('.bigVeg span');if(sp)sp.innerHTML=`<em>${v.n[0]}</em>${v.n.slice(1)}`;}
    const im=document.createElement('img');im.alt=v.n;im.src=vegSrc(v);$('abcBasket').appendChild(im);
    $('abcCowWrap').classList.remove('munch');void $('abcCowWrap').offsetWidth;$('abcCowWrap').classList.add('munch');
    ABC.round++;setTimeout(()=>{if(mode==='letters')abcNext();},2300);}
  else{ABC.first=false;btn.classList.add('wrong');btn.disabled=true;voice({type:'square',f0:200,f1:150,dur:.18,vol:.08});
    const what=ABC.kind==='veg'?`${pick.n} starts with ${pick.l}.`:`${pick} is not it.`;$('abcAsk').innerHTML=`Oops! ${what} Try again!`;say(`Oops! ${what} Try again!`);}}
function abcFinish(){const s=ABC.stars,stars=s>=9?3:s>=6?2:1;const b=best('moonie-abc-best',s,false);SFX.win();
  const got=[...new Set(ABC.learned.filter(Boolean).map(q=>q.v.l))].sort().join(' ');
  showEnd(s>=9?'Letter superstar!':'Great job!',stars,`Moonie munched ${ABC.rounds} veggies and practiced the letters ${got}.`,`<div>First try<b>${s}/${ABC.rounds}</b></div>`+(b?`<div>Best<b>${b}/${ABC.rounds}</b></div>`:''));
  say(s>=9?'Letter superstar!':'Great job!');$('end').hidden=false;(device==='pad'?padFocus($('againBtn')):$('againBtn').focus());}
(function abcInput(){$('abcChoices').addEventListener('click',e=>{const b=e.target.closest('button');if(b)abcPick(+b.dataset.i);});
  $('abcFarm').onclick=backToFarm;$('abcHear').onclick=()=>{audio();const v=ABC.cur;if(!v)return;say(ABC.kind==='veg'?`Which veggie starts with ${v.l}?`:`What letter does ${v.n} start with?`);};})();

/* ================= COUNT THE ANIMALS ================= */
const PLURAL={pig:'pigs',chicken:'chickens',sheep:'sheep',duck:'ducks',goat:'goats',horse:'horses',dog:'dogs',cat:'cats',llama:'llamas',donkey:'donkeys'};
const NUM_WORDS=['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve'];
const PIP_COLS=['#e0393a','#ff8a2a','#f5b800','#3fa34d','#3d6fd6'];
const CNT={round:0,rounds:10,stars:0,first:true,wrong:0,ans:0,kind:null,choices:[],busy:false,tapN:0,lastKind:null};
const kindImg=k=>{const f=FRIENDS.find(q=>q.kind===k);const im=f&&mem.imgs.find(q=>q.f===f);return im?im.src:COW_TOKEN;};
function startCount(){voiceLoad();mode='count';state='play';hud(['cntUI']);CNT.round=0;CNT.stars=0;$('cntCow').src=COW_TOKEN;
  // first choose: count the animals, or add two groups together (1 pig + 3 pigs = ?)
  CNT.picking=true;CNT.ab=null;CNT.kind=null;$('cntChoices').innerHTML='';$('cntQ').innerHTML='Count them, or add them up?';$('cntDots').innerHTML='';
  const F=$('cntField');F.innerHTML=`<div class="cntMode"><button data-m="count">Count them<small>How many?</small></button><button data-m="add">Add them up<small>1 + 2 = ?</small></button></div>`;
  F.querySelectorAll('.cntMode button').forEach(b=>b.onclick=e=>{e.stopPropagation();audio();CNT.add=b.dataset.m==='add';CNT.picking=false;cntBegin();});
  setTimeout(()=>{if(device==='pad')padFocus(F.querySelector('.cntMode button'));},80);say('Count them, or add them up?');}
function cntBegin(){
  $('cntDots').innerHTML=Array.from({length:CNT.rounds},()=>'<i></i>').join('');cntNext();}
function cntQuestion(){const k=CNT.kind;if(CNT.add&&CNT.ab){const[a,b]=CNT.ab,w=n=>n===1?k:PLURAL[k];return`What is ${a} plus ${b}?`;}return k?`How many ${PLURAL[k]} do you see?`:'How many animals do you see?';}
function cntNext(){if(CNT.round>=CNT.rounds){cntFinish();return;}if(CNT.add){cntNextAdd();return;}
  const r=CNT.round,kinds=Object.keys(PLURAL);CNT.first=true;CNT.wrong=0;CNT.busy=false;CNT.tapN=0;
  [...$('cntDots').children].forEach((d,i)=>d.classList.toggle('now',i===r));
  let list=[];
  if(r===3||r===6||r===9){CNT.kind=null;const n=Math.floor(rnd(3,r<6?7:r<9?9:11));CNT.ans=n;for(let i=0;i<n;i++)list.push({k:kinds[Math.floor(Math.random()*kinds.length)],t:true});}
  else{let k;do k=kinds[Math.floor(Math.random()*kinds.length)];while(k===CNT.lastKind);CNT.kind=k;CNT.lastKind=k;
    const max=r<3?4:r<6?6:8,n=1+Math.floor(Math.random()*max);CNT.ans=n;for(let i=0;i<n;i++)list.push({k,t:true});
    const others=kinds.filter(x=>x!==k).sort(()=>Math.random()-.5).slice(0,r<3?2:3),nd=Math.floor(rnd(r<3?2:3,r<3?4:7));
    for(let i=0;i<nd;i++)list.push({k:others[i%others.length],t:false});}
  // spread the animals over a grid in the grass, back rows a little smaller
  const F0=$('cntField'),tall=(F0.clientWidth/(F0.clientHeight||1))<1.5,COLS=tall?4:6,ROWS=tall?4:3,cells=[];for(let y=0;y<ROWS;y++)for(let x=0;x<COLS;x++)cells.push([x,y]);cells.sort(()=>Math.random()-.5);
  const F=$('cntField');F.innerHTML='';list.sort(()=>Math.random()-.5);const tallK=(F.clientWidth/(F.clientHeight||1))<1.5?1.5:1;
  list.forEach((a,i)=>{const [cx,cy]=cells[i];const sz=(9+cy*(tall?1.8:2.6)+rnd(-.6,.6))*tallK,px=clamp((cx+.5+rnd(-.22,.22))/COLS*100,sz/2+1,99-sz/2),py=(tall?42:48)+(cy+.6+rnd(-.12,.12))/ROWS*(tall?54:48);
    const b=document.createElement('button');b.className='cntA'+(Math.random()<.5?' flip':'');b.style.cssText=`left:${px}%;top:${py}%;width:${sz}%;z-index:${Math.round(py)};animation-delay:${i*.05}s`;
    b.innerHTML=`<img alt="" src="${kindImg(a.k)}">`;b.setAttribute('aria-label',a.k);b.dataset.k=a.k;if(a.t)b.dataset.t='1';b.tabIndex=-1;F.appendChild(b);});
  const pic=CNT.kind?`<img alt="" src="${kindImg(CNT.kind)}">`:`<span class="mix">${kinds.slice(0,3).map(k=>`<img alt="" src="${kindImg(k)}">`).join('')}</span>`;
  $('cntQ').innerHTML=CNT.kind?`How many ${pic} <b>${PLURAL[CNT.kind]}</b> do you see?`:`How many ${pic} <b>animals</b> do you see?`;
  const a=CNT.ans,opts=new Set([a]);const cand=[a-2,a-1,a+1,a+2,a+3].filter(v=>v>=1&&v<=12).sort(()=>Math.random()-.5);for(const v of cand){if(opts.size>=3)break;opts.add(v);}
  CNT.choices=[...opts].sort((x,y)=>x-y);
  const ch=$('cntChoices');ch.innerHTML=CNT.choices.map((v,i)=>`<button class="cntBtn" data-i="${i}" aria-label="${v}"><kbd>${i+1}</kbd><b>${v}</b><span class="pips">${Array.from({length:v},(_,j)=>`<i style="--c:${PIP_COLS[Math.floor(j/5)%5]}"></i>`).join('')}</span></button>`).join('');
  setTimeout(()=>{if(mode==='count')say(cntQuestion());},500);
  setTimeout(()=>{if(mode==='count'&&device==='pad')padFocus(ch.children[0]);},80);}
// adding rounds: two groups of the same animal with a big plus between them
function cntNextAdd(){const r=CNT.round,kinds=Object.keys(PLURAL);CNT.first=true;CNT.wrong=0;CNT.busy=false;CNT.tapN=0;
  [...$('cntDots').children].forEach((d,i)=>d.classList.toggle('now',i===r));
  let k;do k=kinds[Math.floor(Math.random()*kinds.length)];while(k===CNT.lastKind);CNT.kind=k;CNT.lastKind=k;
  const mx=r<3?2:r<6?3:5,a=1+Math.floor(Math.random()*mx),b=1+Math.floor(Math.random()*mx);CNT.ab=[a,b];CNT.ans=a+b;
  const F=$('cntField');F.innerHTML='<div class="cntPlus">+</div>';const tall=(F.clientWidth/(F.clientHeight||1))<1.5,tallK=tall?1.5:1;
  const place=(n,x0,x1)=>{const cols=n<=2?n:n<=4?2:3,rows=Math.ceil(n/cols);for(let i=0;i<n;i++){const cx=i%cols,cy=Math.floor(i/cols);
    const sz=(rows>1?11:13)*tallK,px=x0+(cx+.5)/cols*(x1-x0)+rnd(-1.5,1.5),py=(rows>1?52:62)+cy*(tall?20:24)+rnd(-2,2);
    const el=document.createElement('button');el.className='cntA'+(Math.random()<.5?' flip':'');el.style.cssText=`left:${px}%;top:${py}%;width:${sz}%;z-index:${Math.round(py)};animation-delay:${(F.children.length)*.06}s`;
    el.innerHTML=`<img alt="" src="${kindImg(k)}">`;el.setAttribute('aria-label',k);el.dataset.k=k;el.dataset.t='1';el.tabIndex=-1;F.appendChild(el);}};
  place(a,6,42);place(b,58,94);
  const img=`<img alt="" src="${kindImg(k)}">`;$('cntQ').innerHTML=`<b>${a}</b> ${img} + <b>${b}</b> ${img} = <b>?</b>`;
  const opts=new Set([CNT.ans]);const cand=[CNT.ans-2,CNT.ans-1,CNT.ans+1,CNT.ans+2].filter(v=>v>=2&&v<=10).sort(()=>Math.random()-.5);for(const v of cand){if(opts.size>=3)break;opts.add(v);}
  CNT.choices=[...opts].sort((x,y)=>x-y);
  $('cntChoices').innerHTML=CNT.choices.map((v,i)=>`<button class="cntBtn" data-i="${i}" aria-label="${v}"><kbd>${i+1}</kbd><b>${v}</b><span class="pips">${Array.from({length:v},(_,j)=>`<i style="--c:${PIP_COLS[Math.floor(j/5)%5]}"></i>`).join('')}</span></button>`).join('');
  setTimeout(()=>{if(mode==='count')say(cntQuestion());},500);
  setTimeout(()=>{if(mode==='count'&&device==='pad')padFocus($('cntChoices').children[0]);},80);}
function cntTap(b){if(mode!=='count'||state!=='play')return;audio();const f=FRIENDS.find(q=>q.kind===b.dataset.k);
  b.classList.remove('hop','no');void b.offsetWidth;
  const counts=!CNT.kind||b.dataset.t;
  if(!counts){b.classList.add('no');if(f)friendSound(f,.8,0);say(`That's a ${b.dataset.k}!`);return;}
  b.classList.add('hop');if(f)friendSound(f,.7,0);
  if(b.querySelector('.badge'))return;CNT.tapN++;const s=document.createElement('span');s.className='badge';s.textContent=CNT.tapN;b.appendChild(s);say(String(CNT.tapN));
  voice({type:'triangle',f0:400+CNT.tapN*60,f1:440+CNT.tapN*60,dur:.1,vol:.08});}
function cntCountAlong(done){// count every right animal, left to right, out loud
  const F=$('cntField');F.querySelectorAll('.badge').forEach(x=>x.remove());const ts=[...F.querySelectorAll('.cntA')].filter(b=>!CNT.kind||b.dataset.t).sort((a,b)=>parseFloat(a.style.left)-parseFloat(b.style.left));
  F.querySelectorAll('.cntA').forEach(b=>{if(CNT.kind&&!b.dataset.t)b.classList.add('dim');});
  ts.forEach((b,i)=>setTimeout(()=>{if(mode!=='count')return;b.classList.remove('hop');void b.offsetWidth;b.classList.add('hop');const s=document.createElement('span');s.className='badge auto';s.textContent=i+1;b.appendChild(s);
    say(NUM_WORDS[i+1]||String(i+1));voice({type:'triangle',f0:440+i*55,f1:480+i*55,dur:.12,vol:.09});if(i===ts.length-1&&done)setTimeout(done,650);},i*620));
  if(!ts.length&&done)done();}
function cntPick(i){if(CNT.busy||mode!=='count'||state!=='play')return;audio();const btn=$('cntChoices').children[i];if(!btn||btn.disabled)return;const v=CNT.choices[i];
  if(v===CNT.ans){CNT.busy=true;btn.classList.remove('hint');btn.classList.add('right');if(CNT.first)CNT.stars++;$('cntDots').children[CNT.round].className=CNT.first?'ok':'meh';
    [523,659,784].forEach((f,k)=>voice({type:'triangle',f0:f,f1:f,dur:.14,vol:.12,delay:k*.08}));
    const what=CNT.kind?(v===1?CNT.kind:PLURAL[CNT.kind]):(v===1?'animal':'animals');
    cntCountAlong(()=>{if(mode!=='count')return;say(`Yes! ${v} ${what}!`);$('cntQ').innerHTML=CNT.add&&CNT.ab?`Yes! <b>${CNT.ab[0]}</b> + <b>${CNT.ab[1]}</b> = <b>${v}</b> ${what}!`:`Yes! <b>${v}</b> ${what}!`;
      FRIENDS.length&&$('cntCow').animate([{transform:'none'},{transform:'translateY(-14px) rotate(-8deg)'},{transform:'none'}],{duration:500,iterations:2});
      CNT.round++;setTimeout(()=>{if(mode==='count')cntNext();},1900);});}
  else{CNT.first=false;CNT.wrong++;btn.classList.add('wrong');btn.disabled=true;voice({type:'square',f0:200,f1:150,dur:.18,vol:.08});
    if(CNT.wrong>=2){CNT.busy=true;say("Let's count together!");$('cntQ').innerHTML="Let's count together!";
      setTimeout(()=>cntCountAlong(()=>{CNT.busy=false;const ok=[...$('cntChoices').children].find((b,j)=>CNT.choices[j]===CNT.ans);if(ok)ok.classList.add('hint');}),900);}
    else{say(`Not quite! Tap the ${CNT.kind?PLURAL[CNT.kind]:'animals'} to count them.`);$('cntQ').innerHTML=`Not quite! Tap the ${CNT.kind?`<img alt="" src="${kindImg(CNT.kind)}"> <b>${PLURAL[CNT.kind]}</b>`:'<b>animals</b>'} to count them.`;}}}
function cntFinish(){const s=CNT.stars,stars=s>=9?3:s>=6?2:1;const b=best('moonie-count-best',s,false);SFX.win();
  showEnd(s>=9?'Counting superstar!':'Great counting!',stars,`Moonie counted animals all over the farm with you.`,`<div>First try<b>${s}/${CNT.rounds}</b></div>`+(b?`<div>Best<b>${b}/${CNT.rounds}</b></div>`:''));
  say(s>=9?'Counting superstar!':'Great counting!');$('end').hidden=false;(device==='pad'?padFocus($('againBtn')):$('againBtn').focus());}
(function cntInput(){$('cntChoices').addEventListener('click',e=>{const b=e.target.closest('button');if(b)cntPick(+b.dataset.i);});
  $('cntField').addEventListener('click',e=>{const b=e.target.closest('.cntA');if(b)cntTap(b);});
  $('cntFarm').onclick=backToFarm;$('cntHear').onclick=()=>{audio();say(CNT.picking?'Count them, or add them up?':cntQuestion());};})();

/* ================= BUBBLE POP (pond swipe game) ================= */
const BUB={c:null,x:null,W:0,H:0,dpr:1,objs:[],parts:[],texts:[],trail:[],score:0,hearts:3,time:75,t:0,spawnT:0,stroke:null,wand:{x:.5,y:.5,on:false,px:0,py:0},imgs:null,best:0,combo:0,ripples:[],over:false};
function bubResize(){if(!BUB.c)return;const dpr=Math.min(devicePixelRatio||1,2);BUB.dpr=dpr;BUB.W=innerWidth;BUB.H=innerHeight;BUB.c.width=BUB.W*dpr;BUB.c.height=BUB.H*dpr;BUB.x.setTransform(dpr,0,0,dpr,0,0);}
addEventListener('resize',()=>{if(mode==='bubble')bubResize();});
const bubWater=()=>BUB.H*.6,bubR=()=>Math.max(26,Math.min(BUB.W,BUB.H)*.065);
/* ================= MOO SAYS (Simon-style: the animals sing a pattern, copy it) ================= */
const SAYS={pads:[],seq:[],step:0,phase:'idle',t:0,hearts:3,round:0,bestLen:0,cast:[],els:[],wait:0,lit:-1,litT:0};
const SAYS_KEYS=[['Y','yp','xy'],['B','bp','xb'],['A','a','xa'],['X','xp','xx'],['LB','lb',''],['RB','rb','']];
function saysPickCast(n){const have=new Set(SAYS.cast.map(f=>f.name));const pool=FRIENDS.filter(f=>!have.has(f.name)).sort(()=>Math.random()-.5);while(SAYS.cast.length<n&&pool.length)SAYS.cast.push(pool.pop());}
function saysBuild(){const B=$('sBoard');B.querySelectorAll('.sPad').forEach(e=>e.remove());const n=SAYS.cast.length,imgs={};
  for(const q of(mem.imgs||[]))if(q.f)imgs[q.f.name]=q.src;
  SAYS.els=SAYS.cast.map((f,i)=>{const a=-Math.PI/2+i/n*TAU,el=document.createElement('button');el.className='sPad';el.dataset.i=i;
    el.style.left=(50+Math.cos(a)*36)+'%';el.style.top=(50+Math.sin(a)*36)+'%';el.style.setProperty('--c',f.color||'#ffd23f');
    const K=SAYS_KEYS[i];el.innerHTML=`<img alt="" src="${imgs[f.name]||COW_TOKEN}"><b>${f.name}</b><i class="sk kb">${i<4?['↑','→','↓','←'][i]:i+1}</i><i class="sk pd key ${K[2]}">${K[0]}</i>`;
    el.setAttribute('aria-label',f.name);el.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();audio();saysTap(i);});B.appendChild(el);return el;});
  $('saysUI').classList.toggle('pad',device==='pad');}
function startSays(){mode='says';state='play';SAYS.cast=[];saysPickCast(4);
  Object.assign(SAYS,{seq:[],step:0,phase:'wait',t:0,wait:1.1,hearts:3,round:0,bestLen:0,lit:-1});
  for(const id of['title','end','pause','intro'])$(id).hidden=true;
  try{chMakeSprites();if(CH.spr&&CH.spr.moonie)$('sMoonie').src=CH.spr.moonie.toDataURL();else $('sMoonie').src=COW_TOKEN;}catch(e){$('sMoonie').src=COW_TOKEN;}
  saysBuild();hud(['saysUI','pauseBtn']);saysHud();saysMsg('Moo says… listen!');saysNext(true);}
function saysHud(){$('sRound').textContent=Math.max(1,SAYS.seq.length);$('sHearts').innerHTML=[0,1,2].map(i=>`<span class="${i<SAYS.hearts?'':'off'}">♥</span>`).join('');
  const b=lsNum('moonie-says-best');$('sBest').textContent=b==null?'-':b;}
function saysMsg(t,cls=''){const m=$('sMsg');m.textContent=t;m.className=cls;}
function saysNext(first){if(!first)SAYS.round++;
  // a new friend joins the band at rounds 6 and 10
  const want=SAYS.seq.length>=9?6:SAYS.seq.length>=5?5:4;if(want>SAYS.cast.length){saysPickCast(want);saysBuild();saysMsg(SAYS.cast[SAYS.cast.length-1].name+' joined the band!','new');SAYS.wait=1.6;}
  if(!SAYS.seq.length)SAYS.seq.push(Math.floor(Math.random()*SAYS.cast.length));
  SAYS.seq.push(Math.floor(Math.random()*SAYS.cast.length));SAYS.phase='wait';SAYS.wait=Math.max(SAYS.wait,.9);SAYS.next='show';saysHud();}
function saysLight(i,dur){const el=SAYS.els[i];if(!el)return;el.classList.remove('lit');void el.offsetWidth;el.classList.add('lit');SAYS.lit=i;SAYS.litT=dur;friendSound(SAYS.cast[i],1,0);}
function saysTap(i){if(state!=='play'||mode!=='says'||SAYS.phase!=='input')return;saysLight(i,.35);
  if(i===SAYS.seq[SAYS.step]){SAYS.step++;if(SAYS.step>=SAYS.seq.length){SAYS.phase='wait';SAYS.next='good';SAYS.wait=.55;SAYS.bestLen=Math.max(SAYS.bestLen,SAYS.seq.length);if(SAYS.seq.length>=8)award('copycow');}}
  else{SAYS.phase='wait';SAYS.next='oops';SAYS.wait=.25;SAYS.miss=SAYS.seq[SAYS.step];const el=SAYS.els[i];el.classList.add('wrong');setTimeout(()=>el.classList.remove('wrong'),500);}}
function updateSays(dt,pad){const S=SAYS;
  if(S.litT>0){S.litT-=dt;if(S.litT<=0&&S.els[S.lit])S.els[S.lit].classList.remove('lit');}
  if(S.phase==='input'){const b=pad.btn||{};SAYS_KEYS.forEach((K,i)=>{if(b[K[1]]&&i<S.cast.length)saysTap(i);});}
  if(S.phase==='wait'){S.wait-=dt;if(S.wait>0)return;
    if(S.next==='show'){S.phase='show';S.step=0;S.t=0;saysMsg('Moo says… listen!');$('sMoonie').classList.add('talk');}
    else if(S.next==='good'){const n=S.seq.length;saysMsg(n>=8?'Amazing! '+n+' in a row!':['Great job!','You got it!','Moo-tastic!','Perfect!','Yes!'][Math.floor(Math.random()*5)],'good');SFX.moo();$('sMoonie').classList.add('hop');setTimeout(()=>$('sMoonie').classList.remove('hop'),700);S.wait=1.3;S.next='more';S.phase='wait';}
    else if(S.next==='more'){saysNext(false);}
    else if(S.next==='oops'){S.hearts--;saysHud();voice({type:'sine',f0:420,f1:160,dur:.45,vol:.14,vib:6});saysMsg(S.hearts>0?'Uh oh! It was '+S.cast[S.miss].name+'. Listen again!':'Uh oh!','bad');
      const el=S.els[S.miss];if(el){el.classList.add('hint');setTimeout(()=>el.classList.remove('hint'),1200);}
      if(S.hearts<=0){S.phase='over';setTimeout(saysEnd,1400);return;}S.wait=1.8;S.next='show';S.phase='wait';}
    return;}
  if(S.phase==='show'){const gap=Math.max(.42,.85-S.seq.length*.035);S.t-=dt;if(S.t>0)return;
    if(S.step<S.seq.length){saysLight(S.seq[S.step],gap*.7);S.step++;S.t=gap;}
    else{S.phase='input';S.step=0;$('sMoonie').classList.remove('talk');saysMsg('Your turn!','turn');}}}
function saysEnd(){if(mode!=='says')return;const n=SAYS.bestLen,b=best('moonie-says-best',n,false),stars=n>=10?3:n>=7?2:n>=4?1:0;
  SFX.win();showEnd(n>=8?'Copy Cow champion!':'Great listening!',stars,n?`You copied the animal band ${n} sounds in a row!`:'That was a tricky one. Listen carefully and try again!',
    `<div>Longest<b>${n}</b></div>`+(b!=null?`<div>Best<b>${b}</b></div>`:''));}
function saysCleanup(){SAYS.phase='idle';}
addEventListener('keydown',e=>{if(mode!=='says'||state!=='play')return;const map={ArrowUp:0,ArrowRight:1,ArrowDown:2,ArrowLeft:3,Digit1:0,Digit2:1,Digit3:2,Digit4:3,Digit5:4,Digit6:5,Numpad1:0,Numpad2:1,Numpad3:2,Numpad4:3,Numpad5:4,Numpad6:5};
  if(e.code in map&&map[e.code]<SAYS.cast.length){e.preventDefault();if(!e.repeat)saysTap(map[e.code]);}});
function startBubble(){mode='bubble';state='play';if(!BUB.c){BUB.c=$('bubC');BUB.x=BUB.c.getContext('2d');bubInput();}
  BUB.imgs=mem.imgs.filter(q=>q.f).map(q=>{const i=new Image();i.src=q.src;return{img:i,f:q.f};});
  Object.assign(BUB,{flies:[],screenSplats:[],rings:[],objs:[],parts:[],texts:[],trail:[],score:0,hearts:3,t:0,spawnT:.8,combo:0,ripples:[],over:false,stroke:null,finishIn:0,session:(BUB.session||0)+1});
  BUB.wand={x:.5,y:.45,on:false,px:.5,py:.45};hud(['bubUI','pauseBtn']);bubResize();bubHud();
  for(const id of['title','end','pause','intro'])$(id).hidden=true;
  toast(isTouch()?'<b>Swipe to pop the bubbles!</b>Don\'t touch the animals or the stinky poop!':'<b>Swipe with the mouse to pop the bubbles!</b>Don\'t touch the animals or the stinky poop!',3200);}
function bubLaunch(kind,f){const W=BUB.W,H=BUB.H,r=bubR()*(kind==='animal'?1.25:kind==='poop'?.85:kind==='gold'?1.05:rnd(.8,1.15));const x=rnd(W*.12,W*.88),y=H+r;
  const peak=rnd(H*.12,H*.42),g=H*1.15,vy=-Math.sqrt(2*g*(y-peak)),tFl=-vy/g,vx=((W*.5+rnd(-W*.25,W*.25))-x)/(tFl*2)*rnd(.5,1);
  BUB.objs.push({kind,f,x,y,vx,vy,g,r,rot:rnd(-1,1),vr:rnd(-2,2),hue:Math.floor(rnd(0,360)),dead:false,hit:false,wob:rnd(0,TAU)});
  if(kind==='animal'){voice({type:'triangle',f0:300,f1:600,dur:.15,vol:.08});}
  if(kind==='poop'){voice({type:'sine',f0:200,f1:120,dur:.2,vol:.08,vib:8});}}
function bubSpawn(){const lv=Math.min(1,BUB.t/60),n=1+Math.floor(Math.random()*(2+lv*3));
  const session=BUB.session;for(let i=0;i<n;i++)setTimeout(()=>{if(mode!=='bubble'||state!=='play'||BUB.over||BUB.finishIn||BUB.session!==session)return;
    const a=Math.random()<.14+lv*.14&&BUB.imgs.length;if(a){const o=BUB.imgs[Math.floor(Math.random()*BUB.imgs.length)];bubLaunch('animal',o);}else if(BUB.t>4&&Math.random()<.05+lv*.04)bubLaunch('poop');else bubLaunch(Math.random()<.08?'gold':'bubble');},i*rnd(120,260));
  BUB.spawnT=rnd(1.2,1.9)-lv*.5;}
function segHit(ax,ay,bx,by,cx,cy,r){const dx=bx-ax,dy=by-ay,l2=dx*dx+dy*dy;let t=l2?((cx-ax)*dx+(cy-ay)*dy)/l2:0;t=clamp(t,0,1);const px=ax+dx*t-cx,py=ay+dy*t-cy;return px*px+py*py<r*r;}
function bubSlice(ax,ay,bx,by){if(BUB.over||BUB.finishIn)return;for(const o of BUB.objs){if(BUB.finishIn)break;if(o.dead||o.hit)continue;if(!segHit(ax,ay,bx,by,o.x,o.y,o.r*(o.kind==='animal'?.8:o.kind==='poop'?.75:1)))continue;
    if(o.kind==='animal')bubBonk(o);else if(o.kind==='poop')bubPoop(o);else bubPop(o);}}
function bubPop(o){o.dead=true;const gold=o.kind==='gold',pts=gold?5:1;BUB.rings.push({x:o.x,y:o.y,r:o.r*.9,t:.4,c:gold?'#ffd23f':'#ffffff',a:rnd(0,1),g:o.r*3});BUB.score+=pts;if(BUB.stroke)BUB.stroke.n++;
  for(let i=0;i<(gold?18:10);i++){const a=rnd(0,TAU),s=rnd(80,260);BUB.parts.push({x:o.x,y:o.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,r:rnd(3,7),t:rnd(.35,.6),c:gold?'#ffd23f':`hsl(${o.hue},90%,80%)`});}
  BUB.texts.push({x:o.x,y:o.y,s:'+'+pts,t:.8,c:gold?'#ffd23f':'#fff'});
  if(gold)[880,1175,1568].forEach((f,i)=>voice({type:'triangle',f0:f,f1:f,dur:.12,vol:.1,delay:i*.06}));
  else voice({type:'sine',f0:rnd(500,800),f1:rnd(1300,1800),dur:.07,vol:.14});bubHud();}
function bubBonk(o){o.hit=true;o.vy=Math.min(o.vy,-BUB.H*.2);o.vr=12*(Math.random()<.5?-1:1);BUB.hearts--;friendSound(o.f.f,1,0);voice({type:'square',f0:180,f1:90,dur:.2,vol:.12});
  BUB.texts.push({x:o.x,y:o.y-o.r,s:`Oops! Not ${o.f.f.name}!`,t:1.4,c:'#ff6b6b',big:true});
  const w=$('bubUI');w.classList.remove('bonk');void w.offsetWidth;w.classList.add('bonk');bubHud();
  if(BUB.hearts<=0)BUB.finishIn=.7;}
// Screen-space cartoon splatter, independent of collision or pointer input.
function bubScreenSplat(o){
  const W=BUB.W,H=BUB.H,S=Math.min(W,H),px=clamp(o.x/W,.08,.92),py=clamp(o.y/H,.12,.80);
  const n=7,colors=['#75441f','#89542b','#613718'];
  for(let i=0;i<n;i++){
    const a=rnd(0,TAU),d=i===0?0:rnd(.10,.43),xx=clamp(px+Math.cos(a)*d,.045,.955),yy=clamp(py+Math.sin(a)*d,.12,.83);
    const points=Array.from({length:20},(_,j)=>({a:j/20*TAU,r:j%2===0?rnd(.94,1.34):rnd(.52,.90)}));
    const drops=Array.from({length:3},()=>({a:rnd(0,TAU),d:rnd(1.05,1.65),r:rnd(.08,.22)}));
    BUB.screenSplats.push({x:xx,y:yy,r:i===0?.12:rnd(.04,.086),rot:rnd(0,TAU),points,drops,age:0,life:3,drip:rnd(.25,.75),col:colors[i%3]});
  }
  // Bound the workload and occlusion even after repeated mistakes.
  if(BUB.screenSplats.length>14)BUB.screenSplats.splice(0,BUB.screenSplats.length-14);
}
function bubTickSplats(dt){for(const s of BUB.screenSplats)s.age+=dt;BUB.screenSplats=BUB.screenSplats.filter(s=>s.age<s.life);}
function bubDrawSplats(x,W,H){const S=Math.min(W,H);for(const s of BUB.screenSplats){
  const t=s.age,fade=clamp((s.life-t)/.8),scale=.60+.40*clamp(t/.10),r=S*s.r*scale;
  x.save();x.translate(s.x*W,s.y*H+S*.035*t*t/3);x.globalAlpha=.94*fade;
  x.fillStyle=s.col;x.strokeStyle='#4b2914';x.lineWidth=Math.max(1.5,r*.035);x.lineJoin='round';x.lineCap='round';
  x.beginPath();const p=s.points;for(let i=0;i<p.length;i++){const a=p[i].a+s.rot,b=p[(i+1)%p.length].a+s.rot;const ax=Math.cos(a)*p[i].r*r,ay=Math.sin(a)*p[i].r*r,bx=Math.cos(b)*p[(i+1)%p.length].r*r,by=Math.sin(b)*p[(i+1)%p.length].r*r;if(i===0)x.moveTo(ax,ay);x.quadraticCurveTo(ax,ay,(ax+bx)/2,(ay+by)/2);}x.closePath();x.fill();x.stroke();
  for(const d of s.drops){const a=d.a+s.rot;x.beginPath();x.ellipse(Math.cos(a)*d.d*r,Math.sin(a)*d.d*r,d.r*r,d.r*r*.7,a,0,TAU);x.fill();}
  // Rounded downward trails remain vertical even when the splat is rotated.
  x.strokeStyle=s.col;x.lineWidth=r*.23;x.beginPath();x.moveTo(-r*.16,r*.43);x.lineTo(-r*.16,r*(.78+s.drip*clamp(t/2.2)));x.stroke();
  x.lineWidth=r*.13;x.beginPath();x.moveTo(r*.35,r*.34);x.lineTo(r*.35,r*(.65+s.drip*.65*clamp(t/2.2)));x.stroke();
  x.fillStyle='rgba(255,208,148,.24)';x.beginPath();x.ellipse(-r*.26,-r*.25,r*.33,r*.11,-.5,0,TAU);x.fill();x.restore();
}}
function bubPoop(o){o.dead=true;o.hit=true;BUB.hearts--;
  for(let i=0;i<34;i++){const a=rnd(0,TAU),s=rnd(120,520);BUB.parts.push({x:o.x,y:o.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-120,r:rnd(4,11),t:rnd(.5,1),c:['#7a4a24','#5c3517','#9a6232','#4a2a12'][i%4]});}
  for(let i=0;i<9;i++)BUB.flies.push({x:o.x+rnd(-10,10),y:o.y+rnd(-10,10),cx:o.x,cy:o.y,a:rnd(0,TAU),r:rnd(20,70),sp:rnd(5,9)*(Math.random()<.5?-1:1),t:0,life:rnd(2.2,3.4),vx:rnd(-120,120),vy:rnd(-160,-60)});
  BUB.texts.push({x:o.x,y:o.y-o.r,s:'EWWW! Poop!',t:1.4,c:'#c98a4a',big:true});bubScreenSplat(o);if(BUB.flies.length>18)BUB.flies.splice(0,BUB.flies.length-18);
  noiseBurst(.35,.3,500);voice({type:'sine',f0:160,f1:50,dur:.35,vol:.2});for(let i=0;i<10;i++)voice({type:'sawtooth',f0:rnd(180,240),f1:rnd(200,260),dur:.08,vol:.03,filt:900,delay:.2+i*.09});
  const w=$('bubUI');w.classList.remove('bonk');void w.offsetWidth;w.classList.add('bonk');bubHud();if(BUB.hearts<=0)BUB.finishIn=3;}
function bubSplash(px,py,n){for(let i=0;i<n;i++){const a=-Math.PI/2+rnd(-.9,.9),s=rnd(120,320);BUB.parts.push({x:px+rnd(-10,10),y:py,vx:Math.cos(a)*s,vy:Math.sin(a)*s,r:rnd(3,7),t:rnd(.4,.7),c:'#d6f6ff'});}}
function bubHud(){$('bScore').textContent=BUB.score;$('bTime').textContent=fmt(Math.max(0,BUB.time-BUB.t));
  $('bHearts').innerHTML=Array.from({length:3},(_,i)=>`<i class="${i<BUB.hearts?'on':''}"></i>`).join('');}
function bubFinish(){if(BUB.over)return;BUB.over=true;const s=BUB.score,stars=s>=70?3:s>=35?2:s>=10?1:0;const b=best('moonie-bubble-best',s,false);SFX.win();
  showEnd(BUB.hearts<=0?'Oh no, too many bonks!':'Pop-tastic!',stars,BUB.hearts<=0?'Too many bonks and splats, so everyone called a time-out. Remember: pop the bubbles, not the animals or the poop!':`Moonie popped bubbles until the sun went down. The animals stayed safe${BUB.hearts===3?' the whole time':''}!`,
    `<div>Score<b>${s}</b></div><div>Hearts left<b>${Math.max(0,BUB.hearts)}</b></div>`+(b?`<div>Best<b>${b}</b></div>`:''));
  $('end').hidden=false;(device==='pad'?padFocus($('againBtn')):$('againBtn').focus());}
function bubInput(){const c=BUB.c;
  const down=(x,y,id)=>{if(BUB.over||BUB.finishIn)return;audio();BUB.stroke={id,lx:x,ly:y,n:0};BUB.trail.push({x,y,t:performance.now()});
    for(const o of BUB.objs){if(BUB.finishIn)break;if(o.dead||o.hit||o.kind==='animal')continue;if(Math.hypot(o.x-x,o.y-y)<o.r*(o.kind==='poop'?.8:1.05)){if(o.kind==='poop')bubPoop(o);else bubPop(o);}}}; // taps pop bubbles too (and squish poop!)
  const move=(x,y)=>{const s=BUB.stroke;if(!s)return;if(Math.hypot(x-s.lx,y-s.ly)>2){bubSlice(s.lx,s.ly,x,y);s.lx=x;s.ly=y;BUB.trail.push({x,y,t:performance.now()});}};
  const up=()=>{const s=BUB.stroke;if(s&&s.n>=3){const bonus=s.n;BUB.score+=bonus;BUB.texts.push({x:s.lx,y:s.ly-30,s:`${s.n} in a row! +${bonus}`,t:1.2,c:'#ffd23f',big:true});voice({type:'triangle',f0:660,f1:1320,dur:.25,vol:.12});bubHud();}BUB.stroke=null;};
  c.addEventListener('pointerdown',e=>{if(state!=='play')return;device=e.pointerType==='touch'?'touch':'kb';c.setPointerCapture(e.pointerId);down(e.clientX,e.clientY,e.pointerId);});
  c.addEventListener('pointermove',e=>{if(state==='play')move(e.clientX,e.clientY);});
  c.addEventListener('pointerup',up);c.addEventListener('pointercancel',up);}
function updateBubble(dt,pad){if(!BUB.x||BUB.over)return;if(BUB.finishIn>0){BUB.finishIn=Math.max(0,BUB.finishIn-dt);if(!BUB.finishIn){bubFinish();return;}}else{BUB.t+=dt;if(BUB.t>=BUB.time){bubHud();bubFinish();return;}}
  const W=BUB.W,H=BUB.H,wl=bubWater();
  // keyboard / controller wand
  let ix=(keys.ArrowRight||keys.KeyD?1:0)-(keys.ArrowLeft||keys.KeyA?1:0),iy=(keys.ArrowDown||keys.KeyS?1:0)-(keys.ArrowUp||keys.KeyW?1:0);
  if(pad){ix+=pad.x||0;iy+=pad.y||0;}const wd=BUB.wand,using=Math.abs(ix)+Math.abs(iy)>.15;
  if(using||wd.on){wd.on=true;wd.px=wd.x;wd.py=wd.y;wd.x=clamp(wd.x+ix*dt*.75,0,1);wd.y=clamp(wd.y+iy*dt*.75*W/H,0,1);
    const hold=keys.Space||(pad&&pad.btn&&pad.btn.aHeld);if(hold&&state==='play'&&!BUB.finishIn){if(!BUB.stroke)BUB.stroke={id:'wand',lx:wd.px*W,ly:wd.py*H,n:0};bubSlice(wd.px*W,wd.py*H,wd.x*W,wd.y*H);BUB.stroke.lx=wd.x*W;BUB.stroke.ly=wd.y*H;BUB.trail.push({x:wd.x*W,y:wd.y*H,t:performance.now()});}
    else if(BUB.stroke&&BUB.stroke.id==='wand'){const s=BUB.stroke;if(s.n>=3){BUB.score+=s.n;BUB.texts.push({x:s.lx,y:s.ly-30,s:`${s.n} in a row! +${s.n}`,t:1.2,c:'#ffd23f',big:true});bubHud();}BUB.stroke=null;}}
  if(!BUB.over&&!BUB.finishIn&&state==='play'){BUB.spawnT-=dt;if(BUB.spawnT<=0)bubSpawn();}
  for(const o of BUB.objs){o.vy+=o.g*dt;o.x+=o.vx*dt;o.y+=o.vy*dt;o.rot+=o.vr*dt;o.wob+=dt*4;
    const sy=shoreY(o.x);if(o.vy<0&&!o.emerged&&o.y<sy+o.r*.5){o.emerged=true;bubSplash(o.x,sy+H*.03,o.kind==='animal'?14:5);}
    if(o.vy>0&&o.y>wl+o.r*.3&&!o.splashed&&o.y<H+o.r){o.splashed=true;bubSplash(o.x,Math.max(sy+H*.03,Math.min(o.y,H-10)),o.kind==='animal'?16:4);BUB.ripples.push({x:o.x,y:wl+rnd(10,H*.3),r:4,t:1});if(!o.dead)noiseBurst(.12,.04,1800);}
    if(o.y>H+o.r*2&&o.vy>0)o.dead=true;}
  BUB.objs=BUB.objs.filter(o=>!(o.dead&&(o.kind!=='animal'||o.y>H+o.r*2)));
  for(const p of BUB.parts){p.t-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=500*dt;}BUB.parts=BUB.parts.filter(p=>p.t>0);
  for(const f of BUB.flies||[]){f.t+=dt;f.a+=f.sp*dt;f.cx+=f.vx*dt*.4;f.cy+=f.vy*dt*.3;if(f.t>f.life*.6){f.vx*=1+dt;f.vy-=dt*200;}f.x=f.cx+Math.cos(f.a)*f.r;f.y=f.cy+Math.sin(f.a*1.3)*f.r*.6;}
  if(BUB.flies)BUB.flies=BUB.flies.filter(f=>f.t<f.life);bubTickSplats(dt);
  for(const q of BUB.texts){q.t-=dt;q.y-=40*dt;}BUB.texts=BUB.texts.filter(q=>q.t>0);
  for(const r of BUB.rings){r.t-=dt;r.r+=dt*r.g;}BUB.rings=BUB.rings.filter(r=>r.t>0);
  for(const r of BUB.ripples){r.t-=dt*.8;r.r+=dt*60;}BUB.ripples=BUB.ripples.filter(r=>r.t>0);
  const now=performance.now();BUB.trail=BUB.trail.filter(p=>now-p.t<150);
  if(Math.floor(BUB.t*4)!==BUB.lastHud){BUB.lastHud=Math.floor(BUB.t*4);bubHud();}
  bubDraw();}
const shoreY=(px)=>{const W=BUB.W,H=BUB.H,u=px/W*2-1;return bubWater()-H*.012+H*.045*u*u;};
function bubBuildBg(){const W=BUB.W,H=BUB.H,dpr=BUB.dpr,wl=bubWater(),ink='#1d1510';const c=document.createElement('canvas');c.width=W*dpr;c.height=H*dpr;const x=c.getContext('2d');x.scale(dpr,dpr);x.lineJoin='round';x.lineCap='round';
  let g=x.createLinearGradient(0,0,0,wl);g.addColorStop(0,'#5fc3ff');g.addColorStop(.7,'#bfe9ff');g.addColorStop(1,'#e8f8ff');x.fillStyle=g;x.fillRect(0,0,W,H);
  const S=Math.min(W,H);
  // far hills
  const hill=(base,amp,freq,ph,col,lw)=>{x.beginPath();x.moveTo(0,H);for(let i=0;i<=60;i++){const px=i/60*W;x.lineTo(px,base-amp*(.5+.5*Math.sin(i/60*TAU*freq+ph)));}x.lineTo(W,H);x.closePath();x.fillStyle=col;x.fill();x.lineWidth=lw;x.strokeStyle=ink;x.stroke();};
  hill(wl-H*.13,H*.07,1.3,1.1,'#9fd88a',3);
  // trees on the far hill
  const tree=(tx,ty,s)=>{x.lineWidth=3;x.strokeStyle=ink;x.fillStyle='#7a5233';x.fillRect(tx-s*.08,ty-s*.35,s*.16,s*.4);x.strokeRect(tx-s*.08,ty-s*.35,s*.16,s*.4);
    for(const[a,b,r]of[[0,-.75,.42],[-.3,-.5,.32],[.3,-.5,.32]]){x.beginPath();x.arc(tx+a*s,ty+b*s,r*s,0,TAU);x.fillStyle='#4fae4a';x.fill();x.stroke();}
    x.fillStyle='rgba(255,255,255,.25)';x.beginPath();x.arc(tx-s*.12,ty-s*.9,s*.13,0,TAU);x.fill();};
  for(const[a,s]of[[.06,.9],[.33,.75],[.62,.85],[.93,1]])tree(a*W,wl-H*.1,S*.12*s);
  hill(wl-H*.04,H*.05,.9,3.2,'#7cc46a',3);
  // barn + silo on the near hill
  const bx=W*.2,by=wl-H*.035,bs=S*.15;x.lineWidth=3.5;x.strokeStyle=ink;
  x.fillStyle='#c9ced4';x.beginPath();x.rect(bx+bs*.62,by-bs*1.05,bs*.32,bs*1.05);x.fill();x.stroke();x.beginPath();x.arc(bx+bs*.78,by-bs*1.05,bs*.16,Math.PI,0);x.fillStyle='#8f6a3a';x.fill();x.stroke();
  x.fillStyle='#d6453d';x.beginPath();x.moveTo(bx-bs*.55,by);x.lineTo(bx-bs*.55,by-bs*.55);x.lineTo(bx,by-bs*.92);x.lineTo(bx+bs*.55,by-bs*.55);x.lineTo(bx+bs*.55,by);x.closePath();x.fill();x.stroke();
  x.fillStyle='#8c2a1f';x.beginPath();x.moveTo(bx-bs*.66,by-bs*.5);x.lineTo(bx,by-bs*1.0);x.lineTo(bx+bs*.66,by-bs*.5);x.lineTo(bx+bs*.6,by-bs*.44);x.lineTo(bx,by-bs*.9);x.lineTo(bx-bs*.6,by-bs*.44);x.closePath();x.fill();x.stroke();
  x.fillStyle='#a8302a';x.fillRect(bx-bs*.2,by-bs*.42,bs*.4,bs*.42);x.strokeStyle='#fff6df';x.lineWidth=3;x.strokeRect(bx-bs*.2,by-bs*.42,bs*.4,bs*.42);x.beginPath();x.moveTo(bx-bs*.2,by-bs*.42);x.lineTo(bx+bs*.2,by);x.moveTo(bx+bs*.2,by-bs*.42);x.lineTo(bx-bs*.2,by);x.stroke();
  x.fillStyle='#fff6df';x.strokeStyle=ink;x.lineWidth=2.5;x.beginPath();x.rect(bx-bs*.09,by-bs*.72,bs*.18,bs*.14);x.fill();x.stroke();
  // fence along the far bank
  x.strokeStyle=ink;x.lineWidth=2.5;const fy=wl-H*.012;for(let px=W*.42;px<W*.98;px+=S*.05){x.fillStyle='#fff6df';x.beginPath();x.rect(px,fy-S*.055,S*.018,S*.055);x.fill();x.stroke();}
  x.fillStyle='#fff6df';x.beginPath();x.rect(W*.42,fy-S*.045,W*.56,S*.012);x.fill();x.stroke();
  // grassy bank down to the water edge
  x.beginPath();x.moveTo(0,wl-H*.03);for(let i=0;i<=40;i++){const px=i/40*W;x.lineTo(px,wl-H*.03+Math.sin(i*1.7)*2);}x.lineTo(W,H);x.lineTo(0,H);x.closePath();x.fillStyle='#5aa83a';x.fill();
  x.fillStyle='#4f9a33';for(let i=0;i<120;i++){const px=Math.random()*W,py=wl-H*.025+Math.random()*H*.05;x.fillRect(px,py,2,5);}
  // sandy rim
  x.beginPath();for(let i=0;i<=60;i++){const px=i/60*W;i?x.lineTo(px,shoreY(px)-5):x.moveTo(px,shoreY(px)-5);}x.lineWidth=12;x.strokeStyle='#e8cf92';x.stroke();
  BUB.bg=c;
  BUB.clouds=BUB.clouds||Array.from({length:4},(_,i)=>({x:Math.random(),y:.06+Math.random()*.2,s:.7+Math.random()*.6,v:.006+Math.random()*.01}));
  BUB.pads=[[.12,.86,1],[.8,.93,1.25],[.56,.76,.8],[.93,.72,.7],[.32,.97,.9]].map(([a,b,s],i)=>({x:a,y:b,s,ph:i*1.7,flower:i===1||i===4}));}
function bubCloud(x,cx,cy,s){x.lineWidth=3;x.strokeStyle='#1d1510';const parts=[[0,0,1],[-.9,.15,.7],[.9,.15,.75],[-.4,-.4,.7],[.45,-.35,.6]];
  x.fillStyle='#ffffff';x.beginPath();for(const[a,b,r]of parts){x.moveTo(cx+a*s+r*s,cy+b*s);x.arc(cx+a*s,cy+b*s,r*s,0,TAU);}x.stroke();x.fill();
  x.fillStyle='rgba(180,220,255,.5)';x.beginPath();x.ellipse(cx,cy+s*.45,s*1.4,s*.22,0,0,TAU);x.fill();}
function bubBubble(x,o,t){const r=o.r,sx=1+Math.sin(o.wob)*.05,sy=1-Math.sin(o.wob)*.05;x.save();x.translate(o.x,o.y);x.scale(sx,sy);const gold=o.kind==='gold';
  const g=x.createRadialGradient(-r*.25,-r*.3,r*.05,0,0,r);
  if(gold){g.addColorStop(0,'rgba(255,255,235,.95)');g.addColorStop(.6,'rgba(255,214,70,.65)');g.addColorStop(1,'rgba(240,150,20,.9)');}
  else{g.addColorStop(0,'rgba(255,255,255,.5)');g.addColorStop(.55,`hsla(${o.hue},100%,92%,.16)`);g.addColorStop(.85,`hsla(${o.hue+40},100%,78%,.32)`);g.addColorStop(1,`hsla(${o.hue+90},100%,70%,.7)`);}
  x.fillStyle=g;x.beginPath();x.arc(0,0,r,0,TAU);x.fill();
  if(x.createConicGradient&&!gold){const cg=x.createConicGradient(o.wob*.4+o.hue,0,0);for(let i=0;i<=6;i++)cg.addColorStop(i/6,`hsla(${o.hue+i*60},100%,72%,.85)`);x.strokeStyle=cg;x.lineWidth=r*.13;x.beginPath();x.arc(0,0,r*.92,0,TAU);x.stroke();}
  x.lineWidth=2.5;x.strokeStyle=gold?'#9a6a10':'rgba(29,21,16,.55)';x.beginPath();x.arc(0,0,r,0,TAU);x.stroke();
  x.strokeStyle='rgba(255,255,255,.95)';x.lineWidth=r*.12;x.lineCap='round';x.beginPath();x.arc(0,0,r*.68,Math.PI*1.08,Math.PI*1.42);x.stroke();
  x.fillStyle='rgba(255,255,255,.95)';x.beginPath();x.arc(-r*.12,-r*.66,r*.06,0,TAU);x.fill();x.beginPath();x.arc(r*.45,r*.42,r*.07,0,TAU);x.fill();
  if(gold){drawStar(x,0,r*.04,r*.48,'#ffd23f');const tw=.5+.5*Math.sin(t*8+o.hue);x.globalAlpha=tw;drawStar(x,r*.7,-r*.7,r*.18,'#fff');x.globalAlpha=1;}
  x.restore();}
function bubFly(x,fx,fy,ph){const wg=Math.abs(Math.sin(ph))*5+2;x.fillStyle='rgba(255,255,255,.8)';x.strokeStyle='#1d1510';x.lineWidth=1;
  x.beginPath();x.ellipse(fx-3,fy-4,wg*.6,wg,-.5,0,TAU);x.ellipse(fx+3,fy-4,wg*.6,wg,.5,0,TAU);x.fill();x.stroke();x.fillStyle='#1d1510';x.beginPath();x.arc(fx,fy,3.5,0,TAU);x.fill();}
function bubPoopDraw(x,o,t){const r=o.r,ink='#1d1510';x.save();x.translate(o.x,o.y);x.rotate(Math.sin(o.wob)*.18);x.lineWidth=4;x.strokeStyle=ink;
  const tier=(cy,w,hh,c)=>{x.fillStyle=c;x.beginPath();x.ellipse(0,cy,w,hh,0,0,TAU);x.fill();x.stroke();};
  tier(r*.45,r*.95,r*.38,'#7a4a24');tier(r*.02,r*.72,r*.32,'#8a5530');tier(-r*.36,r*.48,r*.26,'#9a6232');
  x.fillStyle='#9a6232';x.beginPath();x.moveTo(-r*.18,-r*.55);x.quadraticCurveTo(r*.05,-r*.95,r*.12,-r*.72);x.quadraticCurveTo(r*.2,-r*.55,0,-r*.5);x.closePath();x.fill();x.stroke();
  x.fillStyle='rgba(255,255,255,.35)';x.beginPath();x.ellipse(-r*.4,r*.32,r*.2,r*.08,-.3,0,TAU);x.fill();
  // grumpy little face so kids know it's not a bubble
  x.fillStyle='#fff';for(const s of[-1,1]){x.beginPath();x.arc(s*r*.26,r*.02,r*.13,0,TAU);x.fill();x.stroke();}x.fillStyle=ink;for(const s of[-1,1]){x.beginPath();x.arc(s*r*.26,r*.05,r*.06,0,TAU);x.fill();}
  x.beginPath();x.arc(0,r*.42,r*.14,Math.PI*1.1,Math.PI*1.9);x.stroke();
  // stink lines
  x.strokeStyle='rgba(120,160,60,.8)';x.lineWidth=3;for(const s of[-1,1]){x.beginPath();x.moveTo(s*r*.6,-r*.5);x.quadraticCurveTo(s*r*.8,-r*.8+Math.sin(t*6)*4,s*r*.62,-r*1.1);x.stroke();}
  x.restore();for(let i=0;i<2;i++){const a=t*7+i*Math.PI+o.wob;bubFly(x,o.x+Math.cos(a)*r*1.1,o.y-r*.6+Math.sin(a*1.4)*r*.35,t*45+i);}}
function bubDraw(){const x=BUB.x,W=BUB.W,H=BUB.H,wl=bubWater(),t=performance.now()/1000,ink='#1d1510';
  if(!BUB.bg||BUB.bgW!==W||BUB.bgH!==H){bubBuildBg();BUB.bgW=W;BUB.bgH=H;}
  x.drawImage(BUB.bg,0,0,W,H);
  const S=Math.min(W,H);
  // sun with turning rays
  const sx=W*.86,sy=H*.13,sr=S*.06;x.save();x.translate(sx,sy);x.rotate(t*.2);x.strokeStyle='#ffd23f';x.lineWidth=5;x.lineCap='round';for(let i=0;i<12;i++){x.rotate(TAU/12);x.beginPath();x.moveTo(sr*1.25,0);x.lineTo(sr*1.6,0);x.stroke();}x.restore();
  x.beginPath();x.arc(sx,sy,sr,0,TAU);x.fillStyle='#ffe066';x.fill();x.lineWidth=3;x.strokeStyle=ink;x.stroke();x.fillStyle=ink;for(const s of[-1,1]){x.beginPath();x.arc(sx+s*sr*.32,sy-sr*.1,sr*.09,0,TAU);x.fill();}
  x.beginPath();x.arc(sx,sy+sr*.05,sr*.42,.3,Math.PI-.3);x.stroke();
  for(const c of BUB.clouds){c.x+=c.v/60;if(c.x>1.2)c.x=-.2;bubCloud(x,c.x*W,c.y*H,S*.05*c.s);}
  // pond water (clipped to the shoreline)
  x.save();x.beginPath();for(let i=0;i<=60;i++){const px=i/60*W;i?x.lineTo(px,shoreY(px)):x.moveTo(px,shoreY(px));}x.lineTo(W,H);x.lineTo(0,H);x.closePath();x.clip();
  let g=x.createLinearGradient(0,wl,0,H);g.addColorStop(0,'#7fdcf5');g.addColorStop(.35,'#3fb3e0');g.addColorStop(1,'#1f6fae');x.fillStyle=g;x.fillRect(0,wl-H*.05,W,H);
  x.strokeStyle='rgba(255,255,255,.45)';x.lineWidth=3;x.lineCap='round';
  for(let i=0;i<14;i++){const yy=wl+H*.04+(i/14)*(H-wl),len=W*(.04+((i*37)%5)*.012),px=((i*0.37+t*.02*(1+i%3))%1)*W*1.2-W*.1;x.beginPath();x.moveTo(px,yy);x.quadraticCurveTo(px+len/2,yy-4+Math.sin(t*2+i)*2,px+len,yy);x.stroke();}
  for(const r of BUB.ripples){x.strokeStyle=`rgba(255,255,255,${r.t*.8})`;x.lineWidth=3;x.beginPath();x.ellipse(r.x,r.y,r.r,r.r*.32,0,0,TAU);x.stroke();x.beginPath();x.ellipse(r.x,r.y,r.r*.6,r.r*.2,0,0,TAU);x.stroke();}
  x.restore();
  // lily pads (bobbing) and flowers
  x.lineWidth=3;x.strokeStyle=ink;for(const p of BUB.pads){const px=p.x*W,py=p.y*H+Math.sin(t*1.5+p.ph)*2,r=p.s*S*.065;
    x.fillStyle='#3f8f3a';x.beginPath();x.ellipse(px,py+3,r,r*.42,0,0,TAU);x.fill();
    x.fillStyle='#5fb84d';x.beginPath();x.moveTo(px,py);x.ellipse(px,py,r,r*.4,0,.35,TAU-.1);x.closePath();x.fill();x.stroke();
    x.strokeStyle='rgba(29,21,16,.35)';x.lineWidth=1.5;x.beginPath();x.moveTo(px,py);x.lineTo(px-r*.7,py-r*.15);x.moveTo(px,py);x.lineTo(px+r*.3,py+r*.3);x.stroke();x.strokeStyle=ink;x.lineWidth=3;
    if(p.flower){for(let i=0;i<6;i++){const a=i/6*TAU;x.fillStyle='#ffb3d6';x.beginPath();x.ellipse(px+Math.cos(a)*r*.18,py-r*.18+Math.sin(a)*r*.08,r*.16,r*.08,a,0,TAU);x.fill();x.stroke();}
      x.fillStyle='#ffd23f';x.beginPath();x.arc(px,py-r*.18,r*.08,0,TAU);x.fill();x.stroke();}}
  // cattails swaying at the sides
  for(const[px,s]of[[.015,1],[.045,.8],[.075,.65],[.955,.75],[.985,1.05]]){const sw=Math.sin(t*1.3+px*20)*7,bx=px*W,top=H*(1-.4*s);
    x.strokeStyle='#3f7a2a';x.lineWidth=6;x.beginPath();x.moveTo(bx,H);x.quadraticCurveTo(bx+5,H-(H-top)*.5,bx+sw,top);x.stroke();
    x.strokeStyle='#5aa83a';x.lineWidth=5;x.beginPath();x.moveTo(bx,H);x.quadraticCurveTo(bx-18,H-(H-top)*.4,bx-26+sw*.5,top+H*.08);x.stroke();
    x.fillStyle='#7a4a24';x.strokeStyle=ink;x.lineWidth=2.5;x.beginPath();x.ellipse(bx+sw,top-S*.025,S*.012,S*.035,sw*.01,0,TAU);x.fill();x.stroke();}
  // bubbles + jumping animals
  for(const o of BUB.objs){if(o.dead&&o.kind!=='animal')continue;
    if(o.kind==='animal'){const im=o.f.img;x.save();x.translate(o.x,o.y);x.rotate(o.hit?o.rot:Math.sin(o.wob)*.15);
      if(im.complete&&im.naturalWidth)x.drawImage(im,-o.r*1.15,-o.r*1.05,o.r*2.3,o.r*2.3*im.naturalHeight/im.naturalWidth);else{x.fillStyle=o.f.f.color;x.beginPath();x.arc(0,0,o.r,0,TAU);x.fill();}
      x.restore();if(o.hit){for(let i=0;i<3;i++){const a=t*6+i*2.1;drawStar(x,o.x+Math.cos(a)*o.r*.8,o.y-o.r*.9+Math.sin(a)*o.r*.2,o.r*.18,'#ffd23f');}}continue;}
    if(o.kind==='poop'){if(o.dead)continue;bubPoopDraw(x,o,t);continue;}
    bubBubble(x,o,t);}
  for(const f of BUB.flies||[])bubFly(x,f.x,f.y,t*40+f.a);
  for(const r of BUB.rings||[]){x.strokeStyle=r.c;x.globalAlpha=Math.max(0,r.t*2.5);x.lineWidth=4*r.t*2.5+1;x.beginPath();x.arc(r.x,r.y,r.r,0,TAU);x.stroke();
    for(let i=0;i<8;i++){const a=i/8*TAU+r.a;x.beginPath();x.moveTo(r.x+Math.cos(a)*r.r*1.1,r.y+Math.sin(a)*r.r*1.1);x.lineTo(r.x+Math.cos(a)*r.r*1.35,r.y+Math.sin(a)*r.r*1.35);x.stroke();}}x.globalAlpha=1;
  for(const p of BUB.parts){x.globalAlpha=Math.min(1,p.t*3);x.fillStyle=p.c;x.beginPath();x.arc(p.x,p.y,p.r,0,TAU);x.fill();if(p.r>4){x.fillStyle='rgba(255,255,255,.7)';x.beginPath();x.arc(p.x-p.r*.3,p.y-p.r*.3,p.r*.3,0,TAU);x.fill();}}x.globalAlpha=1;
  bubDrawSplats(x,W,H);
  // rainbow swipe trail (thin at the tail, thick at the finger)
  const tr=BUB.trail;if(tr.length>1){x.lineCap='round';for(let i=1;i<tr.length;i++){const k=i/tr.length,a=tr[i-1],b=tr[i];
      x.strokeStyle='rgba(255,255,255,.5)';x.lineWidth=4+k*18;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke();
      x.strokeStyle=`hsl(${(t*300+i*25)%360},100%,70%)`;x.lineWidth=2+k*8;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke();}}
  if(BUB.wand.on){const wx=BUB.wand.x*W,wy=BUB.wand.y*H;x.strokeStyle=ink;x.lineWidth=7;x.beginPath();x.moveTo(wx+20,wy+34);x.lineTo(wx,wy);x.stroke();x.strokeStyle='#ff7fc0';x.lineWidth=3;x.stroke();drawStar(x,wx,wy,17,'#ffd23f');}
  x.textAlign='center';x.textBaseline='middle';for(const q of BUB.texts){if(q.t0==null){q.t0=q.t;q.rot=rnd(-.15,.15);}const age=q.t0-q.t,k=Math.min(1,q.t*2),pop=age<.12?.5+age/.12*.75:1.25-Math.min(.25,(age-.12)*.5);x.globalAlpha=k;x.save();x.translate(q.x,q.y);x.scale(pop,pop);x.rotate(q.rot||0);
    x.font=`${q.big?30:24}px "Lilita One",sans-serif`;x.lineWidth=6;x.strokeStyle=ink;x.strokeText(q.s,0,0);x.fillStyle=q.c;x.fillText(q.s,0,0);x.restore();}x.globalAlpha=1;}

/* ================= POOP PATROL (secret outhouse game) ================= */
const OUTHOUSE={x:19.7,z:17.5};
const POOP={list:[],carry:0,max:10,score:0,spawnT:0,time:120,delivered:0,trips:0,root:new THREE.Group(),stack:new THREE.Group(),found:false};
try{POOP.found=localStorage.getItem('moonie-poop')==='1';}catch(e){}
farmRoot.add(POOP.root);farmRoot.add(POOP.stack);POOP.root.visible=POOP.stack.visible=false;
const poopTpl=(()=>{const g=new THREE.Group();const c=0x7a4a24;
  for(const[r,y]of[[.24,.09],[.18,.2],[.12,.3]]){const m=new THREE.Mesh(sphG,M(c));m.scale.set(r,r*.62,r);m.position.y=y;g.add(m);}
  const tip=new THREE.Mesh(new THREE.ConeGeometry(.06,.13,10),M(c));tip.position.set(.02,.4,0);tip.rotation.z=-.5;g.add(tip);
  for(const s of[-1,1]){const e=new THREE.Mesh(sphG,M(0xffffff));e.scale.set(.045,.055,.03);e.position.set(s*.065,.22,.16);g.add(e);
    const p=new THREE.Mesh(sphG,M(0x221a14));p.scale.set(.022,.028,.02);p.position.set(s*.065,.215,.185);g.add(p);}
  addOutlines(g,0,.004);return g;})();
const POOP_RING=(()=>{const r=new THREE.Mesh(new THREE.RingGeometry(1.4,1.8,40),new THREE.MeshBasicMaterial({color:0x8a5a2a,transparent:true,opacity:.75,depthWrite:false}));
  r.rotation.x=-Math.PI/2;r.position.set(OUTHOUSE.x,.06,OUTHOUSE.z);r.visible=false;farmRoot.add(r);return r;})();
function dropPoop(x,z,f){if(POOP.list.length>=24)return;const g=poopTpl.clone();const p=new THREE.Vector3(x,0,z);resolve(p,.2);g.position.copy(p);g.rotation.y=rnd(-.6,.6);g.scale.setScalar(.01);
  const flies=[];for(let i=0;i<2;i++){const fl=new THREE.Mesh(sphG,M(0x111111));fl.scale.setScalar(.035);g.add(fl);flies.push(fl);}
  POOP.root.add(g);POOP.list.push({g,t:0,flies,ph:rnd(0,TAU)});
  const dist=Math.hypot(x-moonie.pos.x,z-moonie.pos.z),v=clamp(1.2-dist/18,.15,1);
  voice({type:'sine',f0:240,f1:60,dur:.25,vol:.2*v});noiseBurst(.14,.14*v,450);if(f)f.hop=1;}
function stackRender(){const s=POOP.stack,a=POOP.items||(POOP.items=[]);while(a.length>POOP.carry)s.remove(a.pop());
  while(a.length<POOP.carry){const i=a.length;let r=0,k=i;while(k>r){k-=r+1;r++;}const g=poopTpl.clone();g.scale.setScalar(.66);g.userData.px=(k-r/2)*.4;g.position.set(g.userData.px,r*.3,0);g.rotation.y=Math.PI+rnd(-.3,.3);s.add(g);a.push(g);}}
function poopFloat(txt){const el=document.createElement('div');el.className='ppop';el.textContent=txt;document.body.appendChild(el);setTimeout(()=>el.remove(),950);}
function startPoop(){setLevel('farm');mode='poop';state='play';timeLeft=POOP.time;Object.assign(POOP,{score:0,carry:0,spawnT:.8,delivered:0,trips:0});
  if(!POOP.found){POOP.found=true;try{localStorage.setItem('moonie-poop','1');}catch(e){}showSecretChip();}
  POOP.list.forEach(p=>POOP.root.remove(p.g));POOP.list.length=0;stackRender();POOP.root.visible=POOP.stack.visible=true;POOP_RING.visible=true;
  resetFriendsTo('roam');placeFriendsRoaming(true);resetMoonie(OUTHOUSE.x-2.5,OUTHOUSE.z-3,Math.PI);camYaw=.25;camDist=11;
  hud(['pauseBtn','poopHud','poopTimer']);touchUI();
  for(const id of['title','end','pause','intro'])$(id).hidden=true;canvas.focus();
  toast('<b>Pee-yew!</b>Scoop up the poop and carry it to the outhouse!',3200);}
function updatePoop(dt,t){
  timeLeft-=dt;if(timeLeft<=0){timeLeft=0;finishPoop();return;}
  POOP.spawnT-=dt;if(POOP.spawnT<=0){POOP.spawnT=rnd(.8,1.6)*(POOP.list.length>14?1.7:1);const fs=FRIENDS.filter(f=>f.obj.visible&&!f.knock);const f=fs[Math.floor(Math.random()*fs.length)];
    if(f){const o=f.obj,back=f.size===3?.9:f.size===2?.6:.35;dropPoop(o.position.x-Math.sin(o.rotation.y)*back,o.position.z-Math.cos(o.rotation.y)*back,f);}}
  const m=moonie;
  for(let i=POOP.list.length-1;i>=0;i--){const p=POOP.list[i];p.t+=dt;p.g.scale.setScalar(p.t<.3?Math.max(.01,easeBack(p.t/.3)):1);
    p.flies.forEach((fl,k)=>{const a=t*6+p.ph+k*Math.PI;fl.position.set(Math.cos(a)*.35,.55+Math.sin(t*9+k)*.08,Math.sin(a)*.35);});
    if(p.t>.3&&POOP.carry<POOP.max&&m.y<.8&&Math.hypot(p.g.position.x-m.pos.x,p.g.position.z-m.pos.z)<.9){POOP.root.remove(p.g);POOP.list.splice(i,1);POOP.carry++;stackRender();
      voice({type:'sine',f0:420,f1:820,dur:.1,vol:.13});noiseBurst(.08,.1,1600);
      if(POOP.carry===POOP.max)toast('<b>Arms full!</b>Take it to the outhouse!',1500);}}
  POOP.stack.position.set(m.pos.x,m.y+2.15+Math.sin(t*6)*.05,m.pos.z);POOP.stack.rotation.y=m.yaw;
  (POOP.items||[]).forEach((c,k)=>{c.position.x=c.userData.px+Math.sin(t*4+c.position.y*3)*.03*(1+c.position.y*2);});
  POOP_RING.material.opacity=.45+.3*Math.sin(t*5);POOP_RING.scale.setScalar(POOP.carry?1+.08*Math.sin(t*6):1);
  if(POOP.carry&&Math.hypot(m.pos.x-OUTHOUSE.x,m.pos.z-OUTHOUSE.z)<2.1){const n=POOP.carry,bonus=n>=POOP.max?3:0;POOP.score+=n+bonus;POOP.delivered+=n;POOP.trips++;POOP.carry=0;stackRender();
    noiseBurst(.9,.2,700);voice({type:'sine',f0:900,f1:120,dur:.8,vol:.14,vib:5});voice({type:'triangle',f0:523,f1:784,dur:.2,vol:.1,delay:.75});
    poopFloat(`+${n+bonus}${bonus?' Full load!':''}`);moonie.happy=1;}
  $('pScoreP').textContent=POOP.score;$('pCarry').textContent=`${POOP.carry}/${POOP.max}`;poopClock();}
function poopClock(){const k=timeLeft/POOP.time;$('ptTime').textContent=fmt(Math.ceil(timeLeft));$('ptArc').setAttribute('stroke-dasharray',`${(81.7*k).toFixed(1)} 81.7`);$('ptArc').setAttribute('stroke',k>.5?'#3fa34d':k>.2?'#f5b800':'#d6453d');$('poopTimer').classList.toggle('low',timeLeft<=15);}
function finishPoop(){const s=POOP.score,stars=s>=55?3:s>=28?2:s>=10?1:0;const b=best('moonie-poop-best',s,false);SFX.win();
  showEnd(s>=55?'Poop champion!':'Time\'s up! Pee-yew!',stars,`Moonie carried ${POOP.delivered} poop${POOP.delivered===1?'':'s'} to the outhouse in ${POOP.trips} trip${POOP.trips===1?'':'s'}. The farm smells ${s>=20?'so much better':'a little better'}!`,
    `<div>Score<b>${s}</b></div><div>Poops scooped<b>${POOP.delivered}</b></div><div>Still on the ground<b>${POOP.list.length}</b></div>`+(b?`<div>Best<b>${b}</b></div>`:''));
  $('end').hidden=false;(device==='pad'?padFocus($('againBtn')):$('againBtn').focus());}
function poopCleanup(){POOP.root.visible=POOP.stack.visible=false;POOP_RING.visible=false;POOP.carry=0;stackRender();}

/* ================= GAMES MENU (pick any barn activity from anywhere on the farm) ================= */
let gameImgs=null;
/* ---------- name + high-score signs beside each game ---------- */
function lsNum(k){try{const v=parseFloat(localStorage.getItem(k));return isNaN(v)?null:v;}catch(e){return null;}}
const SCORE_INFO={
  says:()=>{const v=lsNum('moonie-says-best');return v==null?null:{big:String(v),small:'in a row'};},
  snap:()=>{const v=lsNum('moonie-snap-best');return v==null?null:{big:String(v),small:'photo score'};},
  hide:()=>{const v=lsNum('moonie-best-farm');return v==null?null:{big:fmt(v),small:'fastest time'};},
  count:()=>{const v=lsNum('moonie-count-best');return v==null?null:{big:`${v}/10`,small:'right first try'};},
  paint:()=>{const v=lsNum('moonie-paint-best');return v==null?null:{big:String(v),small:'points'};},
  memory:()=>{const L=[['E','easy'],['M','medium'],['H','hard']].map(([a,k])=>[a,lsNum('moonie-memory-best-'+k)]).filter(x=>x[1]!=null);
    if(!L.length){const old=lsNum('moonie-memory-best');return old==null?null:{big:String(old),small:'fewest moves'};}return{big:L.map(([a,v])=>`${a} ${v}`).join('  '),small:'fewest moves',tight:L.length>1};},
  letters:()=>{const v=lsNum('moonie-abc-best');return v==null?null:{big:`${v}/10`,small:'right first try'};},
  bubble:()=>{const v=lsNum('moonie-bubble-best');return v==null?null:{big:String(v),small:'points'};},
  chomp:()=>{const v=lsNum('moonie-chomp-best');return v==null?null:{big:String(v),small:'points'};}};
function drawTrophy(x,cx,cy,s,col){x.save();x.translate(cx,cy);x.scale(s,s);x.lineWidth=5;x.strokeStyle='#2b2118';x.lineJoin='round';
  x.fillStyle=col;x.beginPath();x.moveTo(-26,-30);x.lineTo(26,-30);x.quadraticCurveTo(26,8,0,14);x.quadraticCurveTo(-26,8,-26,-30);x.fill();x.stroke();
  for(const sd of[-1,1]){x.beginPath();x.arc(sd*27,-16,11,sd<0?Math.PI*.5:-Math.PI*.5,sd<0?Math.PI*1.5:Math.PI*.5,false);x.stroke();}
  x.fillRect(-5,14,10,12);x.strokeRect(-5,14,10,12);x.beginPath();x.rect(-18,26,36,9);x.fill();x.stroke();
  x.fillStyle='rgba(255,255,255,.6)';x.beginPath();x.ellipse(-11,-18,4,9,-.3,0,TAU);x.fill();x.restore();}
const BOARDS={};
// every game gets a little wooden sign beside its ring: its name, plus the high score for games that keep one
function buildBoards(){STATIONS.forEach(st=>{const c=document.createElement('canvas');c.width=512;c.height=300;const t=new THREE.CanvasTexture(c);t.anisotropy=4;
    const side=st.id==='mixer'?-1:1;const sg=new THREE.Group();sg.position.set(1.3*side,0,st.front*.75);sg.rotation.y=-.35*side;st.g.add(sg);
    for(const q of[-1,1]){const p=B(.08,1.55,.08,0x6b4a2e,q*.5,.78,-.02,sg);p.userData.noPaint=true;}
    const m=new THREE.Mesh(new THREE.PlaneGeometry(1.25,.73),toonMat({map:t}));m.position.set(0,1.32,.03);m.userData.noOutline=true;m.userData.noPaint=true;sg.add(m);
    const bk=B(1.3,.78,.04,0x6b4a2e,0,1.32,0,sg);bk.userData.noPaint=true;
    BOARDS[st.id]={c,t,label:st.label,css:ACT_PROPS[st.id].css};});refreshBoards();}
// the two screens by the trophy shelf take turns showing each game's high score
function drawScoreScreens(){if(!TROPHY.screens)return;const ids=Object.keys(SCORE_INFO).filter(id=>STATIONS.some(s=>s.id===id));if(!ids.length)return;
  const step=TROPHY.scrStep||0;
  TROPHY.screens.forEach(S=>{const id=ids[(step*2+S.half)%ids.length],x=S.c.getContext('2d'),st=STATIONS.find(s=>s.id===id),info=SCORE_INFO[id](),css=ACT_PROPS[id].css;
    const g=x.createLinearGradient(0,0,0,400);g.addColorStop(0,'#16324a');g.addColorStop(1,'#0b1a2a');x.fillStyle=g;x.fillRect(0,0,512,400);
    x.fillStyle=css;x.fillRect(0,0,512,96);x.globalAlpha=.08;x.fillStyle='#fff';for(let y=0;y<400;y+=6)x.fillRect(0,y,512,2);x.globalAlpha=1;
    x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';let fs=56;x.font=`${fs}px "Lilita One",sans-serif`;while(x.measureText(st.label).width>470&&fs>30){fs-=4;x.font=`${fs}px "Lilita One",sans-serif`;}
    x.lineWidth=8;x.strokeStyle='#2b2118';x.strokeText(st.label,256,50);x.fillStyle='#fff6df';x.fillText(st.label,256,50);
    x.font='900 26px Inter,Arial,sans-serif';x.fillStyle='#ffd23f';x.fillText('HIGH SCORE',256,136);
    x.font=`${info&&info.tight?76:104}px "Lilita One",sans-serif`;x.fillStyle=info?'#7dffa0':'#5a7890';x.fillText(info?info.big:'\u2014',256,232);
    x.font='700 26px Inter,Arial,sans-serif';x.fillStyle='#9fc3e0';x.fillText(info?info.small:'Nobody yet! Go set one!',256,318);
    for(let k=0;k<ids.length;k++){x.fillStyle=ids[k]===id?'#ffd23f':'#3a5670';x.beginPath();x.arc(256+(k-(ids.length-1)/2)*22,368,6,0,TAU);x.fill();}
    S.t.needsUpdate=true;});}
function scoreScreenTick(dt){if(level!=='farm'||!TROPHY.screens)return;TROPHY.scrT=(TROPHY.scrT||4)-dt;if(TROPHY.scrT<=0){TROPHY.scrT=4;TROPHY.scrStep=(TROPHY.scrStep||0)+1;drawScoreScreens();}}
function refreshBoards(){drawScoreScreens();for(const id in BOARDS){const {c,t,label,css}=BOARDS[id],x=c.getContext('2d'),info=SCORE_INFO[id]?SCORE_INFO[id]():undefined;
  x.clearRect(0,0,512,300);x.fillStyle='#2b2118';rrect(x,0,0,512,300,26);x.fill();const g=x.createLinearGradient(0,0,0,300);g.addColorStop(0,'#c48a4f');g.addColorStop(1,'#9a6232');x.fillStyle=g;rrect(x,8,8,496,284,20);x.fill();
  x.fillStyle=css;rrect(x,20,20,472,100,16);x.fill();x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';
  let fs=64;x.font=`${fs}px "Lilita One",sans-serif`;while(x.measureText(label).width>440&&fs>34){fs-=4;x.font=`${fs}px "Lilita One",sans-serif`;}
  x.lineWidth=9;x.strokeStyle='#2b2118';x.strokeText(label,256,72);x.fillStyle='#fff6df';x.fillText(label,256,72);
  if(info===undefined){x.font='800 30px Inter,Arial,sans-serif';x.fillStyle='#fff6df';x.fillText('Step on the ring to play!',256,208);}
  else{drawTrophy(x,80,210,1.25,info?'#ffd23f':'#d9cbb0');
    if(info){x.font='900 24px Inter,Arial,sans-serif';x.fillStyle='#fff6df';x.fillText('HIGH SCORE',300,150);
      x.font=`${info.tight?52:70}px "Lilita One",sans-serif`;x.lineWidth=10;x.strokeStyle='#2b2118';x.strokeText(info.big,300,205);x.fillStyle='#ffd23f';x.fillText(info.big,300,205);
      x.font='800 22px Inter,Arial,sans-serif';x.fillStyle='#fff6df';x.fillText(info.small,300,262);}
    else{x.font='900 24px Inter,Arial,sans-serif';x.fillStyle='#fff6df';x.fillText('HIGH SCORE',300,160);x.font='40px "Lilita One",sans-serif';x.lineWidth=8;x.strokeStyle='#2b2118';x.strokeText('Play to set one!',305,220);x.fillStyle='#fff6df';x.fillText('Play to set one!',305,220);}}
  t.needsUpdate=true;}}
buildBoards();try{document.fonts&&document.fonts.ready.then(refreshBoards);}catch(e){}
function openGames(){if(state!=='play'||mode!=='hub'||level!=='farm')return;audio();state='menu';
  if(!gameImgs){gameImgs={};STATIONS.forEach(s=>{try{gameImgs[s.id]=s.paper.material.map.image.toDataURL('image/jpeg',.82);}catch(e){gameImgs[s.id]='';}});}
  const g=$('gamesGrid');g.innerHTML=STATIONS.map(s=>`<button class="gcard" data-id="${s.id}"><img alt="" src="${gameImgs[s.id]}"><span>${s.label}</span></button>`).join('');
  v8Cards(g);const cards=Array.from(g.children),added=cards.splice(-3);added.forEach((card,i)=>g.insertBefore(card,cards[(i+1)*4]||null));g.scrollTop=0;$('games').hidden=false;hud([]);moonie.vel.set(0,0,0);clickPath=null;voice({type:'triangle',f0:520,f1:780,dur:.12,vol:.1});
  setTimeout(()=>{const b=g.children[0];if(b){device==='pad'?padFocus(b):b.focus();}},40);}
function closeGames(){$('games').hidden=true;$('trophies').hidden=true;state='play';hud(['hubHint','pauseBtn']);touchUI();canvas.focus();}
$('gamesGrid').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;audio();if(b.dataset.v8){v8Open(b.dataset.v8);return;}$('games').hidden=true;state='play';openIntro(b.dataset.id);});
$('gamesClose').onclick=closeGames;$('gamesTrophy').onclick=()=>{closeGames();openTrophies();};$('trophyClose').onclick=closeGames;
$('gamesBtn').addEventListener('click',e=>{e.stopPropagation();openGames();});$('gamesBtn').addEventListener('pointerdown',e=>e.stopPropagation());

const keys={};let device='kb',mode='hub';
const act={jump:false,search:false,moo:false};
let camYaw=0,camDist=12,camManualT=0,clickPath=null,camTilt=.72;
addEventListener('keydown',e=>{if(e.repeat&&!(mode==='memory'&&e.code.startsWith('Arrow')))return;keys[e.code]=true;device='kb';
  if(state==='menu'){if(e.code==='Escape'||e.code==='KeyG'){e.preventDefault();closeGames();}return;}
  if(state==='play'&&mode==='hub'&&e.code==='KeyG'){openGames();return;}
  const uiMode=mode==='ttt'||mode==='mixer'||mode==='color'||mode==='letters'||mode==='count';
  if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Backspace'].includes(e.code)&&state==='play'&&!(uiMode&&e.code==='Space'))e.preventDefault();
  if(state==='play'){
    if(mode==='race'){const m=e.code.match(/^(?:Digit|Numpad)(\d)$/);if(m)raceDigit(m[1]);else if(e.code==='Backspace'){race.typed=race.typed.slice(0,-1);raceUI();}}
    else if(mode==='memory'&&mem.picking){const dv={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[e.code];if(dv){e.preventDefault();spatialNav($('memPick'),dv[0],dv[1]);}const m=e.code.match(/^(?:Digit|Numpad)([1-3])$/);if(m)memPickLevel(['easy','medium','hard'][+m[1]-1]);}
    else if(mode==='memory'){const C=mem.cols||4,mv={ArrowLeft:-1,ArrowRight:1,ArrowUp:-C,ArrowDown:C}[e.code];if(mv){device='pad';memFocus(mem.focus+mv);}if(e.code==='Enter'||e.code==='Space'||e.code==='KeyE'){flipCard(mem.focus);}}
    else if(mode==='chomp'){}
    else if(mode==='count'){const dv={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[e.code];if(dv)spatialNav($('cntChoices'),dv[0],dv[1]);const m=e.code.match(/^(?:Digit|Numpad)([1-3])$/);if(m)cntPick(+m[1]-1);}
    else if(mode==='letters'){const dv={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[e.code];if(dv)spatialNav($('abcUI'),dv[0],dv[1]);
      const m=e.code.match(/^(?:Digit|Numpad)([1-3])$/);if(m)abcPick(+m[1]-1);
      else{const k=e.code.match(/^Key([A-Z])$/);if(k&&ABC.kind==='letter'){const i=ABC.choices.indexOf(k[1]);if(i>=0)abcPick(i);}}}
    else if(mode==='ttt'||mode==='mixer'){const dv={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[e.code];const ws=mode==='mixer'&&document.activeElement&&document.activeElement.closest&&document.activeElement.closest('.wheel');
      if(dv&&ws&&dv[0]&&document.activeElement.classList.contains('wStage')){e.preventDefault();wheelStep(ws.id==='mHeads'?'head':'body',dv[0]);}else if(dv)spatialNav($(mode==='ttt'?'tttUI':'mixUI'),dv[0],dv[1]);
      if(mode==='ttt'&&!$('tttGame').hidden&&e.code==='KeyN')tttNew();
