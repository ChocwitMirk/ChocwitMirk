    kpS(L,()=>L.ellipse(650,388,95,85,0,0,TAU));kpS(L,()=>L.ellipse(668,418,44,32,0,0,TAU));kpS(L,()=>L.ellipse(655,418,7,11,0,0,TAU));kpS(L,()=>L.ellipse(682,418,7,11,0,0,TAU));
    dot(615,365,9);dot(702,365,9);L.beginPath();L.moveTo(628,455);L.quadraticCurveTo(665,472,702,455);L.stroke();
