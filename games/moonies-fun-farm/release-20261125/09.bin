const VNUM=['zero','one','two','three','four','five','six','seven','eight','nine','ten'];
const vNorm=s=>s.toLowerCase().replace(/ñ/g,'n').replace(/[^a-z0-9 ]/g,'').replace(/\s+/g,' ').trim();
function voiceLoad(){if(VOICE.bytes||VOICE.loading){voiceDecode();return;}VOICE.loading=true;
  try{VOICE.bytes=b64bytes(embeddedText('voice.txt'));VOICE.alphabetBytes=b64bytes(embeddedText('alphabet-v5.mp3'));voiceDecode();}catch(e){console.warn('Recorded audio could not be loaded',e);VOICE.loading=false;}}
function voiceDecode(){if(VOICE.buf||!VOICE.bytes||!AC||VOICE.decoding||VOICE.decodeFailed)return;VOICE.decoding=true;
  const decode=bytes=>new Promise((ok,no)=>{try{const p=AC.decodeAudioData(bytes.buffer.slice(0),ok,no);if(p&&p.catch)p.catch(no);}catch(e){no(e);}});
  Promise.allSettled([decode(VOICE.bytes),decode(VOICE.alphabetBytes)]).then(([old,extra])=>{VOICE.decoding=false;
    if(old.status==='fulfilled')VOICE.buf=old.value;else VOICE.decodeFailed=true;
    if(extra.status==='fulfilled')VOICE.alphabetBuf=extra.value;else console.warn('New alphabet audio could not be decoded',extra.reason);
    if(VOICE.pending){const p=VOICE.pending;VOICE.pending=null;if(VOICE.buf)voicePlay(p);}
  });}
function voiceStop(){VOICE.src.forEach(s=>{try{s.stop();}catch(e){}});VOICE.src=[];}
function voicePlay(parts){if(!VOICE.buf){VOICE.pending=parts;voiceDecode();return true;}voiceStop();
  if(!VOICE.gain){VOICE.gain=AC.createGain();VOICE.gain.gain.value=1.6;VOICE.gain.connect(AC.destination);}
  let at=AC.currentTime+.02;for(const[st,du]of parts){const extra=st>=600,buf=extra?VOICE.alphabetBuf:VOICE.buf,from=extra?st-600:st;if(!buf||from>=buf.duration)continue;const duration=Math.min(du,buf.duration-from);if(duration<=0)continue;const s=AC.createBufferSource();s.buffer=buf;s.connect(VOICE.gain);s.start(at,from,duration);VOICE.src.push(s);at+=Math.max(0,duration-.04);}return true;}
// which recorded clip(s) say this text? null = no recording, use the computer voice
function voiceFor(t){const M=VOICE.map,n=vNorm(t);if(M.text[n])return[M.text[n]];
  if(/^\d+$/.test(n)&&VNUM[+n]&&M.text[VNUM[+n]])return[M.text[VNUM[+n]]];
  const y=n.match(/^yes (\d+) ([a-z]+)$/);if(y){const a=M.key.cnt_yes,b=M.key['cnt_num_'+y[1]],c=M.key['cnt_word_'+y[2]];if(a&&b&&c)return[a,b,c];}
  return null;}

// ---- Export the farm as a .glb that Blender can open (File > Import > glTF 2.0) ----
function loadScript(u){return new Promise((ok,no)=>{const e=document.createElement('script');e.src=u;e.onload=ok;e.onerror=()=>no(new Error('Could not load '+u));document.head.appendChild(e);});}
function zipOne(name,data){const u8=new Uint8Array(data),nm=new TextEncoder().encode(name);let c=~0;const T=zipOne.T||(zipOne.T=Array.from({length:256},(_,n)=>{let k=n;for(let i=0;i<8;i++)k=k&1?0xEDB88320^(k>>>1):k>>>1;return k>>>0;}));
  for(let i=0;i<u8.length;i++)c=T[(c^u8[i])&255]^(c>>>8);c=(~c)>>>0;
  const lh=new DataView(new ArrayBuffer(30));lh.setUint32(0,0x04034b50,true);lh.setUint16(4,20,true);lh.setUint32(14,c,true);lh.setUint32(18,u8.length,true);lh.setUint32(22,u8.length,true);lh.setUint16(26,nm.length,true);
  const ch=new DataView(new ArrayBuffer(46));ch.setUint32(0,0x02014b50,true);ch.setUint16(4,20,true);ch.setUint16(6,20,true);ch.setUint32(16,c,true);ch.setUint32(20,u8.length,true);ch.setUint32(24,u8.length,true);ch.setUint16(28,nm.length,true);
  const end=new DataView(new ArrayBuffer(22));end.setUint32(0,0x06054b50,true);end.setUint16(8,1,true);end.setUint16(10,1,true);end.setUint32(12,46+nm.length,true);end.setUint32(16,30+nm.length+u8.length,true);
  return new Blob([lh,nm,u8,ch,nm,end]);}
async function saveFarm(buf){let dl=null;try{if(window.claude&&window.claude.use)dl=await window.claude.use('downloads');}catch(e){}
  if(dl){try{await dl.save({filename:'moonies-farm.zip',data:zipOne('moonies-farm.glb',buf)});return'zip';}catch(e){if(e&&e.code==='declined')return null;toast('Could not save the file here ('+((e&&e.code)||'error')+'). Try the downloaded game file instead.',4000);return null;}}
  const url=URL.createObjectURL(new Blob([buf],{type:'model/gltf-binary'}));const a=document.createElement('a');a.href=url;a.download='moonies-farm.glb';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);return'glb';}
async function exportFarm(){const msg=t=>{try{toast(t,4000);}catch(e){}};
  if(level!=='farm'){msg('Go back to the farm first, then export.');return;}
  msg('<b>Packing up the farm…</b>This can take a few seconds.');
  try{if(!THREE.GLTFExporter)await loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/GLTFExporter.js');}catch(e){msg('Could not load the exporter (needs internet).');return;}
  const hidden=[],temp=[];
  scene.traverse(o=>{if(!o.visible)return;const skip=o.userData.isOutline||o.isPoints||o.isSprite||o.isLine||(o.isMesh&&(o.geometry===blobG||(o.material&&(o.material.isShaderMaterial||(o.material.transparent&&o.material.opacity<.05)))))||o===moonie.root;
    if(skip){o.visible=false;hidden.push(o);}});
  // glTF has no instancing in this exporter: turn each instanced mesh into plain copies that share one mesh
  const im=[];scene.traverse(o=>{if(o.isInstancedMesh&&o.visible)im.push(o);});
  const mtx=new THREE.Matrix4();
  for(const o of im){const g=new THREE.Group();g.name=(o.name||'instanced')+'_copies';g.position.copy(o.position);g.quaternion.copy(o.quaternion);g.scale.copy(o.scale);
    for(let i=0;i<o.count;i++){o.getMatrixAt(i,mtx);const m=new THREE.Mesh(o.geometry,o.material);mtx.decompose(m.position,m.quaternion,m.scale);if(m.scale.lengthSq()<1e-8)continue;g.add(m);}
    o.parent.add(g);temp.push(g);o.visible=false;hidden.push(o);}
  const root=scene;
  const done=buf=>{hidden.forEach(o=>o.visible=true);temp.forEach(g=>g.parent&&g.parent.remove(g));
    saveFarm(buf).then(how=>{if(how)msg(how==='zip'?'<b>Saved moonies-farm.zip</b>Unzip it, then open moonies-farm.glb in Blender with File › Import › glTF 2.0.':'<b>Saved moonies-farm.glb</b>Open it in Blender with File › Import › glTF 2.0.');});};
  try{new THREE.GLTFExporter().parse(root,done,{binary:true,onlyVisible:true,embedImages:true,maxTextureSize:2048});}
  catch(e){hidden.forEach(o=>o.visible=true);temp.forEach(g=>g.parent&&g.parent.remove(g));console.error(e);msg('Export failed: '+e.message);}}

// ---- grown-up layout helper: move a game to where Moonie is standing ----
let LAYOUT={};try{LAYOUT=JSON.parse(localStorage.getItem('moonie-layout')||'{}')||{};}catch(e){LAYOUT={};}
const LAY_HOME={};STATIONS.forEach(st=>{LAY_HOME[st.id]={x:st.g.position.x,z:st.g.position.z,ry:st.ry};});
function moveProp(st,x,z,ry){st.g.position.set(x,0,z);st.g.rotation.y=ry;st.ry=ry;st.x=x+Math.sin(ry)*st.front;st.z=z+Math.cos(ry)*st.front;st.ring.position.set(st.x,.05,st.z);if(st.col){st.col.x=x;st.col.z=z;}}
function laySave(){try{localStorage.setItem('moonie-layout',JSON.stringify(LAYOUT));}catch(e){}}
// Garden layout revision: apply the new default once, while retaining other custom game positions.
try{if(localStorage.getItem('moonie-garden-layout-rev')!=='2026-11-23-v3'){delete LAYOUT.letters;laySave();localStorage.setItem('moonie-garden-layout-rev','2026-11-23-v3');}}catch(e){}
STATIONS.forEach(st=>{const o=LAYOUT[st.id];if(o)moveProp(st,o.x,o.z,o.ry);});
function layOpen(){$('laySel').innerHTML=STATIONS.map(st=>`<option value="${st.id}">${st.label}</option>`).join('');
  $('layPos').textContent=level==='farm'?`Moonie is at x ${moonie.pos.x.toFixed(1)}, z ${moonie.pos.z.toFixed(1)}`:'Go to the farm first.';$('layMsg').textContent='';$('layout').hidden=false;}
function layReport(){const L=Object.entries(LAYOUT).map(([id,o])=>`${id}: x ${o.x.toFixed(1)}, z ${o.z.toFixed(1)}, turn ${o.ry.toFixed(2)}`);return L.length?'Moonie layout\n'+L.join('\n'):'Moonie layout: no games moved.';}

