    else if(mode==='paint'){const m=e.code.match(/^(?:Digit|Numpad)([1-6])$/);if(m)setPaintColor(+m[1]-1);if(e.code==='KeyQ')setPaintColor(paint.sel-1);if(e.code==='KeyE')setPaintColor(paint.sel+1);if(e.code==='Space')act.jump=true;}
    else{if(e.code==='Space')act.jump=true;if(e.code==='KeyE'||e.code==='Enter')act.search=true;if(e.code==='KeyQ')act.moo=true;}}
