// average normals of vertices that share a position (UV seams split them), so the cel bands and outline stay smooth like the other animals
function smoothNormals(g){const p=g.attributes.position,n=g.attributes.normal;if(!p||!n)return;const map=new Map(),key=i=>`${Math.round(p.getX(i)*1e4)},${Math.round(p.getY(i)*1e4)},${Math.round(p.getZ(i)*1e4)}`;
  for(let i=0;i<p.count;i++){const k=key(i);let s=map.get(k);if(!s){s=[0,0,0];map.set(k,s);}s[0]+=n.getX(i);s[1]+=n.getY(i);s[2]+=n.getZ(i);}
  for(let i=0;i<p.count;i++){const s=map.get(key(i)),l=Math.hypot(s[0],s[1],s[2])||1;n.setXYZ(i,s[0]/l,s[1]/l,s[2]/l);}n.needsUpdate=true;}
function loadMoonie(){
  return embeddedFile('moonie-model.txt').then(r=>{if(!r.ok)throw new Error('model '+r.status);return r.text();}).then(b64=>new Promise((res,rej)=>{
    // use plain <img> textures: some embedded previews block fetch() of blob: URLs, which ImageBitmapLoader needs
    const cib=window.createImageBitmap;try{window.createImageBitmap=undefined;}catch(e){}
    const buf=b64bytes(b64).buffer;
    const onLoad=gltf=>{
      const model=gltf.scene;const inner=new THREE.Group();inner.add(model);model.updateMatrixWorld(true);
      model.traverse(o=>{
        if(o.isBone){moonie.rig[o.name]=o;o.userData.rest=o.quaternion.clone();}
        if(o.isMesh){o.frustumCulled=false;o.castShadow=true;const map=o.material.map;if(map){map.encoding=THREE.LinearEncoding;map.anisotropy=4;map.needsUpdate=true;}
          if(o.isSkinnedMesh){smoothNormals(o.geometry);if(map){map.minFilter=THREE.LinearMipmapLinearFilter;map.anisotropy=8;}o.material=[map?moonieCelMat(map):toonMat({color:0xf6d6ac,skinning:true}),outlineMat(true,.0042)];const g=o.geometry,cnt=g.index?g.index.count:g.attributes.position.count;g.clearGroups();g.addGroup(0,cnt,0);g.addGroup(0,cnt,1);o.userData.noOutline=true;}
          else o.material=toonMat({map,side:THREE.DoubleSide});}});
      // eyelids for blinking, parented to the head bone (positions measured from her texture)
      const head=moonie.rig.Head;
      if(head&&moonie.useLids){const ws=new THREE.Vector3();head.getWorldScale(ws);const hq=new THREE.Quaternion();head.getWorldQuaternion(hq);hq.invert();moonie.lids=[];
        for(const[ex,ey,ez,col,tilt]of[[-.176,1.262,.282,0xf6d6ac,-.6],[.172,1.248,.276,0x3b2d29,.68]]){
          const pivot=new THREE.Group();pivot.position.copy(head.worldToLocal(new THREE.Vector3(ex,ey,ez)));
          pivot.quaternion.copy(hq).multiply(new THREE.Quaternion().setFromEuler(new THREE.Euler(-.2,tilt,0)));
          const lid=new THREE.Mesh(new THREE.SphereGeometry(1,18,12),toonMat({color:col}));lid.scale.set(.068/ws.x,.084/ws.y,.03/ws.z);
          lid.userData.noOutline=true;pivot.add(lid);pivot.visible=false;head.add(pivot);moonie.lids.push(pivot);}}
      const box=new THREE.Box3(),v=new THREE.Vector3();
      model.traverse(o=>{if(o.isSkinnedMesh){o.skeleton.update();const n=o.geometry.attributes.position.count;for(let i=0;i<n;i+=5){o.boneTransform(i,v);v.applyMatrix4(o.matrixWorld);box.expandByPoint(v);}}});
      const size=box.getSize(new THREE.Vector3()),c=box.getCenter(new THREE.Vector3());
      model.position.set(-c.x,-box.min.y,-c.z);const S=1.65/size.y;inner.scale.setScalar(S);inner.userData.s=S;
      
      moonie.root.add(inner);moonie.inner=inner;moonie.model=model;
      if(gltf.animations.length){const mx=moonie.mixer=new THREE.AnimationMixer(model);const A=moonie.clips={};
        for(const c of gltf.animations){const a=mx.clipAction(c);a.play();a.setEffectiveWeight(0);A[c.name]=a;}
        // standing pose: first frame of a calm clip (the rig's own rest pose is a T-pose)
        moonie.stand=A.Big_Wave_Hello||A.Victory_Fist_Pump;if(moonie.stand){moonie.stand.time=0;moonie.stand.timeScale=0;}
        moonie.walk=A.Walking;moonie.run=A.Running||gltf.animations[0]&&mx.clipAction(gltf.animations[0]);
        moonie.oneShots={cheer:A.Victory_Fist_Pump,dance:A.FunnyDancing_02};
        moonie.idleDances=['FunnyDancing_02','Gangnam_Groove','Arm_Circle_Shuffle','jumping_jacks','Big_Heart_Gesture','Happy_jump_f','Breakdance_1990'].map(n=>A[n]).filter(Boolean);
        moonie.winDances=['FunnyDancing_02','Happy_jump_f','Gangnam_Groove'].map(n=>A[n]).filter(Boolean);
        // a second copy of the wave clip (the first one is frozen on frame 0 as her standing pose)
        const wv=gltf.animations.find(c=>c.name==='Big_Wave_Hello');if(wv){moonie.waveA=mx.clipAction(wv.clone());moonie.waveA.play();moonie.waveA.setEffectiveWeight(0);}
        // the get-up clip drifts forward; shift it so it starts where the backwards flop ends and finishes back on her spot
        const su=A.Stand_Up4&&A.Stand_Up4.getClip().tracks.find(t=>t.name==='Hips.position');
        if(su){const v=su.values,n=v.length/3,z0=v[2],z1=v[(n-1)*3+2];for(let i=0;i<n;i++){const f=i/(n-1);v[i*3+2]+=lerp(-.17-z0,.06-z1,f);}}
        moonie.allActs=[...Object.values(A),moonie.waveA].filter(Boolean);}
      moonie.loaded=true;res();
    };
    // if a browser refuses her skin texture, load her without it rather than stopping the whole game
    try{new THREE.GLTFLoader().parse(buf,'',onLoad,err=>{console.warn('Moonie texture did not load, using plain colors',err);
      try{new THREE.GLTFLoader().parse(glbNoTextures(buf),'',onLoad,rej);}catch(e){rej(e);}});}finally{try{window.createImageBitmap=cib;}catch(e){}}}));
}
function glbNoTextures(buf){const dv=new DataView(buf),jl=dv.getUint32(12,true),js=JSON.parse(new TextDecoder().decode(new Uint8Array(buf,20,jl)));
  delete js.textures;delete js.images;delete js.samplers;(js.materials||[]).forEach(m=>{if(m.pbrMetallicRoughness){delete m.pbrMetallicRoughness.baseColorTexture;delete m.pbrMetallicRoughness.metallicRoughnessTexture;}delete m.emissiveTexture;delete m.normalTexture;delete m.occlusionTexture;});
  let jb=new TextEncoder().encode(JSON.stringify(js));const pad=(4-jb.length%4)%4;const jp=new Uint8Array(jb.length+pad);jp.set(jb);for(let i=0;i<pad;i++)jp[jb.length+i]=32;
  const rest=new Uint8Array(buf,20+jl),out=new Uint8Array(20+jp.length+rest.length),o=new DataView(out.buffer);
  out.set(new Uint8Array(buf,0,12));o.setUint32(8,out.length,true);o.setUint32(12,jp.length,true);o.setUint32(16,0x4E4F534A,true);out.set(jp,20);out.set(rest,20+jp.length);return out.buffer;}
function poseMoonie(dt){
  const m=moonie;m.t+=dt;
  const sp=Math.hypot(m.vel.x,m.vel.z);const walkK=clamp(sp/3.2),runK=clamp((sp-4.3)/3);const idle=1-walkK;
  // restore the clean animated pose (the mixer skips bones it thinks are unchanged, so offsets would pile up)
  for(const k in m.rig){const b=m.rig[k];b.quaternion.copy(b.userData.base||b.userData.rest);}
  if(m.mixer){
    const A=m.clips,K=1-Math.pow(.0004,dt);
    // idle dances: after 30s of standing still she starts dancing on her own; any movement stops it
    const still=sp<.15&&m.onGround&&!m.action&&!m.script&&!m.climb&&!(m.sit>0)&&state==='play';
    m.idleT=still?(m.idleT||0)+dt:0;
    if(m.idleT>30&&!m.idleDance&&m.idleDances.length){const L=m.idleDances.filter(a=>a.getClip().name!=='Breakdance_1990'||Math.random()<.04);const c=m.idleDance=(L.length?L:m.idleDances)[Math.floor(Math.random()*(L.length||m.idleDances.length))];c.reset();c.timeScale=1;c.setLoop(THREE.LoopRepeat,Math.max(1,Math.round(6/c.getClip().duration)));c.clampWhenFinished=true;}
    if(m.idleDance&&!still)m.idleDance=null;
    if(m.devClip&&sp>.15)m.devClip=null; // a clip tried from the dev tools stops as soon as she walks, so it can't hijack her walk
    if(m.idleDance&&m.idleDance.paused){m.idleT=24+Math.random()*4;m.idleDance=null;}
    // which full-body clip (if any) is taking over right now
    let over=null,key=null;
    if(m.devClip){over=m.devClip;key='dev:'+m.devClip.getClip().name;}
    else if(m.action==='trip'&&A.falling_down&&A.Stand_Up4){if(m.actT<.95){over=A.falling_down;key='tripFall';}else{over=A.Stand_Up4;key='tripUp';}}
    else if(m.action==='sad'&&A.falling_down){over=A.falling_down;key='sad';}
    else if(m.action==='cheer'&&A.Victory_Fist_Pump){over=A.Victory_Fist_Pump;key='cheer';}
    else if(m.action==='wave'&&m.waveA){over=m.waveA;key='wave';}
    else if(m.action==='dance'){if(m.overKey!=='dance')m.winClip=m.winDances[Math.floor(Math.random()*m.winDances.length)];over=m.winClip;key='dance';}
    else if(m.idleDance){over=m.idleDance;key='idle:'+m.idleDance.getClip().name;}
    if(key!==m.overKey){m.overKey=key;
      if(over&&key!=='tripUp'&&!key.startsWith('idle')){over.reset();over.timeScale=key==='wave'?1.5:key==='sad'?1.1:1;over.setLoop(key==='dance'||key.startsWith('dev:')?THREE.LoopRepeat:THREE.LoopOnce);over.clampWhenFinished=true;}
      if(key==='tripUp')over.reset();}
    // the trip is scrubbed by hand so the flop and the scramble back up fit the race's 1.75s stumble
    if(key==='tripFall'){over.timeScale=0;over.time=Math.min(1.7,.3+m.actT*1.5);}
    if(key==='tripUp'){over.timeScale=0;over.time=Math.min(over.getClip().duration,(m.actT-.95)*2.1);}
    // locomotion: walk/run/sprint share one stride phase so their feet stay in step while blending
    const fastK=clamp((sp-5.6)/1.4);
    // the RunFast clip pitches her ~60° forward, which looked bad, so every run speed uses the upright Running clip and just pumps the legs faster
    let wW=walkK*(1-runK),rW=walkK*runK,fW=0,sW=1-walkK,airW=0;
    m.phase=(m.phase||0)+dt*(sp>.15?lerp(sp/3.3,sp/3.9,runK)*(1-.12*fastK):0);
    // big drops (trampoline, seesaw, ledges): switch to her mid-air tumble
    m.airT=m.onGround?0:(m.airT||0)+dt;const fallK=!m.onGround&&A.Fall1?clamp((-m.vy-3.5)/3)*clamp((m.airT-.25)/.2):0;
    if(!m.onGround){wW=0;sW=0;fW=0;rW=1-fallK;airW=fallK;}
    if(m.script||m.climb){wW=rW=fW=airW=0;sW=1;}
    const P=m.phase%1;
    if(m.walk){m.walk.timeScale=0;m.walk.time=P*m.walk.getClip().duration;}
    if(m.run){m.run.timeScale=0;if(m.onGround)m.run.time=P*m.run.getClip().duration;}
    if(A.RunFast){A.RunFast.timeScale=0;A.RunFast.time=P*A.RunFast.getClip().duration;}
    if(A.Fall1&&airW>0&&A.Fall1.timeScale===0){A.Fall1.timeScale=1;A.Fall1.setLoop(THREE.LoopRepeat);}
    if(m.stand){m.stand.time=0;m.stand.timeScale=0;}
    // targets, then ease every clip's weight toward its target (weights always add up to 1, so she never pops into the T-pose)
    const T=m._wT||(m._wT=new Map());T.clear();const add=(a,w)=>{if(a&&w>0)T.set(a,(T.get(a)||0)+w);};
    if(over)add(over,1);else{add(m.stand,sW);add(m.walk,wW);add(m.run,rW);add(A.RunFast,fW);add(A.Fall1,airW);}
    for(const a of m.allActs){const tw=T.get(a)||0;a._mw=lerp(a._mw||0,tw,K);if(a._mw<1e-3&&tw===0)a._mw=0;a.setEffectiveWeight(a._mw);}
    m.mixer.update(dt);
  }
  for(const k in m.rig){const b=m.rig[k];(b.userData.base||(b.userData.base=new THREE.Quaternion())).copy(b.quaternion);}
  m.root.updateMatrixWorld(true);m.inner.getWorldQuaternion(_qr);_qr.invert();
  const br=Math.sin(m.t*1.9);
  let lean=br*.03*idle+.03*runK,headX=-br*.03*idle+Math.sin(m.t*.9)*.04*idle,headZ=Math.sin(m.t*.7)*.1*idle,armOut=br*.05*idle+.06*idle,armFwd=0;
  m.tailPh=(m.tailPh||0)+dt*(2.2+walkK*3.2+m.happy*4);let tail=Math.sin(m.tailPh)*(.28+walkK*.12+m.happy*.18);
  let bob=0;
  if(!m.onGround){armOut+=m.vy>0?.7:.45;headX-=.1;}
  if(m.action==='search'){const k=Math.sin(clamp(m.actT/.8)*Math.PI);lean+=.45*k;headX+=.35*k;armFwd-=.9*k;armOut+=.2*k;}
  if(m.action==='moo'){const k=Math.sin(clamp(m.actT/1.1)*Math.PI);headX-=.5*k;lean-=.15*k;armOut+=.45*k;armFwd-=.3*k;}
  if(m.action==='cheer'&&!m.overKey){const k=Math.sin(clamp(m.actT/1.4)*Math.PI);armOut+=1.6*k;armFwd-=.5*k;headX-=.25*k;bob=Math.abs(Math.sin(m.actT*9))*.22*k;}
  if(m.action==='dance'&&!m.overKey){armOut=1.3+Math.sin(m.t*8)*.4;armFwd=-.4;bob=Math.abs(Math.sin(m.t*8))*.16;headZ=Math.sin(m.t*8)*.2;tail=Math.sin(m.t*14)*.7;}
  if(m.action==='sad'&&!m.overKey){armOut=0;headX=.5;lean=.2;tail=Math.sin(m.t*1.2)*.15;}
  boneAdd('Spine',[['X',lean*.5]]);boneAdd('Spine02',[['X',lean*.5],['Z',0]]);
  boneAdd('Head',[['X',headX],['Z',headZ]]);
  boneAdd('LeftArm',[['Z',armOut],['X',armFwd]]);boneAdd('RightArm',[['Z',-armOut],['X',armFwd]]);
  boneAdd('Tail',[['Y',tail],['X',Math.sin(m.t*1.3)*.1]]);
  // blink
  m.blinkT=(m.blinkT??2)-dt;if(m.blinkT<=0){m.blink=0;m.blinkT=Math.random()<.2?.28:rnd(2.2,5.5);}
  if(m.blink!=null){m.blink+=dt;const bk=m.blink<.07?m.blink/.07:m.blink<.11?1:Math.max(0,1-(m.blink-.11)/.08);if(m.blink>.19)m.blink=null;
    if(m.lids)m.lids.forEach(l=>{l.visible=bk>.02;l.scale.set(1,Math.max(.05,bk),1);});}
  else if(m.lids)m.lids.forEach(l=>{l.visible=m.action==='sad';l.scale.set(1,1,1);});
  m.squash=lerp(m.squash,0,1-Math.pow(.001,dt));
  const S=m.inner.userData.s,sy=1-m.squash*.22+(!m.onGround?.05:0)+br*.016*idle,sx=1+br*.01*idle+m.squash*.08;
  // face-plant: tip forward from the feet, lie there a moment, scramble back up
  let fall=0;if(m.action==='trip'&&!m.overKey){const a=m.actT;fall=a<.28?Math.pow(a/.28,2)*1.42:a<1.25?1.42+Math.sin(a*18)*.02*(1.25-a):1.42*(1-clamp((a-1.25)/.45));
    const lying=clamp(fall/1.42);boneAdd('LeftArm',[['Z',.6*lying],['X',-1.6*lying]]);boneAdd('RightArm',[['Z',-.6*lying],['X',-1.6*lying]]);boneAdd('Head',[['X',-.5*lying]]);
    if(a>.28&&a<1.25&&Math.random()<dt*6)sprayBurst(tmp.set(m.pos.x,.5,m.pos.z+.9),_up,0xffe14d,2);}
  if(m.climb){const c=Math.sin(m.t*11);boneAdd('LeftArm',[['X',-2.4+c*.4]]);boneAdd('RightArm',[['X',-2.4-c*.4]]);boneAdd('LeftUpLeg',[['X',-.6-c*.5]]);boneAdd('RightUpLeg',[['X',-.6+c*.5]]);}
  if(m.sit>0){boneAdd('LeftUpLeg',[['X',-1.45*m.sit]]);boneAdd('RightUpLeg',[['X',-1.45*m.sit]]);boneAdd('LeftArm',[['Z',1.3*m.sit]]);boneAdd('RightArm',[['Z',-1.3*m.sit]]);boneAdd('Spine',[['X',-.25*m.sit]]);}
  m.inner.rotation.x=fall;
  // the Breakdance clip's hips sit ~1.13 model units too low (measured by skinning every frame), so lift her by that while it plays
  const bd=m.clips&&m.clips.Breakdance_1990,bdLift=bd?(bd._mw||0)*1.13*S*sy:0;
  m.inner.scale.set(S*sx,S*sy,S*sx);m.inner.position.y=bob+fall*.12+bdLift;
}

/* ================= RACE TRACK ================= */
const raceRoot=new THREE.Group();scene.add(raceRoot);raceRoot.visible=false;
const TRACK_LEN=90,LANES=[-3,-1,1,3];
(function buildTrack(){WORLD=raceRoot;
  const gg=new THREE.PlaneGeometry(260,260,60,60);gg.rotateX(-Math.PI/2);const cols=new Float32Array(gg.attributes.position.count*3);const c=new THREE.Color();
  for(let i=0;i<gg.attributes.position.count;i++){const x=gg.attributes.position.getX(i),z=gg.attributes.position.getZ(i);c.setHSL(.27+noise(x,z)*.03,.55,.45+noise(x*.7,z*.7)*.05+(Math.floor(z/8)%2?.02:0));cols.set([c.r,c.g,c.b],i*3);}
  gg.setAttribute('color',new THREE.BufferAttribute(cols,3));const gm=new THREE.Mesh(gg,toonMat({vertexColors:true}));gm.receiveShadow=true;gm.position.z=-45;raceRoot.add(gm);
  const tr=new THREE.Mesh(new THREE.PlaneGeometry(9.4,124),toonMat({color:0xc99a62}));tr.rotation.x=-Math.PI/2;tr.position.set(0,.02,-48);tr.receiveShadow=true;raceRoot.add(tr);
  for(const x of[-4,-2,0,2,4]){const l=new THREE.Mesh(new THREE.PlaneGeometry(.1,124),new THREE.MeshBasicMaterial({color:0xfff6df}));l.rotation.x=-Math.PI/2;l.position.set(x,.03,-48);raceRoot.add(l);}
  const sl=new THREE.Mesh(new THREE.PlaneGeometry(8,.35),new THREE.MeshBasicMaterial({color:0xffffff}));sl.rotation.x=-Math.PI/2;sl.position.set(0,.035,0);raceRoot.add(sl);
  for(let i=0;i<16;i++)for(let r=0;r<2;r++){const q=new THREE.Mesh(new THREE.PlaneGeometry(.5,.5),new THREE.MeshBasicMaterial({color:(i+r)%2?0x222222:0xffffff}));q.rotation.x=-Math.PI/2;q.position.set(-3.75+i*.5,.035,-TRACK_LEN-.25+r*.5);raceRoot.add(q);}
  // finish arch
  for(const s of[-1,1])mesh(cylG(.2,.24,4.6,12),0xfff6df,s*5,2.3,-TRACK_LEN,raceRoot);
  B(10.6,1.1,.4,0xc8432f,0,4.4,-TRACK_LEN,raceRoot);
  const fin=new THREE.Mesh(new THREE.PlaneGeometry(6,.9),toonMat({map:signTexture('FINISH','','#c8432f')}));fin.position.set(0,4.4,-TRACK_LEN+.22);fin.userData.noOutline=true;raceRoot.add(fin);
  const st=new THREE.Mesh(new THREE.PlaneGeometry(4,.8),toonMat({map:signTexture('START','','#3d7fd6')}));
  for(const s of[-1,1])mesh(cylG(.15,.18,3.2,10),0xfff6df,s*5,1.6,0,raceRoot);B(10.4,.8,.3,0x3d7fd6,0,3.1,0,raceRoot);st.position.set(0,3.1,.17);st.rotation.y=0;st.userData.noOutline=true;raceRoot.add(st);
  // fences + bunting + crowd props
  for(let z=4;z>-TRACK_LEN-14;z-=3)for(const s of[-1,1]){B(.22,1.1,.22,0xe8d9b8,s*5.6,.55,z,raceRoot);B(.12,.16,3,0xdccaa3,s*5.6,.85,z-1.5,raceRoot);
    const f=mesh(new THREE.ConeGeometry(.18,.34,3),[0xff4f8b,0x3db8ff,0xffd23f,0x7be05a][(Math.abs(z)/3|0)%4],s*5.6,1.35,z,raceRoot);f.rotation.x=Math.PI;}
  for(let z=0;z>-TRACK_LEN-10;z-=11){const s=(z/11)%2?1:-1;const b=bale(raceRoot,s*8,.7,z);b.rotation.y=.3;
    const t=group(-s*11,z-5,0,raceRoot);mesh(cylG(.3,.45,2.4,10),0x7a5233,0,1.2,0,t);ball(1.5,0x4fa244,0,3.3,0,t);ball(1.05,0x5db84d,.9,3,.4,t);ball(.95,0x3f8f3a,-.1,4.3,.1,t);}
  for(let i=0;i<14;i++){const h=mesh(ballG,[0x86b8d6,0x95c2dc,0x6fbf5a][i%3],(i%2?1:-1)*rnd(40,70),-2,-i*12+10,raceRoot,false);h.scale.set(rnd(14,22),rnd(8,16),rnd(14,22));}
  WORLD=scene;addOutlines(raceRoot,.09);
})();

/* ================= PAINTBALL ================= */
const paintRoot=new THREE.Group();scene.add(paintRoot);
const PAINT_COLS=[0xff4f8b,0x3db8ff,0xffd23f,0x7be05a,0xa66bff,0xff8a2a];const PAINT_NAMES=['pink','blue','yellow','green','purple','orange'];
// paint mixing: two colours that land on each other make a new one (blue + pink = purple)
const PCOL={pink:0xff4f8b,blue:0x3db8ff,yellow:0xffd23f,green:0x7be05a,purple:0xa66bff,orange:0xff8a2a,teal:0x2fc4b2,lime:0xc6e83a,magenta:0xd94fd6,coral:0xff7a6b,indigo:0x5a5ae0,gold:0xffb31a,brown:0x9a6a3a};
const MIXT={'blue+pink':'purple','pink+yellow':'orange','blue+yellow':'green','blue+green':'teal','green+yellow':'lime','pink+purple':'magenta','blue+purple':'indigo','orange+yellow':'gold','orange+pink':'coral'};
const colorName=c=>{for(const k in PCOL)if(PCOL[k]===c)return k;return 'paint';};
function mixPaint(a,b){if(a===b)return a;const na=colorName(a),nb=colorName(b);const key=[na,nb].sort().join('+');if(MIXT[key])return PCOL[MIXT[key]];
  return PCOL.brown;} // colours that don't make a nice new one turn muddy brown
const recipeOf=c=>{const n=colorName(c);for(const k in MIXT)if(MIXT[k]===n)return k.split('+').map(x=>PCOL[x]);return null;};
const capName=s=>s[0].toUpperCase()+s.slice(1);
const cssHex=c=>'#'+c.toString(16).padStart(6,'0');
const splatGeos=[0,1,2].map(k=>{const sh=new THREE.Shape();const n=22;for(let i=0;i<=n;i++){const a=i/n*TAU;const r=1+.18*Math.sin(a*3+k*2)+.12*Math.sin(a*5+k)+(i%4===0?.25:0);i?sh.lineTo(Math.cos(a)*r,Math.sin(a)*r):sh.moveTo(Math.cos(a)*r,Math.sin(a)*r);}return new THREE.ShapeGeometry(sh,2);});
const dropG=new THREE.CircleGeometry(1,12);
const splatMats={};const splatMat=c=>splatMats[c]||(splatMats[c]=toonMat({color:c,polygonOffset:true,polygonOffsetFactor:-4,polygonOffsetUnits:-4}));
const ballMats={};const ballMat=c=>ballMats[c]||(ballMats[c]=new THREE.MeshBasicMaterial({color:c}));
const pballG=new THREE.SphereGeometry(.08,10,8);
const gun=new THREE.Group();scene.add(cam);cam.add(gun);gun.visible=false;
(function buildGun(){B(.17,.2,.55,0x3d7fd6,0,0,0,gun);mesh(cylG(.05,.05,.45,12),0x2b2118,0,.03,-.45,gun).rotation.x=Math.PI/2;B(.1,.24,.12,0x2b2118,0,-.18,.12,gun).rotation.x=.25;
  gun.userData.hop=mesh(ballG,toonMat({color:0xff4f8b}),0,.2,-.05,gun);gun.userData.hop.scale.setScalar(.13);gun.position.set(.3,-.28,-.6);gun.traverse(o=>{if(o.isMesh){o.castShadow=false;o.renderOrder=5;}});})();
const paint={sel:0,goals:[],markers:[],things:0,friends:0,shots:0,cool:0,color:0,painted:new Set(),balls:[],splats:[],targets:[],fire:false,locked:false,pitch:0};
function paintTargets(){const list=[],animalMeshes=new Set();for(const f of FRIENDS)f.obj.traverse(o=>animalMeshes.add(o));
  farmRoot.traverse(o=>{if(o.isMesh&&!animalMeshes.has(o)&&!o.userData.isOutline&&!o.userData.ground&&!o.userData.noPaint&&o.visible!==false)list.push(o);});return list;}
function clearPaint(){for(const s of paint.splats)s.parent&&s.parent.remove(s);paint.splats=[];for(const b of paint.balls)scene.remove(b.m);paint.balls=[];paint.painted.clear();}
function shoot(){paint.shots++;paint.cool=.17;const col=PAINT_COLS[paint.sel];
  const d=new THREE.Vector3();cam.getWorldDirection(d);d.x+=rnd(-.012,.012);d.y+=rnd(-.012,.012)+.02;d.normalize();
  const o=new THREE.Vector3(0,.03,-.7);gun.localToWorld(o);const m=new THREE.Mesh(pballG,ballMat(col));m.position.copy(o);scene.add(m);
  paint.balls.push({m,v:d.multiplyScalar(30),col,life:3});gun.userData.kick=1;voice({type:'square',f0:180,f1:70,dur:.09,vol:.12,filt:900});noiseBurst(.06,.06,1800);}
const _rc=new THREE.Raycaster(),_n=new THREE.Vector3(),_up=new THREE.Vector3(0,1,0);
barnDoors.forEach(d=>d.hinge.traverse(o=>{o.userData.splashOnly=true;}));
function addSplat(point,normal,col,parent,scale){const g=splatGeos[Math.floor(Math.random()*3)];const s=new THREE.Mesh(g,splatMat(col));s.userData.col=col;s.userData.big=true;s.userData.r=scale;
  s.position.copy(point).addScaledVector(normal,.012);s.lookAt(tmp2.copy(s.position).add(normal));s.rotateZ(rnd(0,TAU));s.scale.setScalar(scale);s.userData.born=performance.now()/1000;s.userData.s0=scale;
  if(parent){parent.attach(s);}else paintRoot.add(s);paint.splats.push(s);
  while(paint.splats.length>520){const old=paint.splats.shift();old.parent&&old.parent.remove(old);}return s;}
const PAINT_LIFE=300,PAINT_FADE=25;
function paintAgeTick(dt){paint.ageT=(paint.ageT||0)-dt;if(paint.ageT>0||!paint.splats.length)return;paint.ageT=.2;const now=performance.now()/1000;
  for(let i=paint.splats.length-1;i>=0;i--){const s=paint.splats[i],b=s.userData.born;if(b==null)continue;const a=now-b-PAINT_LIFE;if(a<=0)continue;
    const k=1-a/PAINT_FADE;if(k<=0){s.parent&&s.parent.remove(s);paint.splats.splice(i,1);}else s.scale.setScalar(s.userData.s0*k);}}
function splat(hit,col,friend){
  if(hit.face){_n.copy(hit.face.normal).transformDirection(hit.object.matrixWorld);}else _n.set(0,1,0);
  if(!friend&&hit.object&&hit.object.userData&&hit.object.userData.splashOnly){sprayBurst(hit.point,_n,col,7);noiseBurst(.12,.12,1300);return;} // swinging barn doors: splash, but nothing sticks
  if(friend){paintFriend(friend,col);sprayBurst(hit.point,_n,col,16);noiseBurst(.18,.16,1100);}
  else{let mixed=col,mixedWith=null;
    for(const s of paint.splats){if(!s.userData.big||s.parent!==paintRoot)continue;if(s.position.distanceTo(hit.point)>(s.userData.r||.4)+.25)continue;
      const m=mixPaint(s.userData.col,col);if(m!==s.userData.col){if(!mixedWith)mixedWith=s.userData.col;s.userData.col=m;s.material=splatMat(m);}mixed=m;}
    addSplat(hit.point,_n,mixed,null,rnd(.3,.55));sprayBurst(hit.point,_n,mixed,6);
    if(mixedWith!=null&&mixed!==col){const now=performance.now();if(now-(paint.mixPopT||0)>350){paint.mixPopT=now;paintPop(`${capName(colorName(mixedWith))} + ${colorName(col)} = ${colorName(mixed)}!`);
      voice({type:'sine',f0:500,f1:900,dur:.18,vol:.1});voice({type:'triangle',f0:900,f1:1200,dur:.12,vol:.08,delay:.12});}
      if(!paint.mixes)paint.mixes=new Set();if(!paint.mixes.has(mixed)){paint.mixes.add(mixed);paint.score+=15;}}
    col=mixed;}
  if(!friend)
  for(let i=0;i<3;i++){const off=new THREE.Vector3(rnd(-1,1),rnd(-1,1),rnd(-1,1)).projectOnPlane(_n).setLength(rnd(.4,.75));const d=new THREE.Mesh(dropG,splatMat(col));
    d.position.copy(hit.point).add(off).addScaledVector(_n,.014);d.lookAt(tmp2.copy(d.position).add(_n));d.scale.setScalar(rnd(.05,.11));d.userData.born=performance.now()/1000;d.userData.s0=d.scale.x;(friend?friend.obj:paintRoot).attach?((friend?friend.obj:paintRoot).attach(d)):0;paint.splats.push(d);}
  noiseBurst(.12,.12,1300);
  if(friend){const now=performance.now()/1000;if(!friend.hitT||now-friend.hitT>.6){friend.hitT=now;paint.score+=25;paint.friends++;friendSound(friend,.9,0);if(Math.random()<.2)addBubble({x:friend.obj.position.x,z:friend.obj.position.z,obj:friend.obj},'Hey!');
      friend.roam={tx:clamp(friend.obj.position.x+rnd(-10,10),3-FENCE,FENCE-3),tz:clamp(friend.obj.position.z+rnd(-10,10),3-FENCE,FENCE-3),wait:0,flee:1.5};paintPop('+25 '+friend.name+'!');}
    return;}
  const key=hit.object.uuid+(hit.instanceId!=null?':'+hit.instanceId:'');
  if(!paint.painted.has(key)){paint.painted.add(key);paint.things++;paint.score+=10;paintPop('+10');}else paint.score+=1;
}
// friends take on the paintball's colour (eyes stay as they are)
function paintFriend(f,col){
  if(!f.mats){f.mats=[];const eyeSet=new Set();(f.obj.userData.eyes||[]).forEach(g=>g.traverse(o=>eyeSet.add(o)));
    f.obj.traverse(o=>{if(o.isMesh&&!o.userData.isOutline&&o.geometry!==blobG&&!eyeSet.has(o)&&o.material!==splatMats[o.material.color&&o.material.color.getHex()]){f.mats.push({o,orig:o.material});o.material=o.material.clone();}});}
  const prev=f.paintHex;const nc=prev!=null?mixPaint(prev,col):col;f.paintHex=nc;
  if(prev!=null&&nc!==prev&&nc!==col){paintPop(`${f.name}: ${colorName(prev)} + ${colorName(col)} = ${colorName(nc)}!`);voice({type:'sine',f0:500,f1:900,dur:.18,vol:.1});}
  f.paintCol=new THREE.Color(nc);f.paintK=0;f.flash=1;checkGoal(f,nc);}
function unpaintFriends(){FRIENDS.forEach(f=>{if(f.mats){f.mats.forEach(({o,orig})=>{o.material.dispose();o.material=orig;});f.mats=null;}f.paintCol=null;f.paintHex=null;
  f.obj.traverse(o=>{if(o.userData.isSplat&&o.parent)o.parent.remove(o);});});}
function tickFriendPaint(dt){FRIENDS.forEach(f=>{if(!f.mats||!f.paintCol||f.paintK>=1)return;f.paintK=Math.min(1,f.paintK+dt*5);
  const k=f.paintK*f.paintK*(3-2*f.paintK);f.mats.forEach(({o,orig})=>{o.material.color.copy(orig.color).lerp(f.paintCol,.92*k);});
  const sq=1+Math.sin(f.paintK*Math.PI)*.18;f.obj.scale.set(sq,2-sq,sq);if(f.paintK>=1)f.obj.scale.set(1,1,1);});}
// exploding paint spray
const sprayG=new THREE.SphereGeometry(1,8,6);
function sprayBurst(p,n,col,count){for(let i=0;i<count;i++){const m=new THREE.Mesh(sprayG,M(col));const s=rnd(.035,.09);m.scale.setScalar(s);m.position.copy(p).addScaledVector(n,.05);scene.add(m);
  const v=new THREE.Vector3(rnd(-1,1),rnd(-.4,1),rnd(-1,1)).normalize().multiplyScalar(rnd(1.5,5.5)).addScaledVector(n,rnd(1.5,4));v.y+=rnd(.5,2);
  parts.push({m,v,t:rnd(.45,.9),r:0,shrink:s,life:0});}}
function setPaintColor(i){paint.sel=(i+PAINT_COLS.length)%PAINT_COLS.length;gun.userData.hop.material.color.set(PAINT_COLS[paint.sel]);
  document.querySelectorAll('#palette button').forEach((b,k)=>b.classList.toggle('on',k===paint.sel));}
function buildPalette(){$('palette').innerHTML=PAINT_COLS.map((c,i)=>`<button data-i="${i}" style="--c:${cssHex(c)}" aria-label="${PAINT_NAMES[i]}"><span>${i+1}</span></button>`).join('');setPaintColor(paint.sel);}
function goalsUI(){const left=paint.goals.filter(g=>!g.done),show=left.slice(0,3);$('pGoals').innerHTML=show.map(g=>{const im=mem.imgs.find(x=>x.f===g.f);
  return `<div class="goal${g.done?' done':''}"><img src="${im?im.src:''}" alt=""><span class="gname">${g.f.name}</span><i class="sw" style="--c:${cssHex(g.target)}" title="${colorName(g.target)}"></i>${(r=>r?`<span class="rcp">= <i class="sw mini" style="--c:${cssHex(r[0])}"></i>+<i class="sw mini" style="--c:${cssHex(r[1])}"></i></span>`:'')(recipeOf(g.target))}<b>${g.done?'✓':''}</b></div>`;}).join('')+(left.length>3?`<div class="goal more">+${left.length-3} more</div>`:'');
  $('pGoalCount').textContent=paint.goals.filter(g=>g.done).length+'/'+paint.goals.length;}
function checkGoal(f,col){const g=paint.goals.find(x=>x.f===f);if(!g)return;const was=g.done;g.done=col===g.target;
  if(g.done&&!was){paint.score+=100;paintPop('+100 '+f.name+' is '+colorName(col)+'!');burst(f.obj.position.x,1.4,f.obj.position.z,col,24);burst(f.obj.position.x,1.4,f.obj.position.z,0xffffff,10);
    [523,659,784].forEach((fr,i)=>voice({type:'triangle',f0:fr,f1:fr,dur:.18,vol:.12,filt:4000,delay:i*.08}));
    if(paint.goals.every(x=>x.done))setTimeout(()=>{if(mode==='paint'&&state==='play')finishPaint(true);},900);}
  else if(!g.done&&was)toast(`Oh no! ${f.name} needs to be ${colorName(g.target)} again.`,1800);
  goalsUI();}
function buildMarkers(){clearMarkers();paint.goals.forEach(g=>{const m=new THREE.Group();const b=new THREE.Mesh(ballG,M(g.target));b.scale.setScalar(.17);m.add(b);
  const ring=new THREE.Mesh(new THREE.TorusGeometry(.24,.04,8,24),M(0xffffff));m.add(ring);addOutlines(m,0,.004);
  const tip=new THREE.Mesh(new THREE.ConeGeometry(.09,.18,8),M(g.target));tip.rotation.x=Math.PI;tip.position.y=-.26;m.add(tip);scene.add(m);g.marker=m;});}
function clearMarkers(){paint.goals.forEach(g=>{if(g.marker){scene.remove(g.marker);g.marker=null;}});}
function tickMarkers(t){paint.goals.forEach((g,i)=>{const mk=g.marker;if(!mk)return;mk.visible=!g.done&&mode==='paint';const f=g.f;const h=f.size===3?2.75:f.size===2?1.65:1.15;
  mk.position.set(f.obj.position.x,f.obj.position.y+h+Math.sin(t*3+i)*.08,f.obj.position.z);mk.rotation.y=t*1.5;});}
function paintPop(t){const el=document.createElement('div');el.className='ppop';el.textContent=t;$('paintHud').appendChild(el);setTimeout(()=>el.remove(),900);}
function updateBalls(dt){
  for(let i=paint.balls.length-1;i>=0;i--){const b=paint.balls[i];b.life-=dt;const prev=b.m.position.clone();b.v.y-=9*dt;b.m.position.addScaledVector(b.v,dt);
    const seg=tmp.copy(b.m.position).sub(prev);const len=seg.length();let done=b.life<=0;
    if(!done&&len>0){_rc.set(prev,seg.normalize());_rc.far=len;
      for(const bl of BAL.list){balCenter(bl,_balS);if(_rc.ray.distanceSqToPoint(_balS)<bl.r*bl.r&&_balS.distanceTo(prev)<len+bl.r){balPop(bl,'paint');break;}}
      let best=null,bf=null;
      for(const f of FRIENDS){if(!f.obj.visible)continue;if(f.obj.position.distanceTo(prev)>len+3)continue;const h=_rc.intersectObject(f.obj,true).filter(h=>!h.object.userData.isOutline&&h.object.geometry!==blobG)[0];if(h&&(!best||h.distance<best.distance)){best=h;bf=f;}}
      const h2=_rc.intersectObjects(paint.targets,false)[0];if(h2&&(!best||h2.distance<best.distance)){best=h2;bf=null;}
      if(!best&&b.m.position.y<=.02&&Math.abs(b.m.position.x)<30&&Math.abs(b.m.position.z)<30){const k=(prev.y-.02)/Math.max(1e-4,prev.y-b.m.position.y);best={point:prev.clone().lerp(b.m.position,clamp(k)),face:null,object:{uuid:'ground',matrixWorld:null}};best.point.y=0;}
      if(best){splat(best,b.col,bf);done=true;}}
    if(done){scene.remove(b.m);paint.balls.splice(i,1);}}
}

/* ================= MEMORY MATCH ================= */
const mem={cards:[],first:null,second:null,lock:false,moves:0,pairs:0,t:0,focus:0,imgs:[]};
(function extraPortraits(){
  const pr=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true});pr.setSize(160,160);pr.setPixelRatio(1);
  const ps=new THREE.Scene();ps.add(new THREE.HemisphereLight(0xffffff,0x888866,1));const dl=new THREE.DirectionalLight(0xffffff,.5);dl.position.set(2,3,4);ps.add(dl);
  const pc=new THREE.PerspectiveCamera(30,1,.1,50);
  const shot=o=>{ps.add(o);const bb=new THREE.Box3().setFromObject(o);const c=bb.getCenter(new THREE.Vector3()),s=bb.getSize(new THREE.Vector3());const d=Math.max(s.x,s.y,s.z)*2.2;
    pc.position.set(c.x+d*.18,c.y+d*.15,c.z+d);pc.lookAt(c);pr.render(ps,pc);ps.remove(o);return pr.domElement.toDataURL();};
  FRIENDS.forEach(f=>{const o=f.build();o.rotation.y=.5;mem.imgs.push({src:shot(o),name:f.name,f});});
  const pk=new THREE.Group();const pb=new THREE.Mesh(ballG,M(0xf08a2a));pb.scale.set(.6,.45,.6);pk.add(pb);const stem=new THREE.Mesh(cylG(.06,.08,.25,8),M(0x4f7a2a));stem.position.y=.5;pk.add(stem);
  mem.imgs.push({src:shot(pk),name:'Pumpkin'});
  const ap=new THREE.Group();const ab=new THREE.Mesh(ballG,M(0xe0393a));ab.scale.setScalar(.5);ap.add(ab);const lf=new THREE.Mesh(ballG,M(0x5db84d));lf.scale.set(.18,.06,.1);lf.position.set(.12,.52,0);lf.rotation.z=.4;ap.add(lf);
  const st2=new THREE.Mesh(cylG(.03,.03,.2,6),M(0x7a5233));st2.position.y=.5;ap.add(st2);mem.imgs.push({src:shot(ap),name:'Apple'});
  const bn=new THREE.Group();const add=(g,c,x,y,z,sx,sy,sz)=>{const m=new THREE.Mesh(g,M(c));m.position.set(x,y,z);m.scale.set(sx,sy,sz);bn.add(m);return m;};
  add(boxG(1,1,1),0xc8432f,0,.5,0,1.2,1,1);const gab=new THREE.Mesh(prismG,M(0xc8432f));gab.scale.set(1.2,.5,1);gab.position.y=1;bn.add(gab);
  for(const s of[-1,1]){const r=add(boxG(1,1,1),0x8c2a1f,s*.33,1.27,0,.75,.08,1.1);r.rotation.z=-s*.68;}
  add(boxG(1,1,1),0xfff6df,0,.36,.51,.5,.66,.02);add(boxG(1,1,1),0xb63b2a,0,.36,.52,.42,.58,.02);
  const x1=add(boxG(1,1,1),0xfff6df,0,.36,.535,.05,.7,.02);x1.rotation.z=.6;const x2=add(boxG(1,1,1),0xfff6df,0,.36,.535,.05,.7,.02);x2.rotation.z=-.6;
  bn.rotation.y=-.45;mem.imgs.push({src:shot(bn),name:'Barn'});
  const cn=new THREE.Group();const cob=new THREE.Mesh(ballG,M(0xf5c544));cob.scale.set(.2,.55,.2);cn.add(cob);
  for(let i=0;i<14;i++){const k=new THREE.Mesh(ballG,M(0xffde6a));const a=i*2.4,y=-.4+i*.06;k.scale.setScalar(.06);k.position.set(Math.cos(a)*.18,y,Math.sin(a)*.18+.02);cn.add(k);}
  for(const s of[-1,1]){const h=new THREE.Mesh(ballG,M(0x6fbd4b));h.scale.set(.1,.5,.06);h.position.set(s*.17,-.12,.05);h.rotation.z=s*.35;cn.add(h);}
  cn.rotation.z=-.35;mem.imgs.push({src:shot(cn),name:'Corn'});
  pr.dispose();
})();
const MEM_LV={easy:{n:6,label:'Easy',face:'🐣',cls:'e'},medium:{n:10,label:'Medium',face:'🐮',cls:'m'},hard:{n:15,label:'Hard',face:'🔥',cls:'h'}};
function memPool(){// friends and farm things, plus the veggies from Veggie ABCs
  if(!mem.pool){mem.pool=mem.imgs.slice();try{VEGGIES.forEach(v=>mem.pool.push({src:vegSrc(v),name:v.n}));}catch(e){}}return mem.pool;}
function memLayout(){const n=mem.cards.length;if(!n)return;const short=innerHeight<=520&&innerWidth>innerHeight;const W=innerWidth-(short?150:72),H=innerHeight-(short?60:200);
  let best=null;for(let c=2;c<=n;c++){const r=Math.ceil(n/c);if(c*r-n>=c)continue;const cw=Math.min(W/c,H/r*.75);if(!best||cw>best.cw)best={c,r,cw};}
  mem.cols=best.c;const g=$('memGrid');g.style.gridTemplateColumns=`repeat(${best.c},1fr)`;g.style.width=Math.floor(Math.min(best.cw*best.c,short?9999:best.c*120))+'px';}
addEventListener('resize',()=>{if(mode==='memory')memLayout();});
function memShowPick(){const p=$('memPick');p.hidden=false;$('memTable').style.visibility='hidden';document.querySelector('#memory .memhead').style.visibility='hidden';
  p.querySelector('.mpRow').innerHTML=Object.entries(MEM_LV).map(([k,L])=>{const cols=L.n===6?4:L.n===10?5:6;return `<button class="mpBtn ${L.cls}" data-lv="${k}" aria-label="${L.label}: ${L.n*2} cards"><span class="face">${L.face}</span><span class="mini" style="grid-template-columns:repeat(${cols},1fr)">${'<i></i>'.repeat(L.n*2)}</span><b>${L.label}</b><small>${L.n*2} cards</small></button>`;}).join('');
  p.querySelectorAll('.mpBtn').forEach(b=>b.onclick=()=>{audio();memPickLevel(b.dataset.lv);});
  setTimeout(()=>{const b=p.querySelector('.mpBtn.m');if(b){device==='pad'?padFocus(b):b.focus();}},60);}
function memPickLevel(lv){mem.lv=lv;$('memPick').hidden=true;$('memTable').style.visibility='';document.querySelector('#memory .memhead').style.visibility='';voice({type:'triangle',f0:520,f1:780,dur:.12,vol:.1});buildMemory();mem.picking=false;}
function buildMemory(){const pool=memPool();const want=(MEM_LV[mem.lv]||MEM_LV.medium).n;
  const grid=$('memGrid');grid.innerHTML='';const deck=[];
  // always some friends, then fill with farm things and veggies
  const fr=pool.map((im,i)=>i).filter(i=>pool[i].f).sort(()=>Math.random()-.5),ot=pool.map((im,i)=>i).filter(i=>!pool[i].f).sort(()=>Math.random()-.5);
  const nf=Math.min(fr.length,Math.ceil(want/2));const idx=fr.slice(0,nf).concat(ot.slice(0,want-nf));mem.n=idx.length;idx.forEach(i=>deck.push(i,i));
  for(let i=deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[deck[i],deck[j]]=[deck[j],deck[i]];}
  mem.cards=deck.map((k,i)=>{const b=document.createElement('button');b.className='card';b.setAttribute('aria-label','Hidden card');
    b.innerHTML=`<span class="inner"><span class="back"></span><span class="front"><img alt="" src="${pool[k].src}"><em>${pool[k].name}</em></span></span>`;
    b.addEventListener('click',()=>{device='kb';flipCard(i);});grid.appendChild(b);return {k,el:b,up:false,done:false};});
  mem.first=mem.second=null;mem.lock=false;mem.moves=0;mem.pairs=0;mem.t=0;mem.focus=0;memFocus(0);memStats();memLayout();
}
function memFocus(i){const n=mem.cards.length||20;if(!mem.cards.length)return;mem.focus=(i+n)%n;mem.cards.forEach((c,k)=>c.el.classList.toggle('kfocus',k===mem.focus&&device!=='kb'));}
function memStats(){$('memMoves').textContent=mem.moves;$('memPairs').textContent=mem.pairs+'/'+(mem.n||10);$('memTime').textContent=fmt(mem.t);}
function flipCard(i){if(state!=='play'||mode!=='memory'||mem.lock||mem.picking)return;const c=mem.cards[i];if(!c||c.up||c.done)return;audio();
  const pool=memPool();c.up=true;c.el.classList.add('up');c.el.setAttribute('aria-label',pool[c.k].name);voice({type:'triangle',f0:520,f1:700,dur:.08,vol:.08});
  if(!mem.first){mem.first=c;return;}
  mem.second=c;mem.moves++;memStats();
  if(mem.first.k===c.k){const a=mem.first;mem.first=mem.second=null;setTimeout(()=>{a.done=c.done=true;a.el.classList.add('done');c.el.classList.add('done');mem.pairs++;memStats();
      const im=pool[c.k];if(im.f)friendSound(im.f,.9,0);else SFX.pop();moonie.action='cheer';moonie.actT=0;moonie.happy=1;
      if(mem.pairs===mem.n)setTimeout(()=>finishMemory(),900);},250);}
  else{mem.lock=true;setTimeout(()=>{for(const x of[mem.first,mem.second]){x.up=false;x.el.classList.remove('up');x.el.setAttribute('aria-label','Hidden card');}mem.first=mem.second=null;mem.lock=false;},900);}
}

/* ================= INPUT ================= */
/* ================= SHARED 2D DRAWING HELPERS ================= */
function rrect(x,X,Y,w,h,r){x.beginPath();rrp(x,X,Y,w,h,r);x.closePath();}
function rrp(x,X,Y,w,h,r){x.moveTo(X+r,Y);x.arcTo(X+w,Y,X+w,Y+h,r);x.arcTo(X+w,Y+h,X,Y+h,r);x.arcTo(X,Y+h,X,Y,r);x.arcTo(X,Y,X+w,Y,r);}
function drawCow(x,cx,cy,r,o){o=o||{};const ink='#1d1510';x.save();x.translate(cx,cy);if(o.tilt)x.rotate(o.tilt);x.lineWidth=Math.max(1.5,r*.085);x.strokeStyle=ink;x.lineJoin='round';x.lineCap='round';
  const ell=(ex,ey,rx,ry,rot,fill,st)=>{x.beginPath();x.ellipse(ex,ey,rx,ry,rot||0,0,TAU);x.fillStyle=fill;x.fill();if(st!==false)x.stroke();};
  for(const s of[-1,1]){x.beginPath();x.moveTo(s*r*.34,-r*.66);x.quadraticCurveTo(s*r*.56,-r*1.18,s*r*.5,-r*1.12);x.quadraticCurveTo(s*r*.66,-r*.9,s*r*.6,-r*.56);x.closePath();x.fillStyle='#fff1c9';x.fill();x.stroke();}
  for(const s of[-1,1]){ell(s*r*.96,-r*.34,r*.36,r*.19,s*.35,'#f1c294');ell(s*r*.98,-r*.34,r*.2,r*.085,s*.35,'#ff9fb0',false);}
  ell(0,0,r*.86,r*.82,0,'#f1c294');
  x.save();x.beginPath();x.ellipse(0,0,r*.86,r*.82,0,0,TAU);x.clip();x.fillStyle='#54413b';x.beginPath();x.ellipse(r*.5,-r*.52,r*.4,r*.3,.5,0,TAU);x.fill();x.restore();
  x.beginPath();x.ellipse(0,0,r*.86,r*.82,0,0,TAU);x.stroke();
  const lx=(o.look?o.look[0]:0)*r*.07,ly=(o.look?o.look[1]:0)*r*.07;
  if(o.dead){x.lineWidth=Math.max(2,r*.1);for(const s of[-1,1]){const ex=s*r*.32,ey=-r*.16,k=r*.12;x.beginPath();x.moveTo(ex-k,ey-k);x.lineTo(ex+k,ey+k);x.moveTo(ex+k,ey-k);x.lineTo(ex-k,ey+k);x.stroke();}x.lineWidth=Math.max(1.5,r*.085);}
  else for(const s of[-1,1]){ell(s*r*.32,-r*.16,r*.17,r*.21,0,'#ffffff');x.beginPath();x.arc(s*r*.32+lx,-r*.13+ly,r*.1,0,TAU);x.fillStyle=ink;x.fill();x.beginPath();x.arc(s*r*.32+lx+r*.04,-r*.18+ly,r*.035,0,TAU);x.fillStyle='#fff';x.fill();}
  ell(0,r*.38,r*.56,r*.34,0,'#ff9fb0');
  for(const s of[-1,1]){x.beginPath();x.ellipse(s*r*.2,r*.3,r*.07,r*.1,0,0,TAU);x.fillStyle='#a8505e';x.fill();}
  const mo=o.mouth||0;if(mo>.08){x.beginPath();x.ellipse(0,r*.52,r*.24,r*.17*mo,0,0,TAU);x.fillStyle='#5a1e2a';x.fill();x.stroke();}
  else{x.beginPath();x.moveTo(-r*.15,r*.5);x.quadraticCurveTo(0,r*.6,r*.15,r*.5);x.stroke();}
  x.restore();}
function drawCrow(x,cx,cy,r,o){const ink='#1d1510';x.save();x.translate(cx,cy);x.lineWidth=Math.max(1.5,r*.09);x.strokeStyle=ink;x.lineJoin='round';x.lineCap='round';
  const body=o.scared?(o.flash?'#ffffff':'#8fb4ff'):o.col;
  if(!o.eyesOnly){
    for(const s of[-1,1]){x.save();x.translate(s*r*.76,r*.12);x.rotate(s*(.35+Math.sin(o.flap||0)*.45));x.beginPath();x.ellipse(0,0,r*.4,r*.2,0,0,TAU);x.fillStyle=body;x.fill();x.stroke();x.restore();}
    for(const k of[-1,0,1]){x.beginPath();x.ellipse(k*r*.17,-r*.86,r*.09,r*.2,k*.45,0,TAU);x.fillStyle=body;x.fill();x.stroke();}
    x.beginPath();x.ellipse(0,0,r*.8,r*.84,0,0,TAU);x.fillStyle=body;x.fill();x.stroke();
    x.beginPath();x.ellipse(0,r*.32,r*.48,r*.4,0,0,TAU);x.fillStyle='rgba(255,255,255,.3)';x.fill();}
  const dx=o.dx||0,dy=o.dy||0;
  for(const s of[-1,1]){x.beginPath();x.ellipse(s*r*.3,-r*.2,r*.22,r*.27,0,0,TAU);x.fillStyle='#fff';x.fill();x.stroke();x.beginPath();x.arc(s*r*.3+dx*r*.1,-r*.18+dy*r*.1,o.scared?r*.06:r*.11,0,TAU);x.fillStyle=ink;x.fill();}
  if(!o.eyesOnly){
    if(o.scared){x.beginPath();for(let i=0;i<=6;i++){const px=-r*.38+i*r*.76/6,py=r*.3+(i%2?-1:1)*r*.06;i?x.lineTo(px,py):x.moveTo(px,py);}x.strokeStyle=o.flash?'#d6453d':ink;x.stroke();}
    else{x.beginPath();x.moveTo(-r*.17,r*.06);x.lineTo(r*.17,r*.06);x.lineTo(dx*r*.32,r*.42+dy*r*.12);x.closePath();x.fillStyle='#f5b800';x.fill();x.stroke();}}
  x.restore();}
function drawStar(x,cx,cy,r,col){x.beginPath();for(let i=0;i<10;i++){const a=i/10*TAU-Math.PI/2,rr=i%2?r*.46:r;x.lineTo(cx+Math.cos(a)*rr,cy+Math.sin(a)*rr);}x.closePath();x.fillStyle=col;x.fill();x.lineWidth=Math.max(2,r*.1);x.strokeStyle='#1d1510';x.lineJoin='round';x.stroke();}
function drawHeart(x,cx,cy,r,col){x.beginPath();x.moveTo(cx,cy+r*.85);x.bezierCurveTo(cx-r*1.35,cy,cx-r*.7,cy-r*1,cx,cy-r*.38);x.bezierCurveTo(cx+r*.7,cy-r*1,cx+r*1.35,cy,cx,cy+r*.85);x.closePath();x.fillStyle=col;x.fill();x.lineWidth=Math.max(2,r*.1);x.strokeStyle='#1d1510';x.lineJoin='round';x.stroke();}
function drawFlowerS(x,cx,cy,r,col){x.lineWidth=Math.max(2,r*.09);x.strokeStyle='#1d1510';for(let i=0;i<6;i++){const a=i/6*TAU;x.beginPath();x.arc(cx+Math.cos(a)*r*.55,cy+Math.sin(a)*r*.55,r*.42,0,TAU);x.fillStyle=col;x.fill();x.stroke();}
  x.beginPath();x.arc(cx,cy,r*.36,0,TAU);x.fillStyle=col==='#ffd23f'||col==='#f5b800'?'#ff8a2a':'#ffd23f';x.fill();x.stroke();}
function drawSunS(x,cx,cy,r,col){x.lineWidth=Math.max(2,r*.09);x.strokeStyle='#1d1510';x.lineCap='round';for(let i=0;i<10;i++){const a=i/10*TAU;x.beginPath();x.moveTo(cx+Math.cos(a)*r*.72,cy+Math.sin(a)*r*.72);x.lineTo(cx+Math.cos(a)*r,cy+Math.sin(a)*r);x.stroke();}
  x.beginPath();x.arc(cx,cy,r*.6,0,TAU);x.fillStyle=col;x.fill();x.stroke();x.fillStyle='#1d1510';for(const s of[-1,1]){x.beginPath();x.arc(cx+s*r*.2,cy-r*.12,r*.07,0,TAU);x.fill();}
  x.beginPath();x.arc(cx,cy+r*.04,r*.3,.2,Math.PI-.2);x.stroke();}
function drawApple(x,cx,cy,r){x.lineWidth=Math.max(1.5,r*.12);x.strokeStyle='#1d1510';x.beginPath();x.moveTo(cx,cy-r*.8);x.lineTo(cx+r*.12,cy-r*1.25);x.stroke();
  x.beginPath();x.ellipse(cx+r*.42,cy-r*1.05,r*.34,r*.16,-.5,0,TAU);x.fillStyle='#5db84d';x.fill();x.stroke();
  x.beginPath();x.arc(cx,cy,r,0,TAU);x.fillStyle='#e0393a';x.fill();x.stroke();x.beginPath();x.arc(cx-r*.35,cy-r*.3,r*.22,0,TAU);x.fillStyle='rgba(255,255,255,.6)';x.fill();}
function drawPumpkin(x,cx,cy,r){x.lineWidth=Math.max(1.5,r*.1);x.strokeStyle='#1d1510';for(const k of[-.45,.45,0]){x.beginPath();x.ellipse(cx+k*r,cy,r*.55,r*.8,0,0,TAU);x.fillStyle='#f08a2a';x.fill();x.stroke();}
  x.beginPath();x.moveTo(cx,cy-r*.75);x.quadraticCurveTo(cx+r*.1,cy-r*1.1,cx+r*.3,cy-r*1.1);x.lineWidth=Math.max(2,r*.18);x.strokeStyle='#4f7a2a';x.stroke();}
const COW_TOKEN=(()=>{const c=document.createElement('canvas');c.width=c.height=160;drawCow(c.getContext('2d'),80,92,64,{});return c.toDataURL();})();
// move keyboard / d-pad focus to the nearest button in a direction
function spatialNav(root,dx,dy){const els=[...root.querySelectorAll('button')].filter(e=>!e.disabled&&e.offsetParent!==null);if(!els.length)return;
  const cur=document.activeElement;if(!els.includes(cur)){padFocus(els[0]);return;}if(!dx&&!dy)return;
  const r0=cur.getBoundingClientRect(),cx=r0.left+r0.width/2,cy=r0.top+r0.height/2;let best=null,bs=1e9;
  for(const e of els){if(e===cur)continue;const r=e.getBoundingClientRect(),ex=r.left+r.width/2-cx,ey=r.top+r.height/2-cy;const along=ex*dx+ey*dy;if(along<=4)continue;const sc=along+Math.abs(ex*dy-ey*dx)*2.2;if(sc<bs){bs=sc;best=e;}}
  if(best){padFocus(best);voice({type:'triangle',f0:600,f1:600,dur:.04,vol:.05});}}

/* ================= CORN CHOMP (farm maze muncher) ================= */
const CH_MAP=[
'###################',
'#........#........#',
'#o##.###.#.###.##o#',
'#.................#',
'#.##.#.#####.#.##.#',
'#....#...#...#....#',
'####.### # ###.####',
'   #.#       #.#   ',
'####.# ##-## #.####',
'    .  #   #  .    ',
'####.# ##### #.####',
'   #.#       #.#   ',
'####.# ##### #.####',
'#........#........#',
'#.##.###.#.###.##.#',
'#o.#...........#.o#',
'##.#.#.#####.#.#.##',
'#....#...#...#....#',
'#.######.#.######.#',
'#.................#',
'###################'];
const CH={cols:19,rows:21,grid:null,reach:null,dots:0,score:0,lives:3,level:1,phase:'ready',pt:0,fright:0,modeI:0,modeT:0,combo:0,p:null,gs:[],want:[0,0],bonus:null,eatenN:0,hi:false,ts:20,dpr:1,c:null,x:null,wall:null,sirenT:0,pops:[],livesShown:-1,swipe:null};
// ---- farm-friend sprites for Corn Chomp: Moonie and the animals rendered from their real 3D models, once ----
const CH_ROLES=[{ai:'chase',corner:[18,-2],home:[9,7],rel:0},{ai:'ambush',corner:[0,-2],home:[9,9],rel:1.5},{ai:'flank',corner:[18,22],home:[8,9],rel:5},{ai:'shy',corner:[0,22],home:[10,9],rel:9}];
function chTint(src,col){const c=document.createElement('canvas');c.width=src.width;c.height=src.height;const x=c.getContext('2d');x.drawImage(src,0,0);x.globalCompositeOperation='source-atop';x.fillStyle=col;x.fillRect(0,0,c.width,c.height);return c;}
function chMakeSprites(){if(CH.spr)return CH.spr;const S=CH.spr={friends:{},moonie:null};let pr=null;
  try{pr=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true});pr.setSize(192,192);pr.setPixelRatio(1);pr.outputEncoding=R.outputEncoding;
    const ps=new THREE.Scene();ps.add(new THREE.HemisphereLight(0xffffff,0x888866,1));const dl=new THREE.DirectionalLight(0xffffff,.65);dl.position.set(2,3,4);ps.add(dl);
    const pc=new THREE.PerspectiveCamera(28,1,.1,60);
    const shot=(o,full)=>{o.updateMatrixWorld(true);const bb=new THREE.Box3().setFromObject(o),c=bb.getCenter(new THREE.Vector3()),s=bb.getSize(new THREE.Vector3());
      const d=Math.max(s.x,s.y*(full?1:1.05),s.z)*2.25;pc.position.set(c.x+d*.12,c.y+d*.16,c.z+d);pc.lookAt(c);pr.render(ps,pc);
      const cv=document.createElement('canvas');cv.width=cv.height=192;cv.getContext('2d').drawImage(pr.domElement,0,0);return cv;};
    for(const f of FRIENDS){const o=f.build();o.rotation.y=.55;ps.add(o);const cv=shot(o);ps.remove(o);S.friends[f.name]={img:cv,scared:chTint(cv,'rgba(70,110,255,.55)'),flash:chTint(cv,'rgba(255,255,255,.75)')};}
    if(moonie.model){const r=moonie.root,par=r.parent,pos=r.position.clone(),q=r.quaternion.clone(),vis=r.visible;
      try{ps.add(r);r.position.set(0,0,0);r.rotation.set(0,.55,0);r.visible=true;S.moonie=shot(r,true);}finally{(par||scene).add(r);r.position.copy(pos);r.quaternion.copy(q);r.visible=vis;}}
  }catch(e){console.error('Corn Chomp sprites',e);}
  try{pr&&pr.dispose();pr&&pr.forceContextLoss&&pr.forceContextLoss();}catch(e){}
  return S;}
function chPickFriends(){const pool=FRIENDS.slice().sort(()=>Math.random()-.5);CH.cast=CH_ROLES.map((r,i)=>pool[i]);
  $('cWho').innerHTML='<span>Chasing you:</span>'+CH.cast.map(f=>{const s=CH.spr&&CH.spr.friends[f.name];return`<i title="${f.name}">${s?`<img alt="" src="${s.img.toDataURL()}">`:''}<b>${f.name}</b></i>`;}).join('');}
// draw a friend sprite: soft shadow, waddle, faces the way it moves, blue and wobbly when scared, see-through when tagged
function chDrawFriend(x,cx,cy,sz,g,flash){const S=CH.spr&&CH.spr.friends[g.f.name];const t=performance.now()/1000;
  const moving=g.dx||g.dy,wob=moving?Math.sin(g.flap*1.1)*.08:0,hop=moving?Math.abs(Math.sin(g.flap*1.1))*sz*.06:0;
  x.save();x.translate(cx,cy);
  x.globalAlpha=g.state==='eaten'?.18:.3;x.fillStyle='#1d1510';x.beginPath();x.ellipse(0,sz*.36,sz*.32,sz*.1,0,0,TAU);x.fill();
  x.globalAlpha=g.state==='eaten'?.35:1;x.translate(0,-hop);x.rotate(wob+(g.scared&&g.state==='active'?Math.sin(t*22)*.1:0));if(g.dx<0)x.scale(-1,1);
  if(S){const img=g.scared&&g.state==='active'?(flash?S.flash:S.scared):S.img;x.drawImage(img,-sz*.62,-sz*.7,sz*1.24,sz*1.24);}
  else drawCrow(x,0,0,sz*.46,{col:g.f.color||'#d6453d',dx:g.dx,dy:g.dy,flap:g.flap,scared:g.scared&&g.state==='active',flash,eyesOnly:g.state==='eaten'});
  x.restore();
  if(g.scared&&g.state==='active'){x.save();x.font=`${Math.round(sz*.42)}px "Lilita One",sans-serif`;x.textAlign='center';x.lineWidth=3;x.strokeStyle='#1d1510';x.fillStyle='#9fd0ff';x.strokeText('!?',cx+sz*.38,cy-sz*.5);x.fillText('!?',cx+sz*.38,cy-sz*.5);x.restore();}
  if(g.state==='eaten'){x.save();drawHeart(x,cx,cy-sz*.55+Math.sin(t*6)*2,sz*.2,'#ff6f91');x.restore();}}
function chDrawMoonie(x,cx,cy,sz,p,dead,k){const img=CH.spr&&CH.spr.moonie;
  if(!img){if(dead){x.save();x.translate(cx,cy);x.rotate(k*TAU*1.5);x.scale(1-k*.5,1-k*.5);drawCow(x,0,0,sz*.5,{dead:true});x.restore();}else drawCow(x,cx,cy+sz*.02,sz*.5,{mouth:(p.dx||p.dy)?Math.abs(1-p.mouth):.15,look:p.face,tilt:p.face[0]*.12});return;}
  const moving=p.dx||p.dy,chew=moving?Math.abs(Math.sin(p.mouth*Math.PI)):0;
  x.save();x.translate(cx,cy);x.globalAlpha=.3;x.fillStyle='#1d1510';x.beginPath();x.ellipse(0,sz*.38,sz*.34,sz*.1,0,0,TAU);x.fill();x.globalAlpha=1;
  if(dead){x.rotate(k*TAU*1.5);x.scale(1-k*.5,1-k*.5);}else{x.translate(0,-chew*sz*.05);x.scale(1+chew*.06,1-chew*.08);x.rotate(p.face[0]*.08);}
  if(p.face[0]<0)x.scale(-1,1);x.drawImage(img,-sz*.66,-sz*.78,sz*1.32,sz*1.32);x.restore();}

const CH_MODES=[7,20,7,20,5,20,5,1e9];
const chWrap=v=>((v%CH.cols)+CH.cols)%CH.cols;
function chCell(x,y){if(y<0||y>=CH.rows)return '#';return CH.grid[y][chWrap(x)];}
function chOpen(x,y,door){const c=chCell(x,y);return c!=='#'&&(c!=='-'||door);}
function chPos(e){return[e.tx+e.dx*e.t,e.ty+e.dy*e.t];}
function chLoadGrid(){CH.grid=CH_MAP.map(r=>r.split(''));CH.dots=0;for(const r of CH.grid)for(const c of r)if(c==='.'||c==='o')CH.dots++;CH.eatenN=0;
  const R=new Uint8Array(CH.cols*CH.rows),q=[[9,15]];R[15*CH.cols+9]=1;
  while(q.length){const[x,y]=q.pop();for(const[dx,dy]of[[1,0],[-1,0],[0,1],[0,-1]]){const nx=chWrap(x+dx),ny=y+dy;if(ny<0||ny>=CH.rows||CH.grid[ny][nx]==='#')continue;const k=ny*CH.cols+nx;if(R[k])continue;R[k]=1;q.push([nx,ny]);}}CH.reach=R;}
function chMakeWalls(){const ts=CH.ts,dpr=CH.dpr,W=CH.cols*ts,H=CH.rows*ts,c=document.createElement('canvas');c.width=W*dpr;c.height=H*dpr;const x=c.getContext('2d');x.scale(dpr,dpr);
  x.fillStyle='#3f8a3a';x.fillRect(0,0,W,H);for(let i=0;i<CH.cols*CH.rows*1.5;i++){x.fillStyle=i%2?'#4f9e44':'#357a31';x.fillRect(Math.random()*W,Math.random()*H,2,5);}
  const R=CH.reach,open=(i,y)=>R[y*CH.cols+i]&&CH.grid[y][i]!=='#';
  x.fillStyle='#e2b878';for(let y=0;y<CH.rows;y++)for(let i=0;i<CH.cols;i++)if(open(i,y))x.fillRect(i*ts-.5,y*ts-.5,ts+1,ts+1);
  x.fillStyle='rgba(160,110,50,.25)';for(let y=0;y<CH.rows;y++)for(let i=0;i<CH.cols;i++)if(open(i,y)&&(i*7+y*3)%5===0){x.beginPath();x.arc((i+.3)*ts,(y+.7)*ts,ts*.06,0,TAU);x.fill();}
  const hedge=(i,y)=>{if(y<0||y>=CH.rows||i<0||i>=CH.cols||CH.grid[y][i]!=='#')return false;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const yy=y+a,ii=i+b;if(yy>=0&&yy<CH.rows&&ii>=0&&ii<CH.cols&&R[yy*CH.cols+ii])return true;}return false;};
  const segs=[];for(let y=0;y<CH.rows;y++)for(let i=0;i<CH.cols;i++)if(hedge(i,y)){segs.push([i,y,i,y]);if(hedge(i+1,y))segs.push([i,y,i+1,y]);if(hedge(i,y+1))segs.push([i,y,i,y+1]);}
  const pass=(w,col,ox,oy)=>{x.strokeStyle=col;x.lineWidth=w;x.lineCap='round';x.lineJoin='round';x.beginPath();for(const[a,b,c2,d]of segs){x.moveTo((a+.5)*ts+ox,(b+.5)*ts+oy);x.lineTo((c2+.5)*ts+ox+.01,(d+.5)*ts+oy);}x.stroke();};
  pass(ts*.84+5,'#1d1510',0,0);pass(ts*.84,'#3f9b3a',0,0);pass(ts*.4,'#6cc75a',-ts*.08,-ts*.1);
  x.strokeStyle='#ff8fb1';x.lineWidth=ts*.18;x.lineCap='round';x.beginPath();x.moveTo(9*ts+3,8.5*ts);x.lineTo(10*ts-3,8.5*ts);x.stroke();
  CH.wall=c;}
function chResize(){if(!CH.c)return;const padOn=!$('cPad').hidden,short=innerHeight<=520&&innerWidth>innerHeight;
  const aw=short?innerWidth-(padOn?230:0)-170-66:Math.min(innerWidth-40,820),ah=short?innerHeight-24:innerHeight-(padOn?280:150)-(innerWidth<=820?80:0);
  const ts=Math.max(10,Math.floor(Math.min(aw/CH.cols,ah/CH.rows)));CH.ts=ts;CH.dpr=Math.min(devicePixelRatio||1,2);
  const c=CH.c;c.width=CH.cols*ts*CH.dpr;c.height=CH.rows*ts*CH.dpr;c.style.width=CH.cols*ts+'px';c.style.height=CH.rows*ts+'px';CH.x.setTransform(CH.dpr,0,0,CH.dpr,0,0);CH.kern=null;chMakeWalls();}
addEventListener('resize',()=>{if(mode==='chomp')chResize();});
function chPlace(){CH.p={tx:9,ty:15,dx:0,dy:0,t:0,mouth:0,face:[0,1]};CH.want=[0,0];
  const relK=Math.max(.35,1-(CH.level-1)*.15);
  if(!CH.cast)chPickFriends();CH.gs=CH_ROLES.map((G,i)=>Object.assign({},G,{f:CH.cast[i],name:CH.cast[i].name,tx:G.home[0],ty:G.home[1],dx:i===0?-1:0,dy:0,t:0,state:i===0?'active':'pen',relT:G.rel*relK,scared:false,flap:Math.random()*6,bob:Math.random()*6}));
  CH.fright=0;CH.modeI=0;CH.modeT=0;CH.bonus=null;CH.phase='ready';CH.pt=1.8;$('cMsg').textContent=CH.level>1&&CH.lives===3&&CH.score>0?`Level ${CH.level}!`:'Ready!';$('cMsg').hidden=false;}
function chMove(e,dist,decide,onCenter){let guard=0;
  while(dist>1e-6&&guard++<10){
    if(!e.dx&&!e.dy){const d=decide(e);if(!d)return;e.dx=d[0];e.dy=d[1];e.t=0;}
    const left=1-e.t;if(dist<left){e.t+=dist;return;}
    dist-=left;e.tx=chWrap(e.tx+e.dx);e.ty+=e.dy;e.t=0;if(onCenter)onCenter(e);
    const d=decide(e);if(d){e.dx=d[0];e.dy=d[1];}else{e.dx=0;e.dy=0;return;}}}
function chReverse(e){if(!e.dx&&!e.dy)return;if(e.t>0){e.tx=chWrap(e.tx+e.dx);e.ty+=e.dy;e.t=1-e.t;}e.dx=-e.dx;e.dy=-e.dy;}
function chPDecide(p){const w=CH.want;if((w[0]||w[1])&&chOpen(p.tx+w[0],p.ty+w[1],false))return w.slice();if((p.dx||p.dy)&&chOpen(p.tx+p.dx,p.ty+p.dy,false))return[p.dx,p.dy];return null;}
function chTarget(g){if(g.state==='leave')return[9,7];if(g.state==='eaten')return[9,9];
  const p=CH.p,px=p.tx,py=p.ty,pd=p.face;if(CH.modeI%2===0)return g.corner;
  if(g.ai==='chase')return[px,py];if(g.ai==='ambush')return[px+pd[0]*4,py+pd[1]*4];
  if(g.ai==='flank'){const b=CH.gs[0],ax=px+pd[0]*2,ay=py+pd[1]*2;return[ax*2-b.tx,ay*2-b.ty];}
  return Math.hypot(g.tx-px,g.ty-py)>8?[px,py]:g.corner;}
function chGDecide(g){if(g.state==='pen')return null;const door=g.state==='leave'||g.state==='eaten',cand=[];
  for(const[dx,dy]of[[0,-1],[-1,0],[0,1],[1,0]]){if((g.dx||g.dy)&&dx===-g.dx&&dy===-g.dy)continue;if(chOpen(g.tx+dx,g.ty+dy,door))cand.push([dx,dy]);}
  if(!cand.length)return(g.dx||g.dy)?[-g.dx,-g.dy]:null;
  if(g.scared&&g.state==='active')return cand[Math.floor(Math.random()*cand.length)];
  const T=chTarget(g);let best=cand[0],bd=1e9;for(const c of cand){const d=(g.tx+c[0]-T[0])**2+(g.ty+c[1]-T[1])**2;if(d<bd){bd=d;best=c;}}return best;}
function chGCenter(g){if(g.state==='leave'&&g.tx===9&&g.ty===7)g.state='active';else if(g.state==='eaten'&&g.tx===9&&g.ty===9){g.state='leave';g.scared=false;}}
function chEat(p){const c=CH.grid[p.ty][p.tx];
  if(c==='.'){CH.grid[p.ty][p.tx]=' ';CH.score+=10;CH.dots--;CH.eatenN++;CH.hi=!CH.hi;voice({type:'triangle',f0:CH.hi?330:250,f1:CH.hi?420:200,dur:.07,vol:.07,filt:2200});}
  else if(c==='o'){CH.grid[p.ty][p.tx]=' ';CH.score+=50;CH.dots--;CH.eatenN++;chFright();}
  if((CH.eatenN===60||CH.eatenN===140)&&!CH.bonus)CH.bonus={x:9,y:11,t:9};
  if(CH.bonus&&p.tx===CH.bonus.x&&p.ty===CH.bonus.y){const v=300*CH.level;CH.score+=v;chPop(v,CH.bonus.x,CH.bonus.y);CH.bonus=null;SFX.pop();}
  if(CH.dots<=0&&CH.phase==='play'){CH.phase='clear';CH.pt=2.2;SFX.win();}}
function chKernel(ts){const d=CH.dpr,c=document.createElement('canvas'),w=Math.ceil(ts*.42*d),h=Math.ceil(ts*.52*d);c.width=w;c.height=h;const x=c.getContext('2d');x.scale(d,d);x.translate(ts*.21,ts*.26);x.rotate(.45);
  x.lineWidth=Math.max(1,ts*.05);x.strokeStyle='#1d1510';x.fillStyle='#6cc75a';x.beginPath();x.ellipse(-ts*.06,ts*.06,ts*.05,ts*.16,-.4,0,TAU);x.fill();x.stroke();
  x.fillStyle='#ffd23f';x.beginPath();x.ellipse(0,-ts*.02,ts*.09,ts*.16,0,0,TAU);x.fill();x.stroke();x.fillStyle='#f0a81c';for(let k=-1;k<=1;k++)for(let j=-1;j<=1;j+=2){x.beginPath();x.arc(j*ts*.03,k*ts*.06-ts*.02,ts*.018,0,TAU);x.fill();}
  CH.kern=c;CH.kernTs=ts;}
function chFright(){CH.fright=Math.max(2.2,7-CH.level);CH.combo=0;for(const g of CH.gs)if(g.state==='active'){g.scared=true;chReverse(g);}
  voice({type:'sine',f0:300,f1:900,dur:.35,vol:.14});}
function chPop(v,x,y){CH.pops.push({v:'+'+v,x,y,t:1});}
function startChomp(){mode='chomp';state='play';if(!CH.c){CH.c=$('chompC');CH.x=CH.c.getContext('2d');}
  CH.score=0;CH.lives=3;CH.level=1;CH.pops=[];CH.livesShown=-1;chMakeSprites();CH.cast=null;chPickFriends();chLoadGrid();hud(['chompUI','pauseBtn']);
  $('cPad').hidden=!isTouch();chResize();chPlace();chEat(CH.p);touchUI();canvas.focus();}
function updateChomp(dt,pad){if(!CH.x||!CH.p)return;
  if(pad&&pad.btn){const b=pad.btn;if(b.du)CH.want=[0,-1];if(b.dd)CH.want=[0,1];if(b.dl)CH.want=[-1,0];if(b.dr)CH.want=[1,0];}
  if(pad&&(Math.abs(pad.x)>.5||Math.abs(pad.y)>.5))CH.want=Math.abs(pad.x)>Math.abs(pad.y)?[Math.sign(pad.x),0]:[0,Math.sign(pad.y)];
  if(keys.ArrowUp||keys.KeyW)CH.want=[0,-1];else if(keys.ArrowDown||keys.KeyS)CH.want=[0,1];else if(keys.ArrowLeft||keys.KeyA)CH.want=[-1,0];else if(keys.ArrowRight||keys.KeyD)CH.want=[1,0];
  if(CH.phase==='ready'){CH.pt-=dt;if(CH.pt<=0){CH.phase='play';$('cMsg').hidden=true;}}
  else if(CH.phase==='play'){
    const p=CH.p,lv=CH.level,ps=6.4*Math.min(1.35,1+.06*(lv-1))*(CH.fright>0?1.08:1);
    const w=CH.want;if((p.dx||p.dy)&&w[0]===-p.dx&&w[1]===-p.dy&&p.t>0)chReverse(p);
    chMove(p,ps*dt,chPDecide,chEat);if(p.dx||p.dy){p.face=[p.dx,p.dy];p.mouth=(p.mouth+dt*9)%2;}
    if(CH.fright>0){CH.fright-=dt;if(CH.fright<=0){CH.fright=0;CH.gs.forEach(g=>g.scared=false);}}
    else{CH.modeT+=dt;if(CH.modeT>CH_MODES[CH.modeI]){CH.modeT=0;CH.modeI++;CH.gs.forEach(g=>{if(g.state==='active')chReverse(g);});}}
    for(const g of CH.gs){g.flap+=dt*(g.scared?14:9);
      if(g.state==='pen'){g.relT-=dt;g.bob+=dt*5;if(g.relT<=0){g.state='leave';g.dx=g.dy=0;g.t=0;}continue;}
      const tunnel=g.ty===9&&(g.tx<4||g.tx>14);let gs=6.0*Math.min(1.35,1+.07*(lv-1));
      if(g.state==='eaten')gs=13;else if(g.state==='leave')gs*=.55;else if(g.scared)gs*=.55;else if(tunnel)gs*=.5;
      chMove(g,gs*dt,chGDecide,chGCenter);}
    if(CH.phase==='play'){const pp=chPos(p);for(const g of CH.gs){if(g.state!=='active')continue;const gp=chPos(g);let dx=gp[0]-pp[0];if(dx>CH.cols/2)dx-=CH.cols;if(dx<-CH.cols/2)dx+=CH.cols;
      if(Math.hypot(dx,gp[1]-pp[1])<.6){
        if(g.scared){g.state='eaten';g.scared=false;CH.combo++;const v=200*Math.pow(2,CH.combo-1);CH.score+=v;chPop(v,gp[0],gp[1]);[660,880,1100].forEach((f,i)=>voice({type:'square',f0:f,f1:f*1.3,dur:.08,vol:.08,delay:i*.06}));}
        else{CH.phase='dying';CH.pt=1.8;voice({type:'triangle',f0:700,f1:120,dur:1.1,vol:.16,vib:6});break;}}}}
    if(CH.bonus){CH.bonus.t-=dt;if(CH.bonus.t<=0)CH.bonus=null;}
    CH.sirenT-=dt;if(CH.sirenT<=0){CH.sirenT=CH.fright>0?.28:1;if(CH.fright>0)voice({type:'triangle',f0:300,f1:520,dur:.2,vol:.03});}
  }
  else if(CH.phase==='dying'){CH.pt-=dt;if(CH.pt<=0){CH.lives--;if(CH.lives<=0){chGameOver();return;}chPlace();}}
  else if(CH.phase==='clear'){CH.pt-=dt;if(CH.pt<=0){CH.level++;chPickFriends();chLoadGrid();chMakeWalls();chPlace();}}
  for(const q of CH.pops)q.t-=dt*.8;CH.pops=CH.pops.filter(q=>q.t>0);
  $('cScore').textContent=CH.score;$('cLevel').textContent=CH.level;
  if(CH.livesShown!==CH.lives){CH.livesShown=CH.lives;if(!CH.lifeImg)CH.lifeImg=CH.spr&&CH.spr.moonie?CH.spr.moonie.toDataURL():COW_TOKEN;$('cLives').innerHTML=Array.from({length:Math.max(0,CH.lives)},()=>`<img alt="" src="${CH.lifeImg}">`).join('');}
  chDraw();}
function chGameOver(){CH.phase='over';const s=CH.score,b=best('moonie-chomp-best',s,false);const stars=s>=8000?3:s>=3500?2:1;
  showEnd('Game over!',stars,CH.level>1?`Moonie cleared ${CH.level-1} field${CH.level>2?'s':''} of corn before her silly friends tagged her. Delicious!`:'Those silly friends are sneaky! Grab a golden apple, then chase them back.',
    `<div>Score<b>${s}</b></div><div>Field<b>${CH.level}</b></div>`+(b?`<div>High score<b>${b}</b></div>`:''));
  $('end').hidden=false;(device==='pad'?padFocus($('againBtn')):$('againBtn').focus());}
function chEach(px,fn){fn(px);if(px<.6)fn(px+CH.cols);if(px>CH.cols-1.6)fn(px-CH.cols);}
function chDraw(){const x=CH.x,ts=CH.ts,W=CH.cols*ts,H=CH.rows*ts,t=performance.now()/1000;x.clearRect(0,0,W,H);x.drawImage(CH.wall,0,0,W,H);
  if(CH.phase==='clear'&&Math.floor(CH.pt*6)%2===0){x.fillStyle='rgba(255,255,255,.35)';x.fillRect(0,0,W,H);}
  for(let y=0;y<CH.rows;y++)for(let i=0;i<CH.cols;i++){const c=CH.grid[y][i];
    if(c==='.'){if(!CH.kern||CH.kernTs!==ts)chKernel(ts);x.drawImage(CH.kern,(i+.5)*ts-CH.kern.width/(2*CH.dpr),(y+.5)*ts-CH.kern.height/(2*CH.dpr),CH.kern.width/CH.dpr,CH.kern.height/CH.dpr);}
    else if(c==='o')drawApple(x,(i+.5)*ts,(y+.56)*ts,ts*.28*(1+Math.sin(t*6)*.08));}
  if(CH.bonus&&(CH.bonus.t>2||Math.floor(t*8)%2))drawPumpkin(x,(CH.bonus.x+.5)*ts,(CH.bonus.y+.55)*ts,ts*.36);
  const flash=CH.fright>0&&CH.fright<2&&Math.floor(CH.fright*6)%2===0;
  if(CH.phase!=='dying'||CH.pt>1.4)for(const g of CH.gs){const[gx,gy]=chPos(g);const by=g.state==='pen'?Math.sin(g.bob)*.22:0;
    chEach(gx,X=>chDrawFriend(x,(X+.5)*ts,(gy+.5+by)*ts,ts,g,flash));}
  const p=CH.p,[px,py]=chPos(p);
  if(CH.phase==='dying'){const k=clamp(1-CH.pt/1.8);chDrawMoonie(x,(px+.5)*ts,(py+.5)*ts,ts,p,true,k);
    for(let i=0;i<3;i++){const a=t*5+i*2.1;drawStar(x,(px+.5)*ts+Math.cos(a)*ts*.6,(py+.5)*ts-ts*.55+Math.sin(a)*ts*.2,ts*.14,'#ffd23f');}}
  else chEach(px,X=>chDrawMoonie(x,(X+.5)*ts,(py+.5)*ts,ts,p,false,0));
  x.textAlign='center';x.textBaseline='middle';x.font=`${Math.round(ts*.7)}px "Lilita One",sans-serif`;x.lineWidth=3;x.strokeStyle='#1d1510';x.fillStyle='#fff6df';
  for(const q of CH.pops){const yy=(q.y+.5)*ts-(1-q.t)*ts;x.globalAlpha=Math.min(1,q.t*2);x.strokeText(q.v,(q.x+.5)*ts,yy);x.fillText(q.v,(q.x+.5)*ts,yy);}x.globalAlpha=1;}
(function chompInput(){const c=$('chompC');
  c.addEventListener('pointerdown',e=>{audio();CH.swipe={x:e.clientX,y:e.clientY};});
  c.addEventListener('pointermove',e=>{const s=CH.swipe;if(!s)return;const dx=e.clientX-s.x,dy=e.clientY-s.y;if(Math.hypot(dx,dy)>24){CH.want=Math.abs(dx)>Math.abs(dy)?[Math.sign(dx),0]:[0,Math.sign(dy)];CH.swipe={x:e.clientX,y:e.clientY};}});
  addEventListener('pointerup',()=>{CH.swipe=null;});
  $('cPad').addEventListener('pointerdown',e=>{const b=e.target.closest('button');if(!b)return;e.preventDefault();audio();CH.want={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]}[b.dataset.d];});})();

/* ================= MOO CHECKERS ================= */
const TTT={opp:null,oppImg:'',cpu:true,board:[],turn:'m',first:'m',over:false,score:{m:0,o:0,d:0},busy:false,msg:'',seqs:[],taken:[],last:[],quiet:0,nag:0};
const TTT_DIFF={Clucky:[.45,1,'Easy'],Dottie:[.3,1,'Easy'],Pip:[.18,2,'Medium'],Woolly:[.08,3,'Medium'],Gus:[.02,5,'Hard'],Hazel:[0,8,'Super hard'],Kyra:[.12,3,'Medium'],Izzy:[.05,4,'Hard'],Lulu:[.35,1,'Easy'],Dusty:[.15,2,'Medium']};
const ckRC=i=>[i>>3,i&7],ckI=(r,c)=>r*8+c,ckDark=i=>((i>>3)+(i&7))%2===1;
const ckKingRow=(p,i)=>p==='m'?i<8:i>=56;
function ckDirs(pc){return pc.k?[[-1,-1],[-1,1],[1,-1],[1,1]]:pc.p==='m'?[[-1,-1],[-1,1]]:[[1,-1],[1,1]];}
// every legal turn for a player; jumps are compulsory and a jump must keep going while it can
function ckSeqs(b,i,pc,path,caps,acc){const[r,c]=ckRC(i);let any=false;
  for(const[dr,dc]of ckDirs(pc)){const r2=r+2*dr,c2=c+2*dc;if(r2<0||r2>7||c2<0||c2>7)continue;const mi=ckI(r+dr,c+dc),to=ckI(r2,c2),mid=b[mi];
    if(!mid||mid.p===pc.p||b[to])continue;any=true;const nb=b.slice();nb[i]=null;nb[mi]=null;const crown=!pc.k&&ckKingRow(pc.p,to),np=crown?{p:pc.p,k:true}:pc;nb[to]=np;
    if(crown)acc.push({from:path[0],path:path.concat(to),caps:caps.concat(mi)});else ckSeqs(nb,to,np,path.concat(to),caps.concat(mi),acc);}
  if(!any&&caps.length)acc.push({from:path[0],path,caps});}
function ckMoves(b,p){const jumps=[],steps=[];
  for(let i=0;i<64;i++){const pc=b[i];if(!pc||pc.p!==p)continue;ckSeqs(b,i,pc,[i],[],jumps);
    if(!jumps.length){const[r,c]=ckRC(i);for(const[dr,dc]of ckDirs(pc)){const r1=r+dr,c1=c+dc;if(r1<0||r1>7||c1<0||c1>7||b[ckI(r1,c1)])continue;steps.push({from:i,path:[i,ckI(r1,c1)],caps:[]});}}}
  return jumps.length?jumps:steps;}
function ckApply(b,mv){const nb=b.slice();let pc=nb[mv.from];nb[mv.from]=null;for(const c of mv.caps)nb[c]=null;const to=mv.path[mv.path.length-1];if(!pc.k&&ckKingRow(pc.p,to))pc={p:pc.p,k:true};nb[to]=pc;return nb;}
function ckEval(b){let s=0;for(let i=0;i<64;i++){const pc=b[i];if(!pc)continue;const[r,c]=ckRC(i);let v=pc.k?170:100;
    if(!pc.k){v+=(pc.p==='o'?r:7-r)*4;if(pc.p==='o'?r===0:r===7)v+=10;}if(r>1&&r<6&&c>1&&c<6)v+=6;s+=pc.p==='o'?v:-v;}return s;}
function ckSearch(b,p,depth,al,be){const mv=ckMoves(b,p);if(!mv.length)return p==='o'?-10000-depth:10000+depth;if(depth<=0)return ckEval(b);
  if(p==='o'){let best=-1e9;for(const m of mv){const s=ckSearch(ckApply(b,m),'m',depth-1,al,be);if(s>best)best=s;if(best>al)al=best;if(al>=be)break;}return best;}
  let best=1e9;for(const m of mv){const s=ckSearch(ckApply(b,m),'o',depth-1,al,be);if(s<best)best=s;if(best<be)be=best;if(al>=be)break;}return best;}
function ckBest(b,depth){const mv=ckMoves(b,'o');let bs=-1e9,best=mv[0];for(const m of mv){const s=ckSearch(ckApply(b,m),'m',depth-1,-1e9,1e9)+Math.random()*4;if(s>bs){bs=s;best=m;}}return best;}

function tttPicker(){$('tVsCpu').classList.toggle('on',TTT.cpu);$('tVsFriend').classList.toggle('on',!TTT.cpu);
  $('tOpps').innerHTML=FRIENDS.map(f=>{const im=mem.imgs.find(q=>q.f===f);return `<button class="topp" data-n="${f.name}"><img alt="" src="${im.src}"><b>${f.name}</b><span>${TTT.cpu?TTT_DIFF[f.name][2]:'Player 2'}</span></button>`;}).join('');
  $('tPickHint').textContent=TTT.cpu?'Pick an animal to play checkers against. Moonie\'s cows start at the bottom.':'Player 1 is Moonie at the bottom. Player 2 picks an animal to be.';}
function tttShowPicker(){$('tttPick').hidden=false;$('tttGame').hidden=true;tttPicker();setTimeout(()=>{if(device==='pad')padFocus($('tOpps').querySelector('button'));},60);}
function startTTT(){mode='ttt';state='play';hud(['tttUI']);tttShowPicker();}
function tttChoose(name){const f=FRIENDS.find(q=>q.name===name);TTT.opp=f;TTT.oppImg=mem.imgs.find(q=>q.f===f).src;TTT.score={m:0,o:0,d:0};TTT.first='m';
  $('tttPick').hidden=true;$('tttGame').hidden=false;$('tOpImg').src=TTT.oppImg;$('tMeImg').src=COW_TOKEN;$('tOpName').textContent=f.name+(TTT.cpu?'':' (P2)');$('tMeName').textContent=TTT.cpu?'Moonie':'Moonie (P1)';
  $('tttGame').style.setProperty('--oc',({Pip:'#f6a5c0',Clucky:'#ffd23f',Woolly:'#9fd0ff',Dottie:'#ffb347',Gus:'#c2a878',Hazel:'#c98a4a',Kyra:'#6a6260',Izzy:'#8fc4f0',Lulu:'#e0392f',Dusty:'#9b9aa1'})[f.name]||f.color||'#f6b0c0');
  $('tBoard').innerHTML=Array.from({length:64},(_,i)=>`<button class="ck ${ckDark(i)?'d':'l'}" data-i="${i}"${ckDark(i)?'':' tabindex="-1"'}></button>`).join('');friendSound(f,.8,0);tttNew();}
function tttNew(){const b=Array(64).fill(null);for(let i=0;i<64;i++){if(!ckDark(i))continue;const r=i>>3;if(r<3)b[i]={p:'o',k:false};else if(r>4)b[i]={p:'m',k:false};}
  TTT.board=b;TTT.over=false;TTT.busy=false;TTT.last=[];TTT.quiet=0;TTT.turn=TTT.first;TTT.first=TTT.first==='m'?'o':'m';ckTurnStart();
  if(device==='pad'){const s=TTT.seqs[0];padFocus($('tBoard').children[s&&TTT.turn==='m'?s.from:44]);}}
function ckTurnStart(){TTT.seqs=ckMoves(TTT.board,TTT.turn);TTT.taken=[];
  if(!TTT.seqs.length){ckEnd(TTT.turn==='m'?'o':'m');return;}
  if(TTT.quiet>=80){ckEnd('d');return;}
  tttMsg();tttRender();if(TTT.turn==='o'&&TTT.cpu)tttCpu();}
function ckMatching(){const t=TTT.taken;return TTT.seqs.filter(s=>t.every((v,k)=>s.path[k]===v));}
function ckDests(){const t=TTT.taken;if(!t.length)return[];return[...new Set(ckMatching().map(s=>s.path[t.length]).filter(v=>v!=null))];}
const ckName=p=>p==='m'?'Moonie':TTT.opp.name;
function tttMsg(m){if(m){TTT.msg=m;return;}const who=TTT.turn,mid=TTT.taken.length>1;
  if(mid)TTT.msg='Keep jumping!';
  else if(who==='o'&&TTT.cpu)TTT.msg=`${TTT.opp.name} is thinking…`;
  else TTT.msg=(TTT.cpu?'Your turn':`${ckName(who)}'s turn`)+(TTT.seqs[0]&&TTT.seqs[0].caps.length?' — you have to jump!':'!');}
function tttRender(){const cells=[...$('tBoard').children];if(!cells.length)return;const dests=ckDests(),sel=TTT.taken[TTT.taken.length-1],human=!TTT.over&&!(TTT.turn==='o'&&TTT.cpu);
  const movable=human&&!TTT.taken.length?new Set(TTT.seqs.map(s=>s.from)):new Set();
  TTT.board.forEach((pc,i)=>{const c=cells[i];const key=pc?pc.p+(pc.k?'K':''):'';
    if(c.dataset.v!==key){c.dataset.v=key;c.innerHTML=pc?`<i class="pc ${pc.p}${pc.k?' king':''}"><img alt="" src="${pc.p==='m'?COW_TOKEN:TTT.oppImg}"></i>`:'';}
    if(ckDark(i))c.setAttribute('aria-label',`Row ${(i>>3)+1}, column ${(i&7)+1}${pc?`, ${ckName(pc.p)}${pc.k?' king':''}`:''}`);
    c.classList.toggle('sel',human&&i===sel);c.classList.toggle('dest',human&&dests.includes(i));c.classList.toggle('can',movable.has(i));c.classList.toggle('last',TTT.last.includes(i));c.classList.toggle('thinking',TTT.busy);});
  const cnt=p=>TTT.board.filter(q=>q&&q.p===p).length;
  $('tMeS').textContent=TTT.score.m;$('tOpS').textContent=TTT.score.o;$('tDrS').textContent=TTT.score.d;$('tTurn').textContent=TTT.msg;
  $('tMeLeft').textContent=cnt('m')+' left';$('tOpLeft').textContent=cnt('o')+' left';
  $('tMe').classList.toggle('on',!TTT.over&&TTT.turn==='m');$('tOp').classList.toggle('on',!TTT.over&&TTT.turn==='o');}
function tttPlay(i){if(TTT.over||TTT.busy||(TTT.turn==='o'&&TTT.cpu))return;audio();const t=TTT.taken,pc=TTT.board[i];
  if(t.length&&ckDests().includes(i)){ckStep(i);return;}
  if(t.length>1){voice({type:'square',f0:160,f1:140,dur:.12,vol:.06});return;}
  if(pc&&pc.p===TTT.turn){
    if(TTT.seqs.some(s=>s.from===i)){TTT.taken=[i];voice({type:'triangle',f0:520,f1:700,dur:.07,vol:.08});tttRender();}
    else{tttMsg(TTT.seqs[0].caps.length?'You have to jump! Try a glowing piece.':'That piece is stuck. Try a glowing one.');voice({type:'square',f0:180,f1:150,dur:.15,vol:.06});tttRender();clearTimeout(TTT.nag);TTT.nag=setTimeout(()=>{if(!TTT.over&&mode==='ttt'){tttMsg();tttRender();}},1600);}}
  else if(t.length){TTT.taken=[];tttRender();}}
function ckSlide(from,to,fr){try{const cell=$('tBoard').children[to],el=cell&&cell.querySelector('.pc');if(!el||!fr)return;const tr=cell.getBoundingClientRect();const dx=fr.left-tr.left,dy=fr.top-tr.top;
    el.style.animation='none';el.style.transition='none';el.style.transform=`translate(${dx}px,${dy}px) scale(1.12)`;el.getBoundingClientRect();
    el.style.transition='transform .32s cubic-bezier(.3,1.25,.5,1)';el.style.transform='';setTimeout(()=>{el.style.transition='';el.style.animation='';},360);}catch(e){}}
function ckPoof(i){try{const ce=$('tBoard').children[i].querySelector('.pc');if(!ce)return;const r=ce.getBoundingClientRect(),c=ce.cloneNode(true);
    Object.assign(c.style,{position:'fixed',left:r.left+'px',top:r.top+'px',width:r.width+'px',height:r.height+'px',margin:'0',zIndex:40,pointerEvents:'none'});
    c.style.setProperty('--oc',getComputedStyle(ce).getPropertyValue('--oc'));c.classList.add('poof');document.body.appendChild(c);setTimeout(()=>c.remove(),600);
    for(let k=0;k<6;k++){const s=document.createElement('div');s.className='ckstar';s.innerHTML='<svg viewBox="0 0 24 24"><path d="M12 2l3 7 7 .6-5.4 4.6 1.7 7.3L12 17.8 5.7 21.5l1.7-7.3L2 9.6 9 9z" fill="#ffd23f" stroke="#2b2118" stroke-width="2" stroke-linejoin="round"/></svg>';
      const a=k/6*TAU;s.style.left=(r.left+r.width/2)+'px';s.style.top=(r.top+r.height/2)+'px';s.style.setProperty('--dx',Math.cos(a)*r.width+'px');s.style.setProperty('--dy',Math.sin(a)*r.width+'px');document.body.appendChild(s);setTimeout(()=>s.remove(),650);}}catch(e){}}
function ckStep(to){const t=TTT.taken,from=t[t.length-1],s=ckMatching().find(q=>q.path[t.length]===to),cap=s.caps[t.length-1];const fr=$('tBoard').children[from]&&$('tBoard').children[from].getBoundingClientRect();if(cap!=null)ckPoof(cap);const b=TTT.board;let pc=b[from];b[from]=null;
  if(cap!=null){const who=b[cap];b[cap]=null;TTT.quiet=0;if(who&&who.p==='o')friendSound(TTT.opp,.8,0);else voice({type:'triangle',f0:420,f1:180,dur:.25,vol:.12});SFX.pop();}
  else{TTT.quiet++;voice({type:'triangle',f0:pc.p==='m'?440:330,f1:pc.p==='m'?560:400,dur:.08,vol:.09});}
  if(!pc.k&&ckKingRow(pc.p,to)){pc={p:pc.p,k:true};[784,988,1175].forEach((f,k)=>voice({type:'triangle',f0:f,f1:f,dur:.12,vol:.1,delay:k*.08}));}
  b[to]=pc;t.push(to);TTT.last=[from,to];
  const rest=ckMatching();if(rest.length&&rest.some(q=>q.path.length>t.length)){tttMsg();tttRender();ckSlide(from,to,fr);return;}
  TTT.turn=TTT.turn==='m'?'o':'m';ckTurnStart();ckSlide(from,to,fr);
  if(!TTT.over&&device==='pad'&&!(TTT.turn==='o'&&TTT.cpu)){const s=TTT.seqs[0];if(s)padFocus($('tBoard').children[s.from]);}}
function ckEnd(w){TTT.over=true;TTT.taken=[];
  if(w==='d'){TTT.score.d++;tttMsg('Nobody can win this one. It\'s a tie!');voice({type:'sine',f0:300,f1:200,dur:.3,vol:.12,vib:8});}
  else{TTT.score[w]++;if(w==='m'){tttMsg('Moonie wins! The cows rule the board!');SFX.win();moonie.happy=1;}else{tttMsg(`${TTT.opp.name} wins!`);TTT.cpu?SFX.lose():SFX.win();}}
  tttRender();setTimeout(()=>{if(mode==='ttt'&&device==='pad')padFocus($('tNew'));},400);}
function tttCpu(){TTT.busy=true;tttRender();setTimeout(()=>{if(mode!=='ttt'||TTT.over||TTT.turn!=='o'){TTT.busy=false;return;}const[err,depth]=TTT_DIFF[TTT.opp.name];
    const mv=Math.random()<err?TTT.seqs[Math.floor(Math.random()*TTT.seqs.length)]:ckBest(TTT.board,depth);TTT.taken=[mv.from];tttRender();
    const steps=mv.path.slice(1);const go=k=>{if(mode!=='ttt'||TTT.over)return;if(k===steps.length-1)TTT.busy=false;ckStep(steps[k]);if(k<steps.length-1)setTimeout(()=>go(k+1),380);};
    setTimeout(()=>go(0),320);},rnd(450,800));}
(function tttInput(){$('tBoard').addEventListener('click',e=>{const b=e.target.closest('button');if(b)tttPlay(+b.dataset.i);});
  $('tOpps').addEventListener('click',e=>{const b=e.target.closest('button');if(b){audio();tttChoose(b.dataset.n);}});
  $('tVsCpu').onclick=()=>{TTT.cpu=true;tttPicker();};$('tVsFriend').onclick=()=>{TTT.cpu=false;tttPicker();};
  $('tNew').onclick=()=>{audio();tttNew();};$('tChange').onclick=tttShowPicker;$('tFarm').onclick=backToFarm;$('tFarm2').onclick=backToFarm;})();

/* ================= MIX-O-MATIC ================= */
const MIXNAMES={pig:['Pig','iggy'],chicken:['Chick','icken'],sheep:['Sheep','eepy'],duck:['Duck','ucky'],goat:['Goat','oaty'],horse:['Hor','orse'],dog:['Dog','oggy'],cat:['Cat','itty'],llama:['Lla','ama'],donkey:['Donk','onkey']};
const MIX={ready:false,head:null,body:null,r:null,scene:null,cam:null,obj:null,spin:.5,pop:1,busy:false,drag:null,plate:null,cur:null,saved:null,dirty:undefined};
const mixRoot=new THREE.Group();farmRoot.add(mixRoot);const MIXES=[];
const capW=s=>s[0].toUpperCase()+s.slice(1);
function mixName(h,b){if(h===b)return{title:`${capW(h.kind)}-${capW(h.kind)}!`,name:`Just a regular ${h.kind}`};const H=MIXNAMES[h.kind],Bn=MIXNAMES[b.kind];return{title:`${capW(h.kind)}-${capW(b.kind)}!`,name:H[0]+Bn[1]};}
function buildHybrid(hf,bf){const body=bf.build();body.updateMatrixWorld(true);const oh=body.userData.head;const sz=new THREE.Vector3();
  new THREE.Box3().setFromObject(oh).getSize(sz);const rB=sz.length();const hpos=oh.position.clone(),hrot=oh.rotation.clone();oh.parent.remove(oh);
  if(hf===bf){body.add(oh);return body;}
  const donor=hf.build();const nh=donor.userData.head;nh.rotation.set(0,0,0);nh.parent.remove(nh);nh.position.set(0,0,0);nh.updateMatrixWorld(true);
  new THREE.Box3().setFromObject(nh).getSize(sz);const rA=sz.length();const s=clamp(Math.pow(rB/rA,.8),.6,1.7);
  nh.scale.multiplyScalar(s);nh.position.copy(hpos);nh.rotation.copy(hrot);body.add(nh);body.userData.head=nh;body.userData.eyes=donor.userData.eyes;body.userData.ears=donor.userData.ears;return body;}
function mixInit(){if(MIX.r)return;MIX.r=new THREE.WebGLRenderer({canvas:$('mixCanvas'),antialias:true,alpha:true});MIX.r.setPixelRatio(Math.min(devicePixelRatio||1,2));
  MIX.scene=new THREE.Scene();MIX.scene.add(new THREE.HemisphereLight(0xffffff,0x887755,.75));const dl=new THREE.DirectionalLight(0xffffff,.75);dl.position.set(2,4,3);MIX.scene.add(dl);
  MIX.cam=new THREE.PerspectiveCamera(32,1,.1,60);const plate=new THREE.Mesh(cylG(1,1.08,.16,40),M(0xf5c544));plate.position.y=-.08;MIX.scene.add(plate);addOutlines(plate,0,.004);MIX.plate=plate;
  const cv=$('mixCanvas');cv.addEventListener('pointerdown',e=>{MIX.drag={x:e.clientX,s:MIX.spin};cv.setPointerCapture(e.pointerId);});
  cv.addEventListener('pointermove',e=>{if(MIX.drag)MIX.spin=MIX.drag.s+(e.clientX-MIX.drag.x)*.012;});const up=()=>{MIX.drag=null;};cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);}
function mixShow(o){if(MIX.obj)MIX.scene.remove(MIX.obj);MIX.obj=o;addOutlines(o,.07,.0045);MIX.scene.add(o);
  const bb=new THREE.Box3().setFromObject(o),sz=bb.getSize(new THREE.Vector3()),c=bb.getCenter(new THREE.Vector3());
  const d=Math.max(sz.y*1.25,sz.x,sz.z)*2.9+.7;MIX.cam.position.set(0,c.y+d*.3,d);MIX.cam.lookAt(0,c.y*.85,0);MIX.plate.scale.set(Math.max(.55,Math.max(sz.x,sz.z)*.75),1,Math.max(.55,Math.max(sz.x,sz.z)*.75));}
function mixSet(slot,name){MIX[slot]=FRIENDS.find(f=>f.name===name);WHEEL[slot]=FRIENDS.indexOf(MIX[slot]);wheelDraw(slot);
  $(slot==='head'?'mHeadImg':'mBodyImg').src=mem.imgs.find(q=>q.f===MIX[slot]).src;if(!MIX.busy)mixHide();}
function mixHide(){MIX.ready=false;$('machine').classList.remove('ready');$('mKeep').disabled=true;
  $('mixTitle').textContent='Pick a head and a body';$('mixName').textContent='…then pull the lever to see what pops out!';}
/* animal wheels: the pick sits big in the middle, its neighbours peek out smaller behind it on each side */
const WHEEL={head:0,body:0,lastWheel:0};
const CHEV=d=>`<svg viewBox="0 0 16 16" aria-hidden="true"><path d="${d<0?'M11 2 L5 8 L11 14':'M5 2 L11 8 L5 14'}" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
function mixPickers(){const mk=(id,slot)=>{const el=$(id);el.className='wheel';
    el.innerHTML=`<button class="wArr" data-d="-1" aria-label="Previous ${slot}">${CHEV(-1)}</button><button class="wStage" aria-label="${slot==='head'?'Head':'Body'} wheel. Use left and right to spin."></button><button class="wArr" data-d="1" aria-label="Next ${slot}">${CHEV(1)}</button>`;
    const st=el.querySelector('.wStage');st.innerHTML=FRIENDS.map((f,i)=>{const im=mem.imgs.find(q=>q.f===f);return `<span class="wCard" data-i="${i}"><img alt="" src="${im.src}"><span>${f.name}</span></span>`;}).join('');
    el.querySelectorAll('.wArr').forEach(b=>b.onclick=()=>wheelStep(slot,+b.dataset.d));
    let x0=null,moved=false;
    st.addEventListener('pointerdown',e=>{x0=e.clientX;moved=false;try{st.setPointerCapture(e.pointerId);}catch(_){}});
    st.addEventListener('pointermove',e=>{if(x0==null)return;const dx=e.clientX-x0,step=Math.max(34,st.clientWidth*.2);if(Math.abs(dx)>8)moved=true;if(Math.abs(dx)>step){wheelStep(slot,dx<0?1:-1);x0=e.clientX;}});
    const up=()=>{x0=null;};st.addEventListener('pointerup',up);st.addEventListener('pointercancel',up);
    st.addEventListener('click',e=>{if(moved){moved=false;return;}const c=e.target.closest('.wCard');if(c){const d=+c.dataset.d;if(d)wheelStep(slot,d);}});
    st.addEventListener('wheel',e=>{e.preventDefault();const now=performance.now();if(now-WHEEL.lastWheel<140)return;const v=Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY;if(Math.abs(v)<4)return;WHEEL.lastWheel=now;wheelStep(slot,v>0?1:-1);},{passive:false});
    wheelDraw(slot);};
  mk('mHeads','head');mk('mBodies','body');}
function wheelStep(slot,d){if(MIX.busy)return;audio();const n=FRIENDS.length;const i=((WHEEL[slot]+d)%n+n)%n;mixSet(slot,FRIENDS[i].name);
  voice({type:'triangle',f0:d>0?520:480,f1:d>0?660:600,dur:.06,vol:.07});voice({type:'square',f0:1800,f1:1800,dur:.015,vol:.02,filt:3000});}
function wheelDraw(slot){const el=$(slot==='head'?'mHeads':'mBodies');if(!el)return;const n=FRIENDS.length,c=WHEEL[slot];
  el.querySelectorAll('.wCard').forEach(b=>{const i=+b.dataset.i;let d=((i-c)%n+n)%n;if(d>n/2)d-=n;const prev=b.dataset.d==null?null:+b.dataset.d;
    b.classList.toggle('jump',prev!=null&&Math.abs(d-prev)>2);b.dataset.d=d;const a=Math.abs(d),s=Math.sign(d);
    const [x,sc,op,ry]=a===0?[0,1,1,0]:a===1?[86,.74,.95,28]:a===2?[148,.52,.55,40]:[200,.34,0,45];
    b.style.transform=`translateX(${s*x}%) rotateY(${-s*ry}deg) scale(${sc})`;b.style.opacity=op;b.style.zIndex=10-a;b.style.pointerEvents=a>2?'none':'';
    b.classList.toggle('c',a===0);b.classList.toggle('s',a>0);});
  const st=el.querySelector('.wStage');if(st)st.setAttribute('aria-valuetext',FRIENDS[c].name);}
function startMixer(){mode='mixer';state='play';hud(['mixUI']);mixInit();if(!$('mHeads').children.length)mixPickers();
  if(!MIX.head){mixSet('head','Clucky');mixSet('body','Hazel');}else{mixSet('head',MIX.head.name);mixSet('body',MIX.body.name);}
  mixHide();setTimeout(()=>{if(device==='pad')padFocus($('mixGo'));},60);}
function mixDo(instant){if(MIX.busy||!MIX.head||!MIX.body)return;const h=MIX.head,b=MIX.body;audio();
  const done=()=>{mixShow(buildHybrid(h,b));MIX.pop=instant?1:-.35;const n=mixName(h,b);$('mixTitle').textContent=n.title;$('mixName').textContent=n.name===`Just a regular ${h.kind}`?n.name:`Say hi to ${n.name}!`;
    MIX.cur={h:h.name,b:b.name,name:n.name};$('mKeep').disabled=h===b;MIX.ready=true;$('machine').classList.add('ready');
    if(!instant){friendSound(h,.9,0);friendSound(b,.9,0,.4);voice({type:'triangle',f0:1046,f1:1046,dur:.25,vol:.12,delay:.05});}MIX.busy=false;$('machine').classList.remove('mixing');};
  if(instant){done();return;}
  MIX.busy=true;MIX.ready=false;$('machine').classList.remove('ready');$('machine').classList.add('mixing');$('mKeep').disabled=true;if(MIX.obj)MIX.obj.visible=false;$('mixTitle').textContent='Mixing…';$('mixName').textContent='';
  noiseBurst(.15,.2,700);voice({type:'square',f0:200,f1:180,dur:.12,vol:.08,delay:.05});voice({type:'sawtooth',f0:90,f1:420,dur:1.3,vol:.07,filt:1400,vib:9,delay:.15});
  [0,.3,.6,.9,1.2].forEach(d=>noiseBurst(.08,.08,1200+d*800,0,.2+d));voice({type:'sine',f0:300,f1:900,dur:.25,vol:.12,delay:1.35});
  setTimeout(done,1600);}
function mixLoad(){if(!MIX.saved){try{const v=JSON.parse(localStorage.getItem('moonie-mixes')||'[]');MIX.saved=Array.isArray(v)?v.filter(q=>q&&q.h&&q.b):[];}catch(e){MIX.saved=[];}}return MIX.saved.slice();}
function mixKeep(){if(!MIX.cur||MIX.busy)return;const list=mixLoad();list.push({h:MIX.cur.h,b:MIX.cur.b});while(list.length>4)list.shift();MIX.saved=list;MIX.dirty=true;
  try{localStorage.setItem('moonie-mixes',JSON.stringify(list));}catch(e){}
  toast(`<b>${MIX.cur.name}</b>is off to roam the farm! Look for them when you go back outside.`,2800);[523,784].forEach((f,i)=>voice({type:'triangle',f0:f,f1:f,dur:.15,vol:.1,delay:i*.1}));}
function spawnMixes(){while(mixRoot.children.length)mixRoot.remove(mixRoot.children[0]);MIXES.length=0;
  for(const r of mixLoad()){const h=FRIENDS.find(f=>f.name===r.h),b=FRIENDS.find(f=>f.name===r.b);if(!h||!b)continue;const o=buildHybrid(h,b);addOutlines(o,.085,.0048);
    o.traverse(q=>{if(q.isMesh){q.userData.noPaint=true;if(!q.userData.isOutline)q.castShadow=true;}});blob(b.size===3?.6:b.size===2?.45:.3,o);
    const a=rnd(0,TAU),d=rnd(4,9);o.position.set(Math.cos(a)*d,0,4+Math.sin(a)*d*.8);resolve(o.position,.4);mixRoot.add(o);
    MIXES.push({state:'roam',obj:o,size:b.size,sound:h.sound,name:mixName(h,b).name,roam:null,hop:0,knock:null});}}
const easeBack=t=>1+2.7*Math.pow(t-1,3)+1.7*Math.pow(t-1,2);
function updateMixer(dt){if(!MIX.r)return;const cv=$('mixCanvas'),w=cv.clientWidth,h=cv.clientHeight;if(!w||!h)return;
  if(cv.width!==Math.round(w*MIX.r.getPixelRatio())||cv.height!==Math.round(h*MIX.r.getPixelRatio())){MIX.r.setSize(w,h,false);MIX.cam.aspect=w/h;MIX.cam.updateProjectionMatrix();}
  if(MIX.obj){if(!MIX.drag)MIX.spin+=dt*.7;MIX.obj.rotation.y=MIX.spin;MIX.obj.visible=MIX.ready&&!MIX.busy;if(MIX.pop<1){if(MIX.ready)MIX.pop=Math.min(1,MIX.pop+dt*2.2);}const s=MIX.pop<1?(MIX.pop<=0?.01:Math.max(.01,easeBack(MIX.pop))):1;MIX.obj.scale.setScalar(s);
    const ey=MIX.obj.userData.eyes;if(ey){MIX.blinkT=(MIX.blinkT??2)-dt;const k=MIX.blinkT<0&&MIX.blinkT>-.14?.1:1;if(MIX.blinkT<-.14)MIX.blinkT=rnd(2,4);ey.forEach(e=>e.scale.y=k);}}
  MIX.plate.rotation.y=MIX.spin;MIX.r.render(MIX.scene,MIX.cam);}
(function mixInput(){$('mixUI').addEventListener('click',e=>{const b=e.target.closest('.mpk');if(b&&!MIX.busy){audio();mixSet(b.dataset.slot,b.dataset.n);voice({type:'triangle',f0:500,f1:640,dur:.07,vol:.07});}});
  $('mixGo').onclick=()=>{if(!MIX.busy)voice({type:'square',f0:140,f1:90,dur:.12,vol:.1});mixDo(false);};$('mRandom').onclick=()=>{if(MIX.busy)return;const r=()=>FRIENDS[Math.floor(Math.random()*FRIENDS.length)].name;let a=r(),b=r();while(b===a)b=r();mixSet('head',a);mixSet('body',b);mixDo(false);};
  $('mKeep').onclick=mixKeep;$('mFarm').onclick=backToFarm;})();

/* ================= MOO PIX (wacky coloring book) ================= */
const KP={ants:[],drops:[],tool:'pencil',variant:{brush:'paint',eraser:'rubber',stamp:0},size:1,color:'#e0393a',hue:0,undo:[],down:false,last:null,acc:0,sndD:0,page:'moonie',paint:null,lines:null,fx:null,stamps:[],dyn:null,cursor:{x:.5,y:.5},inited:false,showPages:false};
const KP_COLORS=['#1d1510','#ffffff','#e0393a','#ff8a2a','#ffd23f','#9be05a','#3fa34d','#2fc4b2','#7fd3ff','#3d6fd6','#8f55e6','#ff7fc0','#8a5a30','#f1c294','#9aa1aa','#f5b800','rainbow'];
const KP_SIZES=[4,10,22];
const KP_TOOLS=[['pencil','Pencil'],['brush','Brush'],['bucket','Fill'],['stamp','Stamps'],['eraser','Eraser']];
const KP_ANT_EAT=10,KP_ANT_MAX=44;
const KP_PAGES=[['moonie','Moonie'],['barn','The barn'],['pig','Pip in the mud'],['farm1','Activity page'],['farm2','Connect the dots'],['farm3','Match the friends'],['farm4','Placemat'],['blank','Blank page']];
// picture pages: black line art on a see-through background (2000x1400, drawn at half size on the page)
const KP_IMG={farm1:embeddedImage('kp-farm1.png'),farm2:embeddedImage('kp-farm2.png'),farm3:embeddedImage('kp-farm3.png'),farm4:embeddedImage('kp-farm4.png')},KP_IMGS={};
function kpImg(name){if(!KP_IMG[name])return null;if(!KP_IMGS[name]){const im=new Image();im.onload=()=>{if(KP.inited&&KP.page===name&&!KP.undo.length)kpPage(name);if(KP.showPages)kpOpts();};im.src=KP_IMG[name];KP_IMGS[name]=im;}return KP_IMGS[name];}
const KP_ICONS={
 pencil:'<svg viewBox="0 0 48 48" aria-hidden="true"><g transform="rotate(45 24 24)"><rect x="18" y="4" width="12" height="30" rx="2" fill="#ffd23f" stroke="#1d1510" stroke-width="3"/><path d="M18 34 L24 46 L30 34Z" fill="#f1c294" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/><path d="M22.5 43 L24 46 L25.5 43Z" fill="#1d1510"/><rect x="18" y="4" width="12" height="6" fill="#ff7fc0" stroke="#1d1510" stroke-width="3"/></g></svg>',
 brush:'<svg viewBox="0 0 48 48" aria-hidden="true"><g transform="rotate(35 24 24)"><rect x="21" y="2" width="6" height="22" rx="3" fill="#8a5a30" stroke="#1d1510" stroke-width="3"/><rect x="18" y="22" width="12" height="6" fill="#9aa1aa" stroke="#1d1510" stroke-width="3"/><path d="M18 28 Q16 40 24 46 Q32 40 30 28Z" fill="#e0393a" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/></g></svg>',
 bucket:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 16 L14 42 Q24 46 34 42 L38 16Z" fill="#7fd3ff" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/><ellipse cx="24" cy="16" rx="14" ry="5" fill="#3d6fd6" stroke="#1d1510" stroke-width="3"/><path d="M38 17 Q46 22 42 32 Q40 36 42 40" fill="none" stroke="#3d6fd6" stroke-width="5" stroke-linecap="round"/></svg>',
 stamp:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="18" y="4" width="12" height="16" rx="5" fill="#8f55e6" stroke="#1d1510" stroke-width="3"/><rect x="8" y="20" width="32" height="10" rx="3" fill="#c79a62" stroke="#1d1510" stroke-width="3"/><rect x="6" y="30" width="36" height="8" rx="2" fill="#ff7fc0" stroke="#1d1510" stroke-width="3"/><path d="M14 44h20" stroke="#ff7fc0" stroke-width="4" stroke-linecap="round"/></svg>',
 eraser:'<svg viewBox="0 0 48 48" aria-hidden="true"><g transform="rotate(-30 24 24)"><rect x="8" y="16" width="32" height="16" rx="4" fill="#ff9fb0" stroke="#1d1510" stroke-width="3"/><rect x="8" y="16" width="12" height="16" rx="4" fill="#7fd3ff" stroke="#1d1510" stroke-width="3"/></g></svg>'};
function kpS(L,f){L.save();L.globalCompositeOperation='destination-out';L.beginPath();f();L.fill();L.restore();L.beginPath();f();L.stroke();}
function kpCloud(L,cx,cy,rx,ry,n){for(let i=0;i<=96;i++){const a=i/96*TAU,k=.8+.26*Math.abs(Math.sin(a*n/2));const px=cx+Math.cos(a)*rx*k,py=cy+Math.sin(a)*ry*k;i?L.lineTo(px,py):L.moveTo(px,py);}L.closePath();}
function kpBlob(L,cx,cy,rx,ry,n){for(let i=0;i<=72;i++){const a=i/72*TAU,k=1+.14*Math.sin(a*n+1.3);const px=cx+Math.cos(a)*rx*k,py=cy+Math.sin(a)*ry*k;i?L.lineTo(px,py):L.moveTo(px,py);}L.closePath();}
function kpFlowerLA(L,cx,cy,r){L.beginPath();L.moveTo(cx,cy+r*.5);L.lineTo(cx,cy+r*2.4);L.stroke();for(let i=0;i<5;i++){const a=i/5*TAU-Math.PI/2;kpS(L,()=>L.arc(cx+Math.cos(a)*r*.8,cy+Math.sin(a)*r*.8,r*.55,0,TAU));}kpS(L,()=>L.arc(cx,cy,r*.45,0,TAU));}
function kpSun(L,cx,cy,r){kpS(L,()=>L.arc(cx,cy,r,0,TAU));for(let i=0;i<12;i++){const a=i/12*TAU;L.beginPath();L.moveTo(cx+Math.cos(a)*(r+16),cy+Math.sin(a)*(r+16));L.lineTo(cx+Math.cos(a)*(r+40),cy+Math.sin(a)*(r+40));L.stroke();}}
function kpPage(name,ctx){const L=ctx||KP.lines;L.clearRect(0,0,1000,700);
  if(KP_IMG[name]){const im=kpImg(name);if(im.complete&&im.naturalWidth)L.drawImage(im,0,0,1000,700);return;}
  L.lineWidth=7;L.strokeStyle='#1d1510';L.fillStyle='#1d1510';L.lineJoin='round';L.lineCap='round';
  const dot=(x,y,r)=>{L.beginPath();L.arc(x,y,r,0,TAU);L.fill();};
  if(name==='moonie'){
    kpSun(L,870,105,56);kpS(L,()=>kpCloud(L,230,115,92,50,7));
    L.beginPath();L.moveTo(-10,565);L.bezierCurveTo(250,520,520,600,1010,545);L.stroke();
    L.beginPath();L.moveTo(232,410);L.bezierCurveTo(180,400,160,450,170,500);L.stroke();kpS(L,()=>L.ellipse(172,518,16,24,0,0,TAU));
    for(const lx of[262,340,446,524]){kpS(L,()=>rrp(L,lx,478,54,112,22));kpS(L,()=>rrp(L,lx-5,572,64,30,12));}
    kpS(L,()=>L.ellipse(410,440,190,108,0,0,TAU));kpS(L,()=>kpBlob(L,330,412,52,40,5));kpS(L,()=>kpBlob(L,482,470,42,32,4));
    kpS(L,()=>L.ellipse(555,245,52,24,-.45,0,TAU));kpS(L,()=>L.ellipse(765,245,52,24,.45,0,TAU));
    kpS(L,()=>{L.moveTo(605,215);L.quadraticCurveTo(590,150,625,140);L.quadraticCurveTo(632,180,642,205);L.closePath();});
    kpS(L,()=>{L.moveTo(715,215);L.quadraticCurveTo(730,150,695,140);L.quadraticCurveTo(688,180,678,205);L.closePath();});
    kpS(L,()=>L.ellipse(660,300,108,100,0,0,TAU));kpS(L,()=>kpBlob(L,724,250,34,26,5));
    kpS(L,()=>L.ellipse(620,282,20,26,0,0,TAU));kpS(L,()=>L.ellipse(700,282,20,26,0,0,TAU));dot(624,288,9);dot(704,288,9);
    kpS(L,()=>L.ellipse(660,362,76,48,0,0,TAU));kpS(L,()=>L.ellipse(632,352,9,13,0,0,TAU));kpS(L,()=>L.ellipse(688,352,9,13,0,0,TAU));
    L.beginPath();L.moveTo(628,384);L.quadraticCurveTo(660,402,692,384);L.stroke();
    kpFlowerLA(L,110,618,24);kpFlowerLA(L,905,622,28);kpFlowerLA(L,812,600,18);
    for(const gx of[50,200,610,740,960]){L.beginPath();L.moveTo(gx-12,688);L.lineTo(gx-5,664);L.lineTo(gx,688);L.lineTo(gx+6,660);L.lineTo(gx+12,688);L.stroke();}}
  else if(name==='barn'){
    kpSun(L,120,105,50);kpS(L,()=>kpCloud(L,440,105,88,46,7));kpS(L,()=>kpCloud(L,760,80,72,40,6));
    L.beginPath();L.moveTo(-10,580);L.bezierCurveTo(300,550,700,605,1010,565);L.stroke();
    kpS(L,()=>rrp(L,840,385,46,215,10));kpS(L,()=>kpCloud(L,862,322,108,90,7));
    kpS(L,()=>rrp(L,20,486,280,22,6));kpS(L,()=>rrp(L,20,530,280,22,6));
    for(const px of[34,124,214]){kpS(L,()=>{L.moveTo(px,470);L.lineTo(px+20,450);L.lineTo(px+40,470);L.lineTo(px+40,595);L.lineTo(px,595);L.closePath();});}
    kpS(L,()=>{L.moveTo(300,595);L.lineTo(300,330);L.lineTo(500,205);L.lineTo(700,330);L.lineTo(700,595);L.closePath();});
    L.beginPath();L.moveTo(280,345);L.lineTo(500,186);L.lineTo(720,345);L.stroke();
    kpS(L,()=>rrp(L,462,262,76,62,6));L.beginPath();L.moveTo(500,262);L.lineTo(500,324);L.moveTo(462,293);L.lineTo(538,293);L.stroke();
    kpS(L,()=>rrp(L,415,425,170,170,6));L.beginPath();L.moveTo(500,425);L.lineTo(500,595);L.moveTo(415,425);L.lineTo(500,595);L.moveTo(500,425);L.lineTo(415,595);L.moveTo(500,425);L.lineTo(585,595);L.moveTo(585,425);L.lineTo(500,595);L.stroke();
    kpS(L,()=>rrp(L,600,525,130,70,18));L.beginPath();L.moveTo(643,527);L.lineTo(643,593);L.moveTo(688,527);L.lineTo(688,593);L.stroke();
    kpS(L,()=>L.ellipse(780,610,26,22,0,0,TAU));kpS(L,()=>L.arc(800,586,15,0,TAU));kpS(L,()=>{L.moveTo(812,582);L.lineTo(828,588);L.lineTo(812,594);L.closePath();});dot(803,582,4);}
