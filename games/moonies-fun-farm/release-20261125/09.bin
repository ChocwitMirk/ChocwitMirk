    kpS(L,()=>L.ellipse(815,228,30,22,-.6,0,TAU));kpS(L,()=>L.ellipse(818,268,22,16,.5,0,TAU));kpS(L,()=>L.ellipse(885,228,30,22,.6,0,TAU));kpS(L,()=>L.ellipse(882,268,22,16,-.5,0,TAU));kpS(L,()=>L.ellipse(850,248,8,30,0,0,TAU));}}
function kpNewPage(name){kpUp();KP.page=name;KP.ants.length=0;KP.antRun=null;KP.paint.fillStyle='#ffffff';KP.paint.fillRect(0,0,1000,700);kpPage(name);KP.sticker.clearRect(0,0,1000,700);KP.undo=[];KP.showPages=false;kpOpts();}
function kpSetTool(t){kpUp();KP.tool=t;if(t!=='bucket'&&KP.color==='rainbow')KP.color='#e0393a';KP.showPages=false;KP.showPrint=false;document.querySelectorAll('#kpTools .kpt').forEach(b=>b.classList.toggle('on',b.dataset.tool===t));kpOpts();kpSnd('tool');}
function kpSetColor(c){if(c==='rainbow'&&KP.tool!=='bucket')kpSetTool('bucket');KP.color=c;v8Tone(60+[0,2,4,5,7,9,11][KP_COLORS.indexOf(c)%7]+12*Math.floor(KP_COLORS.indexOf(c)/7));document.querySelectorAll('#kpColors .kpc').forEach(b=>b.classList.toggle('on',b.dataset.col===c));if(KP.tool==='stamp'||KP.tool==='brush'||KP.tool==='bucket')kpOpts();}
const kpGlyphIcon=g=>()=>`<svg viewBox="0 0 48 48"><text x="24" y="32" font-size="27" text-anchor="middle" fill="#3d6fd6">${g}</text></svg>`;
const KP_OPT_ICONS={
 wacky:kpGlyphIcon('✿'),tree:kpGlyphIcon('🌳'),alphabet:kpGlyphIcon('ABC'),dingdong:kpGlyphIcon('🔔'),drip:c=>kpCanIcon(c),raincan:()=>kpCanIcon('rainbow'),fill:()=>KP_ICONS.bucket,
 paint:c=>`<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6 C30 6 32 12 38 12 C44 14 44 22 40 26 C44 32 40 40 33 38 C30 44 20 44 18 38 C10 40 4 34 8 28 C3 22 8 14 14 14 C16 8 20 6 24 6Z" fill="${c}" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/><circle cx="19" cy="20" r="3.5" fill="#fff" opacity=".7"/></svg>`,
 rainbow:()=>`<svg viewBox="0 0 48 48" aria-hidden="true">${[['#e0393a',20],['#ff8a2a',16.5],['#ffd23f',13],['#3fa34d',9.5],['#3d6fd6',6]].map(([c,r])=>`<path d="M${24-r} 38 A${r} ${r} 0 0 1 ${24+r} 38" fill="none" stroke="${c}" stroke-width="4"/>`).join('')}<path d="M2 38h44" stroke="#1d1510" stroke-width="3" stroke-linecap="round"/><path d="M2 38 A22 22 0 0 1 46 38" fill="none" stroke="#1d1510" stroke-width="2.5"/></svg>`,
 spray:c=>`<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="22" y="16" width="16" height="28" rx="4" fill="#9aa1aa" stroke="#1d1510" stroke-width="3"/><rect x="22" y="24" width="16" height="10" fill="${c}" stroke="#1d1510" stroke-width="2"/><rect x="26" y="9" width="8" height="7" rx="2" fill="#5f6a75" stroke="#1d1510" stroke-width="3"/>${[[16,10],[12,15],[17,19],[9,9],[8,21],[13,26],[5,15]].map(([x,y])=>`<circle cx="${x}" cy="${y}" r="2.2" fill="${c}" stroke="#1d1510" stroke-width="1"/>`).join('')}</svg>`,
 bubbles:()=>`<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="18" cy="28" r="12" fill="#bfe9ff" stroke="#1d1510" stroke-width="3"/><circle cx="34" cy="16" r="8" fill="#ffd6ef" stroke="#1d1510" stroke-width="3"/><circle cx="36" cy="36" r="5.5" fill="#d9ffc7" stroke="#1d1510" stroke-width="2.5"/><path d="M12 23 Q14 19 18 19" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="M31 12 Q32 10 35 10" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>`,
 rubber:()=>KP_ICONS.eraser,
 dynamite:()=>`<svg viewBox="0 0 48 48" aria-hidden="true"><g transform="rotate(-25 24 28)"><rect x="10" y="22" width="28" height="14" rx="4" fill="#e0393a" stroke="#1d1510" stroke-width="3"/><path d="M16 22v14M32 22v14" stroke="#1d1510" stroke-width="2"/></g><path d="M33 19 Q38 12 34 8" fill="none" stroke="#1d1510" stroke-width="3" stroke-linecap="round"/><path d="M34 2 l2 4 4 -1 -2 4 3 3 -4 1 0 4 -3 -3 -3 3 0 -4 -4 -1 3 -3 -2 -4 4 1Z" fill="#ffd23f" stroke="#1d1510" stroke-width="1.5" stroke-linejoin="round" transform="translate(1 1) scale(.85) translate(6 0)"/></svg>`,
 sprayer:()=>`<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="4" y="24" width="22" height="10" rx="3" fill="#ffd23f" stroke="#1d1510" stroke-width="3"/><path d="M10 34 l-3 10 h8 l2-10" fill="#5f6a75" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/><rect x="26" y="26" width="10" height="6" fill="#9aa1aa" stroke="#1d1510" stroke-width="2.5"/>${[[40,22,3],[44,28,2.5],[42,34,3],[46,18,2],[47,38,2]].map(([x,y,r])=>`<circle cx="${x}" cy="${y}" r="${r}" fill="#7fd0ff" stroke="#1d1510" stroke-width="1.2"/>`).join('')}</svg>`,
 ants:()=>`<svg viewBox="0 0 48 48" aria-hidden="true">${[[14,30,-20],[30,18,25],[34,36,0]].map(([x,y,a])=>`<g transform="translate(${x} ${y}) rotate(${a})"><path d="M-6 -5 l-4 -3 M-6 5 l-4 3 M0 -5 v-5 M0 5 v5 M6 -5 l4 -3 M6 5 l4 3" stroke="#1d1510" stroke-width="2" stroke-linecap="round"/><circle cx="-7" cy="0" r="4.5" fill="#2b2118"/><circle cx="0" cy="0" r="3.5" fill="#2b2118"/><circle cx="7" cy="0" r="4" fill="#2b2118"/><path d="M10 -2 l4 -4 M10 2 l4 4" stroke="#1d1510" stroke-width="1.8" stroke-linecap="round"/></g>`).join('')}</svg>`,
 tap:()=>`<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M20 30 V10 a4 4 0 0 1 8 0 V24 l8 2 a5 5 0 0 1 4 6 l-2 10 H22 l-8 -8 a3.5 3.5 0 0 1 5 -5Z" fill="#fff6df" stroke="#1d1510" stroke-width="3" stroke-linejoin="round"/><path d="M14 8 l-4 -4 M24 2V-2 M34 8 l4 -4" stroke="#ffd23f" stroke-width="3" stroke-linecap="round"/></svg>`};
const kpPic=(icon,label,attrs,on,c)=>`<button class="kpo pic${on?' on':''}" ${attrs} aria-label="${label}">${KP_OPT_ICONS[icon](c)}<span>${label}</span></button>`;
function kpCanIcon(col){const colors=['#e0393a','#ff8a2a','#ffd23f','#3fa34d','#3d6fd6','#8f55e6'];return `<svg viewBox="0 0 48 48"><path d="M10 17V10Q24 -1 38 10V17" fill="none" stroke="#65717e" stroke-width="3"/><rect x="7" y="13" width="34" height="30" rx="5" fill="#c8ced5" stroke="#1d1510" stroke-width="3"/>${col==='rainbow'?colors.map((c,i)=>`<path d="M${8+i*5.3} 15h5.4v${10+i%3*4}q-2.7 8 -5.4 0z" fill="${c}"/>`).join(''):`<path d="M8 15H40V24Q35 30 32 23V32Q27 39 23 31V22Q17 30 13 23L8 26Z" fill="${col}"/>`}<ellipse cx="24" cy="14" rx="16" ry="4" fill="${col==='rainbow'?colors[0]:col}" stroke="#1d1510" stroke-width="2"/></svg>`;}
const KP_THUMBS={};
function kpThumb(name){if(KP_THUMBS[name])return KP_THUMBS[name];if(KP_IMG[name]){const im=kpImg(name);if(!(im.complete&&im.naturalWidth))return'';}const big=document.createElement('canvas');big.width=1000;big.height=700;const bx=big.getContext('2d');kpPage(name,bx);
  const t=document.createElement('canvas');t.width=120;t.height=84;const tx=t.getContext('2d');tx.fillStyle='#fff';tx.fillRect(0,0,120,84);tx.drawImage(big,0,0,120,84);return KP_THUMBS[name]=t.toDataURL();}
function kpOpts(){const o=$('kpOpts');let h='';
  if(KP.showPrint)h=`<button class="kpo pg" data-print="blank"><img alt="" src="${kpThumb(KP.page)}"><span>Blank page</span></button><button class="kpo pg" data-print="color"><img alt="" src="${kpColorThumb()}"><span>My coloring</span></button><span class="kphint">Saves a picture you can open and print</span>`;
  else if(KP.showPages)h=KP_PAGES.map(p=>`<button class="kpo pg${KP.page===p[0]?' on':''}" data-page="${p[0]}" aria-label="${p[1]}"><img alt="" src="${kpThumb(p[0])}"><span>${p[1]}</span></button>`).join('')+'<span class="kphint">Your coloring gets cleared</span>';
  else if(KP.tool==='bucket'){h=[['fill','Fill'],['drip','Drip can']].map(v=>kpPic(v[0],v[1],`data-var="${v[0]}"`,(KP.variant.bucket||'fill')===v[0],KP.color)).join('');h+='<span class="kphint">Fill a shape, or hold a dripping can over the page!</span>';}
  else if(KP.tool==='stamp'){h=KP.stamps.map((s,i)=>`<button class="kpo stp${KP.variant.stamp===i?' on':''}" data-stamp="${i}" aria-label="${s.name} stamp">${s.src?`<img alt="" src="${s.src}">`:s.glyph?`<span style="font-size:25px">${s.glyph}</span>`:`<canvas width="44" height="44" data-shape="${s.shape}"></canvas>`}</button>`).join('');
    h+=KP_SIZES.map((s,i)=>`<button class="kpo size${KP.size===i?' on':''}" data-size="${i}" aria-label="Stamp size ${i+1}"><i style="width:${6+i*7}px;height:${6+i*7}px"></i></button>`).join('');}
  else{if(KP.tool==='brush')h+=[['paint','Paint'],['rainbow','Rainbow'],['spray','Spray'],['bubbles','Bubbles'],['wacky','Wacky'],['tree','Tree'],['alphabet','ABC']].map(v=>kpPic(v[0],v[1],`data-var="${v[0]}"`,KP.variant.brush===v[0],KP.color)).join('');
    if(KP.tool==='eraser')h+=[['rubber','Rubber'],['sprayer','Sprayer'],['ants','Ants'],['dynamite','Dynamite!'],['dingdong','Ding Dong']].map(v=>kpPic(v[0],v[1],`data-var="${v[0]}"`,KP.variant.eraser===v[0])).join('');
    if(KP.tool==='eraser'&&KP.variant.eraser==='dynamite')h+=`<span class="kpicohint">${KP_OPT_ICONS.tap()}</span><span class="kphint">${isTouch()?'Tap':'Click'} the page to light the fuse!</span>`;
    if(KP.tool==='eraser'&&KP.variant.eraser==='ants')h+=`<span class="kpicohint">${KP_OPT_ICONS.tap()}</span><span class="kphint">${isTouch()?'Tap':'Click'} the page to let the hungry ants out!</span>`;
    if(KP.tool==='eraser'&&KP.variant.eraser==='sprayer')h+=`<span class="kphint">Drag to blast the colors away!</span>`;
    else h+=KP_SIZES.map((s,i)=>`<button class="kpo size${KP.size===i?' on':''}" data-size="${i}" aria-label="Size ${i+1}"><i style="width:${6+i*7}px;height:${6+i*7}px"></i></button>`).join('');}
  o.innerHTML=h;o.querySelectorAll('canvas[data-shape]').forEach(c=>kpShapeDraw(c.getContext('2d'),c.dataset.shape,22,22,18,KP.color));}
function kpShapeDraw(x,shape,cx,cy,r,col){if(shape==='star')drawStar(x,cx,cy,r,col);else if(shape==='heart')drawHeart(x,cx,cy,r,col);else if(shape==='flower')drawFlowerS(x,cx,cy,r,col);else drawSunS(x,cx,cy,r,col);}
function kpSnap(){KP.undo.push([KP.paint.getImageData(0,0,1000,700),KP.sticker.getImageData(0,0,1000,700)]);if(KP.undo.length>15)KP.undo.shift();}
function kpUndo(){if(KP.dyn)return;kpUp();KP.ants.length=0;KP.antRun=null;if(KP.undo.length){const u=KP.undo.pop();KP.paint.putImageData(u[0],0,0);KP.sticker.putImageData(u[1],0,0);kpSnd('undo');}else toast('Nothing to undo yet.',1200);}
function kpSnd(k,y){if(!AC)return;const p=(700-(y==null?350:y))/700;
  if(k==='pencil')noiseBurst(.05,.05,2500+p*3000);else if(k==='paint')voice({type:'sine',f0:180+p*500,f1:220+p*520,dur:.08,vol:.06});
  else if(k==='rainbow')voice({type:'triangle',f0:300+KP.hue*2,f1:340+KP.hue*2,dur:.07,vol:.06});else if(k==='spray')noiseBurst(.07,.05,6500);
  else if(k==='bubbles')voice({type:'sine',f0:rnd(500,1000),f1:rnd(1100,1600),dur:.06,vol:.07});else if(k==='eraser')noiseBurst(.06,.05,900);else if(k==='sprayer'){noiseBurst(.18,.09,4200);noiseBurst(.12,.05,1200);}
  else if(k==='gloop'){voice({type:'sine',f0:700,f1:120,dur:.35,vol:.16});voice({type:'sine',f0:300,f1:600,dur:.12,vol:.08,delay:.3});}
  else if(k==='stamp')voice({type:'square',f0:rnd(300,600),f1:rnd(700,1200),dur:.09,vol:.08,filt:2400});
  else if(k==='undo'){voice({type:'triangle',f0:520,f1:500,dur:.14,vol:.12});voice({type:'triangle',f0:390,f1:370,dur:.2,vol:.12,delay:.16});}
  else if(k==='tool')voice({type:'triangle',f0:660,f1:880,dur:.06,vol:.06});}
function kpHex(c){const n=parseInt(c.slice(1),16);return[n>>16&255,n>>8&255,n&255];}
function kpFill(sx,sy,hex,region=null){sx=Math.floor(sx);sy=Math.floor(sy);const W=1000,H=700;if(sx<0||sy<0||sx>=W||sy>=H)return false;const rainbow=hex==='rainbow',rgb=kpHex(rainbow?'#ff0000':hex);
  const P=KP.paint.getImageData(0,0,W,H),d=P.data,Ld=KP.lines.getImageData(0,0,W,H).data;const i0=(sy*W+sx)*4;if(Ld[i0+3]>90)return false;
  const tr=d[i0],tg=d[i0+1],tb=d[i0+2];if(!rainbow&&Math.abs(tr-rgb[0])+Math.abs(tg-rgb[1])+Math.abs(tb-rgb[2])<6)return false;
  const seen=new Uint8Array(W*H),match=i=>Ld[i*4+3]<=90&&Math.abs(d[i*4]-tr)+Math.abs(d[i*4+1]-tg)+Math.abs(d[i*4+2]-tb)<=60;
  const st=[sx,sy];while(st.length){const y=st.pop();let x=st.pop();let i=y*W+x;while(x>=0&&!seen[i]&&match(i)){x--;i--;}x++;i++;const start=x;let up=false,dn=false;
    while(x<W&&!seen[i]&&match(i)){seen[i]=1;const j=i*4;const q=rainbow?v8Rainbow(y):rgb;d[j]=q[0];d[j+1]=q[1];d[j+2]=q[2];d[j+3]=255;
      if(y>0){const k=i-W;if(!seen[k]&&match(k)){if(!up){st.push(x,y-1);up=true;}}else up=false;}
      if(y<H-1){const k=i+W;if(!seen[k]&&match(k)){if(!dn){st.push(x,y+1);dn=true;}}else dn=false;}x++;i++;}
    if(region&&x>start){region.path.rect(start,y,x-start,1);region.top=Math.min(region.top,y);region.bottom=Math.max(region.bottom,y+1);}}
  if(!region)KP.paint.putImageData(P,0,0);return true;}
function kpBubble(x,y){const c=KP.paint,r=rnd(.6,1.2)*(KP_SIZES[KP.size]*.9+8);c.save();c.globalAlpha=.45;c.fillStyle=KP.color;c.beginPath();c.arc(x,y,r,0,TAU);c.fill();c.globalAlpha=1;c.lineWidth=2.5;c.strokeStyle=KP.color;c.stroke();
  c.beginPath();c.arc(x-r*.35,y-r*.35,r*.22,0,TAU);c.fillStyle='rgba(255,255,255,.85)';c.fill();c.restore();}
const KP_MAGNET=['#e0393a','#ff8a2a','#dca800','#3fa34d','#2fc4b2','#3d6fd6','#8f55e6','#ee68a6'];
function kpGlyph(c,g,x,y,size,col){c.save();c.font=`900 ${size}px "Arial Rounded MT Bold",Arial,sans-serif`;c.textAlign='center';c.textBaseline='middle';c.lineJoin='round';c.lineWidth=Math.max(2,size*.045);c.strokeStyle='#43352d';c.fillStyle=col;c.shadowColor='rgba(0,0,0,.3)';c.shadowOffsetY=2;c.strokeText(g,x,y);c.fillText(g,x,y);c.restore();}
function kpTree(c,x,y,size){c.save();c.lineCap='round';function branch(x,y,a,l,depth){const ex=x+Math.cos(a)*l,ey=y+Math.sin(a)*l;c.strokeStyle=depth>1?'#85502f':KP.color;c.lineWidth=depth*1.7;c.beginPath();c.moveTo(x,y);c.lineTo(ex,ey);c.stroke();if(depth>1){branch(ex,ey,a-.48+rnd(-.15,.15),l*.69,depth-1);branch(ex,ey,a+.48+rnd(-.15,.15),l*.69,depth-1);}else{c.fillStyle=KP.color;c.beginPath();c.arc(ex,ey,Math.max(2,size*.08),0,TAU);c.fill();}}branch(x,y+size*.5,-Math.PI/2,size*.55,5);c.restore();}
function kpDripDraw(dt){
 const p=KP.pour;if(!p)return;
 p.t=Math.min(1,p.t+dt/2.8);
 const c=KP.paint,depth=p.top+(p.bottom-p.top)*p.t;
 c.save();c.clip(p.path);
 if(p.rain&&!p.grad){p.grad=c.createLinearGradient(0,0,0,700);v8Colors.forEach((v,i)=>p.grad.addColorStop(i/15,v));}
 c.fillStyle=p.rain?p.grad:p.color;
 if(p.t>=1){c.fillRect(0,p.top,1000,p.bottom-p.top);KP.pour=null;}
 else{
  c.beginPath();c.moveTo(0,p.top);c.lineTo(1000,p.top);c.lineTo(1000,depth);
  for(let i=19;i>=0;i--){
   const x=i*50,tip=Math.min(p.bottom,depth+p.heights[i]*Math.sin(Math.PI*p.t));
   c.bezierCurveTo(x+40,depth,x+40,tip,x+25,tip);
   c.bezierCurveTo(x+10,tip,x+10,depth,x,depth);
  }
  c.closePath();c.fill();
 }
 c.restore();
}
function kpSeg(lx,ly,x,y){const c=KP.paint,t=KP.tool,v=KP.variant.brush,sz=KP_SIZES[KP.size],d=Math.hypot(x-lx,y-ly);
  if(t==='eraser'&&KP.variant.eraser==='sprayer'){const R=sz*2.6+18;for(const A of KP.ants){const dx=x-lx,dy=y-ly,k=clamp(((A.x-lx)*dx+(A.y-ly)*dy)/(dx*dx+dy*dy||1));if(Math.hypot(A.x-lx-dx*k,A.y-ly-dy*k)<R+12){const a=Math.atan2(A.y-y,A.x-x);A.blast={vx:Math.cos(a)*850,vy:Math.sin(a)*850};}}c.fillStyle='#ffffff';const steps=Math.max(1,Math.ceil(d/6));
    for(let s=0;s<=steps;s++){const px=lx+(x-lx)*s/steps,py=ly+(y-ly)*s/steps;c.beginPath();c.arc(px,py,R*.72,0,TAU);c.fill();for(let k=0;k<5;k++){const a=rnd(0,TAU),r=R*Math.sqrt(Math.random());c.beginPath();c.arc(px+Math.cos(a)*r,py+Math.sin(a)*r,rnd(3,8),0,TAU);c.fill();}}
    for(let k=0;k<6;k++){const a=rnd(0,TAU),s=rnd(120,420);KP.drops.push({x:x+rnd(-R*.5,R*.5),y:y+rnd(-R*.5,R*.5),vx:Math.cos(a)*s,vy:Math.sin(a)*s-120,r:rnd(3,7),t:0});}return;}
  if(t==='brush'&&['wacky','tree','alphabet'].includes(v)){const gap=v==='tree'?sz*3+20:sz*1.8+13;const n=d===0?1:Math.floor((KP.acc+d)/gap);const before=KP.acc;KP.acc=d===0?0:(before+d)%gap;for(let i=0;i<Math.min(n,24);i++){const k=d?clamp((gap-before+i*gap)/d):1,px=lerp(lx,x,k),py=lerp(ly,y,k);if(v==='tree')kpTree(c,px,py,sz*2.3+22);else if(v==='alphabet'){const j=KP.letterIndex||0;kpGlyph(c,String.fromCharCode(65+j%26),px,py,sz*2+20,KP_MAGNET[j%KP_MAGNET.length]);KP.letterIndex=j+1;}else{const a=Array.from('✿★☀☂☯✈♫♞☾◆✦☺☁❄✚❋');kpGlyph(c,a[Math.floor(Math.random()*a.length)],px,py,sz*2+20,KP_MAGNET[Math.floor(Math.random()*KP_MAGNET.length)]);}}return;}
  if(t==='pencil'||t==='eraser'||(t==='brush'&&v==='paint')){c.strokeStyle=t==='eraser'?'#ffffff':KP.color;c.lineWidth=t==='pencil'?sz*.6+1:sz*(t==='eraser'?2.2:1.8);c.lineCap=c.lineJoin='round';c.beginPath();c.moveTo(lx,ly);c.lineTo(x+.01,y);c.stroke();}
  else if(v==='rainbow'){const n=Math.max(1,Math.ceil(d/3));for(let i=1;i<=n;i++){KP.hue=(KP.hue+2.2)%360;c.fillStyle=`hsl(${KP.hue},90%,58%)`;c.beginPath();c.arc(lx+(x-lx)*i/n,ly+(y-ly)*i/n,sz*.9+3,0,TAU);c.fill();}}
  else if(v==='spray'){const n=Math.max(1,Math.ceil(d/4))*7;c.fillStyle=KP.color;for(let i=0;i<n;i++){const k=Math.random(),a=rnd(0,TAU),r=Math.sqrt(Math.random())*(sz*2+8);c.fillRect(lx+(x-lx)*k+Math.cos(a)*r,ly+(y-ly)*k+Math.sin(a)*r,2.2,2.2);}}
  else if(v==='bubbles'){KP.acc+=d;const gap=sz*1.6+10;while(KP.acc>=gap){KP.acc-=gap;const k=d?1-KP.acc/d:1;kpBubble(lx+(x-lx)*k,ly+(y-ly)*k);}}}
function kpDown(x,y){if(KP.dyn)return;audio();const t=KP.tool;
  if(t==='bucket'&&['drip','raincan'].includes(KP.variant.bucket)){
    if(KP.pour)kpDripDraw(2.8);
    const region={path:new Path2D(),top:700,bottom:0};
    if(!kpFill(x,y,KP.color,region))return;
    kpSnap();KP.down=true;KP.last=[x,y];
    KP.pour={...region,t:.02,rain:KP.color==='rainbow',color:KP.color,heights:Array.from({length:20},()=>rnd(12,130))};
    kpDripDraw(.015);kpSnd('gloop');return;
  }
  if(t==='bucket'){kpSnap();if(kpFill(x,y,KP.color))kpSnd('gloop');else KP.undo.pop();return;}
  if(t==='brush'&&KP.variant.brush==='tree'){kpSnap();kpStartTree(x,y,[105,180,280][KP.size]||180);return;}
  if(t==='stamp'){kpSnap();const s=KP.stamps[KP.variant.stamp],sz=[60,110,180][KP.size];if(s.name==='tree'){kpStartTree(x,y,sz*1.45);return;}if(s.glyph){kpGlyph(KP.sticker,s.glyph,x,y,sz*.8,s.letter?KP_MAGNET[(s.glyph.charCodeAt(0)-65)%KP_MAGNET.length]:KP.color);if(s.letter)say(s.glyph);}else if(s.img&&s.img.complete&&s.img.naturalWidth)KP.sticker.drawImage(s.img,x-sz/2,y-sz/2,sz,sz);else if(s.shape)kpShapeDraw(KP.sticker,s.shape,x,y,sz*.45,KP.color);
    if(s.moo)SFX.moo();else if(s.f)friendSound(s.f,.6,0);else kpSnd('stamp');return;}
  if(t==='eraser'&&KP.variant.eraser==='dingdong'){kpSnap();KP.ants.length=0;KP.antRun=null;KP.drops.length=0;KP.dyn={kind:'dingdong',t:0};voice({type:'sine',f0:784,f1:784,dur:.28,vol:.15});voice({type:'sine',f0:523,f1:523,dur:.4,vol:.15,delay:.28});return;}
  if(t==='eraser'&&KP.variant.eraser==='dynamite'){kpSnap();KP.dyn={x,y,t:0,boom:false,parts:[]};noiseBurst(.9,.06,5200);return;}
  if(t==='eraser'&&KP.variant.eraser==='ants'){if(!KP.antRun){kpSnap();KP.antRun={t:0,grid:[],scan:0};}
    const have=KP.ants.length,n=Math.min(KP_ANT_MAX-have,KP.antRun.t>0?8:26+KP.size*4);
    for(let i=0;i<n;i++)KP.ants.push({x:x+rnd(-10,10),y:y+rnd(-10,10),a:rnd(0,TAU),sp:rnd(150,210),t:-i*.035,w:rnd(0,TAU),tx:null,ty:null,re:0});
    for(let i=0;i<4;i++)voice({type:'square',f0:rnd(900,1300),f1:rnd(600,900),dur:.03,vol:.03,filt:2500,delay:i*.07});return;}
  kpSnap();KP.down=true;KP.last=[x,y];KP.acc=KP.tool==='brush'&&['tree','wacky','alphabet','bubbles'].includes(KP.variant.brush)?0:999;if(KP.tool==='brush'&&KP.variant.brush==='bubbles')kpBubble(x,y);else kpSeg(x,y,x,y);KP.acc=0;kpSnd(t==='brush'?KP.variant.brush:t==='eraser'&&KP.variant.eraser==='sprayer'?'sprayer':t,y);}
function kpMove(x,y){if(KP.growing)return;if(!KP.down||KP.tool==='bucket')return;const[lx,ly]=KP.last,d=Math.hypot(x-lx,y-ly);if(d<.8)return;kpSeg(lx,ly,x,y);KP.last=[x,y];
  KP.sndD+=d;if(KP.sndD>(KP.tool==='pencil'?26:40)){KP.sndD=0;kpSnd(KP.tool==='brush'?KP.variant.brush:KP.tool==='eraser'&&KP.variant.eraser==='sprayer'?'sprayer':KP.tool,y);}}
function kpUp(){KP.growing=null;KP.down=false;if(KP.pour)kpDripDraw(2.8);}
function kpFxTick(dt){const f=KP.fx,c=KP.paint,sticker=KP.sticker;f.clearRect(0,0,1000,700);
  for(let i=KP.drops.length-1;i>=0;i--){const p=KP.drops[i];p.t+=dt;p.vy+=900*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;if(p.t>.5){KP.drops.splice(i,1);continue;}
    f.globalAlpha=1-p.t/.5;f.fillStyle='#7fd0ff';f.strokeStyle='#2b6fa8';f.lineWidth=1.5;f.beginPath();f.arc(p.x,p.y,p.r,0,TAU);f.fill();f.stroke();}f.globalAlpha=1;
  let munch=false;const R=KP.antRun;
  if(R){R.t+=dt;R.scan-=dt;const eating=R.t<KP_ANT_EAT;
    // Look for ink and any visible stamps or stickers.
    if(eating&&R.scan<=0){
      R.scan=.35;R.grid=[];
      try{
        const d=c.getImageData(0,0,1000,700).data;
        const decals=sticker.getImageData(0,0,1000,700).data;
        for(let gy=10;gy<700;gy+=20)for(let gx=10;gx<1000;gx+=20){
          const o=(gy*1000+gx)*4;
          if(d[o]<245||d[o+1]<245||d[o+2]<245||decals[o+3]>0)R.grid.push([gx,gy]);
        }
      }catch(e){}
    }
    // last second: the ants lick up any crumbs so the page is really clean
    if(!R.cleaned&&R.t>=KP_ANT_EAT&&KP.ants.some(a=>!a.blast)){
      R.cleaned=true;
      c.save();c.fillStyle='#ffffff';c.fillRect(0,0,1000,700);c.restore();
      sticker.clearRect(0,0,1000,700);
    }
    if(R.t>KP_ANT_EAT+5)KP.ants.length=0;
    if(!KP.ants.length){KP.antRun=null;}}
  const er=KP_SIZES[KP.size]*.5+11,eat=R&&R.t<KP_ANT_EAT;
  for(let i=KP.ants.length-1;i>=0;i--){const A=KP.ants[i];A.t+=dt;if(A.t<0)continue;
     if(A.blast){A.x+=A.blast.vx*dt;A.y+=A.blast.vy*dt;A.a=Math.atan2(A.blast.vy,A.blast.vx);if(A.x<-40||A.x>1040||A.y<-40||A.y>740){KP.ants.splice(i,1);continue;}}else{
    if(eat){A.re-=dt;
      if(A.re<=0||A.tx===null||Math.hypot(A.tx-A.x,A.ty-A.y)<er*.6){A.re=rnd(.6,1.2);const G=R.grid;
        if(G.length){let best=null,bd=1e9;for(let k=0;k<6;k++){const g=G[(Math.random()*G.length)|0],dd=Math.hypot(g[0]-A.x,g[1]-A.y);if(dd<bd){bd=dd;best=g;}}A.tx=best[0]+rnd(-8,8);A.ty=best[1]+rnd(-8,8);}
        else{A.tx=rnd(40,960);A.ty=rnd(40,660);}}}
    else if(A.tx!=='out'){const ex=[[-60,A.y],[1060,A.y],[A.x,-60],[A.x,760]];let bi=0,bd=1e9;ex.forEach((e,k)=>{const dd=Math.hypot(e[0]-A.x,e[1]-A.y);if(dd<bd){bd=dd;bi=k;}});A.ox=ex[bi][0];A.oy=ex[bi][1];A.tx='out';}
    const gx=A.tx==='out'?A.ox:A.tx,gy=A.tx==='out'?A.oy:A.ty;
    // smooth steering toward the target, with a gentle wiggle
    A.w+=dt*7;const want=Math.atan2(gy-A.y,gx-A.x)+Math.sin(A.w)*.35;let da=want-A.a;da=Math.atan2(Math.sin(da),Math.cos(da));A.a+=clamp(da,-7*dt,7*dt);
    const sp=A.sp*(eat?1:1.5);A.x+=Math.cos(A.a)*sp*dt;A.y+=Math.sin(A.a)*sp*dt;
    if(eat){
      A.x=clamp(A.x,6,994);A.y=clamp(A.y,6,694);
      c.fillStyle='#ffffff';c.beginPath();c.arc(A.x,A.y,er,0,TAU);c.fill();
      sticker.save();sticker.globalCompositeOperation='destination-out';sticker.fillStyle='#000';
      sticker.beginPath();sticker.arc(A.x,A.y,er,0,TAU);sticker.fill();sticker.restore();
      munch=true;
    }
    else if(A.x<-40||A.x>1040||A.y<-40||A.y>740){KP.ants.splice(i,1);continue;}}
    f.save();f.translate(A.x,A.y);f.rotate(A.a);const lg=Math.sin(A.t*30)*3;f.strokeStyle='#1d1510';f.lineWidth=2;f.lineCap='round';f.beginPath();
    for(const lx of[-6,0,6]){f.moveTo(lx,0);f.lineTo(lx-3+lg*(lx===0?-1:1),-9);f.moveTo(lx,0);f.lineTo(lx-3-lg*(lx===0?-1:1),9);}f.moveTo(11,-2);f.lineTo(16,-7);f.moveTo(11,2);f.lineTo(16,7);f.stroke();
    f.fillStyle='#2b2118';for(const[bx,br]of[[-8,5.5],[0,4],[8,4.5]]){f.beginPath();f.arc(bx,0,br,0,TAU);f.fill();}f.fillStyle='#fff';f.beginPath();f.arc(10,-1.6,1.2,0,TAU);f.arc(10,1.6,1.2,0,TAU);f.fill();f.restore();}
  if(munch){KP.antSnd=(KP.antSnd||0)-dt;if(KP.antSnd<=0){KP.antSnd=rnd(.12,.25);voice({type:'square',f0:rnd(1200,1800),f1:rnd(800,1100),dur:.025,vol:.025,filt:3000});}}
  if(!KP.ants.length&&!KP.drops.length)f.clearRect(0,0,1000,700);}
function kpDynTick(dt){const D=KP.dyn,f=KP.fx;D.t+=dt;f.clearRect(0,0,1000,700);if(D.kind==='dingdong'){v8Door(D,f);return;}
  if(D.t<.9){f.save();f.translate(D.x,D.y);f.rotate(-.2);f.lineWidth=5;f.strokeStyle='#1d1510';f.fillStyle='#e0393a';rrect(f,-22,-50,44,100,8);f.fill();f.stroke();
    f.fillStyle='#fff6df';f.font='22px "Lilita One",sans-serif';f.textAlign='center';f.textBaseline='middle';f.fillText('TNT',0,2);
    const k=1-D.t/.9;f.beginPath();f.moveTo(0,-50);f.quadraticCurveTo(14,-50-25*k,4,-50-42*k);f.stroke();
    for(let i=0;i<6;i++){f.fillStyle=i%2?'#ffd23f':'#ff8a2a';f.beginPath();f.arc(4+rnd(-12,12),-50-42*k+rnd(-12,12),rnd(2,5),0,TAU);f.fill();}f.restore();return;}
  if(!D.boom){D.boom=true;KP.sticker.clearRect(0,0,1000,700);KP.paint.fillStyle='#ffffff';KP.paint.fillRect(0,0,1000,700);noiseBurst(1.2,.4,300);voice({type:'sine',f0:120,f1:30,dur:.9,vol:.35});
    const w=$('kpWrap');w.classList.remove('shake');void w.offsetWidth;w.classList.add('shake');
    for(let i=0;i<80;i++){const a=rnd(0,TAU),s=rnd(200,900);D.parts.push({x:D.x,y:D.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-200,c:KP_COLORS[2+Math.floor(Math.random()*12)],r:rnd(6,18)});}}
  const k=D.t-.9;if(k<.18){f.fillStyle=`rgba(255,250,220,${1-k/.18})`;f.fillRect(0,0,1000,700);}
  f.globalAlpha=Math.max(0,1-k/1.1);for(const p of D.parts){p.vy+=1400*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;f.fillStyle=p.c;f.beginPath();f.arc(p.x,p.y,p.r,0,TAU);f.fill();f.lineWidth=3;f.strokeStyle='#1d1510';f.stroke();}
  f.save();f.translate(D.x,clamp(D.y,90,610));const s=Math.min(1,k*6);f.scale(s,s);f.font='120px "Lilita One",sans-serif';f.textAlign='center';f.textBaseline='middle';f.lineWidth=12;f.strokeStyle='#1d1510';f.fillStyle='#ffd23f';f.strokeText('BOOM!',0,0);f.fillText('BOOM!',0,0);f.restore();f.globalAlpha=1;
  if(k>1.1){KP.dyn=null;f.clearRect(0,0,1000,700);}}
// print: build a big (2000x1400) picture of the blank page or the coloured one and hand it over as a PNG to print
function kpColorThumb(){const t=document.createElement('canvas');t.width=120;t.height=84;const x=t.getContext('2d');x.drawImage(KP.paint.canvas,0,0,120,84);x.drawImage(KP.lines.canvas,0,0,120,84);x.drawImage(KP.sticker.canvas,0,0,120,84);return t.toDataURL();}
/* ---------- Moo Pix puzzle cutter: cut your picture into a jigsaw (8 pieces the first time, 16 the next, then 8 again…) ---------- */
const PZ={on:false,cuts:0,pieces:[],img:null,cols:4,rows:2,drag:null,done:false,s:1,ox:0,oy:0,dpr:1,raf:0,conf:[]};
function pzPath(p,tw,th){ // jigsaw outline of one piece in picture units, (0,0)=piece corner
  const P=new Path2D(),w=tw,h=th,k=Math.min(w,h);
  const edge=(x0,y0,x1,y1,sgn)=>{ // straight edge with a knob in the middle when sgn!=0 (knob bulges to the left of travel*sgn)
    if(!sgn){P.lineTo(x1,y1);return;}const dx=x1-x0,dy=y1-y0,L=Math.hypot(dx,dy),ux=dx/L,uy=dy/L,nx=uy*sgn,ny=-ux*sgn,pt=(a,b)=>[x0+ux*a+nx*b,y0+uy*a+ny*b];
    const a=L/2,nk=k*.22,nw=k*.13,q=[[a-nw*1.1,0],[a-nw*.9,nk*.25],[a-nw*1.5,nk*.55],[a-nw*1.3,nk],[a,nk*1.05],[a+nw*1.3,nk],[a+nw*1.5,nk*.55],[a+nw*.9,nk*.25],[a+nw*1.1,0]];
    P.lineTo(...pt(q[0][0],q[0][1]));P.bezierCurveTo(...pt(...q[1]),...pt(...q[2]),...pt(...q[3]));P.bezierCurveTo(...pt(a-nw*1.1,nk*1.25),...pt(a+nw*1.1,nk*1.25),...pt(...q[5]));
    P.bezierCurveTo(...pt(...q[6]),...pt(...q[7]),...pt(...q[8]));P.lineTo(x1,y1);};
  P.moveTo(0,0);edge(0,0,w,0,p.top);edge(w,0,w,h,p.right);edge(w,h,0,h,p.bottom);edge(0,h,0,0,p.left);P.closePath();return P;}
function pzStart(){if(PZ.on)return;audio();PZ.cuts++;const n=PZ.cuts%2?8:16;PZ.cols=4;PZ.rows=n===8?2:4;
  const big=kpPrintCanvas('color'),c=document.createElement('canvas');c.width=1000;c.height=700;const x=c.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(big,0,0,1000,700);PZ.img=c;
  const C=PZ.cols,R=PZ.rows,tw=1000/C,th=700/R,H=[],V=[];
  for(let r=0;r<R;r++){H[r]=[];V[r]=[];for(let q=0;q<C;q++){H[r][q]=Math.random()<.5?1:-1;V[r][q]=Math.random()<.5?1:-1;}}
  PZ.pieces=[];for(let r=0;r<R;r++)for(let q=0;q<C;q++){
    // edge knobs: a neighbour shares the edge with the opposite sign so the pieces lock together
    const p={r,q,tw,th,top:r?-H[r-1][q]:0,bottom:r<R-1?H[r][q]:0,left:q?-V[r][q-1]:0,right:q<C-1?V[r][q]:0,hx:q*tw,hy:r*th,x:0,y:0,placed:false,z:0};
    p.path=pzPath(p,tw,th);PZ.pieces.push(p);}
  PZ.on=true;PZ.done=false;PZ.drag=null;PZ.conf=[];$('kpPuzzle').hidden=false;$('pzMsg').textContent=`${n} pieces — drag them into the frame!`;$('pzDone').hidden=true;
  pzLayout(true);kpSnd('tool');voice({type:'triangle',f0:300,f1:900,dur:.25,vol:.1});pzLoop();}
function pzLayout(scatter){const cv=$('pzCanvas'),r=cv.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);PZ.dpr=d;cv.width=Math.round(r.width*d);cv.height=Math.round(r.height*d);
  const W=r.width,H=r.height,s=Math.min(W*.6/1000,H*.58/700);PZ.s=s;PZ.ox=(W-1000*s)/2;PZ.oy=(H-700*s)/2+10;PZ.W=W;PZ.H=H;
  // piece pictures at this size (with room for the knobs)
  for(const p of PZ.pieces){const m=Math.min(p.tw,p.th)*.32,c=document.createElement('canvas');c.width=Math.ceil((p.tw+2*m)*s*d);c.height=Math.ceil((p.th+2*m)*s*d);
    const x=c.getContext('2d');x.scale(s*d,s*d);x.translate(m,m);x.save();x.clip(p.path);x.drawImage(PZ.img,-p.hx,-p.hy);x.restore();
    x.lineWidth=2.4/s;x.strokeStyle='rgba(255,255,255,.75)';x.stroke(p.path);x.lineWidth=1.2/s;x.strokeStyle='rgba(43,33,24,.75)';x.stroke(p.path);p.bmp=c;p.m=m;}
  if(scatter){const board={x0:PZ.ox,y0:PZ.oy,x1:PZ.ox+1000*s,y1:PZ.oy+700*s};let z=0;
    for(const p of PZ.pieces.sort(()=>Math.random()-.5)){const pw=p.tw*s,ph=p.th*s;let best=null;
      for(let k=0;k<40;k++){const sx=rnd(6,W-pw-6),sy=rnd(60,H-ph-6),out=sx+pw<board.x0||sx>board.x1||sy+ph<board.y0||sy>board.y1;best=[sx,sy];if(out)break;}
      p.x=(best[0]-PZ.ox)/s;p.y=(best[1]-PZ.oy)/s;p.z=z++;}}}
function pzDraw(){const cv=$('pzCanvas'),x=cv.getContext('2d'),s=PZ.s,d=PZ.dpr;x.setTransform(d,0,0,d,0,0);x.clearRect(0,0,PZ.W,PZ.H);
  // the frame: white board, faint picture to help, dashed piece slots
  x.save();x.translate(PZ.ox,PZ.oy);x.fillStyle='rgba(0,0,0,.25)';x.fillRect(4,8,1000*s,700*s);x.fillStyle='#fff';x.fillRect(0,0,1000*s,700*s);
  x.globalAlpha=.16;x.drawImage(PZ.img,0,0,1000*s,700*s);x.globalAlpha=1;x.scale(s,s);x.setLineDash([8,6]);x.lineWidth=1.5/s;x.strokeStyle='rgba(43,33,24,.3)';
  for(const p of PZ.pieces){x.save();x.translate(p.hx,p.hy);x.stroke(p.path);x.restore();}x.setLineDash([]);x.restore();
  x.lineWidth=5;x.strokeStyle='#2b2118';x.strokeRect(PZ.ox,PZ.oy,1000*s,700*s);
  const L=PZ.pieces.slice().sort((a,b)=>(a.placed===b.placed?a.z-b.z:a.placed?-1:1));
  for(const p of L){const dr=PZ.drag&&PZ.drag.p===p,sx=PZ.ox+(p.x-p.m)*s,sy=PZ.oy+(p.y-p.m)*s,bw=p.bmp.width/d,bh=p.bmp.height/d;
    x.save();if(dr){x.translate(sx+bw/2,sy+bh/2);x.scale(1.06,1.06);x.translate(-bw/2,-bh/2);x.shadowColor='rgba(0,0,0,.35)';x.shadowBlur=14;x.shadowOffsetY=8;x.drawImage(p.bmp,0,0,bw,bh);}
    else{if(!p.placed){x.shadowColor='rgba(0,0,0,.25)';x.shadowBlur=4;x.shadowOffsetY=3;}x.drawImage(p.bmp,sx,sy,bw,bh);}x.restore();}
  for(const c of PZ.conf){x.save();x.translate(c.x,c.y);x.rotate(c.a);x.fillStyle=c.col;x.fillRect(-5,-3,10,6);x.restore();}}
function pzLoop(){if(!PZ.on)return;for(const c of PZ.conf){c.vy+=.25;c.x+=c.vx;c.y+=c.vy;c.a+=c.va;}PZ.conf=PZ.conf.filter(c=>c.y<PZ.H+20);pzDraw();if(PZ.conf.length||PZ.drag||!PZ.done)PZ.raf=requestAnimationFrame(pzLoop);}
function pzAt(e){const r=$('pzCanvas').getBoundingClientRect();return[e.clientX-r.left,e.clientY-r.top];}
function pzHit(sx,sy){const x=$('pzCanvas').getContext('2d'),s=PZ.s,L=PZ.pieces.filter(p=>!p.placed).sort((a,b)=>b.z-a.z);
  for(const p of L){x.setTransform(s,0,0,s,PZ.ox+p.x*s,PZ.oy+p.y*s);const hit=x.isPointInPath(p.path,sx,sy)||(sx>PZ.ox+p.x*s-6&&sx<PZ.ox+(p.x+p.tw)*s+6&&sy>PZ.oy+p.y*s-6&&sy<PZ.oy+(p.y+p.th)*s+6);x.setTransform(1,0,0,1,0,0);if(hit)return p;}return null;}
function pzDown(e){if(!PZ.on||PZ.done||PZ.drag)return;e.preventDefault();const[sx,sy]=pzAt(e),p=pzHit(sx,sy);if(!p)return;
  PZ.drag={p,id:e.pointerId,dx:sx-(PZ.ox+p.x*PZ.s),dy:sy-(PZ.oy+p.y*PZ.s)};p.z=Math.max(...PZ.pieces.map(q=>q.z))+1;$('pzCanvas').setPointerCapture(e.pointerId);
  voice({type:'triangle',f0:520,f1:620,dur:.05,vol:.07});cancelAnimationFrame(PZ.raf);pzLoop();}
function pzMove(e){const D=PZ.drag;if(!D||D.id!==e.pointerId)return;const[sx,sy]=pzAt(e);D.p.x=(sx-D.dx-PZ.ox)/PZ.s;D.p.y=(sy-D.dy-PZ.oy)/PZ.s;}
function pzUp(e){const D=PZ.drag;if(!D||D.id!==e.pointerId)return;PZ.drag=null;const p=D.p,snap=Math.min(p.tw,p.th)*.3;
  if(Math.hypot(p.x-p.hx,p.y-p.hy)<snap){p.x=p.hx;p.y=p.hy;p.placed=true;voice({type:'sine',f0:660,f1:990,dur:.12,vol:.12});
    const left=PZ.pieces.filter(q=>!q.placed).length;$('pzMsg').textContent=left?`${left} to go!`:'You did it!';
    if(!left){PZ.done=true;SFX.win&&SFX.win();say('You did it!');$('pzDone').hidden=false;
      for(let i=0;i<120;i++)PZ.conf.push({x:PZ.W/2+rnd(-60,60),y:PZ.H*.45,vx:rnd(-9,9),vy:rnd(-14,-4),a:rnd(0,6),va:rnd(-.3,.3),col:['#e0393a','#ffd23f','#3d7be0','#5ac44a','#ff8fb1','#a66bff'][i%6]});}}
  else voice({type:'triangle',f0:440,f1:380,dur:.05,vol:.05});
  cancelAnimationFrame(PZ.raf);pzLoop();}
function pzClose(){PZ.on=false;PZ.drag=null;cancelAnimationFrame(PZ.raf);$('kpPuzzle').hidden=true;}
(function pzInit(){const cv=$('pzCanvas');cv.addEventListener('pointerdown',pzDown);cv.addEventListener('pointermove',pzMove);cv.addEventListener('pointerup',pzUp);cv.addEventListener('pointercancel',pzUp);
  $('kpCut').onclick=pzStart;$('pzBack').onclick=()=>{audio();pzClose();};$('pzDone').onclick=()=>{audio();pzClose();};$('pzAgain').onclick=()=>{audio();pzClose();pzStart();};
  addEventListener('resize',()=>{if(PZ.on){pzLayout(false);if(PZ.done)pzDraw();}});})();
function kpPrintCanvas(kind){const c=document.createElement('canvas');c.width=2000;c.height=1400;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,2000,1400);
  if(kind==='color'){x.imageSmoothingQuality='high';x.drawImage(KP.paint.canvas,0,0,2000,1400);}
  const im=KP_IMG[KP.page]&&kpImg(KP.page);if(im&&im.complete&&im.naturalWidth)x.drawImage(im,0,0,2000,1400);
  else{const l=document.createElement('canvas');l.width=2000;l.height=1400;const lx=l.getContext('2d');lx.scale(2,2);kpPage(KP.page,lx);x.drawImage(l,0,0);}
  if(kind==='color')x.drawImage(KP.sticker.canvas,0,0,2000,1400);return c;}
async function kpPrint(kind){const c=kpPrintCanvas(kind),name=`moo-pix-${KP.page}-${kind==='color'?'colored':'blank'}.png`;
  const blob=await new Promise(r=>c.toBlob(r,'image/png'));if(!blob){toast('Could not make the picture.',2000);return;}
  let dl=null;try{if(window.claude&&window.claude.use)dl=await window.claude.use('downloads');}catch(e){}
  if(dl){try{await dl.save({filename:name,data:new Uint8Array(await blob.arrayBuffer())});toast('<b>Saved!</b>Open the picture and print it.',2800);}catch(e){if(!(e&&e.code==='declined'))toast('Could not save the picture here.',2500);}return;}
  // the downloaded game file: open the browser's print window with just the picture
  const url=URL.createObjectURL(blob),w=window.open('');if(w){w.document.write(`<title>${name}</title><style>@page{size:landscape;margin:8mm}html,body{margin:0}img{width:100%;height:auto;display:block}</style><img src="${url}" onload="setTimeout(()=>print(),200)">`);w.document.close();}
  else{const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();}
  setTimeout(()=>URL.revokeObjectURL(url),120000);}
function kpHang(){award('art');ART.used=true;const c=ART.ctx;c.fillStyle='#fff';c.fillRect(0,0,500,350);c.drawImage(KP.paint.canvas,0,0,500,350);c.drawImage(KP.lines.canvas,0,0,500,350);c.drawImage(KP.sticker.canvas,0,0,500,350);ART.tex.needsUpdate=true;
  try{localStorage.setItem('moonie-art',ART.canvas.toDataURL('image/jpeg',.85));}catch(e){}
  toast('<b>Hung in the barn!</b>Look for it on the front of the barn, right of the doors.',2800);[523,659,784].forEach((f,i)=>voice({type:'triangle',f0:f,f1:f,dur:.15,vol:.1,delay:i*.09}));}
function kpInit(){if(KP.inited)return;KP.inited=true;Object.keys(KP_IMG).forEach(kpImg);KP.paint=$('kpPaint').getContext('2d',{willReadFrequently:true});KP.lines=$('kpLines').getContext('2d',{willReadFrequently:true});KP.fx=$('kpFx').getContext('2d');KP.sticker=$('kpSticker').getContext('2d');
  KP.stamps=[(()=>{const i=new Image();i.src=COW_TOKEN;return{name:'Moonie',src:COW_TOKEN,img:i,moo:true};})()].concat(mem.imgs.map(im=>{const i=new Image();i.src=im.src;return{name:im.name,src:im.src,img:i,f:im.f};})).concat(['star','heart','flower','sun'].map(s=>({name:s,shape:s}))).concat(Array.from('ABCDEFGHIJKLMNOPQRSTUVWXYZ',g=>({name:g,glyph:g,letter:true})),[['barn','🏠'],['tractor','🚜'],['train','🚂'],['tree','🌳'],['cloud','☁'],['rainbow','🌈'],['dinosaur','🦕'],['butterfly','🦋'],['car','🚗'],['rocket','🚀'],['apple','🍎'],['cake','🎂'],['fish','🐟'],['bird','🐦'],['smile','☺'],['balloon','🎈'],['moon','🌙'],['snowflake','❄']].map(([name,glyph])=>({name,glyph})));
  $('kpTools').innerHTML=KP_TOOLS.map(([id,n])=>`<button class="kpt" data-tool="${id}" aria-label="${n}">${KP_ICONS[id]}<span>${n}</span></button>`).join('');
  $('kpColors').innerHTML=KP_COLORS.map(c=>`<button class="kpc" data-col="${c}" style="--c:${c==='rainbow'?'linear-gradient(#f33,#ff0,#0f8,#08f,#f8c,#08f,#0f8,#ff0,#f33)':c}" aria-label="Color ${c}"></button>`).join('');
  $('kpTools').addEventListener('click',e=>{const b=e.target.closest('button');if(b){audio();kpSetTool(b.dataset.tool);}});
  $('kpColors').addEventListener('click',e=>{const b=e.target.closest('button');if(b){audio();kpSetColor(b.dataset.col);}});
  $('kpOpts').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;audio();
    if(b.dataset.print){KP.showPrint=false;kpOpts();kpPrint(b.dataset.print);return;}
    if(b.dataset.page){kpNewPage(b.dataset.page);voice({type:'sine',f0:400,f1:800,dur:.2,vol:.1});return;}
    if(b.dataset.var){if(KP.tool==='brush')KP.variant.brush=b.dataset.var;else if(KP.tool==='bucket')KP.variant.bucket=b.dataset.var;else KP.variant.eraser=b.dataset.var;}
    if(b.dataset.size)KP.size=+b.dataset.size;if(b.dataset.stamp)KP.variant.stamp=+b.dataset.stamp;kpOpts();kpSnd('tool');});
  $('kpPage').onclick=()=>{audio();KP.showPages=!KP.showPages;KP.showPrint=false;kpOpts();};$('kpUndo').onclick=()=>{say('Uh oh!');kpUndo();};$('kpPrint').onclick=()=>{audio();KP.showPrint=!KP.showPrint;KP.showPages=false;kpOpts();};$('kpHang').onclick=kpHang;$('kpFarm').onclick=backToFarm;
  const w=$('kpWrap'),xy=e=>{const r=w.getBoundingClientRect();return[(e.clientX-r.left)/r.width*1000,(e.clientY-r.top)/r.height*700];};
  w.addEventListener('pointerdown',e=>{e.preventDefault();device=e.pointerType==='touch'?'touch':'kb';w.setPointerCapture(e.pointerId);kpDown(...xy(e));});
  w.addEventListener('pointermove',e=>{if(KP.down)kpMove(...xy(e));});w.addEventListener('pointerup',kpUp);w.addEventListener('pointercancel',kpUp);w.addEventListener('lostpointercapture',kpUp);
  kpNewPage('moonie');kpSetTool('pencil');kpSetColor('#e0393a');}
function startColor(){mode='color';state='play';hud(['colorUI']);kpInit();KP.ants.length=0;KP.antRun=null;if(KP.fx)KP.fx.clearRect(0,0,1000,700);}
function kpCycle(list,cur,step){const i=list.indexOf(cur);return list[((i<0?0:i)+step+list.length)%list.length];}
function updateColor(dt,pad){
  if(device==='pad'&&pad&&pad.btn){const b=pad.btn,C=KP.cursor,pc=$('padCursor');
    C.x=clamp(C.x+pad.x*dt*.55,0,1);C.y=clamp(C.y+pad.y*dt*.55*innerWidth/innerHeight,0,1);
    if(b.lb)kpSetTool(kpCycle(KP_TOOLS.map(t=>t[0]),KP.tool,-1));if(b.rb)kpSetTool(kpCycle(KP_TOOLS.map(t=>t[0]),KP.tool,1));
    if(b.xp)kpSetColor(kpCycle(KP_COLORS,KP.color,-1));if(b.yp)kpSetColor(kpCycle(KP_COLORS,KP.color,1));if(b.bp)kpUndo();
    if(b.dl||b.dr){const st=b.dr?1:-1;if(KP.tool==='brush')KP.variant.brush=kpCycle(['paint','rainbow','spray','bubbles','wacky','tree','alphabet'],KP.variant.brush,st);
      else if(KP.tool==='bucket')KP.variant.bucket=kpCycle(['fill','drip'],KP.variant.bucket||'fill',st);else if(KP.tool==='stamp')KP.variant.stamp=(KP.variant.stamp+st+KP.stamps.length)%KP.stamps.length;else if(KP.tool==='eraser')KP.variant.eraser=kpCycle(['rubber','sprayer','ants','dynamite','dingdong'],KP.variant.eraser,st);kpOpts();kpSnd('tool');}
    if(b.du||b.dd){KP.size=clamp(KP.size+(b.du?1:-1),0,2);kpOpts();kpSnd('tool');}
    const cx=C.x*innerWidth,cy=C.y*innerHeight;pc.hidden=false;pc.style.transform=`translate(${cx}px,${cy}px)`;pc.style.background=KP.color;
    const w=$('kpWrap'),r=w.getBoundingClientRect(),onC=cx>=r.left&&cx<=r.right&&cy>=r.top&&cy<=r.bottom,px=(cx-r.left)/r.width*1000,py=(cy-r.top)/r.height*700;
    if(b.a){if(onC)kpDown(px,py);else{const el=document.elementFromPoint(cx,cy),btn=el&&el.closest&&el.closest('button');if(btn)btn.click();}}
    else if(b.aHeld&&KP.down&&onC)kpMove(px,py);
    if(!b.aHeld&&KP.down)kpUp();}
  else $('padCursor').hidden=true;
  if(KP.growing)v8Grow(dt);if(KP.pour&&KP.down&&KP.tool==='bucket')kpDripDraw(dt);if(KP.dyn)kpDynTick(dt);else if(KP.ants.length||KP.drops.length||KP.antRun)kpFxTick(dt);}

/* ================= VEGGIE ABCs (letters game) ================= */
const VEG_INK='#1d1510';
function vFace(x,cx,cy,r,dark){x.fillStyle=dark?'#fff':VEG_INK;for(const s of[-1,1]){x.beginPath();x.ellipse(cx+s*r*.28,cy,r*.09,r*.12,0,0,TAU);x.fill();}
  x.fillStyle='#fff';for(const s of[-1,1]){x.beginPath();x.arc(cx+s*r*.28+r*.03,cy-r*.04,r*.035,0,TAU);x.fill();}
  x.strokeStyle=dark?'#fff':VEG_INK;x.lineWidth=Math.max(2,r*.06);x.lineCap='round';x.beginPath();x.arc(cx,cy+r*.12,r*.16,.25,Math.PI-.25);x.stroke();
  x.fillStyle='rgba(255,120,140,.55)';for(const s of[-1,1]){x.beginPath();x.ellipse(cx+s*r*.46,cy+r*.14,r*.09,r*.06,0,0,TAU);x.fill();}}
function vLeaf(x,px,py,len,wid,ang,col){x.save();x.translate(px,py);x.rotate(ang);x.beginPath();x.moveTo(0,0);x.quadraticCurveTo(wid,-len*.5,0,-len);x.quadraticCurveTo(-wid,-len*.5,0,0);x.closePath();x.fillStyle=col;x.fill();x.stroke();
  x.beginPath();x.moveTo(0,-len*.1);x.lineTo(0,-len*.85);x.lineWidth*=.5;x.stroke();x.restore();}
function vShape(x,fill,path){x.beginPath();path();x.fillStyle=fill;x.fill();x.stroke();}
const VEGGIES=[
 {n:'Asparagus',l:'A',d(x,r){x.save();for(const[o,a]of[[-.32,-.12],[0,0],[.32,.12]]){x.save();x.translate(o*r,r*.1);x.rotate(a);vShape(x,'#7dbb4a',()=>{x.moveTo(-r*.09,r*.9);x.lineTo(-r*.07,-r*.55);x.quadraticCurveTo(0,-r*.95,r*.07,-r*.55);x.lineTo(r*.09,r*.9);x.closePath();});
   for(let i=0;i<4;i++){x.beginPath();x.moveTo(-r*.08,-r*.3+i*r*.3);x.lineTo(0,-r*.42+i*r*.3);x.lineTo(r*.08,-r*.3+i*r*.3);x.stroke();}x.restore();}
   vShape(x,'#c7703f',()=>{x.rect(-r*.5,r*.35,r,r*.18);});x.restore();vFace(x,0,-r*.1,r*.45);}},
 {n:'Broccoli',l:'B',d(x,r){vShape(x,'#a6d36a',()=>{x.moveTo(-r*.22,r*.9);x.lineTo(-r*.14,r*.05);x.lineTo(r*.14,r*.05);x.lineTo(r*.22,r*.9);x.closePath();});
   for(const[cx,cy,rr]of[[-.45,-.15,.32],[.45,-.15,.32],[-.22,-.48,.34],[.22,-.48,.34],[0,-.15,.36]])vShape(x,'#3f9b3a',()=>x.arc(cx*r,cy*r,rr*r,0,TAU));vFace(x,0,-.2*r,r*.7,true);}},
 {n:'Beet',l:'B',d(x,r){x.lineWidth=Math.max(2,r*.07);for(const a of[-.5,0,.5])vLeaf(x,a*r*.2,-r*.45,r*.55,r*.2,a,'#4f9e44');
   vShape(x,'#a3214f',()=>{x.moveTo(0,r*.95);x.quadraticCurveTo(r*.15,r*.55,r*.55,r*.25);x.arc(0,-r*.05,r*.55,.6,Math.PI-.6,true);x.quadraticCurveTo(-r*.15,r*.55,0,r*.95);});vFace(x,0,0,r*.6,true);}},
 {n:'Carrot',l:'C',d(x,r){x.lineWidth=Math.max(2,r*.07);for(const a of[-.45,0,.45])vLeaf(x,0,-r*.5,r*.5,r*.16,a,'#5db84d');
   vShape(x,'#f08a2a',()=>{x.moveTo(-r*.36,-r*.5);x.quadraticCurveTo(0,-r*.62,r*.36,-r*.5);x.quadraticCurveTo(r*.2,r*.4,0,r*.95);x.quadraticCurveTo(-r*.2,r*.4,-r*.36,-r*.5);});
   for(const y of[-.1,.25,.55]){x.beginPath();x.moveTo(-r*.18,y*r);x.lineTo(-r*.05,y*r+3);x.stroke();}vFace(x,0,-r*.25,r*.5);}},
 {n:'Corn',l:'C',d(x,r){vShape(x,'#ffd23f',()=>x.ellipse(0,-r*.05,r*.36,r*.82,0,0,TAU));x.save();x.clip();x.lineWidth=Math.max(1.5,r*.035);for(let i=-4;i<=4;i++){x.beginPath();x.moveTo(i*r*.1,-r);x.lineTo(i*r*.1,r);x.stroke();}for(let j=-8;j<=8;j++){x.beginPath();x.moveTo(-r,j*r*.1);x.lineTo(r,j*r*.1);x.stroke();}x.restore();
   x.lineWidth=Math.max(2,r*.07);for(const s of[-1,1])vShape(x,'#6cc75a',()=>{x.moveTo(0,r*.95);x.quadraticCurveTo(s*r*.6,r*.4,s*r*.42,-r*.35);x.quadraticCurveTo(s*r*.3,r*.3,0,r*.95);});vFace(x,0,-r*.15,r*.5);}},
 {n:'Cucumber',l:'C',d(x,r){x.save();x.rotate(-.5);vShape(x,'#3f8a3a',()=>{x.ellipse(0,0,r*.3,r*.92,0,0,TAU);});x.fillStyle='#7cc46a';for(const[a,b]of[[-.1,-.5],[.12,-.1],[-.08,.35],[.1,.6]]){x.beginPath();x.arc(a*r,b*r,r*.04,0,TAU);x.fill();}x.restore();vFace(x,0,-r*.05,r*.45,true);}},
 {n:'Daikon',l:'D',d(x,r){x.lineWidth=Math.max(2,r*.07);for(const a of[-.5,0,.5])vLeaf(x,0,-r*.55,r*.45,r*.17,a,'#5db84d');
   vShape(x,'#f6f1e4',()=>{x.moveTo(-r*.25,-r*.55);x.quadraticCurveTo(0,-r*.65,r*.25,-r*.55);x.quadraticCurveTo(r*.28,r*.5,0,r*.95);x.quadraticCurveTo(-r*.28,r*.5,-r*.25,-r*.55);});
   x.fillStyle='rgba(140,200,100,.5)';x.beginPath();x.ellipse(0,-r*.48,r*.22,r*.08,0,0,TAU);x.fill();vFace(x,0,-r*.15,r*.45);}},
 {n:'Eggplant',l:'E',d(x,r){x.save();x.rotate(.35);vShape(x,'#6a3a8f',()=>{x.moveTo(0,-r*.55);x.bezierCurveTo(r*.42,-r*.5,r*.62,r*.6,0,r*.9);x.bezierCurveTo(-r*.62,r*.6,-r*.42,-r*.5,0,-r*.55);});
   vShape(x,'#4f9e44',()=>{x.moveTo(-r*.3,-r*.42);x.lineTo(-r*.12,-r*.62);x.lineTo(0,-r*.48);x.lineTo(r*.12,-r*.62);x.lineTo(r*.3,-r*.42);x.quadraticCurveTo(0,-r*.3,-r*.3,-r*.42);});
   vShape(x,'#4f9e44',()=>x.rect(-r*.05,-r*.85,r*.1,r*.3));x.restore();vFace(x,r*.05,r*.15,r*.55,true);}},
 {n:'Garlic',l:'G',d(x,r){vShape(x,'#f7f1e6',()=>{x.moveTo(0,-r*.85);x.quadraticCurveTo(r*.1,-r*.4,r*.55,-r*.05);x.quadraticCurveTo(r*.75,r*.55,0,r*.7);x.quadraticCurveTo(-r*.75,r*.55,-r*.55,-r*.05);x.quadraticCurveTo(-r*.1,-r*.4,0,-r*.85);});
   x.lineWidth=Math.max(1.5,r*.04);for(const s of[-.3,0,.3]){x.beginPath();x.moveTo(s*r*.3,-r*.4);x.quadraticCurveTo(s*r*1.5,r*.2,s*r*.6,r*.65);x.stroke();}
   x.lineWidth=Math.max(2,r*.06);for(const s of[-1,0,1]){x.beginPath();x.moveTo(s*r*.1,r*.7);x.lineTo(s*r*.16,r*.85);x.stroke();}vFace(x,0,r*.15,r*.5);}},
 {n:'Jalapeño',l:'J',d(x,r){x.save();x.rotate(-.4);vShape(x,'#2f8a3a',()=>{x.moveTo(-r*.2,-r*.6);x.quadraticCurveTo(r*.35,-r*.65,r*.25,-r*.1);x.quadraticCurveTo(r*.15,r*.6,-r*.2,r*.9);x.quadraticCurveTo(-r*.05,r*.4,-r*.25,-r*.2);x.closePath();});
   vShape(x,'#7a9a3a',()=>{x.moveTo(-r*.05,-r*.62);x.quadraticCurveTo(0,-r*.9,r*.2,-r*.95);x.lineTo(r*.22,-r*.86);x.quadraticCurveTo(r*.08,-r*.82,r*.08,-r*.6);x.closePath();});x.restore();vFace(x,0,-r*.05,r*.45,true);}},
 {n:'Kale',l:'K',d(x,r){vShape(x,'#7ab84a',()=>{x.moveTo(0,r*.95);x.lineTo(0,r*.3);});
   vShape(x,'#2f7a3a',()=>{for(let i=0;i<=40;i++){const a=-Math.PI/2+(i/40-.5)*TAU*.95,k=1+.12*Math.sin(i*1.9);const px=Math.cos(a)*r*.55*k,py=-r*.1+Math.sin(a)*r*.75*k;i?x.lineTo(px,py):x.moveTo(px,py);}x.closePath();});
   x.strokeStyle='#a6d36a';x.lineWidth=Math.max(2,r*.05);x.beginPath();x.moveTo(0,r*.6);x.lineTo(0,-r*.75);for(const y of[-.4,0,.3]){x.moveTo(0,y*r);x.lineTo(-r*.3,y*r-r*.2);x.moveTo(0,y*r);x.lineTo(r*.3,y*r-r*.2);}x.stroke();x.strokeStyle=VEG_INK;}},
 {n:'Lettuce',l:'L',d(x,r){for(const[cx,rr,c]of[[-.35,.45,'#4f9e44'],[.35,.45,'#4f9e44'],[0,.58,'#7cc46a'],[0,.4,'#b5e08a']])vShape(x,c,()=>x.arc(cx*r,r*.12,rr*r,0,TAU));vFace(x,0,r*.1,r*.6);}},
 {n:'Mushroom',l:'M',d(x,r){vShape(x,'#f3e6cf',()=>{x.moveTo(-r*.25,r*.9);x.quadraticCurveTo(-r*.32,r*.3,-r*.22,-r*.05);x.lineTo(r*.22,-r*.05);x.quadraticCurveTo(r*.32,r*.3,r*.25,r*.9);x.closePath();});
   vShape(x,'#b5713a',()=>{x.moveTo(-r*.85,0);x.quadraticCurveTo(-r*.8,-r*.85,0,-r*.88);x.quadraticCurveTo(r*.8,-r*.85,r*.85,0);x.quadraticCurveTo(0,r*.12,-r*.85,0);});
   x.fillStyle='#f7e3c0';for(const[a,b,c]of[[-.4,-.35,.1],[.15,-.55,.12],[.5,-.25,.08]]){x.beginPath();x.arc(a*r,b*r,c*r,0,TAU);x.fill();}vFace(x,0,r*.4,r*.4);}},
 {n:'Onion',l:'O',d(x,r){vShape(x,'#e3a23a',()=>{x.moveTo(0,-r*.9);x.quadraticCurveTo(r*.15,-r*.5,r*.6,-r*.15);x.quadraticCurveTo(r*.85,r*.6,0,r*.72);x.quadraticCurveTo(-r*.85,r*.6,-r*.6,-r*.15);x.quadraticCurveTo(-r*.15,-r*.5,0,-r*.9);});
   x.lineWidth=Math.max(1.5,r*.04);for(const s of[-.5,.5]){x.beginPath();x.moveTo(s*r*.15,-r*.5);x.quadraticCurveTo(s*r*1.2,r*.1,s*r*.5,r*.65);x.stroke();}
   x.lineWidth=Math.max(2,r*.06);for(const s of[-1,0,1]){x.beginPath();x.moveTo(s*r*.08,r*.72);x.lineTo(s*r*.14,r*.88);x.stroke();}vFace(x,0,r*.12,r*.55);}},
 {n:'Pumpkin',l:'P',d(x,r){drawPumpkin(x,0,r*.1,r*.75);vFace(x,0,r*.1,r*.6);}},
 {n:'Peas',l:'P',d(x,r){x.save();x.rotate(-.3);vShape(x,'#4f9e44',()=>{x.moveTo(-r*.9,0);x.quadraticCurveTo(0,r*.6,r*.9,0);x.quadraticCurveTo(0,-r*.25,-r*.9,0);});
   for(let i=0;i<4;i++)vShape(x,'#9be05a',()=>x.arc(-r*.5+i*r*.33,r*.07,r*.16,0,TAU));x.restore();
   x.save();x.rotate(-.3);for(let i=0;i<4;i++){x.fillStyle=VEG_INK;for(const s of[-1,1]){x.beginPath();x.arc(-r*.5+i*r*.33+s*r*.05,r*.05,r*.022,0,TAU);x.fill();}}x.restore();}},
 {n:'Potato',l:'P',d(x,r){vShape(x,'#c9965a',()=>{for(let i=0;i<=40;i++){const a=i/40*TAU,k=1+.06*Math.sin(a*5+1);const px=Math.cos(a)*r*.82*k,py=Math.sin(a)*r*.55*k;i?x.lineTo(px,py):x.moveTo(px,py);}x.closePath();});
   x.fillStyle='#8a6034';for(const[a,b]of[[-.55,-.2],[.5,.25],[.3,-.3],[-.3,.3]]){x.beginPath();x.arc(a*r,b*r,r*.04,0,TAU);x.fill();}vFace(x,0,0,r*.6);}},
 {n:'Radish',l:'R',d(x,r){x.lineWidth=Math.max(2,r*.07);for(const a of[-.5,0,.5])vLeaf(x,0,-r*.35,r*.55,r*.2,a,'#5db84d');
   vShape(x,'#e0393a',()=>x.arc(0,r*.1,r*.5,0,TAU));vShape(x,'#fff6ef',()=>{x.moveTo(-r*.2,r*.52);x.quadraticCurveTo(0,r*.68,r*.2,r*.52);x.lineTo(0,r*.95);x.closePath();});vFace(x,0,r*.08,r*.55,true);}},
 {n:'Squash',l:'S',d(x,r){x.save();x.rotate(.3);vShape(x,'#f1c27d',()=>{x.moveTo(0,-r*.85);x.bezierCurveTo(r*.3,-r*.85,r*.25,-r*.2,r*.45,r*.25);x.bezierCurveTo(r*.65,r*.95,-r*.65,r*.95,-r*.45,r*.25);x.bezierCurveTo(-r*.25,-r*.2,-r*.3,-r*.85,0,-r*.85);});
   vShape(x,'#7a9a3a',()=>x.rect(-r*.06,-r*.98,r*.12,r*.16));x.restore();vFace(x,r*.12,r*.4,r*.45);}},
 {n:'Tomato',l:'T',d(x,r){vShape(x,'#e0393a',()=>x.ellipse(0,r*.1,r*.72,r*.62,0,0,TAU));
   vShape(x,'#3f9b3a',()=>{for(let i=0;i<10;i++){const a=i/10*TAU-Math.PI/2,rr=i%2?r*.12:r*.32;x.lineTo(Math.cos(a)*rr,-r*.48+Math.sin(a)*rr*.6);}x.closePath();});
   x.fillStyle='rgba(255,255,255,.55)';x.beginPath();x.ellipse(-r*.38,-r*.12,r*.1,r*.16,-.5,0,TAU);x.fill();vFace(x,0,r*.18,r*.6,true);}},
 {n:'Turnip',l:'T',d(x,r){x.lineWidth=Math.max(2,r*.07);for(const a of[-.45,0,.45])vLeaf(x,0,-r*.4,r*.5,r*.18,a,'#5db84d');
   vShape(x,'#f6f1e4',()=>{x.moveTo(0,r*.95);x.quadraticCurveTo(r*.2,r*.6,r*.55,r*.3);x.arc(0,r*.05,r*.55,.47,Math.PI-.47,true);x.quadraticCurveTo(-r*.2,r*.6,0,r*.95);});
   x.save();x.beginPath();x.arc(0,r*.05,r*.55,0,TAU);x.clip();x.fillStyle='#9a4fb5';x.fillRect(-r,-r,2*r,r*.9);x.restore();x.beginPath();x.arc(0,r*.05,r*.55,Math.PI+.1,-.1);x.stroke();vFace(x,0,r*.15,r*.55);}},
 {n:'Yam',l:'Y',d(x,r){x.save();x.rotate(-.25);vShape(x,'#b5552f',()=>{x.moveTo(-r*.9,r*.05);x.bezierCurveTo(-r*.6,-r*.5,r*.6,-r*.55,r*.9,-r*.05);x.bezierCurveTo(r*.6,r*.5,-r*.6,r*.55,-r*.9,r*.05);});
   x.fillStyle='#7a3518';for(const[a,b]of[[-.45,-.05],[.1,.15],[.45,-.12]]){x.beginPath();x.arc(a*r,b*r,r*.035,0,TAU);x.fill();}x.restore();vFace(x,0,0,r*.5,true);}},
 {n:'Zucchini',l:'Z',d(x,r){x.save();x.rotate(-.6);vShape(x,'#2f6a2f',()=>{x.moveTo(-r*.22,-r*.75);x.quadraticCurveTo(-r*.3,r*.7,0,r*.92);x.quadraticCurveTo(r*.3,r*.7,r*.22,-r*.75);x.quadraticCurveTo(0,-r*.85,-r*.22,-r*.75);});
   x.strokeStyle='#7cc46a';x.lineWidth=Math.max(2,r*.04);x.beginPath();x.moveTo(-r*.08,-r*.6);x.lineTo(-r*.1,r*.6);x.moveTo(r*.08,-r*.6);x.lineTo(r*.1,r*.6);x.stroke();x.strokeStyle=VEG_INK;x.lineWidth=Math.max(2,r*.07);
   vShape(x,'#7a9a3a',()=>x.rect(-r*.08,-r*.98,r*.16,r*.24));x.restore();vFace(x,0,0,r*.45,true);}},
];
const vegImg={};
function vegSrc(v){if(vegImg[v.n])return vegImg[v.n];const c=document.createElement('canvas');c.width=c.height=220;const x=c.getContext('2d');x.translate(110,114);x.lineJoin='round';x.lineCap='round';x.strokeStyle=VEG_INK;x.lineWidth=6;
  try{v.d(x,92);}catch(e){console.warn(e);}return vegImg[v.n]=c.toDataURL();}
const ABC={round:0,rounds:10,stars:0,tries:0,cur:null,choices:[],kind:'veg',busy:false,learned:[],first:true};
const abcLetters=()=>[...new Set(VEGGIES.map(v=>v.l))];
// pick the most natural-sounding English voice the device has (neural/enhanced voices sound far less robotic)
let SAY_VOICE=null;
function pickVoice(){try{const vs=speechSynthesis.getVoices();if(!vs.length)return null;let best=null,bs=-1e9;
  for(const v of vs){const n=v.name,l=(v.lang||'').toLowerCase();if(!l.startsWith('en'))continue;let s=0;
    if(l==='en-us')s+=3;else if(l==='en-gb'||l==='en-au'||l==='en-ca')s+=2;else s+=1;
    if(/natural|neural/i.test(n))s+=14;if(/online/i.test(n))s+=4;if(/premium|enhanced|siri/i.test(n))s+=10;if(/google (us|uk) english/i.test(n))s+=7;
    // a clear female voice: known female voice names score high, male voices are pushed to the bottom
    if(/female|woman|google us english/i.test(n))s+=12;
    if(/\b(aria|jenny|ava|emma|michelle|sonia|libby|natasha|clara|samantha|allison|susan|zira|hazel|catherine|heera|victoria|karen|moira|tessa|fiona|veena|kate|serena|nicky|zoe|joelle|joanna|salli|kendra|kimberly|ruth|olivia|amy|ellie|maisie|jane|nancy|sara|ashley|cora|elizabeth|monica|amber|anna|kathleen)\b/i.test(n))s+=12;
    if(/\bana\b/i.test(n))s+=5; // a child's voice: female, but less clear
    if(/\b(male|man)\b|\b(david|mark|guy|andrew|brian|christopher|eric|roger|steffan|ryan|thomas|daniel|alex|fred|tom|aaron|arthur|oliver|rishi|lee|james|william|george|davis|tony|jason|brandon|liam|matthew|joey|justin|kevin|russell|gordon|reed|rocko)\b/i.test(n))s-=25;
    if(!v.localService)s+=1;
    if(/espeak|compact|eloquence|fred|albert|bad news|bahh|bells|boing|bubbles|cellos|deranged|good news|hysterical|pipe organ|trinoids|whisper|zarvox|jester|organ|superstar|wobble|junior|ralph|kathy|grandma|grandpa|rocko|shelley|\bflo\b|eddy|reed|sandy/i.test(n))s-=30;
    if(s>bs){bs=s;best=v;}}
  return best;}catch(e){return null;}}
try{if('speechSynthesis' in window){SAY_VOICE=pickVoice();speechSynthesis.addEventListener&&speechSynthesis.addEventListener('voiceschanged',()=>{SAY_VOICE=pickVoice();});}}catch(e){}
