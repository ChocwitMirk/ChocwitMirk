const v8Colors=['#ef2525','#ff8727','#ffe62e','#39c54c','#28e3df','#2465ef','#8c42df','#ff80c6','#ff80c6','#8c42df','#2465ef','#28e3df','#39c54c','#ffe62e','#ff8727','#ef2525'];
function v8Rainbow(y){const v=Math.max(0,Math.min(15,y/699*15)),i=Math.floor(v),a=kpHex(v8Colors[i]),b=kpHex(v8Colors[Math.min(15,i+1)]);return a.map((x,k)=>Math.round(x+(b[k]-x)*(v-i)));}
function v8Tone(note,kind='Piano',duration=.22){audio();if(!AC)return;const f=440*Math.pow(2,(note-69)/12),t=AC.currentTime;const types={Piano:'triangle',Guitar:'triangle',Bass:'sine',Flute:'sine',Trumpet:'sawtooth',Synth:'square',Drums:'sine',Farm:'triangle'};const o=AC.createOscillator(),g=AC.createGain();o.type=types[kind]||'triangle';o.frequency.setValueAtTime(kind==='Drums'?f/2:f,t);if(kind==='Drums'||kind==='Farm')o.frequency.exponentialRampToValueAtTime(Math.max(35,f*.45),t+duration*.8);g.gain.setValueAtTime(.001,t);g.gain.exponentialRampToValueAtTime(.075,t+.012);g.gain.exponentialRampToValueAtTime(.001,t+duration);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+duration+.02);}
function kpStartTree(x,y,size){
  KP.down=true;KP.last=[x,y];const branches=[],leaves=[];const rand=(a,b)=>a+Math.random()*(b-a);const depth=6;
  function branch(x,y,a,l,d,birth){const ex=x+Math.cos(a)*l,ey=y+Math.sin(a)*l;const bend=rand(-.12,.12)*l;const mx=(x+ex)/2+Math.cos(a+Math.PI/2)*bend,my=(y+ey)/2+Math.sin(a+Math.PI/2)*bend;const duration=d===0?.65:rand(.28,.53);const width=Math.max(.75,size*.065*Math.pow(.65,d));branches.push({x,y,ex,ey,mx,my,birth,duration,width,d,done:0});if(d<depth){const spread=rand(.33,.65);branch(ex,ey,a-spread,l*rand(.65,.79),d+1,birth+duration*.83);branch(ex,ey,a+rand(.32,.68),l*rand(.65,.79),d+1,birth+duration*.83);if(d<3&&Math.random()<.33)branch(ex,ey,a+rand(-.24,.24),l*rand(.52,.68),d+1,birth+duration*.9);}else{for(let j=0;j<3;j++)leaves.push({x:ex+rand(-4,4),y:ey+rand(-4,4),r:Math.max(1.7,size*rand(.009,.021)),birth:birth+duration*.7+j*.06,col:['#40883b','#72ad3d','#a0c34c','#326e34'][Math.floor(Math.random()*4)],done:false});}}
  branch(x,y,-Math.PI/2+rand(-.13,.13),size*.34,0,0);KP.growing={t:0,branches,leaves,ctx:KP.sticker};v8Grow(.12);kpSnd('tree');
}
function v8Grow(dt){const G=KP.growing;if(!G)return;G.t+=Math.min(.12,dt);const c=G.ctx;c.save();c.lineCap='round';c.lineJoin='round';let pending=false;for(const b of G.branches){const f=Math.max(0,Math.min(1,(G.t-b.birth)/b.duration));if(f<1)pending=true;if(f<=b.done)continue;const at=t=>[(1-t)*(1-t)*b.x+2*(1-t)*t*b.mx+t*t*b.ex,(1-t)*(1-t)*b.y+2*(1-t)*t*b.my+t*t*b.ey];c.strokeStyle=b.d<3?'#795032':b.d<5?'#6a6032':'#427b35';c.lineWidth=b.width*(1-.22*f);c.beginPath();c.moveTo(...at(b.done));for(let j=1;j<=5;j++)c.lineTo(...at(b.done+(f-b.done)*j/5));c.stroke();b.done=f;}for(const l of G.leaves){if(l.done)continue;if(G.t<l.birth){pending=true;continue;}c.fillStyle=l.col;c.beginPath();c.ellipse(l.x,l.y,l.r,l.r*.65,.6,0,TAU);c.fill();l.done=true;}c.restore();if(!pending){KP.growing=null;KP.down=false;}}

function v8Door(D,f){const t=D.t;if(t>2.35){KP.dyn=null;return;}const open=t>.55&&t<1.8;f.save();f.translate(500,350);const k=Math.min(1,t*5);f.scale(k,k);f.fillStyle='#493020';f.fillRect(-53,-75,106,150);f.fillStyle='#a66c38';f.fillRect(-46,-69,92,138);f.fillStyle='#312119';f.fillRect(-39,-62,78,124);f.save();f.translate(-39,0);f.scale(open?.18:1,1);f.fillStyle='#b77440';f.fillRect(0,-62,78,124);f.strokeStyle='#6e4125';f.lineWidth=4;f.strokeRect(6,-54,65,108);f.fillStyle='#fbd455';f.beginPath();f.arc(64,4,5,0,TAU);f.fill();f.restore();if(open){f.font='bold 36px sans-serif';f.textAlign='center';f.fillStyle='#fff';f.strokeStyle='#39271c';f.lineWidth=6;f.strokeText('Goodbye!',0,-96);f.fillText('Goodbye!',0,-96);if(!D.spoken){D.spoken=true;say('Goodbye!');}}if(t>=1.8&&!D.slam){D.slam=true;noiseBurst(.15,.2,450);}f.restore();}
let v8panel=null,v8cleanup=()=>{};
window.moonieNativePause=function(paused){window.__moonieNativePaused=paused;if(paused&&AC&&AC.state==='running')AC.suspend().catch(()=>{});if(!paused&&AC&&AC.state==='suspended')AC.resume().catch(()=>{});};
document.addEventListener('visibilitychange',()=>{if(document.hidden&&AC&&AC.state==='running')AC.suspend().catch(()=>{});});
function v8Cards(g){[['tunes','Moo Tunes','🎹'],['whack','Whack-a-Moo!','🔨'],['lab','Moonie’s Labyrinth','🥕']].forEach(([id,name,emoji])=>{const b=document.createElement('button');b.className='gcard';b.dataset.v8=id;const cv=document.createElement('canvas');cv.width=512;cv.height=680;const x=cv.getContext('2d'),col={tunes:'#8352b9',whack:'#c9782c',lab:'#4f9b46'}[id],sub={tunes:'Make a farm song!',whack:'Bonk, but avoid poop!',lab:'Collect every veggie!'}[id];x.fillStyle='#fff6df';x.fillRect(0,0,512,680);x.strokeStyle='#2b2118';x.lineWidth=12;x.strokeRect(12,12,488,656);x.fillStyle=col;x.fillRect(30,30,452,112);x.fillStyle='#fff6df';x.textAlign='center';x.textBaseline='middle';x.font='900 50px Nunito,Arial,sans-serif';x.fillText(name,256,86,420);x.font='220px sans-serif';x.fillText(emoji,256,346);x.fillStyle='#2b2118';x.font='800 32px Nunito,Arial,sans-serif';x.fillText(sub,256,594,440);b.innerHTML=`<img alt="" src="${cv.toDataURL()}"><span>${name}</span>`;g.appendChild(b);});}
function v8Open(id){$('games').hidden=true;state='menu';v8panel=document.createElement('section');v8panel.id='v8panel';document.body.appendChild(v8panel);v8panel.innerHTML='<button class="v8exit">← Games</button>';v8panel.firstChild.onclick=v8Close;if(id==='tunes'){tunesMuted=true;syncMusic();v8Tunes();}else if(id==='whack')v8Whack();else v8Lab();}
function v8Close(){v8cleanup();if(tunesMuted){tunesMuted=false;syncMusic();}v8cleanup=()=>{};if(v8panel)v8panel.remove();v8panel=null;$('games').hidden=false;state='menu';}
const mooGuitarDrive=Float32Array.from({length:2049},(_,i)=>{
 const sample=i/1024-1;
 return Math.tanh(5*sample)/Math.tanh(5);
});
function mooElectricGuitar(f,t,duration){
 const dur=Math.max(.22,Math.min(.8,duration+.19));
 const pickup=AC.createBiquadFilter(),drive=AC.createWaveShaper();
 const cabinet=AC.createBiquadFilter(),level=AC.createGain();
 pickup.type='highpass';pickup.frequency.value=95;pickup.Q.value=.65;
 drive.curve=mooGuitarDrive;drive.oversample='4x';
 cabinet.type='lowpass';cabinet.frequency.value=3600;cabinet.Q.value=.65;
 level.gain.setValueAtTime(.0001,t);
 level.gain.exponentialRampToValueAtTime(.12,t+.008);
 level.gain.exponentialRampToValueAtTime(.055,t+dur*.55);
 level.gain.exponentialRampToValueAtTime(.0001,t+dur);
 pickup.connect(drive).connect(cabinet).connect(level).connect(master);
 [1,.68,.4,.28,.16,.12].forEach((amp,i)=>{
  const string=AC.createOscillator(),partial=AC.createGain();
  string.type='sine';string.frequency.value=f*(i+1);
  partial.gain.setValueAtTime(amp*.44,t);
  partial.gain.exponentialRampToValueAtTime(.0001,t+dur/(1+i*.19));
  string.connect(partial).connect(pickup);
  string.start(t);string.stop(t+dur+.02);
  if(i===0)string.onended=()=>{pickup.disconnect();drive.disconnect();cabinet.disconnect();level.disconnect();};
 });
 noiseBurst(.018,.016,2800);
}
function mooInstrument(note,kind,duration){
 if(kind!=='Piano'&&kind!=='Guitar'){v8Tone(note,kind,duration);return;}
 audio();if(!AC)return;
 const t=AC.currentTime,f=440*2**((note-69)/12),dur=.9;
 if(kind==='Guitar'){mooElectricGuitar(f,t,duration);return;}
 [1,.34,.12,.18,.05].forEach((amp,i)=>{
  const o=AC.createOscillator(),g=AC.createGain();
  o.type='sine';o.frequency.value=f*(i+1)*Math.sqrt(1+.00016*i*i);
  g.gain.setValueAtTime(.0001,t);
  g.gain.exponentialRampToValueAtTime(amp*.065,t+.012);
  g.gain.exponentialRampToValueAtTime(.0001,t+dur/(1+i*.26));
  o.connect(g).connect(master);o.start(t);o.stop(t+dur+.01);
 });
}
function mooMusical(note){audio();if(!AC)return;const t=AC.currentTime,d=.62,f=170*2**((note-60)/12),o=AC.createOscillator(),g=AC.createGain(),pre=AC.createGain();o.type='sawtooth';o.frequency.setValueAtTime(f*.85,t);o.frequency.linearRampToValueAtTime(f,t+.13);o.frequency.setValueAtTime(f,t+.36);o.frequency.linearRampToValueAtTime(f*.83,t+d);o.connect(pre);for(const [hz,q,v] of [[320,3,1],[800,5,.6],[1600,7,.12]]){const b=AC.createBiquadFilter(),a=AC.createGain();b.type='bandpass';b.Q.value=q;b.frequency.setValueAtTime(hz*.7,t);b.frequency.linearRampToValueAtTime(hz,t+.15);a.gain.value=v;pre.connect(b).connect(a).connect(g);}g.gain.setValueAtTime(.001,t);g.gain.linearRampToValueAtTime(.24,t+.09);g.gain.setValueAtTime(.24,t+.32);g.gain.exponentialRampToValueAtTime(.001,t+d);g.connect(master);o.start(t);o.stop(t+d+.02);}
function mooDrum(i){
 audio(); if(!AC||i<0||i>5)return; const t=AC.currentTime;
 function membrane(f0,f1,d,v){const o=AC.createOscillator(),g=AC.createGain();o.type='sine';o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(f1,t+d*.65);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+d+.01);}
 function noise(d,v,type,f){const n=Math.ceil(AC.sampleRate*d),buf=AC.createBuffer(1,n,AC.sampleRate),a=buf.getChannelData(0);for(let j=0;j<n;j++)a[j]=Math.random()*2-1;const src=AC.createBufferSource(),filter=AC.createBiquadFilter(),g=AC.createGain();src.buffer=buf;filter.type=type;filter.frequency.value=f;g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);src.connect(filter);filter.connect(g);g.connect(AC.destination);src.start(t);}
 if(i===0){noise(.075,.13,'highpass',7500);}else if(i===1){noise(.18,.24,'bandpass',2200);membrane(190,115,.12,.09);}else if(i===5){membrane(155,43,.32,.28);noise(.018,.035,'lowpass',1600);}else{const f=[250,175,115][i-2];membrane(f,f*.65,.25+(i-2)*.05,.19);noise(.028,.035,'lowpass',1900);}
}
function v8Tunes(){
  const tracksMeta=[
    {name:'Piano',icon:'🎹',hint:'classic keys',accent:'#ffd95e'},
    {name:'Guitar',icon:'🎸',hint:'distorted electric guitar',accent:'#ff9d5c'},
    {name:'Cow',icon:'🐄',hint:'musical moo',accent:'#95d46f'},
    {name:'Drums',icon:'🥁',hint:'barn beat',accent:'#ff7fc0'},
    {name:'Trumpet',icon:'🎺',hint:'bright horn',accent:'#7fd3ff'},
    {name:'Flute',icon:'🪈',hint:'soft lead',accent:'#f7f0aa'},
    {name:'Synth',icon:'✨',hint:'sparkle pad',accent:'#bda9ff'},
    {name:'Barnyard',icon:'🏠',hint:'choose an animal',accent:'#9fe8ff'}
  ];
  const notes=[72,71,69,67,65,64,62,60,70,68,66,63,61], labels=['C5','B4','A4','G4','F4','E4','D4','C4','A♯4','G♯4','F♯4','D♯4','C♯4'];
  const drumNames=['Hi-hat','Snare','High tom','Mid tom','Low tom','Kick'], drumIcons=['✦','🥁','③','②','①','●'];
  const rowLabels=()=>track===3?drumNames:labels;
  const animals=[{name:'Moonie',sound:'moo',kind:'cow'},...FRIENDS];
  const animalIcons={cow:'🐄',pig:'🐷',chicken:'🐔',sheep:'🐑',duck:'🦆',goat:'🐐',horse:'🐴',dog:'🐕',cat:'🐈',llama:'🦙',donkey:'🫏'};
  let chosen=0; const animalTracks=animals.map(()=>Array.from({length:13},()=>Array(16).fill(false)));
  const ornaments=['♪','♫','★','✦','♩','♬','✩','♭'];
  let track=0, step=0, timer=0, recording=false, liveBeat=-1;
  let tracks=tracksMeta.map(()=>Array.from({length:13},()=>Array(16).fill(false)));
  const p=v8panel;
  p.insertAdjacentHTML('beforeend',`<div class="mooTunesShell"><h2>🎹 Moo Tunes</h2><div class="mooSub">Compose little farm songs on a music staff, just like the old colorful music toys.</div><div class="mooTransport v8bar"><button id="v8play" title="Play">▶</button><button id="v8stop" title="Stop">■</button><button id="v8rew" title="Rewind">⏮</button><button id="v8record" aria-pressed="false" title="Record keys during playback">● Record</button><button id="v8clear" title="Clear this track">⌫</button><button id="v8clearall" title="Clear every track">Clear All</button><button id="v8save" title="Save song">💾</button><button id="v8load" title="Load song">📂</button><label class="v8loopLabel"><input id="v8loop" type="checkbox" checked> Loop</label><label class="v8tempoLabel">Tempo <input id="v8tempo" type="range" min="60" max="160" value="100"><span id="v8bpm">100</span></label></div><div class="mooTracks" id="v8tracks"></div><div id="mooAnimals" class="v8bar" hidden></div><div class="mooStage"><div class="mooStageTop"><div class="mooLegend"><span id="v8staffLabel">Treble Staff</span><b>Beat <span id="v8beat">1</span> of 16</b></div><div class="mooHint">Tap the staff to place notes. Each track keeps its own pattern.</div></div><div class="mooStaffWrap"><div class="mooClef">𝄞</div><div class="mooDecor mooHorn">📯</div><div class="mooDecor mooStar">★</div><div class="mooDecor mooNote">♪</div><div class="mooDecor mooDuck">🐥</div><div class="v8grid mooGrid" id="v8notes"></div></div></div><div class="mooKeyboard v8keys" id="v8keys"></div><div id="v8msg" class="mooMsg" aria-live="polite"></div></div>`);
  const q=id=>p.querySelector('#'+id), grid=q('v8notes');
  function current(){return track===7?animalTracks[chosen]:track===3?tracks[3].slice(0,6):tracks[track];}
  function sound(n,i,d=.26,animal=chosen){if(i===7){audio();if(animals[animal].sound==='moo')mooMusical(n);else friendSound(animals[animal],.65,0);}else if(i===2)mooMusical(n);else if(i===3)mooDrum(notes.indexOf(n));else mooInstrument(n,tracksMeta[i].name,d);}
  function trackHasData(i){return i===7?animalTracks.some(tr=>tr.some(r=>r.some(Boolean))):tracks[i].some(r=>r.some(Boolean));}
  function renderAnimals(){const el=q('mooAnimals');el.style.display=track===7?'flex':'none';el.innerHTML=animals.map((f,i)=>`<button data-animal="${i}" aria-pressed="${i===chosen}" style="background:${i===chosen?'#ffd95e':'#fff6df'}">${animalIcons[f.kind]||'♪'} ${f.kind} ${animalTracks[i].some(r=>r.some(Boolean))?'♪':''}</button>`).join('');}
  q('mooAnimals').onclick=e=>{const b=e.target.closest('[data-animal]');if(!b)return;chosen=+b.dataset.animal;sound(60,7);renderAnimals();renderGrid();};
  function renderTracks(){
    q('v8tracks').innerHTML=tracksMeta.map((meta,i)=>`<button class="mooTrack ${i===track?'on':''}" data-t="${i}" style="--accent:${meta.accent}"><span class="ico">${meta.icon}</span><span class="name">${meta.name}</span><small>${meta.hint}</small><span class="dot">${trackHasData(i)?'♪':''}</span></button>`).join('');
  }
  function renderGrid(){
    grid.classList.toggle('drumGrid',track===3); q('v8staffLabel').textContent=track===3?'Drum Kit':'Treble Staff';
    grid.innerHTML=(track===3?[0,1,2,3,4,5]:[0,1,8,2,9,3,10,4,5,11,6,12,7]).map(r=>current()[r].map((v,c)=>`<button title="${rowLabels()[r]} beat ${c+1}" aria-label="${rowLabels()[r]} beat ${c+1}" data-r="${r}" data-c="${c}" data-l="${rowLabels()[r]}" class="${v?'on':''} ${liveBeat===c?'now':''}"><span>${v?(track===7?(animalIcons[animals[chosen].kind]||'♪'):track===2?'🐄':track===3?drumIcons[r]:ornaments[(r+c)%ornaments.length]):''}</span>${c===0?`<em>${rowLabels()[r]}</em>`:''}</button>`).join('')).join('');
    q('v8beat').textContent=String((liveBeat>=0?liveBeat:step)+1);
  }
  function renderKeys(){
    if(track===3){q('v8keys').innerHTML='<div class="mooDrumPads">'+drumNames.map((name,i)=>`<button data-n="${notes[i]}"><b>${drumIcons[i]}</b><span>${name}</span></button>`).join('')+'</div>';return;}
    const whites=[60,62,64,65,67,69,71,72];
    const blackMap={0:61,1:63,3:66,4:68,5:70};
    q('v8keys').innerHTML=`<div class="mooPiano">${whites.map((n,i)=>`<button class="white" data-n="${n}"><span>${['C','D','E','F','G','A','B','C'][i]}</span></button>`).join('')}${Object.entries(blackMap).map(([i,n])=>`<button class="black k${i}" data-n="${n}" aria-label="Sharp note"></button>`).join('')}</div>`;
  }
  function render(){renderTracks();renderAnimals();renderGrid();renderKeys();}
  q('v8tracks').onclick=e=>{const b=e.target.closest('[data-t]'); if(!b)return; track=+b.dataset.t; render();};
  grid.onclick=e=>{const b=e.target.closest('[data-r]'); if(!b)return; const r=+b.dataset.r,c=+b.dataset.c; current()[r][c]=!current()[r][c]; if(current()[r][c]){sound(notes[r],track); q('v8msg').textContent=`${tracksMeta[track].name}: added ${rowLabels()[r]} on beat ${c+1}.`; } else q('v8msg').textContent=`Removed ${rowLabels()[r]} from beat ${c+1}.`; renderGrid(); renderTracks(); renderAnimals(); };
  q('v8keys').onpointerdown=e=>{const b=e.target.closest('[data-n]'); if(!b)return; const n=+b.dataset.n; sound(n,track,.26); if(recording&&liveBeat>=0){const r=notes.indexOf(n);if(r>=0&&current()[r]){current()[r][liveBeat]=true;renderGrid();renderTracks();renderAnimals();}} b.classList.add('tap'); setTimeout(()=>b.classList.remove('tap'),140);};
  function stop(){clearTimeout(timer);timer=0;liveBeat=-1;step=0;grid.querySelectorAll('.now').forEach(b=>b.classList.remove('now'));q('v8msg').textContent='Stopped.';q('v8beat').textContent='1';}
  function tick(){
    liveBeat=step;
    grid.querySelectorAll('button').forEach(b=>b.classList.toggle('now',+b.dataset.c===step));
    q('v8beat').textContent=String(step+1);
    tracks.slice(0,7).forEach((tr,i)=>tr.forEach((r,j)=>{if(r[step]&&(i!==3||j<6))sound(notes[j],i,.22);}));animalTracks.forEach((tr,i)=>{tr.forEach((r,j)=>{if(r[step])sound(notes[j],7,.22,i);});});
    step++;
    if(step===16){step=0; if(!q('v8loop').checked){timer=setTimeout(()=>{stop();renderGrid();},260); return;}}
    timer=setTimeout(tick,60000/+q('v8tempo').value/2);
  }
  q('v8record').onclick=()=>{recording=!recording;q('v8record').setAttribute('aria-pressed',String(recording));q('v8msg').textContent=recording?'Record armed — press Play and tap the keys or pads.':'Recording off.';};
  q('v8clearall').onclick=()=>{stop();tracks.forEach(tr=>tr.forEach(r=>r.fill(false)));animalTracks.forEach(tr=>tr.forEach(r=>r.fill(false)));render();q('v8msg').textContent='All tracks cleared.';};
  q('v8play').onclick=()=>{if(!timer){q('v8msg').textContent='Playing your farm tune!'; tick();}};
  q('v8stop').onclick=()=>{stop(); renderGrid();};
  q('v8rew').onclick=()=>{step=0; q('v8beat').textContent='1'; grid.querySelectorAll('.now').forEach(b=>b.classList.remove('now')); q('v8msg').textContent='Rewound to the start.';};
  q('v8tempo').oninput=()=>q('v8bpm').textContent=q('v8tempo').value;
  q('v8clear').onclick=()=>{current().forEach(r=>r.fill(false)); render(); q('v8msg').textContent=`Cleared the ${tracksMeta[track].name} track.`;};
  q('v8save').onclick=()=>{try{localStorage.setItem('moonie-v8-song',JSON.stringify({tracks,animalTracks,tempo:q('v8tempo').value}));q('v8msg').textContent='Song saved!';}catch(e){q('v8msg').textContent='Storage unavailable.';}};
  q('v8load').onclick=()=>{try{const d=JSON.parse(localStorage.getItem('moonie-v8-song'));if(d&&d.tracks){tracks=d.tracks.map(tr=>Array.from({length:13},(_,i)=>Array.from({length:16},(_,j)=>!!tr?.[i]?.[j]))); if(tracks[3]){for(let j=0;j<16;j++)tracks[3][5][j]=!!(tracks[3][5][j]||tracks[3][6][j]||tracks[3][7][j]);tracks[3][6].fill(false);tracks[3][7].fill(false);} if(Array.isArray(d.animalTracks)){d.animalTracks.slice(0,animals.length).forEach((tr,i)=>{if(Array.isArray(tr))animalTracks[i]=Array.from({length:13},(_,r)=>Array.from({length:16},(_,j)=>!!tr[r]?.[j]));});}else if(tracks[7])animalTracks[0]=tracks[7];q('v8tempo').value=d.tempo||100;q('v8bpm').textContent=q('v8tempo').value;render();q('v8msg').textContent='Song loaded!';}else q('v8msg').textContent='No saved song yet.';}catch(e){q('v8msg').textContent='Could not load song.';}};
  render();
  v8cleanup=stop;
}
function v8Whack(){
  const p=v8panel;
  p.insertAdjacentHTML('beforeend','<h2>🔨 Whack-a-Moo!</h2><div>Bonk the farm animal heads — avoid the poop!</div><div class="v8bar"><select id="v8diff"><option>Easy</option><option>Medium</option><option>Hard</option></select><button id="v8start">Start round</button><b id="v8score">Score: 0 • 60s</b></div><div id="v8holes"></div><div id="v8mallet" hidden>🔨</div><div id="v8result" aria-live="polite"></div>');
  const q=id=>p.querySelector('#'+id),board=q('v8holes'),mallet=q('v8mallet');
  let score=0,end=0,spawn=0,clock=0,active=false;

  function buildWhackHeads(){
    if(mem.whackHeads&&mem.whackHeads.length)return mem.whackHeads;
    const list=[];
    try{
      const pr=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true});
      pr.setSize(220,220); pr.setPixelRatio(1); if(R&&R.outputEncoding!=null)pr.outputEncoding=R.outputEncoding;
      const ps=new THREE.Scene();
      ps.add(new THREE.HemisphereLight(0xffffff,0x887755,1.08));
      const dl=new THREE.DirectionalLight(0xffffff,.75); dl.position.set(2.2,3,4.4); ps.add(dl);
      const pc=new THREE.PerspectiveCamera(26,1,.1,60);
      const snap=(obj,crop=false)=>{
        ps.add(obj); obj.updateMatrixWorld(true);
        const bb=new THREE.Box3().setFromObject(obj), c=bb.getCenter(new THREE.Vector3()), s=bb.getSize(new THREE.Vector3());
        const d=Math.max(s.x,s.y,s.z)*2.4;
        pc.position.set(c.x+(crop?0:d*.12),c.y+(crop?0:d*.1),c.z+d); pc.lookAt(c.x,c.y+s.y*.03,c.z); pr.render(ps,pc);
        const src=pr.domElement, cv=document.createElement('canvas'); cv.width=cv.height=220; const ct=cv.getContext('2d');
        ct.clearRect(0,0,220,220);
        if(crop) ct.drawImage(src,30,0,160,132,0,0,220,220); else ct.drawImage(src,0,0,220,220);
        ps.remove(obj); return cv.toDataURL();
      };
      if(moonie&&moonie.root){
        // Render the actual skinned rig, not a clone sharing the live skeleton.
        // Moonie's eyes and muzzle face local +Z (see loadMoonie eyelid coordinates).
        const m=moonie.root, parent=m.parent, pos=m.position.clone(), rot=m.quaternion.clone(), vis=m.visible;
        const innerVis=moonie.inner.visible;
        try{
          m.position.set(0,0,0); m.rotation.set(0,0,0); m.visible=true; moonie.inner.visible=true;
          m.updateMatrixWorld(true);
          list.push({name:'Moonie',src:snap(m,true),moonie:true});
        }finally{
          if(parent)parent.add(m); else if(m.parent)m.parent.remove(m);
          m.position.copy(pos); m.quaternion.copy(rot); m.visible=vis; moonie.inner.visible=innerVis; m.updateMatrixWorld(true);
        }
      }
      FRIENDS.forEach(f=>{
        const built=f.build(); let subject=built;
        if(built.userData&&built.userData.head){
          const wrap=new THREE.Group(), head=built.userData.head.clone(true);
          head.position.set(0,0,0); head.rotation.y=.08; wrap.add(head); subject=wrap;
        }
        subject.rotation.y=.55;
        list.push({name:f.name,src:snap(subject,false),f});
      });
      try{pr.dispose(); pr.forceContextLoss&&pr.forceContextLoss();}catch(e){}
      mem.whackHeads=list;
      return list;
    }catch(e){
      console.error('Whack head render',e);
      mem.whackHeads=[{name:'Moonie',src:COW_TOKEN,moonie:true}].concat(FRIENDS.map(f=>{const im=(mem.imgs||[]).find(q=>q.f===f); return {name:f.name,src:im?im.src:COW_TOKEN,f};}));
      return mem.whackHeads;
    }
  }

  function splatScreen(){
    const layer=document.createElement('div');layer.className='whackSplat';p.appendChild(layer);
    for(let i=0;i<11;i++){const blob=document.createElement('div');blob.className='whackBlob';const size=35+Math.random()*125;blob.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${size}px;height:${size*.85}px;transform:translate(-50%,-50%) rotate(${Math.random()*360}deg);`;blob.innerHTML='<svg viewBox="0 0 100 100"><path fill="#75401d" stroke="#50290e" stroke-width="3" d="M47 24Q28 2 29 24L33 37Q1 18 13 41L28 48Q-5 55 17 69L36 63Q26 98 44 86L52 72Q77 103 77 78L66 64Q101 76 88 54L71 48Q98 21 76 25L61 37Q61 4 47 24Z"/><ellipse cx="43" cy="47" rx="12" ry="7" fill="#a76b37" opacity=".65"/></svg>';layer.appendChild(blob);}
    for(let i=0;i<7;i++){const f=document.createElement('i');f.className='whackFly';f.textContent='🪰';f.style.cssText=`left:${20+Math.random()*60}%;top:${20+Math.random()*60}%;--dx:${(Math.random()-.5)*500}px;--dy:${(Math.random()-.5)*400}px`;layer.appendChild(f);}setTimeout(()=>layer.remove(),1800);
  }
  const animals=buildWhackHeads();
  const holes=Array.from({length:9},(_,i)=>{
    const b=document.createElement('button');
    b.setAttribute('aria-label','Hole '+(i+1));
    b.innerHTML='<span class="popWrap"></span>';
    board.appendChild(b);
    b.onclick=()=>{
      if(!active||!b.classList.contains('up'))return;
      const poop=b.dataset.poop==='1';
      score=Math.max(0,score+(poop?-2:1));
      b.classList.remove('up'); b.classList.add('bonk'); clearTimeout(b.timeout);
      if(poop){audio();noiseBurst(.35,.22,280);voice({type:'sawtooth',f0:150,f1:52,dur:.38,vol:.22,filt:380,vib:17});voice({type:'triangle',f0:185,f1:105,dur:.32,vol:.18,delay:.24});splatScreen();q('v8result').textContent='Oops! Avoid the poop!';}
      else{v8Tone(48,'Drums',.13); if(b.animal&&b.animal.moonie)SFX.moo(); else if(b.animal&&b.animal.f)friendSound(b.animal.f,.45,0); q('v8result').textContent=`Bonk! ${b.animal?b.animal.name:''}`;}
      setTimeout(()=>b.classList.remove('bonk'),160);
    };
    return b;
  });
  function clearHole(b){b.classList.remove('up','bonk'); b.dataset.poop='0'; b.animal=null; const w=b.querySelector('.popWrap'); if(w)w.innerHTML='';}
  function stop(){active=false; clearTimeout(spawn); clearInterval(clock); holes.forEach(b=>{clearTimeout(b.timeout); clearHole(b);});}
  function pop(){
    if(!active)return;
    const free=holes.filter(b=>!b.classList.contains('up')&&!b.classList.contains('bonk'));
    if(free.length){
      const b=free[Math.floor(Math.random()*free.length)], wrap=b.querySelector('.popWrap'), poop=Math.random()<.19;
      clearHole(b); b.dataset.poop=poop?'1':'0';
      if(poop){wrap.innerHTML='<div class="poopPop" aria-label="Poop">💩</div>';}
      else{
        const a=animals[Math.floor(Math.random()*animals.length)]; b.animal=a;
        wrap.innerHTML=`<div class="headWrap"><img class="headPop" alt="${a.name} head" src="${a.src}"></div>`;
      }
      b.classList.add('up');
      const difficulty=q('v8diff').selectedIndex, elapsed=60-Math.max(0,(end-Date.now())/1000);
      b.timeout=setTimeout(()=>clearHole(b),Math.max(420,1900-difficulty*450-elapsed*12));
    }
    spawn=setTimeout(pop,Math.max(260,900-q('v8diff').selectedIndex*170-(60-(end-Date.now())/1000)*6));
  }
  q('v8start').onclick=()=>{
    stop(); audio(); score=0; end=Date.now()+60000; active=true; q('v8result').textContent='Go!'; q('v8score').textContent='Score: 0 • 60s'; pop();
    clock=setInterval(()=>{const left=Math.max(0,Math.ceil((end-Date.now())/1000)); q('v8score').textContent=`Score: ${score} • ${left}s`; if(!left){stop(); q('v8result').textContent=`Round complete! You scored ${score}!`; try{const k='moonie-whack-best',best=Math.max(score,+localStorage.getItem(k)||0); localStorage.setItem(k,best); q('v8result').textContent+=` Best: ${best}`;}catch(e){}}},100);
  };
  board.onpointermove=e=>{if(e.pointerType==='mouse'){mallet.hidden=false; mallet.style.left=e.clientX+'px'; mallet.style.top=e.clientY+'px';}};
  board.onpointerleave=()=>mallet.hidden=true;
  board.onpointerdown=e=>{mallet.hidden=false; mallet.style.left=e.clientX+'px'; mallet.style.top=e.clientY+'px'; mallet.animate([{transform:'translate(-25%,-90%) rotate(-30deg)'},{transform:'translate(-25%,-60%) rotate(35deg)'},{transform:'translate(-25%,-90%) rotate(-30deg)'}],{duration:180}); if(e.pointerType!=='mouse')setTimeout(()=>mallet.hidden=true,190);};
  v8cleanup=stop;
}
function v8Lab(){
 const p=v8panel;p.classList.add('labPanel');p.insertAdjacentHTML('beforeend',`<h2>Moonie's Labyrinth</h2><div id="v8labinfo"></div><div class="labLayout"><canvas id="v8maze"></canvas><div class="labSide"><div id="v8pad"><button data-dir="0,-1">↑</button><button data-dir="-1,0">←</button><button data-dir="0,1">↓</button><button data-dir="1,0">→</button></div><button id="v8reset">↻ Retry</button><div id="v8labmsg"></div></div></div>`);
 const q=id=>p.querySelector('#'+id),c=q('v8maze'),N=10;
 let lv=0,grid,px,py,remaining,dead,won,dir=null,raf=0,falling=new Set(),nextGravity=0,moveStart=0,moving=false,fromX=0,fromY=0,last=0,closed=false,ready=false,hero,mixer,run,idle,face=0,padPrev='',swipe=null,winAt=0;
 const duration=155,sc=new THREE.Scene();sc.background=new THREE.Color(0x476d32);sc.add(new THREE.HemisphereLight(0xfff6db,0x70804b,1.15));const light=new THREE.DirectionalLight(0xfff4d5,.9);light.position.set(-5,12,7);sc.add(light);
 let rr;try{rr=new THREE.WebGLRenderer({canvas:c,antialias:true});rr.setPixelRatio(Math.min(devicePixelRatio||1,1.5));rr.outputEncoding=R.outputEncoding;}catch(e){q('v8labmsg').textContent='3D graphics unavailable on this device.';return;}
 const camera=new THREE.OrthographicCamera(-5.8,5.8,5.8,-5.8,.1,80);camera.position.set(0,14,6.7);camera.lookAt(0,0,0);
 const board=new THREE.Group();sc.add(board);const pieces=new Map();
 const mats={grass:new THREE.MeshStandardMaterial({color:0x8fc458}),grass2:new THREE.MeshStandardMaterial({color:0x83b64e}),soil:new THREE.MeshStandardMaterial({color:0xa16a3a}),ridge:new THREE.MeshStandardMaterial({color:0xc18b50}),wall:new THREE.MeshStandardMaterial({color:0xa66b39}),walltop:new THREE.MeshStandardMaterial({color:0xe0ae69}),hay:new THREE.MeshStandardMaterial({color:0xe4b341}),band:new THREE.MeshStandardMaterial({color:0x976527}),carrot:new THREE.MeshStandardMaterial({color:0xf78b25}),leaf:new THREE.MeshStandardMaterial({color:0x429537}),red:new THREE.MeshStandardMaterial({color:0xb8352a}),roof:new THREE.MeshStandardMaterial({color:0x743525}),door:new THREE.MeshStandardMaterial({color:0x563b26}),open:new THREE.MeshStandardMaterial({color:0xffd95c}),shadow:new THREE.MeshBasicMaterial({color:0x46612c,transparent:true,opacity:.35,depthWrite:false})};
 const white=new THREE.MeshStandardMaterial({color:0xfff4d9}),dark=new THREE.MeshStandardMaterial({color:0x351e18}),gold=new THREE.MeshStandardMaterial({color:0xffe25c,emissive:0x996000,emissiveIntensity:.35}); const box=new THREE.BoxGeometry(1,1,1),ball=new THREE.SphereGeometry(1,16,10),cone=new THREE.ConeGeometry(1,1,12),cyl=new THREE.CylinderGeometry(1,1,1,18);
 function mesh(g,geo,mat,x,y,z,sx,sy,sz){const m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.scale.set(sx,sy,sz);g.add(m);return m;}
 function tile(t,x,y){const g=new THREE.Group();g.position.set(x-4.5,0,y-4.5);board.add(g);if(t==='#'){mesh(g,box,mats.wall,0,.32,0,.96,.64,.96);mesh(g,box,mats.walltop,0,.65,0,.98,.10,.98);for(const z of [-.3,.3])mesh(g,box,mats.band,0,.22,z,.98,.07,.07);}if(t==='.'){mesh(g,box,mats.soil,0,.04,0,.95,.09,.95);for(const z of [-.28,0,.28])mesh(g,box,mats.ridge,0,.105,z,.84,.035,.09);}if(t==='R'){const h=mesh(g,cyl,mats.hay,0,.39,0,.38,.77,.38);h.rotation.z=Math.PI/2;for(const x of [-.23,.23]){const band=mesh(g,cyl,mats.band,x,.39,0,.385,.055,.385);band.rotation.z=Math.PI/2;}}if(t==='V'){const carrot=mesh(g,cone,mats.carrot,0,.31,0,.19,.52,.19);carrot.rotation.z=Math.PI;for(let i=0;i<3;i++){const l=mesh(g,ball,mats.leaf,(i-1)*.10,.65,0,.07,.19,.06);l.rotation.z=(1-i)*.45;}}if(t==='E'){
 const entry=maps[lv].entry;g.rotation.y=Math.atan2(-entry[0],-entry[1]);
 mesh(g,cyl,gold,0,.025,0,.49,.05,.49);
 mesh(g,box,mats.red,0,.31,0,.82,.62,.78);
 for(const side of [-1,1]){const roof=mesh(g,box,mats.roof,side*.23,.76,0,.59,.095,.96);roof.rotation.z=-side*.63;mesh(g,box,white,side*.39,.31,.405,.055,.62,.035);}
 mesh(g,box,dark,0,.24,.405,.43,.48,.035);
 for(const side of [-1,1]){mesh(g,box,white,side*.24,.24,.43,.045,.5,.035);const door=mesh(g,box,mats.red,side*.36,.24,.48,.20,.48,.045);door.rotation.y=side*.65;}
 mesh(g,box,white,0,.49,.43,.52,.045,.035);
 mesh(g,box,white,0,.57,.413,.18,.13,.04);mesh(g,box,dark,0,.57,.438,.12,.08,.02);
 const sign=mesh(g,box,white,0,.88,.02,.62,.06,.30);
 // Floating goal marker faces the overhead camera.
 const cv=document.createElement('canvas');cv.width=256;cv.height=96;const ctx=cv.getContext('2d');ctx.fillStyle='#fff4d9';ctx.fillRect(4,4,248,88);ctx.strokeStyle='#7b3721';ctx.lineWidth=8;ctx.strokeRect(4,4,248,88);ctx.fillStyle='#a92e24';ctx.font='bold 44px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('BARN',128,49);const tex=new THREE.CanvasTexture(cv);const label=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,depthTest:false}));label.position.set(0,1.38,0);label.scale.set(.94,.35,1);label.renderOrder=10;g.add(label);const arrow=new THREE.ArrowHelper(new THREE.Vector3(0,0,-1),new THREE.Vector3(0,.17,1.05),.55,0x39ef35,.22,.25);g.add(arrow);
 }return g;}
 function sync(){for(let y=0;y<N;y++)for(let x=0;x<N;x++){const k=y*N+x,t=grid[y][x],old=pieces.get(k),tag=t+(t==='E'?String(lv):'');if(old&&old.tag===tag)continue;if(old){old.g.traverse(o=>{if(o.isSprite){o.material.map?.dispose();o.material.dispose();}});board.remove(old.g);}pieces.set(k,{tag,g:tile(t,x,y)});}q('v8labinfo').textContent=`Level ${lv+1} / 10 • Reach the barn`;}
 for(let y=0;y<N;y++)for(let x=0;x<N;x++)mesh(sc,box,(x+y)%2?mats.grass:mats.grass2,x-4.5,-.075,y-4.5,.99,.15,.99);
 const maps=[{"rows": ["R         ", "          ", "      R   ", "          ", "          ", "      E   ", "   P   R  ", "          ", "R         ", "     R    "], "entry": [0, -1]}, {"rows": ["          ", "R         ", "          ", "          ", "    R     ", "R         ", "  RR   P  ", "   E      ", "    R    R", "          "], "entry": [-1, 0]}, {"rows": ["          ", "        R ", "   R      ", "         R", " R  E     ", "  R       ", "R R    R  ", "      P  R", "          ", "          "], "entry": [0, 1]}, {"rows": ["          ", "          ", "       R  ", "        R ", "   R      ", "R     E   ", "R    P    ", "    R  R R", " R      RR", "          "], "entry": [1, 0]}, {"rows": ["   EP R   ", "  R       ", "         R", "  R R     ", "        R ", "R    R    ", "  R     R ", "       R  ", "          ", "   R   R  "], "entry": [0, -1]}, {"rows": ["   R      ", " R   R   P", "       R  ", "          ", "R         ", "     RR   ", "   RE     ", "          ", "R     R  R", "RR  R   R "], "entry": [-1, 0]}, {"rows": ["R  R      ", "RR  P R   ", "    R   R ", "  R       ", "         R", "R R    E  ", "   RR     ", "     R    ", "   R      ", "   R R    "], "entry": [0, 1]}, {"rows": ["          ", "         R", "          ", " RR       ", "   RR  R  ", "R  R  E  R", "R      R  ", "P        R", "R    R    ", " R  R RRR "], "entry": [1, 0]}, {"rows": ["   RR  ER ", "  R       ", " R        ", " R  RR    ", "RR P  R   ", "     R  R ", "  R       ", "       R R", "RR        ", "  R R   R "], "entry": [0, -1]}, {"rows": ["RR       R", " R   R    ", "R  R   R  ", "      E  R", "        R ", "    R  R  ", " R  R     ", "R R RR    ", " R  R     ", "P  R  R R "], "entry": [-1, 0]}];
 function init(){grid=maps[lv].rows.map(r=>r.split(''));remaining=0;dead=won=moving=false;dir=null;for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(grid[y][x]==='P'){px=x;py=y;grid[y][x]=' ';}winAt=0;q('v8labmsg').textContent='Enter through the barn doors! Avoid running off the open field.';sync();if(hero)hero.position.set(px-4.5,0,py-4.5);}
 function advance(now){if(!dir||dead||won||!ready)return;const [dx,dy]=dir,x=px+dx,y=py+dy,t=grid[y]?.[x];if(!t){fromX=px;fromY=py;px=x;py=y;moving=true;moveStart=now;dead=true;dir=null;q('v8labmsg').textContent='Oops! Moonie ran off the field. Try again!';winAt=now+650;return;}if(t==='#'||t==='R'||(t==='E'&&(dx!==maps[lv].entry[0]||dy!==maps[lv].entry[1]))){dir=null;return;}fromX=px;fromY=py;px=x;py=y;moving=true;moveStart=now;face=Math.atan2(dx,dy);if(t==='E'){won=true;dir=null;q('v8labmsg').textContent=lv===maps.length-1?'All 10 levels complete!':'Great job! You reached the barn!';winAt=now+1050; if(lv<29)q('v8labmsg').textContent='Great job! Next level…';v8Tone(76);} }
 function setDir(d){if(!ready||dead||won||moving||dir)return;audio();dir=d;}
 q('v8pad').onclick=e=>{const b=e.target.closest('[data-dir]');if(b)setDir(b.dataset.dir.split(',').map(Number));};q('v8reset').onclick=init;
 const key=e=>{const d={ArrowUp:[0,-1],ArrowDown:[0,1],ArrowLeft:[-1,0],ArrowRight:[1,0],w:[0,-1],s:[0,1],a:[-1,0],d:[1,0]}[e.key];if(d||e.code==='Space'){e.preventDefault();e.stopImmediatePropagation();if(d&&!e.repeat)setDir(d);}};window.addEventListener('keydown',key,true);
 c.onpointerdown=e=>{swipe=[e.clientX,e.clientY];c.setPointerCapture(e.pointerId);};c.onpointerup=e=>{if(!swipe)return;const dx=e.clientX-swipe[0],dy=e.clientY-swipe[1];swipe=null;if(Math.hypot(dx,dy)>12)setDir(Math.abs(dx)>Math.abs(dy)?[Math.sign(dx),0]:[0,Math.sign(dy)]);};
 function frame(now){if(closed)return;raf=requestAnimationFrame(frame);if(document.hidden||window.__moonieNativePaused){last=now;return;}const dt=Math.min(.05,(now-(last||now))/1000);last=now;const size=Math.max(1,Math.min(c.clientWidth,c.clientHeight));if(c._size!==size){c._size=size;rr.setSize(size,size,false);}const pad=navigator.getGamepads&&Array.from(navigator.getGamepads()).find(Boolean);if(pad){let d=pad.buttons[12]?.pressed||pad.axes[1]<-.5?[0,-1]:pad.buttons[13]?.pressed||pad.axes[1]>.5?[0,1]:pad.buttons[14]?.pressed||pad.axes[0]<-.5?[-1,0]:pad.buttons[15]?.pressed||pad.axes[0]>.5?[1,0]:null;const k=d?d.join(','):'';if(k&&k!==padPrev)setDir(d);padPrev=k;}
 if(moving&&now-moveStart>=duration){moving=false;if(hero)hero.position.set(px-4.5,0,py-4.5);}if(dead&&!moving&&winAt&&now>=winAt){init();}if(won&&!moving&&winAt&&now>=winAt&&lv<maps.length-1){lv++;init();}if(!moving)advance(now);if(hero){const t=moving?Math.min(1,(now-moveStart)/duration):1;hero.position.set((moving?fromX+(px-fromX)*t:px)-4.5,0,(moving?fromY+(py-fromY)*t:py)-4.5);hero.rotation.y=face;if(run&&idle){run.setEffectiveWeight(moving?1:0);idle.setEffectiveWeight(moving?0:1);}if(mixer)mixer.update(dt);}q('v8pad').classList.toggle('running',!!dir||moving);rr.render(sc,camera);}
 init();q('v8labmsg').textContent='Loading Moonie’s 3D model…';
 embeddedFile('moonie-model.txt').then(r=>r.text()).then(b64=>{if(closed)return;new THREE.GLTFLoader().parse(b64bytes(b64).buffer,'',gltf=>{if(closed)return;const model=gltf.scene;model.updateMatrixWorld(true);const bb=new THREE.Box3(),v=new THREE.Vector3();model.traverse(o=>{if(o.isSkinnedMesh){o.skeleton.update();for(let i=0;i<o.geometry.attributes.position.count;i+=5){o.boneTransform(i,v);v.applyMatrix4(o.matrixWorld);bb.expandByPoint(v);}}if(o.isMesh){o.frustumCulled=false;}});if(bb.isEmpty())bb.setFromObject(model);const center=bb.getCenter(new THREE.Vector3()),sz=bb.getSize(new THREE.Vector3());hero=new THREE.Group();const inner=new THREE.Group();inner.scale.setScalar(.94/Math.max(.001,sz.y));model.position.set(-center.x,-bb.min.y,-center.z);inner.add(model);hero.add(inner);sc.add(hero);mixer=new THREE.AnimationMixer(model);const rc=gltf.animations.find(a=>a.name==='Running')||gltf.animations.find(a=>a.name==='Walking'),ic=gltf.animations.find(a=>a.name==='Big_Wave_Hello')||rc;if(rc){run=mixer.clipAction(rc);run.play();run.timeScale=1.55;}if(ic){idle=mixer.clipAction(ic.clone());idle.play();idle.timeScale=0;idle.setEffectiveWeight(1);}ready=true;q('v8labmsg').textContent='Choose a direction. Use obstacles to stop. Enter the barn through its doors; avoid the field edges.';},()=>{q('v8labmsg').textContent='Moonie’s model could not load. Reopen the game to retry.';});}).catch(()=>{if(!closed)q('v8labmsg').textContent='Moonie’s model could not load.';});
 raf=requestAnimationFrame(frame);v8cleanup=()=>{closed=true;cancelAnimationFrame(raf);window.removeEventListener('keydown',key,true);if(mixer)mixer.stopAllAction();board.traverse(o=>{if(o.isSprite){o.material.map?.dispose();o.material.dispose();}});for(const m of [...Object.values(mats),white,dark,gold])m.dispose();for(const g of [box,ball,cone,cyl])g.dispose();rr.dispose();rr.forceContextLoss();};
}

})();
</script>

<style>
#gamesGrid{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:clamp(4px,1vw,10px);max-height:none;overflow:visible;width:100%}
#games .gsign{width:min(960px,96vw,calc((100dvh - 135px)*1.16));max-width:960px!important;padding:clamp(8px,1.5vw,18px);gap:8px;box-sizing:border-box}
#games .gcard{min-width:0;padding:clamp(3px,.5vw,7px);gap:4px;font-size:clamp(9px,1.35vw,15px);box-sizing:border-box}
#games .gcard img,#games .gcard .v8icon{box-sizing:border-box;display:block;width:100%;aspect-ratio:512/680}
#games .gcard .v8icon{display:grid;place-items:center;font-size:clamp(16px,4vw,54px)}
#games .gcard>span:last-child{min-height:2em;display:grid;place-items:center}
#games .gsign>.row{flex-wrap:nowrap;gap:6px}#games .gsign>.row .btn{font-size:clamp(11px,2vw,18px);padding:8px 12px}
@media(max-height:520px) and (orientation:landscape){#games .gsign{width:min(95vw,calc((100dvh - 90px)*1.16));padding:6px;gap:4px}#games .gsign h2{font-size:18px}#games .gcard{font-size:9px;padding:2px;gap:2px}#games .gcard>span:last-child{min-height:1.4em}#games .gsign>.row .btn{font-size:12px;padding:5px 8px}}
@media(orientation:portrait) and (max-width:600px){#games .gsign{width:96vw;padding:7px}#games .gcard{font-size:9px;padding:2px;gap:2px}}.gcard .v8icon{display:grid;place-items:center;width:100%;aspect-ratio:512/680;background:linear-gradient(#9fd8f5,#7fc65a);border:2px solid #382619;border-radius:8px;font-size:clamp(35px,8vw,80px)}
#v8panel{position:fixed;inset:0;z-index:100;background:radial-gradient(circle at top,#7f38a5 0,#5a237b 26%,#3b164f 62%,#2a0f38 100%);overflow:auto;touch-action:pan-y;padding:12px;box-sizing:border-box;text-align:center;color:#fff6df;font:800 15px var(--body)}#v8panel:before{content:'';position:fixed;inset:0;pointer-events:none;background-image:radial-gradient(circle at 10% 12%,rgba(255,255,255,.9) 0 2px,transparent 3px),radial-gradient(circle at 22% 30%,rgba(255,255,255,.6) 0 1px,transparent 2px),radial-gradient(circle at 75% 18%,rgba(255,255,255,.9) 0 2px,transparent 3px),radial-gradient(circle at 88% 28%,rgba(255,255,255,.55) 0 1px,transparent 2px),radial-gradient(circle at 62% 10%,rgba(255,255,255,.75) 0 1px,transparent 2px),radial-gradient(circle at 34% 7%,rgba(255,255,255,.7) 0 1px,transparent 2px)}#v8panel h2{font:clamp(28px,5vw,44px) var(--display);margin:4px;color:#ffd95e;text-shadow:0 3px 0 #2b123b}#v8panel button,#v8panel select{font:800 15px var(--body);border:2px solid #382619;border-radius:12px;background:#fff6df;color:#382619;padding:8px;cursor:pointer;touch-action:manipulation}#v8panel button:active{transform:scale(.95)}#v8panel .v8bar{display:flex;justify-content:center;align-items:center;gap:7px;flex-wrap:wrap;margin:8px auto}#v8panel .v8exit{position:absolute;top:8px;left:8px;z-index:5}#v8panel .v8grid{display:grid;grid-template-columns:repeat(16,minmax(16px,1fr));gap:3px;max-width:850px;margin:auto}.mooTunesShell{max-width:1120px;margin:0 auto;padding-top:36px}.mooSub{opacity:.9;margin-bottom:10px}.mooTransport{background:rgba(255,246,223,.18);border:3px solid rgba(255,230,170,.65);border-radius:18px;padding:8px 12px;box-shadow:0 8px 0 rgba(26,6,35,.28)}.mooTransport button{min-width:50px;font-size:20px;padding:8px 10px;background:linear-gradient(#ffe790,#f7c448)}.v8loopLabel,.v8tempoLabel{display:flex;align-items:center;gap:6px;background:rgba(255,246,223,.15);padding:6px 10px;border-radius:999px}.mooTracks{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px;max-width:1020px;margin:12px auto}.mooTrack{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 8px 12px;background:linear-gradient(#fff8db,#efd8a4);box-shadow:0 5px 0 rgba(31,13,41,.45)}.mooTrack .ico{font-size:28px;line-height:1}.mooTrack .name{font:20px/1 var(--display)}.mooTrack small{font:900 10px/1.1 var(--body);text-transform:uppercase;letter-spacing:.08em;opacity:.75}.mooTrack .dot{position:absolute;right:8px;top:6px;font:20px/1 var(--display);color:#a83126}.mooTrack.on{background:linear-gradient(var(--accent),#fff6df);transform:translateY(-3px);box-shadow:0 8px 0 rgba(31,13,41,.45),0 0 0 4px rgba(255,255,255,.18)}.mooStage{position:relative;max-width:1030px;margin:0 auto;padding:14px;border-radius:26px;background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.08));border:3px solid rgba(255,240,185,.72);box-shadow:0 10px 0 rgba(28,11,37,.35)}.mooStageTop{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:10px}.mooLegend{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.mooLegend span,.mooLegend b,.mooHint{background:rgba(255,246,223,.14);padding:6px 12px;border-radius:999px}.mooHint{font-size:12px;opacity:.9}.mooStaffWrap{position:relative;padding:18px 18px 18px 76px;border-radius:26px;background:radial-gradient(circle at 50% 0,rgba(255,255,255,.16),rgba(255,255,255,.04) 60%),linear-gradient(#7f2ea4,#7f2ea4 14%,#6f288f 28%,#66257f 42%,#732995 56%,#612376 70%,#6d288a 84%,#692682 100%);overflow:hidden;box-shadow:inset 0 0 0 3px rgba(255,240,190,.15)}.mooStaffWrap:before{content:'';position:absolute;left:68px;right:14px;top:17%;bottom:14%;background:repeating-linear-gradient(to bottom,rgba(88,255,100,.88) 0 2px,transparent 2px 42px);opacity:.85;pointer-events:none}.mooStaffWrap:after{content:'';position:absolute;left:68px;right:14px;top:16px;bottom:16px;background:repeating-linear-gradient(to right,rgba(166,255,120,.75) 0 2px,transparent 2px 58px);opacity:.35;pointer-events:none}.mooClef{position:absolute;left:15px;top:50%;transform:translateY(-50%);font-size:150px;line-height:1;color:#78d34d;text-shadow:0 4px 0 #1c1220}.mooDecor{position:absolute;pointer-events:none;text-shadow:0 2px 0 #25122d}.mooHorn{left:78px;top:52px;font-size:42px;transform:rotate(-18deg)}.mooStar{right:120px;bottom:54px;font-size:60px;color:#8ef13e}.mooNote{left:255px;top:26px;font-size:52px;color:#171019}.mooDuck{left:230px;top:170px;font-size:56px}.mooGrid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(16,minmax(26px,1fr));gap:4px;max-width:none}.mooGrid button{position:relative;display:flex;align-items:center;justify-content:center;padding:0;aspect-ratio:1/.92;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05);border-radius:6px;color:#ffd95e;overflow:visible}.mooGrid button em{position:absolute;left:-56px;top:50%;transform:translateY(-50%);font:900 13px/1 var(--body);font-style:normal;color:#fff8db;text-shadow:0 2px 0 #24122b;pointer-events:none}.mooGrid button span{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:auto;height:auto;font-size:33px;line-height:1;transform:translate(-50%,-50%)}.mooGrid button.on{background:rgba(255,255,255,.08)}.mooGrid button.on span{filter:drop-shadow(0 3px 0 #25122d)}.mooGrid button.now{background:rgba(127,211,255,.22);box-shadow:inset 0 0 0 3px #8fe9ff,0 0 0 2px rgba(255,255,255,.08)}.mooGrid button.now:after{content:'';position:absolute;inset:-4px auto -4px -2px;width:calc(100% + 4px);background:rgba(104,255,166,.18);pointer-events:none}.mooKeyboard{max-width:920px;margin:14px auto 8px}.mooPiano{position:relative;display:grid;grid-template-columns:repeat(8,1fr);gap:2px;padding:16px 14px 14px;background:linear-gradient(#cfd6f4,#8aa0e8);border-radius:20px;border:3px solid #382619;box-shadow:0 8px 0 rgba(28,11,37,.4)}.mooPiano .white{position:relative;height:112px;background:linear-gradient(#fff,#ececec);border:2px solid #382619;border-radius:0 0 12px 12px;box-shadow:0 5px 0 rgba(56,38,25,.35)}.mooPiano .white span{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);font:900 12px/1 var(--body);color:#654f44}.mooPiano .black{position:absolute;top:14px;width:8.5%;height:68px;background:linear-gradient(#222,#020202);border:2px solid #382619;border-radius:0 0 10px 10px;z-index:2;box-shadow:0 4px 0 rgba(0,0,0,.35)}.mooPiano .black.k0{left:10.6%}.mooPiano .black.k1{left:22.7%}.mooPiano .black.k3{left:47.1%}.mooPiano .black.k4{left:59.2%}.mooPiano .black.k5{left:71.3%}.mooPiano button.tap{transform:translateY(3px)}.mooMsg{min-height:24px;margin:8px auto 18px;color:#fff8db;text-shadow:0 2px 0 #25122d}.v8keys button{touch-action:manipulation}#v8holes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;width:min(88vw,75vh,580px);margin:auto;padding:22px;border-radius:28px;border:6px solid #5b3518;background:linear-gradient(90deg,#8d5327 0 7%,#b87640 7% 15%,#8d5327 15% 23%,#b87640 23% 31%,#8d5327 31% 39%,#b87640 39% 47%,#8d5327 47% 55%,#b87640 55% 63%,#8d5327 63% 71%,#b87640 71% 79%,#8d5327 79% 87%,#b87640 87% 95%,#8d5327 95% 100%);box-shadow:inset 0 0 0 4px rgba(255,220,170,.15),inset 0 10px 16px rgba(255,255,255,.12),inset 0 -18px 26px rgba(72,36,15,.42),0 12px 0 #5b3518,0 20px 28px rgba(0,0,0,.25);position:relative}#v8holes:before{content:'';position:absolute;inset:10px;border-radius:18px;pointer-events:none;background:repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 2px,transparent 2px 74px),radial-gradient(circle at 12% 16%,rgba(255,245,220,.13) 0 8px,transparent 9px),radial-gradient(circle at 88% 16%,rgba(255,245,220,.13) 0 8px,transparent 9px),radial-gradient(circle at 12% 84%,rgba(255,245,220,.13) 0 8px,transparent 9px),radial-gradient(circle at 88% 84%,rgba(255,245,220,.13) 0 8px,transparent 9px)}#v8holes button{position:relative;aspect-ratio:1.12;overflow:hidden;border:0;background:radial-gradient(ellipse at 50% 80%,#160e09 0 30%,#2a180d 31% 34%,#6c4120 35% 39%,#9f6535 40% 46%,transparent 47%),linear-gradient(#c99057,#a86331);cursor:crosshair;border-radius:18px;box-shadow:inset 0 4px 8px rgba(255,255,255,.12),inset 0 -6px 10px rgba(78,40,17,.28)}#v8holes .popWrap{position:absolute;inset:0;display:grid;place-items:end center;transform:translateY(112%);transition:transform .15s}#v8holes button.up .popWrap{transform:translateY(4%)}#v8holes .headWrap{width:100%;height:100%;display:grid;place-items:end center;overflow:hidden}#v8holes .headPop{width:112%;height:112%;object-fit:contain;object-position:center 24%;filter:drop-shadow(0 5px 0 rgba(0,0,0,.18))}#v8holes .poopPop{font-size:clamp(40px,9vh,72px);line-height:1;filter:drop-shadow(0 5px 0 rgba(0,0,0,.18))}#v8holes button.bonk .popWrap{transform:translateY(65%) rotate(-15deg)}#v8mallet{position:fixed;pointer-events:none;z-index:110;font-size:45px;transform:translate(-25%,-90%) rotate(-30deg)}#v8maze{display:block;margin:auto;width:min(76vw,58vh,540px);aspect-ratio:1;touch-action:none;border:4px solid #50391f;border-radius:10px;box-shadow:0 5px #50391f}#v8pad button{min-width:52px;font-size:20px;padding:5px}@media(max-width:820px){.mooGrid button em{display:none}.mooStaffWrap{padding-left:26px}.mooClef{position:static;transform:none;display:block;margin:0 auto 10px;font-size:100px}.mooStaffWrap:before,.mooStaffWrap:after{left:12px}.mooGrid{grid-template-columns:repeat(16,minmax(18px,1fr))}.mooTransport{gap:6px}.mooTrack .name{font-size:16px}.mooPiano .white{height:86px}.mooPiano .black{height:54px}.mooDecor{opacity:.7}}@media(max-height:500px){#v8panel{padding-left:80px}.mooTunesShell{padding-top:10px}.mooTransport{padding:6px 8px}.mooTrack{padding:6px}.mooGrid button span{font-size:22px}.mooPiano .white{height:60px}.mooPiano .black{height:38px}#v8maze{width:48vh}#v8holes{width:min(60vh,92vw);gap:6px;padding:10px}}
</style>

<style>.whackSplat{position:fixed;inset:0;z-index:150;pointer-events:none;animation:whackFade 1.8s forwards}.whackBlob{position:absolute;filter:drop-shadow(0 4px 2px #301a0c88)}.whackBlob svg{width:100%;height:100%}.whackFly{position:absolute;font-size:25px;animation:whackFly 1.3s ease-out forwards}@keyframes whackFade{0%{opacity:1}65%{opacity:1}100%{opacity:0}}@keyframes whackFly{to{transform:translate(var(--dx),var(--dy)) rotate(180deg);opacity:0}}#v8panel.labPanel{background:radial-gradient(ellipse,#a3d47c,#476d32);color:#fff;padding:12px}#v8panel.labPanel h2{color:#fff0b0}.labLayout{display:flex;align-items:center;justify-content:center;gap:20px;margin:10px auto}.labPanel #v8maze{width:min(76vw,76vh,760px);height:auto;aspect-ratio:1;flex:none;background:#476d32}.labSide{display:flex;flex-direction:column;gap:10px;width:200px;align-items:stretch}.labSide #v8pad{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.labSide #v8pad button:first-child{grid-column:2}.labSide #v8pad button:nth-child(2){grid-row:2;grid-column:1}.labSide #v8pad button:nth-child(3){grid-row:2;grid-column:2}.labSide #v8pad button:nth-child(4){grid-row:2;grid-column:3}.labSide #v8pad button{min-width:0;min-height:44px}#v8labmsg{font-size:13px;line-height:1.4}@media(max-width:650px) and (orientation:portrait){.labLayout{flex-direction:column;gap:8px}.labPanel #v8maze{width:min(91vw,58vh)}.labSide{width:min(90vw,350px)}}@media(max-height:500px) and (orientation:landscape){.labPanel #v8maze{width:72vh}.labSide{width:160px;gap:5px}.labPanel .labLayout{margin:3px auto}.labSide #v8pad button{min-height:32px}}</style><style>
#v8panel .mooDrumPads{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}#v8panel .mooDrumPads button{background:linear-gradient(#ffe9b3,#f5ad79);height:76px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:4px;font-size:clamp(10px,2vw,15px)}#v8panel .mooDrumPads b{font-size:25px}#v8panel .mooGrid.drumGrid button em{left:-70px;font-size:11px;width:65px;text-align:right}#v8panel .mooGrid.drumGrid button span{font-size:clamp(12px,2.5vw,27px)}@media(max-width:820px){#v8panel .mooGrid.drumGrid button em{display:block;left:-48px;width:43px;font-size:8px}#v8panel .mooStaffWrap:has(.drumGrid){padding-left:58px}#v8panel .mooDrumPads button{height:54px}} 
</style>
<style>#v8pad.running button{opacity:.48;cursor:default}</style><style>#v8panel #v8record[aria-pressed="true"]{background:#d93642;color:white;box-shadow:0 0 0 3px #ff9ba2}#v8panel .mooGrid button{aspect-ratio:auto;height:clamp(18px,3.1vh,38px)}#v8panel .mooGrid button span{font-size:clamp(14px,2.8vh,28px)}#v8panel .mooGrid button em{font-size:11px}#v8panel .mooPiano .black{background:linear-gradient(#333,#080808);color:white}</style></body></html>
